}

/* Navigation chip.
 * sets the background fill.
 * Source rule 3000.
 */
.nav-on-light .navigation-chip {
  background-color: var(--skin-surface-canvas-alpha-70);
}

/* Navigation primary nav calendar wiget calendar.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3001.
 */
.nav-on-light .navigation-primary-nav-calendar-wiget-calendar {
  border-color: var(--skin-surface-canvas);
  background-color: var(--skin-on-media-alpha-24);
}

/* Portal image.
 * tints background artwork.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3002.
 */
.nav-on-light .navigation-tab-portal-default-active-true .portal-image,
.nav-on-light .navigation-tab-portal-default-active-true:hover .portal-image,
.nav-on-light .navigation-tab-portal-default-active-false .portal-image,
.nav-on-light .navigation-tab-portal-default-active-false:hover .portal-image,
.nav-on-light .navigation-tab-portal-default-active-true:hover #NavTabDropdownIndicator,
.nav-on-light .navigation-tab-portal-default-active-false:hover #NavTabDropdownIndicator {
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Portal text.
 * Changes text/foreground colour.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3003.
 */
.nav-on-light .navigation-tab-portal-default-active-true .portal-text,
.nav-on-light .navigation-tab-portal-default-active-true:hover .portal-text,
.nav-on-light .navigation-tab-portal-default-active-false .portal-text,
.nav-on-light .navigation-tab-portal-default-active-false:hover .portal-text {
  color: var(--global-text-primary);
}

/* Nd flat black.
 * Changes text/foreground colour; tints background artwork.
 * Source rule 3004.
 */
.nav-on-light .nd-flat-black {
  color: var(--skin-ink);
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Non Diegetic Button — pointer hover.
 * sets the background fill.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3005.
 */
.nav-on-light .nonDiegeticButton:hover,
.inputs-switch-checkbox-default-switch-false--icon-none:checked:active:enabled,
.player-comparison-row-highlighted,
.nav-on-light .navigation-primary-nav-calendar-wiget-calendar:hover {
  background-color: var(--skin-on-media-alpha-35);
}

/* Navigatable tactics empty position button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3006.
 */
.navigatable-tactics-empty-position-button {
  height: 40px;
  margin: 0;
  padding: 0;
  border-width: 2px;
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
  border-radius: var(--skin-radius-card);
}

/* Navigatable tactics position.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3007.
 */
.navigatable-tactics-position {
  width: 80px;
  height: 44px;
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
  border-radius: var(--skin-radius-control);
}

/* Navigation navigation dropdown menu item base default.
 * sets the background fill; controls size/placement; sets spacing around/inside the element; defines how
 * state changes animate.
 * Source rule 3008.
 */
.navigation-_navigation-dropdown-menu_item_base-default {
  height: 32px;
  padding: 0;
  background-color: var(--skin-transparent);
  align-items: center;
  align-self: stretch;
  max-height: 32px;
  min-height: 32px;
  transition-property: var(--transition-props-paint);
  transition-duration: 0.15s;
  transition-timing-function: ease;
}

/* Navigation bookmarks expanded default type bookmark settings.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 3009.
 */
.navigation-bookmarks-expanded-default-type-bookmark-settings {
  display: flex;
  width: 550px;
  height: 633px;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--layout-surfaces-border-radius, var(--skin-radius-small));
  margin-bottom: 64px;
}

/* This is a floating popup, so use the dialog edge instead of ordinary cards.
 * Template wrappers extend beyond its bottom margin; they must not paint art
 * behind the rounded content panel. Keep their layout and hit testing intact. */
.bookmark-edit-panel.navigation-bookmarks-expanded-default-type-bookmark-settings {
  border-width: var(--skin-dialog-border-width);
  border-color: var(--skin-dialog-border);
  border-radius: var(--skin-dialog-radius);
}

.bookmark-edit-panel-floating-element > VisualElement,
.bookmark-edit-panel-floating-element > VisualElement > VisualElement,
.bookmark-edit-panel-floating-element > VisualElement > VisualElement > VisualElement {
  background-color: var(--skin-transparent);
  background-image: none;
}

/* Pin glyphs are direct concept-art leaves, not inherited text. Pair each
 * saved state with its surface while leaving arbitrary bookmark images alone. */
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-true:enabled {
  background-color: var(--skin-selection-background);
}
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-true:hover:enabled {
  background-color: var(--skin-selection-hover);
}
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-true:active:enabled {
  background-color: var(--skin-selection-pressed);
}
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-true:enabled #PinIconStyleSetter {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-false:enabled {
  background-color: var(--skin-control-background);
}
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-false:hover:enabled {
  background-color: var(--skin-control-hover);
}
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-false:active:enabled {
  background-color: var(--skin-control-pressed);
}
.bookmark-edit-panel #PinButton.input-toggle-icon-default-active-false:enabled #PinIconStyleSetter {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
.bookmark-edit-panel #PinButton:disabled {
  background-color: var(--skin-action-disabled-background);
}
.bookmark-edit-panel #PinButton:disabled #PinIconStyleSetter {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

/* Navigation browser tab label default menu true.
 * Changes text/foreground colour; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3010.
 */
.navigation-browser_tab-label-default--menu-true {
  height: 40px;
  padding: var(--numbers-border-radius-null) var(--spacing-small---8);
  color: var(--skin-text-primary);
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
}

/* Navigation chip.
 * sets the background fill; sets the outline/corner shape; controls size/placement; defines how state
 * changes animate.
 * Source rule 3011.
 */
.navigation-chip {
  width: 100%;
  height: 3px;
  background-color: var(--skin-nav-active-indicator);
  border-radius: var(--border-radius-radius-1);
  overflow: hidden;
  transition: background-color 0.1s ease-out, opacity 0.1s ease-out, width 0.1s ease-out;
}

/* Navigation chip container.
 * controls size/placement.
 * Source rule 3012.
 */
.navigation-chip-container {
  position: absolute;
  bottom: -4px;
  left: 0px;
}

/* Navigation core clubname kit.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3013.
 */
.navigation-core-clubname-kit {
  height: 48px;
  justify-content: center;
  align-items: flex-start;
  border-radius: var(--border-radius-trailing-extra-small);
  overflow: hidden;
}

/* Navigation dropdown menu item base default.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3014.
 */
.navigation-dropdown-menu_item_base-default {
  width: 195px;
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
  align-items: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Navigation dropdown menu item base default — pressed.
 * sets the background fill.
 * Source rule 3015.
 */
.navigation-dropdown-menu_item_base-default:active:enabled {
  background-color: var(--skin-selection-pressed);
  color: var(--skin-selection-foreground);
}

/* Navigation dropdown menu item base default — pointer hover.
 * sets the background fill.
 * Source rule 3016.
 */
.navigation-dropdown-menu_item_base-default:hover:enabled {
  background-color: var(--skin-selection-hover);
  color: var(--skin-selection-foreground);
}

/* This older menu family is separate from the secondary-nav sub-dropdown.
 * Only enabled pointer states receive the paired selection fill and ink. */
.navigation-dropdown-menu_item_base-default:hover:enabled .sitext,
.navigation-dropdown-menu_item_base-default:active:enabled .sitext {
  color: var(--skin-selection-foreground);
}

/* Press wins when both pseudo-states are present. */
.navigation-dropdown-menu_item_base-default:hover:active:enabled {
  background-color: var(--skin-selection-pressed);
}

/* Navigation global diagetic button.
 * controls size/placement; sets spacing around/inside the element; defines how state changes animate.
 * Source rule 3017.
 */
.navigation-global-diagetic-button {
  width: 32px;
  height: 40px;
  margin: var(--global-gap-none);
  padding: var(--global-padding-none) var(--global-padding-small);
  max-width: 32px;
  transition: min-width var(--global-transition-buttons) var(--global-transition-animation-buttons), width var(--global-transition-buttons) var(--global-transition-animation-buttons);
  align-items: center;
  justify-content: center;
}

/* Sibutton.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3018.
 */
.navigation-global-diagetic-button .sibutton {
  width: 32px;
  height: 40px;
  margin: var(--global-gap-none);
  padding: var(--global-padding-none) var(--global-padding-small);
  max-width: 32px;
  border-radius: var(--global-radius-small);
  align-items: center;
  justify-content: center;
}

/* SI dropdown selection field.
 * controls size/placement; sets spacing around/inside the element.
 * Shared rule for 7 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3019.
 */
.navigation-global-diagetic-button.trailing-button-var .si-dropdown__selection-field,
.navigation-global-diagetic-button.trailing-button-var,
.navigation-global-diagetic-button.trailing-button-var:hover,
.navigation-global-diagetic-button.trailing-button-var .sibutton,
.navigation-global-diagetic-button.trailing-button-var:hover .sibutton,
.navigation-global-diagetic-button.leading-button-var,
.navigation-global-diagetic-button.leading-button-var .sibutton {
  width: auto;
  padding: var(--global-padding-none) var(--global-padding-small);
  min-width: 40px;
}

/* Navigation identity entity selector default switch type nation.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3020.
 */
.navigation-identity-entity-selector-default-switch-type-nation {
  width: 20px;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  padding-top: 2px;
  padding-right: 0px;
  padding-bottom: 2px;
  padding-left: 0px;
  justify-content: center;
  align-items: center;
  border-radius: var(--interaction-global-radius-sm);
  flex-direction: var(--row-direction-normal);
}

/* Navigation main calendar button default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3021.
 */
.navigation-main-calendar-button-default {
  height: 42px;
  background-color: var(--skin-surface-page);
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
  margin-right: 0;
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Navigation primary nav calendar wiget calendar.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3022.
 */
.navigation-primary-nav-calendar-wiget-calendar {
  height: var(--interaction-global-height-lg);
  padding: var(--interaction-global-padding-vertical) var(--global-gap-regular);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-canvas);
  flex-direction: var(--row-direction-normal);
  justify-content: center;
  align-items: center;
  border-radius: var(--interaction-global-radius-md);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Sigradient.
 * changes opacity for the whole element and its contents.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3023.
 */
.navigation-secondary-tab-portal-default-active-false .sigradient,
.body-language-changed .body-language-morph-rest,
.navigation-tab-portal-default-active-false .navigation-chip {
  opacity: 0;
}

/* Sigradient.
 * sets the background fill; controls size/placement; changes opacity for the whole element and its
 * contents; sets the gradient colours drawn by this component.
 * Source rule 3024.
 */
.navigation-secondary-tab-portal-default-active-true .sigradient {
  opacity: 1;
  width: 100%;
  height: 2px;
  background-color: var(--skin-transparent);
  --start-colour: var(--skin-nav-active-indicator);
  --end-colour: var(--skin-nav-active-indicator);
}

/* Secondary navigation tab text.
 * Changes text/foreground colour; sets spacing around/inside the element; defines how state changes
 * animate; changes opacity for the whole element and its contents.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3025.
 */
.navigation-secondary-text-portal-default-active-false .secondary-navigation-tab-text,
.secondary-navigation-tab-dropdown .secondary-navigation-tab-text {
  opacity: 0.75;
  margin: 0;
  color: var(--skin-text-primary);
  font-size: var(--skin-font-secondary-navigation-size);
  -unity-font-definition: var(--skin-font-secondary-navigation);
  -unity-font-style: var(--skin-font-secondary-navigation-weight);
  transition: color 0.15s ease, opacity 0.15s ease;
}

/* Secondary navigation tab icon — pointer hover.
 * tints background artwork.
 * Source rule 3026.
 */
.navigation-secondary-text-portal-default-active-false:hover .secondary-navigation-tab-icon {
  -unity-background-image-tint-color: var(--skin-text-primary);
}

/* Secondary navigation tab text — pointer hover.
 * Changes text/foreground colour; changes opacity for the whole element and its contents.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3027.
 */
.navigation-secondary-text-portal-default-active-false:hover .secondary-navigation-tab-text,
.secondary-navigation-tab-dropdown:hover .secondary-navigation-tab-text {
  opacity: 1;
  color: var(--skin-text-primary);
}

/* Secondary navigation tab text.
 * Changes text/foreground colour; sets spacing around/inside the element; defines how state changes
 * animate.
 * Source rule 3028.
 */
.navigation-secondary-text-portal-default-active-true .secondary-navigation-tab-text {
  margin: 0;
  color: var(--skin-text-primary);
  font-size: var(--skin-font-secondary-navigation-size);
  -unity-font-definition: var(--skin-font-secondary-navigation);
  -unity-font-style: var(--skin-font-secondary-navigation-weight);
  transition-property: var(--transition-props-paint);
  transition-duration: 0.15s;
  transition-timing-function: ease;
}

/* Header bookmark labels — keeps longer shortcuts clear of the overflow button. */
.bookmarks-button .bookmark-label {
  font-size: var(--skin-font-bookmark-label-size);
  -unity-font-definition: var(--skin-font-bookmark-label);
  -unity-font-style: var(--skin-font-bookmark-label-weight);
}

/* Header bookmarks are shortcuts, quieter than the current navigation tab.
 * Share its typography role, with quiet borderless controls and preserve
 * bookmark images rather than tinting arbitrary club/content artwork. */
#MenuTitle #SecondaryNavigationBar .bookmarks-button {
  background-color: var(--skin-bookmark-background);
  border-color: var(--skin-bookmark-border);
  border-width: var(--skin-bookmark-border-width);
  border-radius: var(--skin-radius-control);
  color: var(--skin-bookmark-foreground);
}
#MenuTitle #SecondaryNavigationBar .bookmarks-button:hover:enabled {
  background-color: var(--skin-bookmark-hover);
}
#MenuTitle #SecondaryNavigationBar .bookmarks-button:active:enabled {
  background-color: var(--skin-bookmark-pressed);
}
#MenuTitle #SecondaryNavigationBar .bookmarks-button:focus:enabled {
  border-width: var(--skin-bookmark-focus-border-width);
  border-color: var(--skin-focus-ring);
}
/* The overflow glyph is painted on the clickable host itself. Native button
 * height/padding stretched its 16px artwork into a narrow tall chevron. Keep
 * a square target and an independently sized, centred background image. */
#MenuTitle #SecondaryNavigationBar #BookmarksPopupWidget.bookmarks-button {
  width: var(--skin-bookmark-overflow-size);
  height: var(--skin-bookmark-overflow-size);
  min-width: var(--skin-bookmark-overflow-size);
  max-height: var(--skin-bookmark-overflow-size);
  padding: var(--skin-bookmark-overflow-padding);
  background-size: var(--skin-bookmark-overflow-icon-size) var(--skin-bookmark-overflow-icon-size);
  background-position: center;
  -unity-background-image-tint-color: var(--skin-bookmark-foreground);
  align-self: center;
}
#MenuTitle #SecondaryNavigationBar .bookmark-label,
#MenuTitle #SecondaryNavigationBar #BookmarksText {
  font-size: var(--skin-font-bookmark-label-size);
  -unity-font-definition: var(--skin-font-bookmark-label);
  -unity-font-style: var(--skin-font-bookmark-label-weight);
  color: var(--skin-bookmark-foreground);
}

/* Compact quick links share the row with the overflow control; use the small
 * spacing token so the final visible label is not hidden behind “+N”. */
.bookmarks-button.padding-horizontal-global-padding-regular {
  padding-left: var(--interaction-global-padding-horizontal-sm);
  padding-right: var(--interaction-global-padding-horizontal-sm);
}

/* Navigation tab default default text.
 * Changes text/foreground colour; sets font/text presentation; defines how state changes animate.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3029.
 */
.navigation-tab-default-default--active-false .navigation-tab-default-default-text,
.navigation-tab-default-default--active-false .body-md {
  color: var(--skin-text-secondary);
  font-size: var(--typography-size-16);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-left;
  transition-property: color;
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Navigation tab settings circle empty icon.
 * tints background artwork; defines how state changes animate.
 * Source rule 3030.
 */
.navigation-tab-default-default--active-false .navigation-tab-settings-circle-empty-icon {
  -unity-background-image-tint-color: var(--skin-on-media-alpha-65);
  transition-property: -unity-background-image-tint-color;
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Navigation tab settings circle filled icon.
 * tints background artwork; defines how state changes animate.
 * Source rule 3031.
 */
.navigation-tab-default-default--active-false .navigation-tab-settings-circle-filled-icon {
  -unity-background-image-tint-color: var(--skin-transparent);
  transition-property: -unity-background-image-tint-color;
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Navigation tab default default active false.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3032.
 */
.navigation-tab-default-default--active-false,
.menu-element .navigation-tab-default-default--active-false {
  border-width: 1.5px;
  background-color: var(--none);
  color: var(--skin-text-secondary);
  padding-top: 0px;
  padding-right: var(--global-padding-extra-large);
  padding-bottom: 0px;
  padding-left: var(--global-padding-extra-large);
  justify-content: center;
  align-items: center;
  flex-direction: var(--row-direction-normal);
  transition-property: color, background-color, border-color;
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Navigation tab default default active false — disabled.
 * Changes text/foreground colour.
 * Source rule 3033.
 */
.navigation-tab-default-default--active-false:disabled {
  color: var(--skin-text-disabled);
}

/* Navigation tab default default text.
 * Changes text/foreground colour; sets font/text presentation; defines how state changes animate.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3034.
 */
.navigation-tab-default-default--active-true .navigation-tab-default-default-text,
.manager-creation-face-sculpt-dropdown--active-true,
.virtualised-list__item--selected .navigation-tab-default-default-text,
.navigation-tab-default-default--active-true.navigation-tab-default-default--active-false .sitext {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-16);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-left;
  transition-property: color;
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Navigation tab default default active true.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3035.
 */
.navigation-tab-default-default--active-true,
.virtualised-list__item--selected .navigation-tab-default-default--active-false {
  padding: 0 var(--global-padding-extra-large);
  border-width: 1.5px;
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  justify-content: center;
  align-items: center;
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--colours-base-neutral-white);
  flex-direction: var(--row-direction-normal);
  cursor: var(--cursor-default-1x-url) var(--cursor-default-1x-hotspot-x) var(--cursor-default-1x-hotspot-y);
}

/* Navigation tab default default text.
 * sets font/text presentation.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3036.
 */
.navigation-tab-default-small-text .navigation-tab-default-default-text,
.standard-breakpoint .breakpoint-text,
.portal-messages-small-res .portal-messages-header-text {
  font-size: var(--typography-size-14);
}

/* Navigation tab dropdown.
 * controls size/placement.
 * Source rule 3037.
 */
.navigation-tab-dropdown {
  width: 24px;
  align-items: center;
  justify-content: center;
}

/* SI dropdown selection field.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element; defines
 * how state changes animate.
 * Source rule 3038.
 */
.navigation-tab-dropdown > .si-dropdown__selection-field {
  opacity: 0.65;
  padding: 0;
  border-width: 0;
  flex-direction: var(--row-direction-normal);
  flex-grow: 0;
  flex-shrink: 1;
  transition: opacity var(--global-transition-long) ease-in-out;
  border-radius: var(--skin-radius-card);
  align-items: center;
}

/* Navigation tab group box.
 * sets spacing around/inside the element.
 * Source rule 3039.
 */
.navigation-tab-group-box {
  margin-top: var(--global-gap-none);
  padding-top: var(--global-gap-none);
}

/* Navigation tab no dropdown padding element.
 * controls size/placement.
 * Source rule 3040.
 */
.navigation-tab-no-dropdown-padding-element {
  width: 10px;
}

/* Navigation tab dropdown.
 * sets spacing around/inside the element; defines how state changes animate.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3041.
 */
.navigation-tab-portal-default-active-false .navigation-tab-dropdown,
.navigation-tab-portal-default-active-true .navigation-tab-dropdown,
.navigation-tab-portal-default-active-false .navigation-tab-dropdown:hover,
.navigation-tab-portal-default-active-true .navigation-tab-dropdown:hover {
  padding: 0;
  transition: background-color 0.3s ease-in-out, border-radius 0.3s ease-in-out, opacity 0.3s ease-in-out;
}

/* Portal image.
 * tints background artwork.
 * Source rule 3042.
 */
.navigation-tab-portal-default-active-false .portal-image {
  -unity-background-image-tint-color: var(--skin-component-navigation-tab-portal-default-active-false-portal-image-image-tint);
}

/* Inactive primary portal text.
 * The shared thematic-md role owns its font; keep inactive labels quieter.
 * Source rule 3043.
 */
.navigation-tab-portal-default-active-false .portal-text {
  opacity: 0.75;
  color: var(--skin-text-primary);
  transition: color 0.15s ease, opacity 0.15s ease;
}

/* Navigation tab portal default active false.
 * sets the background fill; controls size/placement; sets spacing around/inside the element; defines how
 * state changes animate.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3044.
 */
.navigation-tab-portal-default-active-false,
.navigation-tab-portal-default-active-true {
  height: var(--main-header-tab-height);
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
  flex-direction: column;
  align-items: flex-start;
  transition-property: var(--transition-props-continuous);
  transition-duration: var(--global-transition-long);
  transition-timing-function: ease-in-out;
}

/* SI dropdown selection field — pointer hover.
 * sets the background artwork; controls size/placement; sets spacing around/inside the element; defines how
 * state changes animate.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3045.
 */
.navigation-tab-portal-default-active-false:hover .navigation-tab-dropdown > .si-dropdown__selection-field,
.navigation-tab-portal-default-active-true:hover .navigation-tab-dropdown > .si-dropdown__selection-field {
  opacity: 1;
  padding: 0;
  background-image: none;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 1;
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-long);
  transition-timing-function: ease-in-out;
}

/* Navigation tab dropdown — pointer hover.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element; changes
 * opacity for the whole element and its contents.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3046.
 */
.navigation-tab-portal-default-active-false:hover .navigation-tab-dropdown,
.navigation-tab-portal-default-active-true:hover .navigation-tab-dropdown {
  opacity: 1;
  padding: 0;
  background-color: var(--skin-transparent);
  border-radius: 0;
}

/* Visual highlighted — pointer hover.
 * Changes text/foreground colour.
 * Source rule 3047.
 */
.navigation-tab-portal-default-active-false:hover .portal-text > .si-dropdown__selection-field.visual-highlighted {
  color: var(--skin-text-secondary);
}

/* Navigation chip.
 * controls size/placement; changes opacity for the whole element and its contents.
 * Source rule 3048.
 */
.navigation-tab-portal-default-active-true .navigation-chip {
  opacity: 1;
  width: 12px;
}

/* Active primary portal text.
 * The shared thematic-md role owns its font; keep full active-state contrast.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3049.
 */
.navigation-tab-portal-default-active-true .portal-text,
.navigation-tab-portal-default-active-true:hover .portal-text {
  opacity: 1;
  color: var(--skin-text-primary);
}

/* FM applies thematic-md after portal-tab rules. This role-scoped selector
 * keeps the primary-nav face from falling back to the condensed game font;
 * secondary nav and metadata keep their own body/data roles.
 */
.nav-on-dark .navigation-tab-portal-default-active-false .portal-text.thematic-md,
.nav-on-dark .navigation-tab-portal-default-active-true .portal-text.thematic-md {
  -unity-font-definition: var(--skin-font-primary-navigation);
  -unity-font-style: var(--skin-font-primary-navigation-weight);
}

/* Navigation tab regular default active false.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3050.
 */
.navigation-tab-regular-default--active-false,
.buttongroup.Default .navigation-tab-regular-default--active-false {
  height: var(--interaction-global-height-md);
  padding: var(--global-padding-regular) var(--global-padding-none);
  background-color: var(--none);
  justify-content: center;
  align-items: center;
  align-self: stretch;
  border-left-color: var(--none);
  border-right-color: var(--none);
  border-top-color: var(--none);
  border-bottom-width: var(--global-border-thick);
  margin-right: var(--spacing-padding-medium---16);
  flex-direction: var(--row-direction-normal);
}

/* Navigation tab regular default active false — pointer hover.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3051.
 */
.navigation-tab-regular-default--active-false:hover,
.navigation-tab-regular-default--active-true:hover {
  border-bottom-color: var(--colours-base-neutral-white);
}

/* Navigation tab regular default active true.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3052.
 */
.navigation-tab-regular-default--active-true,
.buttongroup.Default .navigation-tab-regular-default--active-true {
  height: var(--interaction-global-height-md);
  padding: var(--global-padding-regular) var(--global-padding-none);
  justify-content: center;
  align-items: center;
  border-bottom-width: var(--global-border-thick);
  border-bottom-color: var(--colours-base-neutral-white);
  margin-right: var(--spacing-padding-medium---16);
  flex-direction: var(--row-direction-normal);
}

/* Navigation tab settings.
 * controls size/placement.
 * Source rule 3053.
 */
.navigation-tab-settings {
  width: 202px;
  height: 34px;
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  align-items: center;
}

/* Detailed Preferences is a navigation list, not a list of section headings.
 * The native Default buttongroup forces selected heading-md labels back to
 * primary white at higher specificity. Scope the actual template label so its
 * selection ink and navigation type survive that shared native contract. */
.fmc-preferences-radio-buttons .navigation-tab-settings #navigation-tab-title-text {
  font-size: var(--skin-font-secondary-navigation-size);
  -unity-font-definition: var(--skin-font-secondary-navigation);
  -unity-font-style: var(--skin-font-secondary-navigation-weight);
}
.fmc-preferences-radio-buttons.buttongroup__button:hover:enabled > .navigation-tab-settings #navigation-tab-title-text,
.fmc-preferences-radio-buttons.buttongroup__button:active:enabled > .navigation-tab-settings #navigation-tab-title-text,
.tabgroup__tab-settings--active .navigation-tab-settings #navigation-tab-title-text,
.fmc-preferences-radio-buttons .navigation-tab-settings:hover:enabled #navigation-tab-title-text,
.fmc-preferences-radio-buttons .navigation-tab-settings:active:enabled #navigation-tab-title-text {
  color: var(--skin-radio-interaction-foreground);
}
.fmc-preferences-radio-buttons .navigation-tab-settings:disabled #navigation-tab-title-text {
  color: var(--skin-text-disabled);
}

/* Navigation tab small default.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 3054.
 */
.navigation-tab-small-default {
  height: var(--interaction-global-height-sm);
  padding: var(--global-padding-regular) var(--global-padding-none);
  background-color: var(--none);
  color: var(--skin-text-secondary);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  border-bottom-width: var(--global-border-thick);
  border-bottom-color: var(--none);
}

/* Navigation tab small default text.
 * Changes text/foreground colour; sets font/text presentation; defines how state changes animate.
 * Source rule 3055.
 */
.navigation-tab-small-default--active-false .navigation-tab-small-default-text {
  color: var(--skin-text-secondary);
  font-size: var(--typography-size-14);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-left;
  -unity-font-style: var(--typography-weight-bold);
  transition: color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Navigation tab small default active false.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3056.
 */
.navigation-tab-small-default--active-false,
.buttongroup.Default .navigation-tab-small-default--active-false {
  height: var(--interaction-global-height-sm);
  padding: var(--global-padding-regular) var(--global-padding-none);
  background-color: var(--none);
  justify-content: center;
  align-items: center;
  margin-right: var(--spacing-tiles);
  flex-direction: var(--row-direction-normal);
  transition-property: var(--transition-props-continuous);
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
  border-bottom-width: var(--global-border-thick);
  border-bottom-color: var(--none);
}

/* Navigation tab small default text.
 * Changes text/foreground colour; sets font/text presentation; defines how state changes animate.
 * Source rule 3057.
 */
.navigation-tab-small-default--active-true .navigation-tab-small-default-text {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-left;
  -unity-font-style: var(--typography-weight-bold);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Navigation tab small default active true.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3058.
 */
.navigation-tab-small-default--active-true,
.buttongroup.Default .navigation-tab-small-default--active-true {
  height: var(--interaction-global-height-sm);
  padding: var(--global-padding-regular) var(--global-padding-none);
  background-color: var(--none);
  justify-content: center;
  align-items: center;
  border-bottom-width: var(--global-border-thick);
  border-bottom-color: var(--colours-base-neutral-white);
  margin-right: var(--spacing-tiles);
  flex-direction: var(--row-direction-normal);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Tabgroup tab active.
 * Changes text/foreground colour; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3059.
 */
.navigation-tab-small-default.tabgroup__tab--active,
.navigation-tab-small-default.buttongroup__button--active {
  color: var(--skin-text-primary);
  border-bottom-width: var(--global-border-thick);
  border-bottom-color: var(--colours-base-neutral-white);
}

/* Navigation type competition.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3060.
 */
.navigation-type-competition {
  width: 100%;
  height: 30px;
  max-height: 30px;
  padding-right: var(--global-padding-regular);
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* Non Diegetic Button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3111.
 */
.nonDiegeticButton {
  height: var(--interaction-global-height-lg);
  margin: 0px;
  padding: var(--interaction-global-padding-vertical) var(--global-gap-regular);
  border-width: var(--none);
  background-color: var(--none);
  flex-direction: var(--row-direction-normal);
  justify-content: center;
  align-items: center;
  border-radius: var(--interaction-global-radius-md);
  transition: background-color 0.15s ease;
}

/* Selection Field.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3112.
 */
.nonDiegeticButton #SelectionField {
  margin: var(--none);
  padding: var(--none);
  border-width: var(--none);
  justify-content: center;
  border-radius: var(--interaction-global-radius-md);
}

/* The action and clock are anchors in the top bar, not secondary metadata.
 * Use the explicit bold font file rather than synthetic weight selection. */
#MenuTitle .continue-button #text,
.continue-button---match #text,
#MenuTitle .calendar-widget-time-container #Time {
  -unity-font-definition: var(--skin-font-action-emphasis);
  -unity-font-style: var(--skin-font-action-emphasis-weight);
}

/* Navigation items are not table rows. Let the secondary bar own the surface,
 * while its existing active underline and text hover remain visible. */
#MenuTitle #SecondaryNavigationTabs .virtualised-list__item,
#MenuTitle #SecondaryNavigationTabs .virtualised-list__item--odd {
  background-color: var(--skin-transparent);
}

/* Recruitment priority is a filled segmented choice. Native FocusPriorityButtons
 * uses plain glyph elements (including the stock ggame spelling). Tint only
 * selected glyphs; unselected Top keeps its meaningful amber priority artwork. */
.buttongroup.SegmentedButtonRow .buttongroup__button--active:enabled .game-concepts-focus-top_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:enabled .ggame-concepts-focus-standard_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:enabled .game-concepts-focus-ongoing_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.buttongroup.SegmentedButtonRow .buttongroup__button--active:disabled .game-concepts-focus-top_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:disabled .ggame-concepts-focus-standard_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:disabled .game-concepts-focus-ongoing_small {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}
