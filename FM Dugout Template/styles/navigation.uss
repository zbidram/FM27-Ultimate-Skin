/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Navigation
 * Native navigation selectors, with adjacent shared rules in source order.
 */

/* Tabgroup tab.
 * controls size/placement.
 * Source rule 37.
 */
.tabgroup > .tabgroup__tabs .tabgroup__tab {
  height: 34px;
}

/* Buttongroup button.
 * controls size/placement.
 * Source rule 38.
 */
.buttongroup__button {
  height: 34px;
}

/* Tab button height store fmc.
 * controls size/placement.
 * Source rule 39.
 */
.tabgroup > .tabgroup__tabs .tab-button-height-store-fmc {
  height: 34px;
}

/* Manager creation tab button mobile.
 * controls size/placement.
 * Source rule 40.
 */
.tabgroup > .buttongroup .manager-creation-tab-button-mobile {
  height: 34px;
}

/* Manager creation tab button.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 41.
 */
.tabgroup > .row-direction-normal > .buttongroup .manager-creation-tab-button {
  height: 34px;
  padding: 0 16px 0 16px;
}

/* Tabgroup tab.
 * controls size/placement.
 * Source rule 42.
 */
.tabgroup.largetabs > .tabgroup__tabs .tabgroup__tab {
  height: 34px;
}

/* Tabgroup tab leading.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 43.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--leading,
.buttongroup.SegmentedButtonRow .buttongroup__button--leading {
  margin: 0 1px 0 0;
  border-radius: var(--border-radius-leading-small);
}

/* Tabgroup tab trailing.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 44.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--trailing,
.buttongroup.SegmentedButtonRow .buttongroup__button--trailing {
  margin: 0 0 0 1px;
  border-radius: var(--border-radius-trailing-small);
}

/* Generated rows can retain both active/inactive placement classes. The live
 * group state owns selection; unselected labels stay readable on neutral paint. */
.buttongroup.SegmentedButtonRow .buttongroup__button {
  color: var(--skin-text-primary);
}
.buttongroup.SegmentedButtonRow .buttongroup__button .sitext,
.buttongroup.SegmentedButtonRow .buttongroup__button .sitextmedium,
.buttongroup.SegmentedButtonRow .buttongroup__button .sitextsmall {
  color: var(--skin-text-primary);
}
.buttongroup.SegmentedButtonRow .buttongroup__button .global-text-secondary {
  color: var(--skin-text-secondary);
}

/* Tabgroup tab active.
 * sets the background fill; sets the background artwork; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 45.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active,
.buttongroup.SegmentedButtonRow .buttongroup__button--active {
  border-color: var(--skin-border-default);
  background-color: var(--skin-selection-background);
  background-image: none;
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active,
.buttongroup.SegmentedButtonRow .buttongroup__button--active {
  --custom-focus-background: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}

/* Tabgroup tab active.
 * Changes text/foreground colour.
 * Shared rule for 7 selectors. Editing a declaration here affects the whole group below.
 * Source rule 46.
 */
.buttons-segmented-button-row-active-regular-placement-leading,
.buttons-segmented-button-row-active-regular-placement-middle,
.buttons-segmented-button-row-active-regular-placement-trailing,
.buttons-segmented-button-row-active-small-placement-leading,
.buttons-segmented-button-row-active-small-placement-middle,
.buttons-segmented-button-row-active-small-placement-trailing,
.buttons-segmented-button-row-active-default-placement-leading {
  --custom-focus-background: var(--skin-selection-background);
}

/* Tabgroup tab active.
 * Changes text/foreground colour.
 * Source rule 46.
 */
.buttons-segmented-button-row-active-default-placement-middle {
  color: var(--skin-text-primary);
  --custom-focus-background: var(--skin-selection-background);
}

/* Tabgroup tab active.
 * Changes text/foreground colour.
 * Source rule 46.
 */
.buttons-segmented-button-row-active-default-placement-trailing {
  --custom-focus-background: var(--skin-selection-background);
}

/* Global text secondary.
 * Active segmented rows are Volt, so nested secondary labels need the same
 * dark selection foreground as their primary labels.
 * Shared rule for 11 selectors. Editing a declaration here affects the whole group below.
 * Source rule 47.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active .global-text-secondary,
.buttongroup.SegmentedButtonRow .buttongroup__button--active .global-text-secondary,
.buttons-segmented-button-row-active-regular-placement-leading .global-text-secondary,
.buttons-segmented-button-row-active-regular-placement-middle .global-text-secondary,
.buttons-segmented-button-row-active-regular-placement-trailing .global-text-secondary,
.buttons-segmented-button-row-active-small-placement-leading .global-text-secondary,
.buttons-segmented-button-row-active-small-placement-middle .global-text-secondary,
.buttons-segmented-button-row-active-small-placement-trailing .global-text-secondary,
.buttons-segmented-button-row-active-default-placement-leading .global-text-secondary,
.buttons-segmented-button-row-active-default-placement-middle .global-text-secondary,
.buttons-segmented-button-row-active-default-placement-trailing .global-text-secondary {
  color: var(--skin-selection-foreground);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab:hover:enabled {
  background-color: var(--skin-selection-hover);
  color: var(--skin-selection-foreground);
}

/* Buttongroup button — pointer hover.
 * sets the background fill.
 * Source rule 49.
 */
.buttongroup.SegmentedButtonRow .buttongroup__button:hover:enabled {
  background-color: var(--skin-control-hover);
  color: var(--skin-text-primary);
}

/* A selected segmented control lightens slightly on hover while preserving its
 * selected state and the paired dark Volt foreground.
 */
.buttongroup.SegmentedButtonRow .buttongroup__button--active:hover:enabled {
  background-color: var(--skin-selection-hover);
  cursor: var(--cursor-default-1x-url) var(--cursor-default-1x-hotspot-x) var(--cursor-default-1x-hotspot-y);
  color: var(--skin-selection-foreground);
}

/* Held feedback follows the same selected/unselected distinction and wins
 * over hover, including rows with both generated placement classes. */
.buttongroup.SegmentedButtonRow .buttongroup__button:active:enabled {
  background-color: var(--skin-control-pressed);
  color: var(--skin-text-primary);
}
.buttongroup.SegmentedButtonRow .buttongroup__button--active:active:enabled {
  background-color: var(--skin-selection-pressed);
  color: var(--skin-selection-foreground);
}

/* Sitext hover cursor — pointer hover.
 * chooses the pointer and hotspot.
 * Source rule 51.
 */
.buttongroup.SegmentedButtonRow .buttongroup__button--active:hover:enabled .sitext-hover-cursor {
  cursor: var(--cursor-default-1x-url) var(--cursor-default-1x-hotspot-x) var(--cursor-default-1x-hotspot-y);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active .sitext,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active .sitextmedium,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active .sitextsmall,
.buttongroup.SegmentedButtonRow .buttongroup__button--active .sitext,
.buttongroup.SegmentedButtonRow .buttongroup__button--active .sitextmedium,
.buttongroup.SegmentedButtonRow .buttongroup__button--active .sitextsmall,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab:hover:enabled .sitext,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab:hover:enabled .sitextmedium,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab:hover:enabled .sitextsmall,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:hover:enabled .sitext,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:hover:enabled .sitextmedium,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:hover:enabled .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Possession selectors use plain glyph elements, not Unity Image children.
 * Verified on Squad Overview: inherited text colour does not tint their art.
 * Keep this limited to the two stock glyphs so badges/portraits are untouched. */
.buttongroup.SegmentedButtonRow .buttongroup__button--active:enabled .game-concepts-in-possession_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:enabled .game-concepts-out-of-possession_small,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active:enabled .game-concepts-in-possession_small,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active:enabled .game-concepts-out-of-possession_small,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab:hover:enabled .game-concepts-in-possession_small,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab:hover:enabled .game-concepts-out-of-possession_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

.buttongroup.SegmentedButtonRow .buttongroup__button--active:disabled .game-concepts-in-possession_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:disabled .game-concepts-out-of-possession_small,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active:disabled .game-concepts-in-possession_small,
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab--active:disabled .game-concepts-out-of-possession_small {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

/* Scout/Analyst segmented tabs create plain monochrome concept leaves.
 * Their text colour does not tint the artwork. Pair only these verified glyphs
 * with the real group selection, keeping portraits and status art untouched. */
.buttongroup.SegmentedButtonRow .buttongroup__button .game-concepts-scouting-binoculars_small,
.buttongroup.SegmentedButtonRow .buttongroup__button .game-concepts-analyst-bar-chart_small {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
.buttongroup.SegmentedButtonRow .buttongroup__button:disabled .game-concepts-scouting-binoculars_small,
.buttongroup.SegmentedButtonRow .buttongroup__button:disabled .game-concepts-analyst-bar-chart_small {
  -unity-background-image-tint-color: var(--skin-text-disabled);
}
.buttongroup.SegmentedButtonRow .buttongroup__button--active:enabled .game-concepts-scouting-binoculars_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:enabled .game-concepts-analyst-bar-chart_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:disabled .game-concepts-scouting-binoculars_small,
.buttongroup.SegmentedButtonRow .buttongroup__button--active:disabled .game-concepts-analyst-bar-chart_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* Navigation
 * Native navigation selectors, with adjacent shared rules in source order.
 */

/* Ribbon button left.
 * sets the outline/corner shape.
 * Source rule 492.
 */
.ribbon__button-left {
  border-bottom-right-radius: 0;
  border-top-right-radius: 0;
  border-right-color: var(--skin-transparent);
  border-right-width: 0;
}

/* Ribbon button right.
 * sets the outline/corner shape.
 * Source rule 493.
 */
.ribbon__button-right {
  border-bottom-left-radius: 0;
  border-top-left-radius: 0;
  border-left-width: 0;
}

/* Ribbon button middle.
 * sets the outline/corner shape.
 * Source rule 494.
 */
.ribbon__button-middle {
  border-radius: 0;
  border-left-width: 0;
  border-right-width: 0;
  border-right-color: var(--skin-transparent);
}

/* Ribbon button content selected.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 495.
 */
.ribbon-button-content__selected {
  height: 32px;
  padding: var(--spacing-padding-small---8);
  border-color: var(--skin-on-media-alpha-40);
  background-color: var(--skin-text-secondary);
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-card);
  flex-direction: var(--row-direction-normal);
}

/* Sitext.
 * Hides these elements.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 496.
 */
.ribbon-button-no-text .sitext,
.ribbon-button-selected-with-text .sitext {
  display: none;
}

/* Sitext.
 * Shows these elements; Changes text/foreground colour; sets font/text presentation.
 * Source rule 497.
 */
.ribbon-button-selected-with-text .ribbon-button-content__selected .sitext {
  display: flex;
  color: var(--skin-selection-foreground);
  -unity-font-definition: var(--skin-font-display);
}

/* Unity image.
 * tints background artwork.
 * Source rule 498.
 */
.ribbon-button-content__selected .unity-image {
  -unity-background-image-tint-color: var(--skin-surface-page);
}

/* Home ribbon root.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 499.
 */
.home-ribbon-root {
  position: absolute;
  flex-grow: 1;
  bottom: 0;
  padding-bottom: 24px;
  align-self: flex-end;
}

/* Home ribbon root.
 * defines how state changes animate.
 * Source rule 500.
 */
.overlay-ribbon .home-ribbon-root {
  transition-property: translate;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  translate: 0 0;
}

/* Home ribbon root.
 * defines how state changes animate.
 * Source rule 501.
 */
.overlay-ribbon--hidden .home-ribbon-root {
  transition-property: translate;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  translate: 0 100px;
}

/* Virtualised list item.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 502.
 */
.si-dropdown-iphone .virtualised-list__item {
  width: 220px;
  height: 40px;
  margin: 0;
  padding: 3px 0;
  background-color: var(--skin-surface-canvas-alpha-90);
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  white-space: nowrap;
  -unity-text-align: middle-left;
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  border-bottom-width: 1px;
  border-bottom-color: var(--skin-on-media-alpha-10);
}

/* Unity radio button group container.
 * controls size/placement.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 503.
 */
.game-creation-radiogroup .unity-radio-button-group__container,
.game-creation-radiogroup .unity-radio-button__container,
.grow_radiogroup .unity-radio-button-group__container {
  flex-grow: 1;
  align-self: stretch;
  justify-content: flex-start;
}

/* Shortcut fake button.
 * sets the background fill; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 504.
 */
.shortcut-fake-button,
.search-fake-button > SIButton {
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
}

/* Shortcuts panel.
 * controls size/placement.
 * Source rule 505.
 */
.shortcuts-panel {
  position: absolute;
  translate: 0 100px;
  bottom: 0;
  left: 0;
  right: 0;
}

/* Shortcuts panel gradient.
 * sets the gradient colours drawn by this component.
 * Source rule 506.
 */
.shortcuts-panel-gradient {
  --start-colour: var(--skin-transparent);
  --end-colour: var(--skin-surface-canvas-alpha-94);
}

/* Tab Button Scroll View.
 * controls size/placement.
 * Source rule 507.
 */
#TabButtonScrollView {
  width: 100%;
  flex-shrink: 0;
}

/* Quick action buttons template layout.
 * controls size/placement.
 * Source rule 509.
 */
.quick-action-buttons-template-layout {
  position: absolute;
  width: 100%;
  left: 0;
  bottom: 0;
}

/* Quick action buttons.
 * sets spacing around/inside the element.
 * Source rule 510.
 */
.quick-action-buttons {
  padding-left: 64px;
  padding-bottom: 24px;
}

/* SI card title bar header.
 * sets the background fill; sets the background artwork; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 511.
 */
.si-card-title-bar-header {
  height: 24px;
  background-color: var(--skin-transparent);
  background-image: none;
  margin-top: 4px;
  margin-bottom: 4px;
  flex-direction: var(--row-direction-normal);
  padding-right: 12px;
  padding-left: 12px;
  flex-shrink: 0;
  flex-grow: 1;
}

/* Sidropdown iphone card header.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 512.
 */
.sidropdown-iphone-card-header {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-16);
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-left;
}

/* Bg hover transparency 50 — pointer hover.
 * sets the background fill; chooses the pointer and hotspot.
 * Source rule 513.
 */
.bg-hover-transparency-50:hover:enabled {
  background-color: var(--skin-surface-canvas-alpha-50);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sibutton — pointer hover.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 514.
 */
.search-fake-button > .sibutton:hover {
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
}

/* SI grid element margin top.
 * sets spacing around/inside the element.
 * Source rule 515.
 */
.si-grid-element-margin-top {
  margin-top: var(--spacing-padding-medium---16);
}

/* Global search card container.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 516.
 */
.global-search-card-container {
  background-color: var(--skin-surface-page-alpha-80);
  flex-grow: 1;
  align-items: center;
  padding-top: 16px;
  padding-right: 16px;
  padding-bottom: 16px;
  padding-left: 16px;
}

/* Round border centered content.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 517.
 */
.round-border-centered-content {
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--colours-speak-to-background-default);
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-card);
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
}

/* Quick-action dropdown uses the same Volt action surface as a primary button.
 * Pair its label with dark action ink; generic dropdown text otherwise stays white.
 * Source rule 518.
 */
.si-dropdown-quick-action > .si-dropdown__selection-field {
  padding: var(--spacing-small---8) var(--spacing-tiles);
  border-color: var(--skin-action-primary-border);
  background-color: var(--skin-action-primary-background);
  color: var(--skin-action-primary-foreground);
  background-image: none;
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  flex-shrink: 1;
  max-height: 32px;
  overflow: visible;
}

/* Keep the whole quick-action family paired across default, hover, pressed and
 * disabled states. Only text is recoloured: badges and other artwork keep their
 * own image colours. */
.si-dropdown-quick-action > .si-dropdown__selection-field .sitext,
.si-dropdown-quick-action > .si-dropdown__selection-field .sitextmedium,
.si-dropdown-quick-action > .si-dropdown__selection-field .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

.si-dropdown-quick-action > .si-dropdown__selection-field:hover:enabled {
  background-color: var(--skin-action-primary-hover);
}

.si-dropdown-quick-action > .si-dropdown__selection-field:active:enabled {
  background-color: var(--skin-action-primary-pressed);
}

.si-dropdown-quick-action > .si-dropdown__selection-field:disabled {
  border-color: var(--skin-action-disabled-border);
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-action-disabled-foreground);
}

.si-dropdown-quick-action > .si-dropdown__selection-field:disabled .sitext,
.si-dropdown-quick-action > .si-dropdown__selection-field:disabled .sitextmedium,
.si-dropdown-quick-action > .si-dropdown__selection-field:disabled .sitextsmall {
  color: var(--skin-action-disabled-foreground);
}

/* Block background.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 519.
 */
.block-background,
.tactic-position-overview-widget-item__unfilled {
  background-color: var(--skin-surface-page-alpha-80);
}

/* Sitooltip.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 520.
 */
.sitooltip {
  padding: 8px;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-raised);
  border-radius: var(--skin-radius-small);
}

/* Sitooltip floating element.
 * controls size/placement.
 * Source rule 521.
 */
.sitooltip-floating-element {
  align-items: center;
}

/* Sitext tooltip.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 522.
 */
.sitext-tooltip {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: auto;
  max-width: 312px;
  border-radius: var(--skin-radius-small);
}

/* Sitext tooltip text.
 * Changes text/foreground colour; sets spacing around/inside the element.
 * Source rule 523.
 */
.sitext-tooltip-text {
  padding: 4px 8px;
  color: var(--skin-text-primary);
  -unity-text-generator: advanced;
}

/* Unity scroll view content container.
 * controls size/placement.
 * Source rule 524.
 */
.right-to-left-streamed-object-list .unity-scroll-view__content-container {
  justify-content: flex-end;
  align-items: flex-end;
}

/* Unity scroll view content container.
 * controls size/placement.
 * Source rule 525.
 */
.right-to-left-justify-content-streamed-object-list .unity-scroll-view__content-container {
  justify-content: flex-end;
}

/* Unity radio button group container.
 * controls size/placement.
 * Source rule 526.
 */
.matchpreferences-radiogroup > .unity-radio-button-group__container SIRadioButton {
  height: 32px;
}

/* Unity radio button group container.
 * sets spacing around/inside the element.
 * Source rule 527.
 */
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container SIRadioButton {
  margin-left: 1px;
  margin-right: 1px;
}

/* Unity radio button group child first.
 * sets the outline/corner shape.
 * Source rule 528.
 */
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container SIRadioButton.unity-radio-button-group__child-first {
  border-radius: var(--border-radius-leading-medium-small);
}

/* Unity radio button group child last.
 * sets the outline/corner shape.
 * Source rule 529.
 */
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container SIRadioButton.unity-radio-button-group__child-last {
  border-radius: var(--border-radius-trailing-medium-small);
}

/* Matchpreferences hightlightmodes radialgauge.
 * supplies local values read by the component styling.
 * Source rule 530.
 */
.matchpreferences-hightlightmodes-radialgauge {
  --current-colour: var(--skin-surface-raised);
}

/* Navigation
 * Native navigation selectors, with adjacent shared rules in source order.
