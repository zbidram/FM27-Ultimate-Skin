  align-items: center;
  flex-shrink: 0;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
  border-radius: 0 0 0 0;
}

/* Semantic progress fills can also carry these generic chart-fill classes.
 * Native AlwaysApplied places red/green after the generic colours, while the
 * split core/data imports reverse that tie. Keep the proven compound pairs
 * semantic, including rounded Create Schedule impact bars. Paint only: generic
 * categorical bars and the native progress geometry retain their own rules.
 */
.progress-bar-value-red.data_display-graphs-elements-bar-colour-lime,
.progress-bar-value-red-left-radius.data_display-graphs-elements-bar-colour-lime {
  background-color: var(--communication-feedback-negative);
}

.progress-bar-value-green.data_display-graphs-elements-bar-colour-cyan,
.progress-bar-value-green-right-radius.data_display-graphs-elements-bar-colour-cyan {
  background-color: var(--communication-feedback-positive);
