/* Attribute text player left.
 * Changes text/foreground colour.
 * Shared rule for 9 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1144.
 */
.squad-dynamics-pro-con-positive-text,
.club-vision-text-colour-positive,
.fitness-test-result-text-colour-pass,
.player-interest-green,
.colours-base-green-20,
.transfer-overview-open-text,
.relationship-with-you-text-colour-very-close,
.happiness-delighted-text-colour {
  color: var(--colours-base-green-soft);
}

/* Attribute text player right.
 * Changes text/foreground colour.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1145.
 */
.relationship-with-you-text-colour-no-relationship,
.loaned-out-color .cell-primary-text,
.body-language-sad-text-colour {
  color: var(--colours-base-blue-soft);
}

/* Attributes comparison bar fill left.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1146.
 */
.attributes-comparison-bar-fill-left {
  background-color: var(--skin-comparison-left);
  border-radius: var(--border-radius-leading-small);
  flex-wrap: var(--flex-wrap-reverse);
}

/* Attributes comparison bar fill right.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1147.
 */
.attributes-comparison-bar-fill-right {
  background-color: var(--skin-comparison-right);
  border-radius: var(--border-radius-trailing-small);
  flex-wrap: var(--flex-wrap-normal);
}

/* Attributes comparison bar left.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 1148.
 */
.attributes-comparison-bar-left {
  border-radius: var(--border-radius-leading-small);
  flex-wrap: var(--flex-wrap-reverse);
}

/* Attributes comparison bar right.
 * controls size/placement.
 * Source rule 1149.
 */
.attributes-comparison-bar-right {
  flex-wrap: var(--flex-wrap-normal);
}

/* Attributes comparison bar right.
 * sets the outline/corner shape.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1150.
 */
.attributes-comparison-bar-right,
.tab-button-segmented-selected.tabgroup__tab--trailing,
.team-report-segmented-bar-chart-segment-container-element.tabgroup__tab--trailing,
.tab-button-segmented-selected.buttongroup__button--trailing,
.team-report-segmented-bar-chart-segment-container-element.buttongroup__button--trailing,
.buttongroup__button--trailing .sigradient {
  border-radius: var(--border-radius-trailing-small);
}

/* Attributes key.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1151.
 */
.attributes-key {
  padding: 5px var(--spacing-tiles);
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-card) var(--skin-radius-card) 0 0;
  border-top-width: 1px;
  border-top-color: var(--skin-border-subtle);
  border-right-width: 1px;
  border-right-color: var(--skin-border-subtle);
  border-left-width: 1px;
  border-left-color: var(--skin-border-subtle);
  flex-direction: var(--row-direction-normal);
}

/* Attributes key ip.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1152.
 */
.attributes-key-ip {
  padding: 5px var(--global-padding-large);
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-small) var(--skin-radius-small) 0 0;
  border-top-width: 1px;
  border-top-color: var(--skin-border-subtle);
  border-right-width: 1px;
  border-right-color: var(--skin-border-subtle);
  border-left-width: 1px;
  border-left-color: var(--skin-border-subtle);
  flex-direction: var(--row-direction-normal);
}

/* Attributes key ip size min.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1153.
 */
.attributes-key-ip-size-min {
  padding-top: 2px;
  padding-right: 8px;
  padding-bottom: 2px;
  padding-left: 8px;
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-small) var(--skin-radius-small) 0 0;
  border-top-width: 1px;
  border-top-color: var(--skin-border-subtle);
  border-right-width: 1px;
  border-right-color: var(--skin-border-subtle);
  border-left-width: 1px;
  border-left-color: var(--skin-border-subtle);
  flex-direction: var(--row-direction-normal);
}

