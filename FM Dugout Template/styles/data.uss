/* Data display graph spider graph labelled tile x large.
 * controls size/placement.
 * Source rule 1169.
 */
.attributespiderchartplayerreport.data_display-graph-spider-graph-labelled--tile-x-large {
  width: 100%;
  height: auto;
  min-width: 504px;
  max-width: 800px;
  min-height: 408px;
  max-height: 648px;
}

/* Five fixed sectioned reference bands, with the game drawing the live player outline above them. Band
 * artwork is not player data.
 */
.attributespiderchartplayerreport.fmspiderchartlarge,
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge {
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  -unity-background-image-tint-color: var(--skin-on-media);
  --chart-outline-colour: var(--skin-border-default);
  --chart-axis-colour: var(--skin-transparent);
  --chart-inner-ring-colour: var(--skin-transparent);
  --chart-fill-colour: var(--skin-transparent);
  --chart-outline-line-width: 1;
  --chart-axis-line-width: 0;
  --chart-inner-ring-line-width: 0;
  --series-line-width: 2;
  --series-1-chartpoint-radius: 0;
  --series-2-chartpoint-radius: 0;
  background-image: var(--skin-radar-profile-artwork);
  --series-fill-alpha: 0;
  --series-1-stroke-colour: var(--skin-radar-profile-line);
  --series-1-fill-colour: var(--skin-transparent);
  --series-1-chartpoint-colour: var(--skin-radar-profile-line);
  --series-2-stroke-colour: var(--skin-text-secondary);
  --series-2-fill-colour: var(--skin-transparent);
  --chart-graded-colour-1: var(--skin-radar-profile-line);
  --chart-graded-colour-2: var(--skin-radar-profile-line);
  --chart-graded-colour-3: var(--skin-radar-profile-line);
  --chart-graded-colour-4: var(--skin-radar-profile-line);
  --chart-graded-colour-5: var(--skin-radar-profile-line);
}

/* Hide only the numeric profile radar labels; category names and live polygon stay visible.
 */
.attributespiderchartplayerreport.fmspiderchartlarge #Value,
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge #Value {
  display: none;
}

/* Center category labels on the native radar anchors, preserving the existing live bindings.
 */
.attributespiderchartplayerreport.fmspiderchartlarge #Label,
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge #Label {
  margin-left: 0;
  margin-right: 0;
  padding-left: 0;
  padding-right: 0;
  position: absolute;
  left: 0;
  top: 0;
  width: 200px;
  height: 24px;
  translate: -50% -50%;
  white-space: nowrap;
  -unity-text-align: middle-center;
  overflow: visible;
}

/* Align category names with the existing chart anchors, matching the prior working radar treatment.
 */
.attributespiderchartplayerreport.fmspiderchartlarge .margin-right-global-gap-extra-small,
.attributespiderchartplayerreport.fmspiderchartlarge .margin-left-global-gap-extra-small,
.attributespiderchartplayerreport.fmspiderchartlarge .margin-left-global-gap-small,
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge .margin-right-global-gap-extra-small,
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge .margin-left-global-gap-extra-small,
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge .margin-left-global-gap-small {
  margin-left: 0;
  margin-right: 0;
  padding-left: 0;
  padding-right: 0;
}

/* Anchor boxes do not push category names off the polygon; labels retain their own visible size.
 */
.attributespiderchartplayerreport.fmspiderchartlarge > *,
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge > * {
  width: 0;
  min-width: 0;
  max-width: 0;
  height: 0;
  min-height: 0;
  max-height: 0;
  overflow: visible;
}

/* Two live comparison polygons over muted bands: series 1 is the right player; series 2 is the
 * left player. Both consume the same identities as comparison bars and copy.
 */
.player-comparison-spider-graph .fmspiderchartlarge.flex-grow-class {
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  -unity-background-image-tint-color: var(--skin-on-media);
  --chart-outline-colour: var(--skin-border-default);
  --chart-axis-colour: var(--skin-transparent);
  --chart-inner-ring-colour: var(--skin-transparent);
  --chart-fill-colour: var(--skin-transparent);
  --chart-outline-line-width: 1;
  --chart-axis-line-width: 0;
  --chart-inner-ring-line-width: 0;
  --series-line-width: 2;
  --series-1-chartpoint-radius: 0;
  --series-2-chartpoint-radius: 0;
  background-image: var(--skin-radar-comparison-artwork);
  --series-fill-alpha: 0.10;
  --series-1-stroke-colour: var(--skin-radar-comparison-line);
  --series-1-fill-colour: var(--skin-radar-comparison-fill);
  --series-1-chartpoint-colour: var(--skin-radar-comparison-line);
  --series-2-stroke-colour: var(--skin-radar-subject-line);
  --series-2-fill-colour: var(--skin-radar-subject-fill);
  --series-2-chartpoint-colour: var(--skin-radar-subject-line);
  opacity: 1;
}

/* The value key uses the same colour as its player outline, keeping the comparison identifiable.
 */
.player-comparison-spider-graph .fmspiderchartlarge.flex-grow-class #subject_Value {
  color: var(--skin-radar-subject-line);
  background-color: var(--skin-transparent);
  padding-left: 0;
  padding-right: 0;
  border-radius: 0;
}

/* The value key uses the same colour as its player outline, keeping the comparison identifiable.
 */
.player-comparison-spider-graph .fmspiderchartlarge.flex-grow-class #comparison_Value {
  color: var(--skin-radar-comparison-line);
  background-color: var(--skin-transparent);
  padding-left: 0;
  padding-right: 0;
  border-radius: 0;
}

/* Tables Data
 * Table/list rows, cells, attributes and data display roles; names do not prove table-exclusive use.
 */

/* Cell border default extra small.
 * sets the outline/corner shape.
 * Source rule 1635.
 */
.cell-border-default-extra-small {
  border-width: 1px;
  border-color: var(--layout-ui-cell-focus-default-border);
  border-radius: var(--numbers-border-radius-extra-small);
}

/* Cell border width 1 radius 4.
 * sets the outline/corner shape.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1636.
 */
.cell-border-width-1-radius-4,
.multi-box-container,
.sub-phone-cell-empty-slot {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  border-radius: var(--skin-radius-small);
}

/* Cell button.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element; chooses
 * the pointer and hotspot.
 * Source rule 1637.
 */
.cell-button {
  margin: var(--global-gap-none);
  padding: var(--global-padding-none);
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Cell primary text — pointer hover.
 * sets the background fill.
 * Source rule 1638.
 */
.cell-button:hover .cell-primary-text {
  background-color: var(--underline-hover-background);
}

/* Cell large.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1639.
 */
.cell-large {
  height: var(--interaction-global-height-sm);
  flex-direction: var(--row-direction-normal);
  align-items: center;
  align-self: var(--flex-start-normal);
  margin-right: var(--global-gap-close);
  margin-left: var(--global-gap-close);
  overflow: hidden;
}

/* Cell medium.
 * controls size/placement; sets spacing around/inside the element; chooses the pointer and hotspot.
 * Source rule 1640.
 */
.cell-medium {
  height: 16px;
  flex-direction: var(--row-direction-normal);
  align-items: center;
  margin-right: var(--none);
  margin-left: var(--none);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
  overflow: hidden;
}

/* Cell primary text.
 * defines how state changes animate.
 * Source rule 1641.
 */
.cell-primary-text {
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Cell secondary text.
 * Changes text/foreground colour; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 1642.
 */
.cell-secondary-text {
  border-color: var(--skin-transparent);
  color: var(--skin-text-secondary);
  margin-left: var(--global-gap-close);
  border-bottom-width: var(--global-border-regular);
}

/* Cell text underline.
 * sets the background fill; controls size/placement.
 * Source rule 1643.
 */
.cell-text-underline {
  position: absolute;
  width: 100%;
  height: 1px;
  background-color: var(--skin-transparent);
  bottom: 1px;
  left: 0px;
}

/* Unity radio button container.
 * controls size/placement.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1644.
 */
.center-radio-button-template-content .unity-radio-button__container,
.team-form-container-draw,
.team-news-panel-comp-info,
.player-form-fixed-bars .unity-scroll-view__content-container {
  justify-content: center;
}

/* Change next week block schedule details.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1645.
 */
.change-next-week-block-schedule-details {
  width: 640px;
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-default);
  align-items: flex-start;
  border-radius: var(--skin-radius-card);
  flex-direction: var(--row-direction-normal);
}

/* Chart category indicator budget additional.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
