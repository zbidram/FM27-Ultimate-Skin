  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-shell);
}

/* Data display sicell substitute.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element; defines
