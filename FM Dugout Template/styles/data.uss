  height: 16px;
  padding: 1px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Sislider tracker.
 * Own the shared track paint so standalone/multiplayer sliders do not inherit
 * Unity's hardcoded grey. Keep the native track/handle dimensions and opacity.
 * Source rule 1979.
 */
.data_display-range_slider-track-default-increments-none .sislider--tracker {
  background-color: var(--skin-range-track-background);
  border-color: var(--skin-range-track-border);
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  flex: 1 0 0;
  border-radius: var(--skin-radius-small);
}

/* Data display selection button property default.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1980.
 */
.data_display-selection-button-property-default {
  width: 300px;
  height: 40px;
  padding: var(--global-padding-large);
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-20);
  align-items: center;
  border-radius: var(--global-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Navigation tab settings circle filled icon.
 * sets the background fill.
 * Source rule 1981.
 */
.data_display-selection-button-property-default-active .navigation-tab-settings-circle-filled-icon {
  background-color: var(--skin-surface-raised);
}

/* Data display selection button property default active.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1982.
 */
.data_display-selection-button-property-default-active,
.filter-tags-property:active:enabled,
.tab-button-segmented-selected {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}

/* Legacy data selections have their own label leaves. Pair their foreground
 * explicitly so generic primary-text helpers cannot paint white over Volt. */
.data_display-selection-button-property-default-active .sitext,
.filter-tags-property:active:enabled .sitext,
.tab-button-segmented-selected .sitext {
  color: var(--skin-selection-foreground);
}

.data_display-selection-button-property-default-active:hover:enabled,
.tab-button-segmented-selected:hover:enabled {
  background-color: var(--skin-selection-hover);
}

.data_display-selection-button-property-default-active:active:enabled,
.filter-tags-property:active:enabled,
.tab-button-segmented-selected:active:enabled {
  background-color: var(--skin-selection-pressed);
}

.data_display-selection-button-property-default-active:disabled,
.tab-button-segmented-selected:disabled {
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-action-disabled-foreground);
}

.data_display-selection-button-property-default-active:disabled .sitext,
.tab-button-segmented-selected:disabled .sitext {
  color: var(--skin-action-disabled-foreground);
}

/* Data display set pieces player indicator visualiser type type6.
