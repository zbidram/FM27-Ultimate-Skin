 */
.silinechart.fm-financial-history-chart {
  --line-width: 2;
  --line-colour: var(--skin-data-silinechart-fm-financial-history-chart-line-colour);
}

/* FM wage expenditure history chart.
 * supplies local values read by the component styling.
 * Source rule 345.
