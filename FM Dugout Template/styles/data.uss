/* Tables Data
 * Table/list rows, cells, attributes and data display roles; names do not prove table-exclusive use.
 */

/* About rules block row.
 * sets spacing around/inside the element.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4269.
 */
.virtualised-list__item--first .about-rules-block-row,
.virtualised-list__item--first .milestone-large-row,
.virtualised-list__item--first .targets-promise_show-on-meet_the_time-no-size-large,
.player_search_transfer_interest_radio .unity-base-field {
  margin-top: 0;
}

/* Vertical line upper.
 * Controls visibility while retaining the layout space.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4270.
 */
.virtualised-list__item--first .vertical-line-upper,
.virtualised-list__item--last .team-report-form-divider,
.virtualised-list__item--last .vertical-line-lower,
.visibility-hidden-tifo {
  visibility: hidden;
}

/* Bar chart item.
 * sets spacing around/inside the element.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4271.
 */
.virtualised-list__item--last .bar-chart-item,
.stats-star-ratings-potential-3-ability-3-youth-false.no-margin,
.input-field-noborder .unity-base-text-field {
  margin: 0px;
}

/* Team report assist summary record.
 * sets spacing around/inside the element.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4272.
 */
.virtualised-list__item--last .team-report-assist-summary-record,
.virtualised-list__item--last .team-report-assist-type-record,
.virtualised-list__item--last > * > * > #SpeakToResponseActionButton .speakto-body-header-suggestion-button--action-secondary,
.navigation-secondary-text-portal-default-active-true .sibutton,
.navigation-secondary-text-portal-default-active-false .sibutton,
.sibutton.no-margin {
  margin: 0;
}

/* Agent offer player item.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 4273.
 */
.virtualised-list__item--selected .agent-offer-player-item {
  border-color: var(--skin-card-border-colour);
  background-color: var(--skin-control-hover);
  border-radius: var(--border-radius-radius-4);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.virtualised-list__item--selected .buttons-toggle-picture-button-default-type-unselected--selected-false,
.virtualised-list__item--selected .manager-preset-button-bg,
.virtualised-list__item--selected .manager-preset-button-bg:hover {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}

/* Inputs colour picker swatch pallete swatch.
 * sets the outline/corner shape.
 * Source rule 4275.
 */
.virtualised-list__item--selected .inputs-colour_picker-swatch-pallete-swatch {
  border-width: 1px;
}

/* Manager creation menu text block.
 * sets spacing around/inside the element; chooses the pointer and hotspot.
 * Source rule 4276.
 */
.virtualised-list__item--selected .manager-creation-menu-text-block {
  padding-left: 12px;
  padding-right: 16px;
  padding-bottom: 8px;
  padding-top: 8px;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Manager preset button bg border.
 * sets the outline/corner shape.
 * Source rule 4277.
 */
.virtualised-list__item--selected .manager-preset-button-bg-border {
  border-width: var(--global-border-width-thick);
  border-color: var(--skin-border-subtle);
  border-radius: var(--interaction-global-radius-md);
}

/* A selectable row inside a grouped list shares the neutral selection role.
 * Keep parent month headings and linked club/competition names readable too. */
.virtualised-list__item--selected .selectable-list__item-child--selected {
  background-color: var(--skin-list-selection-background);
  color: var(--skin-list-selection-foreground);
}
.virtualised-list__item--selected .selectable-list__item-child--selected:hover {
  background-color: var(--skin-list-selection-hover);
}

/* Virtualised list view.
 * controls size/placement.
 * Source rule 4279.
 */
.virtualised-list__view-max-width .virtualised-list__view {
  width: 100%;
  max-width: 100%;
}

/* White dot.
 * Shows these elements; controls size/placement; sets spacing around/inside the element.
 * Source rule 4282.
 */
.white-dot {
  display: flex;
  width: 14px;
  height: 14px;
  align-items: center;
  flex-direction: var(--row-direction-normal);
  margin-right: 0;
  flex-wrap: nowrap;
  flex-grow: 0;
  align-self: auto;
  padding-top: 1px;
  padding-right: 1px;
  padding-bottom: 1px;
  padding-left: 1px;
}

/* Widget container block.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4283.
 */
.widget-container-block {
  padding: 12px;
  background-color: var(--skin-surface-panel);
  justify-content: center;
  border-radius: var(--skin-radius-control);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.virtualised-list__item--selected .buttons-toggle-picture-button-default-type-unselected--selected-false .sitext,
.virtualised-list__item--selected .buttons-toggle-picture-button-default-type-unselected--selected-false .sitextmedium,
.virtualised-list__item--selected .buttons-toggle-picture-button-default-type-unselected--selected-false .sitextsmall,
.virtualised-list__item--selected .manager-preset-button-bg .sitext,
.virtualised-list__item--selected .manager-preset-button-bg .sitextmedium,
.virtualised-list__item--selected .manager-preset-button-bg .sitextsmall,
.virtualised-list__item--selected .manager-preset-button-bg:hover .sitext,
.virtualised-list__item--selected .manager-preset-button-bg:hover .sitextmedium,
.virtualised-list__item--selected .manager-preset-button-bg:hover .sitextsmall {
  color: var(--skin-selection-foreground);
}
.virtualised-list__item--selected .selectable-list__item-child--selected .sitext,
.virtualised-list__item--selected .selectable-list__item-child--selected .sitextmedium,
.virtualised-list__item--selected .selectable-list__item-child--selected .sitextsmall {
  color: var(--skin-list-selection-foreground);
}

/* Tables Data
 * Table/list rows, cells, attributes and data display roles; names do not prove table-exclusive use.
 */

/* Bar.
 * sets the background fill.
 * Source rule 4697.
 */
.table-accent-orange #bar {
  background-color: var(--data-tables-accent-orange);
}

/* Bar.
 * sets the background fill.
 * Source rule 4698.
 */
.table-accent-blue #bar {
  background-color: var(--data-tables-accent-blue);
}

/* Bar.
 * sets the background fill.
 * Source rule 4699.
 */
.table-accent-red #bar {
  background-color: var(--data-tables-accent-red);
}

/* Bar.
 * sets the background fill.
 * Source rule 4700.
 */
.table-accent-green #bar {
  background-color: var(--data-tables-accent-green);
}

/* Row.
 * sets the background fill.
 * Source rule 4701.
 */
.table-row-purple #row {
  background-color: var(--colours-base-purple-base);
}

/* Sitext.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4702.
 */
.table-row-disabled .sitext,
.table-row-disabled .sibutton {
  color: var(--skin-text-disabled);
}

/* Unity image.
 * Changes text/foreground colour; tints background artwork.
 * Source rule 4703.
 */
.table-row-disabled .unity-image {
  color: var(--skin-ink);
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Team report goal analysis goal times scoring.
 * sets the background fill.
 * Source rule 4704.
 */
.team-report-goal-analysis-goal-times-scoring {
  background-color: var(--colours-base-green-soft);
}

/* Team report linear ranges 7 values 1.
 * tints background artwork.
 * Source rule 4705.
 */
.team-report-linear-ranges-7-values-1 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-1);
}

/* Team report linear ranges 7 values 2.
 * tints background artwork.
 * Source rule 4706.
 */
.team-report-linear-ranges-7-values-2 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-2);
}

/* Team report linear ranges 7 values 3.
 * tints background artwork.
 * Source rule 4707.
 */
.team-report-linear-ranges-7-values-3 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-3);
}

/* Team report linear ranges 7 values 4.
 * tints background artwork.
 * Source rule 4708.
 */
.team-report-linear-ranges-7-values-4 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-4);
}

/* Team report linear ranges 7 values 5.
 * tints background artwork.
 * Source rule 4709.
 */
.team-report-linear-ranges-7-values-5 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-5);
}

/* Team report linear ranges 7 values 6.
 * tints background artwork.
 * Source rule 4710.
 */
.team-report-linear-ranges-7-values-6 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-6);
}

/* Team report linear ranges 7 values 7.
 * tints background artwork.
 * Source rule 4711.
 */
.team-report-linear-ranges-7-values-7 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-7);
}

/* Text colours brand FM ultra violet.
 * Changes text/foreground colour.
 * Source rule 4712.
 */
.text-colours-brand-fm-ultra-violet {
  color: var(--skin-brand-primary);
}

/* Text light red.
 * Changes text/foreground colour.
 * Source rule 4713.
 */
.text-light-red {
  color: var(--linear-ranges-4-values-1);
}

/* Text neutral black.
 * Changes text/foreground colour.
 * Source rule 4714.
 */
.text-neutral-black {
  color: var(--colours-base-neutral-black);
}

/* First-contact zones are intensity bands, not value-height bars. Native bound
 * heights can exceed the compact pitch and hide the percentage labels. Cap the
 * bands at the pitch interior while preserving every semantic intensity. */
.firstcontact_map_container .zone-map-bar-intensity-1,
.firstcontact_map_container .zone-map-bar-intensity-2,
.firstcontact_map_container .zone-map-bar-intensity-3,
.firstcontact_map_container .zone-map-bar-intensity-4,
.firstcontact_map_container .zone-map-bar-intensity-5,
.firstcontact_map_container .zone-map-bar-intensity-6,
.firstcontact_map_container .zone-map-bar-intensity-7,
.firstcontact_map_container .zone-map-bar-intensity-8 {
  max-height: var(--skin-chart-first-contact-zone-height);
}

/* Report radar labels extend outside the native plot bounds. Leave horizontal
 * gutters in report tiles; profile/comparison and miniature charts are separate. */
.data-hub-padding .fmspiderchartlarge {
  width: var(--skin-chart-report-radar-width);
  max-width: var(--skin-chart-report-radar-width);
  align-self: center;
}

/* Use the comparison's muted reference bands for Data Hub radar families,
 * including the compact Data Hub widget hosted by Portal Overview.
 * The existing PNG is the verified runtime fallback for the editable SVG.
 * Clear native grey fill/grid paint without hiding live series or grade data. */
.data-hub-padding .fmspiderchartlarge,
.data-hub-padding .fmspiderchartmedium,
#PortalScreen #DataHub .fmspiderchartmedium {
  background-image: var(--skin-chart-radar-artwork);
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  -unity-background-image-tint-color: var(--skin-on-media);
  --chart-fill-colour: var(--skin-transparent);
  --chart-axis-colour: var(--skin-transparent);
  --chart-inner-ring-colour: var(--skin-transparent);
  --chart-outline-colour: var(--skin-chart-grid);
  --chart-outline-line-width: 1;
  --chart-axis-line-width: 0;
  --chart-inner-ring-line-width: 0;
  --chart-graded-colour-1: var(--skin-chart-grade-1);
  --chart-graded-colour-2: var(--skin-chart-grade-2);
  --chart-graded-colour-3: var(--skin-chart-grade-3);
  --chart-graded-colour-4: var(--skin-chart-grade-4);
  --chart-graded-colour-5: var(--skin-chart-grade-5);
  --series-1-stroke-colour: var(--skin-chart-series-1);
  --series-1-fill-colour: var(--skin-chart-series-1-fill);
  --series-1-chartpoint-colour: var(--skin-chart-series-1);
  --series-2-stroke-colour: var(--skin-chart-series-2);
  --series-2-fill-colour: var(--skin-chart-series-2-fill);
  --series-2-chartpoint-colour: var(--skin-chart-series-2);
}

/* The compact Portal plot reaches its element bounds. The shared artwork has
 * comparison label padding; enlarge its paint only, preserving plot geometry. */
#PortalScreen #DataHub .fmspiderchartmedium {
  background-size: var(--skin-chart-compact-radar-background-size);
}

/* Position-map colours are bound by the game. Tone the text overlay rather
 * than replacing scoring/conceding meaning or muting the entire tile. */
#GoalAnalysis #PositionSection #PositionsTemplate_Item > #TextFrame {
  background-color: var(--skin-chart-position-scrim);
}

/* Income/expenditure history labels extend to the left of the native plot.
 * Shrink only that plot within its existing card and reserve the axis gutter. */
.silinechart.fm-financial-history-chart {
  width: auto;
  align-self: stretch;
  margin-left: var(--skin-chart-finance-axis-gutter);
  margin-right: var(--skin-chart-finance-edge-gutter);
  margin-bottom: var(--skin-chart-finance-label-gap);
}


/* Stable comparison identities shared by labels, bars and radar lines. */
.attribute-text-player-left {
  color: var(--skin-comparison-left);
}

/* Stable comparison identities shared by labels, bars and radar lines. */
.attribute-text-player-right {
  color: var(--skin-comparison-right);
}

.attributes-key-key {
  -unity-background-image-tint-color: var(--skin-attribute-key);
}

.attributes-key-preferable-oop {
  -unity-background-image-tint-color: var(--skin-attribute-preferred);
}

/* Native radar labels have a narrow measured width. A minimum constraint and
 * shared compact type keep abbreviations readable around the existing anchors. */
.data-hub-padding .fmspiderchartlarge #Label {
  min-width: var(--skin-chart-radar-label-min-width);
  font-size: var(--skin-chart-label-size);
  white-space: nowrap;
}
.data-hub-padding .fmspiderchartlarge #Value {
  font-size: var(--skin-chart-label-size);
  white-space: nowrap;
}

/* The single-player match popup uses a white live outline over the same graded
 * reference bands, independently from the overview/comparison series palette. */
#MatchPlayerReport #AttributeSpiderChart .fmspiderchartlarge {
  --series-1-stroke-colour: var(--skin-radar-match-profile-line);
  --series-1-chartpoint-colour: var(--skin-radar-match-profile-line);
  --chart-graded-colour-1: var(--skin-radar-match-profile-line);
  --chart-graded-colour-2: var(--skin-radar-match-profile-line);
  --chart-graded-colour-3: var(--skin-radar-match-profile-line);
  --chart-graded-colour-4: var(--skin-radar-match-profile-line);
  --chart-graded-colour-5: var(--skin-radar-match-profile-line);
}


/* Embedded and expanded analysis reports reuse the native comparison-frame
 * owner, outside Data Hub's padding wrapper. Keep series identity consistent
 * with its reference-first source order, across lines, points and value labels. */
#data_display-graph-spider-graph-comparison-frame .fmspiderchartlarge {
  background-image: var(--skin-chart-radar-artwork);
  background-size: contain;
  background-position: center;
  background-repeat: no-repeat;
  -unity-background-image-tint-color: var(--skin-on-media);
  --chart-fill-colour: var(--skin-transparent);
  --chart-axis-colour: var(--skin-transparent);
  --chart-inner-ring-colour: var(--skin-transparent);
  --chart-outline-colour: var(--skin-chart-grid);
  --chart-outline-line-width: 1;
  --chart-axis-line-width: 0;
  --chart-inner-ring-line-width: 0;
  --series-1-stroke-colour: var(--skin-report-radar-reference-line);
  --series-1-fill-colour: var(--skin-report-radar-reference-fill);
  --series-1-chartpoint-colour: var(--skin-report-radar-reference-line);
  --series-2-stroke-colour: var(--skin-report-radar-subject-line);
  --series-2-fill-colour: var(--skin-report-radar-subject-fill);
  --series-2-chartpoint-colour: var(--skin-report-radar-subject-line);
}
#data_display-graph-spider-graph-comparison-frame #subject_Value {
  color: var(--skin-report-radar-subject-line);
}
#data_display-graph-spider-graph-comparison-frame #comparison_Value {
  color: var(--skin-report-radar-reference-line);
}
.frame-states-radar-polygon-graph-template-template3 #SpiderGraphField.graph_datavis_accent_background {
  background-color: var(--skin-report-chart-surface);
}

.frame-states-radar-polygon-graph-template-template3 #attributes-key .image-tint-cyan-50 {
  -unity-background-image-tint-color: var(--skin-report-radar-subject-line);
}
.frame-states-radar-polygon-graph-template-template3 #attributes-key .image-tint-orange-50 {
  -unity-background-image-tint-color: var(--skin-report-radar-reference-line);
}

/* Embedded finance summaries reserve an axis gutter and a separate label line
 * before the next heading/table. Native short heights failed the Windows
 * projection-label check; retain this checkpoint pending renderer diagnosis. */
.frames-finance-graph-property .silinechart.fm-finance-graph-overal,
.frames-finance-graph-property .silinechart.fm-finance-graph-projections,
.frames-finance-graph-property .silinechart.fm-finance-graph-income,
.frames-finance-graph-property .silinechart.fm-finance-graph-expenditures {
  width: auto;
  align-self: stretch;
  height: var(--skin-chart-finance-summary-height);
  min-height: var(--skin-chart-finance-summary-height);
  margin-left: var(--skin-chart-finance-axis-gutter);
  margin-right: var(--skin-chart-finance-edge-gutter);
  margin-bottom: var(--skin-chart-finance-label-gap);
  --axis-colour: var(--skin-chart-axis-foreground);
  --axis-label-colour: var(--skin-chart-axis-foreground);
}
.frames-finance-graph-property .silinechart.fm-finance-graph-overal,
.frames-finance-graph-property .silinechart.fm-finance-graph-projections {
  --line-colour: var(--skin-chart-finance-line);
  --fill-colour: var(--skin-chart-finance-fill);
}

/* The authored Expenditure season view alone has an inline 606px maximum.
 * Use its parent's available allocation so category labels fit the fixed rows.
 * The typed root excludes the inspected Income BindingExpect hierarchy. */
#ReportBody ComponentElement > #Body.frames-income-breakdown > #Tabs > TabGroup > #TabsContent > #ThisSeasonView {
  min-width: var(--skin-finance-breakdown-view-min-width);
}

/* Attribute link cells retain horizontal ellipsis but need a complete font
 * line box: native 16px cells clipped Poppins descenders. Rows keep their height. */
.attributes-row-number .cell-medium {
  height: var(--skin-attribute-label-line-height);
}
.attributes-row-number .cell-medium .cell-primary-text {
  min-height: var(--skin-attribute-label-line-height);
}

/* Individual Training's Footedness/Traits card shares the attribute row's
 * natural height. Compact only its vertical inset; keep feet/traits content,
 * horizontal padding, attribute list allocation and legend semantics intact. */
#ReportBody #AttributesAndCoachReport #Attributes #FootednessAndTraits #FootednessAndTraitsFrame.widget-container-block {
  padding-top: var(--skin-training-traits-vertical-inset);
  padding-bottom: var(--skin-training-traits-vertical-inset);
}

/* Compact Board Culture and Members tables retain narrow native columns.
 * Reclaim redundant header inset for the wider family, keeping native sorting,
 * ellipsis, column allocation, objective icon gutters and row height. */
#ReportBody #NonPhoneVisible > #BoardMembers > .figma-table .data-display-data_display-table-heading-default-default,
#ReportBody #tile-wide-4x2 #Culture .data-display-data_display-table-heading-default-default {
  padding-left: var(--skin-summary-table-header-inset);
  padding-right: var(--skin-summary-table-header-inset);
}
#ReportBody #NonPhoneVisible > #BoardMembers > .figma-table .text-header-container,
#ReportBody #tile-wide-4x2 #Culture .text-header-container {
  margin-right: var(--skin-summary-table-header-inset);
}

/* Award history's direct Best Players table uses the same compact header.
 * Reclaim its horizontal inset for metric labels, retaining native column
 * allocation, typography, sort-icon gap, body cells and the separate branches. */
#ReportBody #BestPlayers > #Frame > .row-direction-normal > #PreviousAwardsList > StreamedTable .data-display-data_display-table-heading-default-default {
  padding-left: var(--skin-summary-table-header-inset);
  padding-right: var(--skin-summary-table-header-inset);
}

/* Risk Assessment uses the same compact native header in fixed health lanes.
 * Reclaim its horizontal template padding without changing column allocation,
 * typography, sort icons, body cells or the separate message-table branch. */
#ReportBody .medical-risk-assessment-state5 #table .data-display-data_display-table-heading-default-default {
  padding-left: var(--skin-summary-table-header-inset);
  padding-right: var(--skin-summary-table-header-inset);
}

/* Captains' two left-player views use StandardHeaderCellGrow with the same
 * compact inset owner. Keep native title overrides, sorting and body columns. */
#ReportBody #Content.siblock-border > #LHSPanel #FilteredPlayersTable .data-display-data_display-table-heading-default-default {
  padding-left: var(--skin-captain-table-header-inset);
  padding-right: var(--skin-captain-table-header-inset);
}

/* Individual Detailed and Intensity share native compact table headings.
 * Reclaim their horizontal inset, keeping sorting, text/row heights, sibling
 * headers and native column allocation. Factory column IDs are not USS hooks. */
#ReportBody #ViewContent > #frame > .width-30-percent > #Frame > #Table .data-display-data_display-table-heading-default-default,
#ReportBody #individual-intensity .data-display-data_display-table-heading-default-default {
  padding-left: var(--skin-training-table-header-inset);
  padding-right: var(--skin-training-table-header-inset);
}

/* Job Market uses the standard compact header with a 4px horizontal inset.
 * Reclaim that inset inside the authored table only, preserving its native
 * column allocation, 24px height, sort icon and separate trailing text gap. */
#ReportBody .frame-states-property-1-job-market-property-2-hi-res-property-3-v2 > #streamed-table-container .data-display-data_display-table-heading-default-default {
  padding-left: var(--skin-job-market-header-inset);
  padding-right: var(--skin-job-market-header-inset);
}

/* CompCell's native 4px inset is separate from the team name, logo gap and
 * outer cell padding. These authored table/list-entry hosts share that leaf;
 * both competition and no-competition branches retain native heights/content. */
#ReportBody .frame-states-property-1-job-market-property-2-hi-res-property-3-v2 > #streamed-table-container #root.padding-horizontal-global-padding-regular > #content-container .default-cell-start,
#TeamRemapper > #root > #container > #left-side #root.padding-horizontal-global-padding-regular > #content-container .default-cell-start {
  padding-left: var(--skin-job-market-competition-inset);
  padding-right: var(--skin-job-market-competition-inset);
}

/* Squad Numbers' plain-text cells share their host spacing. Reclaim only this
 * horizontal inset for playing-time, position and age; retain native widths,
 * row height, single-line ellipsis and all number/portrait controls. */
#ReportBody #TableView.squad-numbers-disaplay-table-view .data_display-table-cell-default-default-type-1---text-basic-space-regular-accent-false-orientation-default-selected-false {
  padding-left: var(--skin-number-table-plain-cell-inset);
  padding-right: var(--skin-number-table-plain-cell-inset);
}

/* All domestic Staff views share the native portrait/name cell. Reclaim only
 * its portrait gap; keep preview controls, text gutters and column allocation. */
#ReportBody #StaffContractsTable BindingExpect.row-direction-normal > .thumbnails-alt-person-picture-property-1-24px {
  margin-right: var(--skin-staff-identity-portrait-gap);
}

/* The Staff Contracts factory's Club Job text has no authored trailing gutter.
 * Bound this leaf inside its native column before the first attribute value. */
#ReportBody #StaffContractsTable BindingExpect.align-items-start.align-self-start.flex-grow-class.justify-content-center > SIText.body-sm.global-text-primary.content-no-wrap.content-ellipsis {
  max-width: 100%;
  padding-right: var(--skin-staff-job-gutter);
}

/* Loans Compact, More Details and Contract share the native ExpiryDateCell.
 * Reclaim only its date/NA text's redundant trailing margin. Preserve the
 * clock's separate icon gap, column allocation, host inset and ellipsis. */
#ReportBody #LoanPlayerContent #PlayersTable #cell-expect #end-date-text.margin-right-global-gap-small,
#ReportBody #LoanPlayerContent #PlayersTable #cell-expect #na-text.margin-right-global-gap-small {
  margin-right: var(--skin-loans-expiry-text-trailing-gap);
}

/* The same expiry host owns horizontal padding. Its native neighbours retain
 * their own gutters: Progress/Wage before, Loan Happiness/Transfer Value after.
 * Reclaim this host inset without changing the clock's inter-element gap. */
#ReportBody #LoanPlayerContent #PlayersTable #cell-expect.padding-horizontal-global-padding-small {
  padding-left: var(--skin-loans-expiry-cell-inset);
  padding-right: var(--skin-loans-expiry-cell-inset);
}
