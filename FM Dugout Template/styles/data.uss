.silinechart.fm-wage-expenditure-history-chart {
  --line-width: 2;
  --line-colour: var(--skin-data-silinechart-fm-wage-expenditure-history-chart-line-colour);
  --line-colour-1: var(--skin-data-silinechart-fm-wage-expenditure-history-chart-line-colour-1);
  --line-colour-2: var(--skin-data-silinechart-fm-wage-expenditure-history-chart-line-colour-2);
}

/* FM recruitment chart.
 * controls size/placement.
 * Source rule 346.
 */
.silinechart.fm-recruitment-chart {
  flex-grow: 0;
  --line-width: 0;
  --axis-width: 4;
  --datapoint-radius: 4;
  --axis-colour: var(--skin-surface-canvas-alpha-30);
  --datapoint-stroke-colour: var(--skin-transparent);
  --datapoint-fill-colour: var(--skin-on-media-alpha-89);
}

/* FM league history chart.
 * supplies local values read by the component styling.
 * Source rule 347.
 */
.silinechart.fm-league-history-chart {
  --line-width: 2;
  --line-colour: var(--skin-on-media-alpha-35);
  --line-colour-1: var(--skin-on-media-alpha-35);
  --line-colour-2: var(--skin-data-silinechart-fm-league-history-chart-line-colour-2);
}

/* FM fifa ranking history chart.
 * supplies local values read by the component styling.
 * Source rule 348.
 */
.silinechart.fm-fifa-ranking-history-chart {
  --line-width: 2;
  --line-colour: var(--skin-data-silinechart-fm-fifa-ranking-history-chart-line-colour);
}

/* FM squad injury chart.
 * supplies local values read by the component styling.
 * Source rule 349.
 */
.silinechart.fm-squad-injury-chart {
  --line-width: 2;
  --fill-colour-1: var(--skin-data-silinechart-fm-squad-injury-chart-fill-colour-1);
  --line-colour-1: var(--skin-data-silinechart-fm-squad-injury-chart-line-colour-1);
