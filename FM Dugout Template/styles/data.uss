/* Attributes row number.
 * sets the outline/corner shape; controls size/placement; defines how state changes animate.
 * Source rule 1159.
 */
.attributes-row-number {
  align-items: center;
  flex-direction: var(--row-direction-normal);
  border-left-width: 2px;
  border-left-color: var(--skin-transparent);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-long);
  transition-timing-function: ease;
  align-self: stretch;
}

/* Attributes row number key.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1160.
