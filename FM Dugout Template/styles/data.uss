  height: 24px;
  padding: 1.5px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Data display radial stepper 5 small level 4.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1978.
 */
.data_display-radial-stepper-5-small-level-4 {
