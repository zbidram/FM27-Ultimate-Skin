  border-radius: var(--numbers-border-radius-extra-small);
  padding-left: var(--spacing-padding-new-ex);
  padding-right: var(--spacing-padding-new-ex);
  padding-top: var(--spacing-border-standard);
  padding-bottom: var(--spacing-border-standard);
  transition: background-color var(--global-transition-medium) ease-in-out;
}

/* Data display slot counter number 0 slot.
