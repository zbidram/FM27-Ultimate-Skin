  align-self: center;
  margin-top: var(--global-gap-close);
  border-top-left-radius: var(--global-radius-regular);
  border-top-right-radius: var(--global-radius-regular);
  border-top-width: 1px;
  border-right-width: 1px;
  border-left-width: 1px;
}

/* Data hub ios tabs left.
