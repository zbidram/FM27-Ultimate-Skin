/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Shared single-line fixture rows reserve 16px for the bound home/away letter.
 * Honour their authored zero horizontal inset instead of .sitextmedium's 5px
 * sides, which leave too little room for Poppins in compact report widgets.
 * Match the shared row itself: Training Overview's tile can sit outside the
 * report-body host used by other consumers of this exact component.
 */
#BindingRoot_FixtureRow > #Container > SIText#FixtureVenueShort {
  padding-left: 0;
  padding-right: 0;
}

/* Tables Data
 * Table/list rows, cells, attributes and data display roles; names do not prove table-exclusive use.
 */

/* Silinechart.
 * sets font/text presentation; controls size/placement.
 * Source rule 336.
 */
.silinechart {
  width: 100%;
  flex-grow: 1;
  flex-shrink: 1;
  flex-direction: var(--row-direction-normal);
  justify-content: center;
  --axis-colour: var(--skin-on-media-alpha-80);
  --axis-font-size: 12;
  --axis-width: 4;
  --line-width: 4;
  --line-colour: var(--skin-surface-raised);
  --fill-colour: var(--skin-data-silinechart-fill-colour);
  --datapoint-radius: 5;
  --datapoint-stroke-colour: var(--skin-on-media-alpha-40);
  --datapoint-fill-colour: var(--skin-data-silinechart-datapoint-fill-colour);
  -unity-font-definition: var(--skin-font-body);
}

/* FM progress table line chart.
 * supplies local values read by the component styling.
 * Source rule 337.
 */
.silinechart.fm-progress-table-line-chart {
  /* Native row sizing can stretch this miniature plot to the cell edges.
   * Cap only progress sparklines, preserving full chart layouts and data. */
  max-height: var(--skin-chart-compact-height);
  /* The end points straddle the plot edge; the height cap leaves row space. */
  overflow: visible;
  flex-grow: 0;
  margin-top: auto;
  margin-bottom: auto;
  --line-width: 1;
}

/* FM attribute history chart.
 * supplies local values read by the component styling.
 * Source rule 338.
 */
.silinechart.fm-attribute-history-chart {
  --line-width: 2;
  --line-colour: var(--skin-surface-raised);
  --fill-colour: var(--skin-data-silinechart-fm-attribute-history-chart-fill-colour);
  --line-colour-1: var(--colours-player-chart-attribute-line-0);
  --line-colour-2: var(--colours-player-chart-attribute-line-1);
  --line-colour-3: var(--colours-player-chart-attribute-line-2);
  --line-colour-4: var(--colours-player-chart-attribute-line-3);
  --line-colour-5: var(--colours-player-chart-attribute-line-4);
  --line-colour-6: var(--colours-player-chart-attribute-line-5);
  --line-colour-7: var(--colours-player-chart-attribute-line-6);
  --line-colour-8: var(--colours-player-chart-attribute-line-7);
