/* Tables Data
 * Table/list rows, cells, attributes and data display roles; names do not prove table-exclusive use.
 */

/* Data display graphs tile elements y axis label.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 561.
 */
.data_display-graphs-tile_elements-y_axis_label,
.data_display-graphs-tile_elements-x_axis_label {
  color: var(--skin-text-secondary);
}

/* Data display graphs data points medium circle grey.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 562.
 */
.data_display-graphs-data_points-medium-circle-grey {
  width: 8px;
  height: 8px;
  background-color: var(--skin-surface-raised);
  flex-shrink: 0;
  border-left-color: var(--skin-on-media-alpha-35);
  border-right-color: var(--skin-on-media-alpha-35);
  border-top-color: var(--skin-on-media-alpha-35);
  border-bottom-color: var(--skin-on-media-alpha-35);
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;
  border-bottom-left-radius: 4px;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
}

/* Data display graphs data points large square.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 563.
 */
.data_display-graphs-data_points-large-square {
  width: 16px;
  height: 16px;
  border-width: 1px;
  flex-shrink: 0;
}

/* Data display graphs data points medium circle.
 * sets the outline/corner shape; controls size/placement; defines how state changes animate; chooses the
 * pointer and hotspot.
 * Source rule 564.
 */
.data_display-graphs-data_points-medium-circle {
  width: 8px;
  height: 8px;
  border-width: 1px;
  flex-shrink: 0;
  border-radius: 4px;
  transition: background-color var(--global-transition-short) ease;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Data display graphs data points medium circle — pointer hover.
 * sets the background fill.
 * Source rule 565.
 */
.data_display-graphs-data_points-medium-circle:hover {
  background-color: var(--colours-base-neutral-white);
}

/* Contract negotiations tab value changed icon medium circle.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 566.
 */
.contract-negotiations-tab-value-changed-icon-medium-circle {
  width: 8px;
  height: 8px;
  border-width: 1px;
  background-color: var(--colours-linear-scale-strong-3);
  flex-shrink: 0;
  border-radius: 4px;
}

/* Data display graphs data points large circle.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 567.
 */
.data_display-graphs-data_points-large-circle {
  width: 16px;
  height: 16px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  flex-shrink: 0;
  border-radius: 8px;
}

/* Data display graphs data points medium circle purple.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 568.
 */
.data_display-graphs-data_points-medium-circle-purple {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-data-data-display-graphs-data-points-medium-circle-purple-background);
}

/* Data display graphs data points small circle purple.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 569.
 */
.data_display-graphs-data_points-small-circle-purple {
  width: 5px;
  height: 5px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-data-data-display-graphs-data-points-small-circle-purple-background);
  flex-shrink: 0;
  border-radius: 2.5px;
}

/* Data display graphs data points medium circle invisible.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 570.
 */
.data_display-graphs-data_points-medium-circle-invisible {
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
}

/* Data display graphs data points medium circle invisible — pointer hover.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 571.
 */
.data_display-graphs-data_points-medium-circle-invisible:hover {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-surface-raised);
}

/* Data display league history chart data points circle base blue.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 572.
 */
.data_display-league-history-chart-data_points-circle-base-blue {
  width: 8px;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--colours-base-blue-20);
  flex-shrink: 0;
  border-radius: 4px;
}

/* Data display league history chart data points circle base purple.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 573.
 */
.data_display-league-history-chart-data_points-circle-base-purple {
  width: 8px;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--colours-base-purple-50);
  flex-shrink: 0;
  border-radius: 4px;
}

/* Data display league history chart data points circle base neutral.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 574.
 */
.data_display-league-history-chart-data_points-circle-base-neutral {
  width: 8px;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--colours-base-grey-strong);
  flex-shrink: 0;
  border-radius: 4px;
}

/* Data display league history chart data points circle base green.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 575.
 */
.data_display-league-history-chart-data_points-circle-base-green {
  width: 8px;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--colours-base-green-base);
  flex-shrink: 0;
  border-radius: 4px;
}

/* Data display league history chart data points circle base red.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 576.
 */
.data_display-league-history-chart-data_points-circle-base-red {
  width: 8px;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--colours-base-red-base);
  flex-shrink: 0;
  border-radius: 4px;
}

/* Data display graphs data points large type circle cyan.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 577.
 */
.data_display-graphs-data_points-large-type-circle-cyan {
  width: 12px;
  height: 12px;
  background-color: var(--skin-data-data-display-graphs-data-points-large-type-circle-cyan-background);
  flex-shrink: 0;
  border-left-color: var(--skin-on-media-alpha-35);
  border-right-color: var(--skin-on-media-alpha-35);
  border-top-color: var(--skin-on-media-alpha-35);
  border-bottom-color: var(--skin-on-media-alpha-35);
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
  border-bottom-left-radius: 8px;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
}

