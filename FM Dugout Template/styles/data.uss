/* FM ability history chart.
 * supplies local values read by the component styling.
 * Source rule 339.
 */
.silinechart.fm-ability-history-chart {
  --line-width: 2;
  --line-colour: var(--skin-on-media-alpha-80);
  --fill-colour: var(--skin-data-silinechart-fm-ability-history-chart-fill-colour);
}

/* FM ability recent history chart.
 * supplies local values read by the component styling.
 * Source rule 340.
 */
.silinechart.fm-ability-recent-history-chart {
  --line-width: 2;
  --line-colour: var(--skin-data-silinechart-fm-ability-recent-history-chart-line-colour);
  --fill-colour: var(--skin-data-silinechart-fm-ability-recent-history-chart-fill-colour);
}

/* FM budget chart.
 * supplies local values read by the component styling.
 * Source rule 341.
 */
.silinechart.fm-budget-chart {
  --line-width: 2;
  --line-colour: var(--skin-chart-finance-line);
  --fill-colour: var(--skin-chart-finance-fill);
  --axis-colour: var(--skin-chart-axis-foreground);
  --datapoint-fill-colour: var(--skin-chart-finance-line);
  --datapoint-stroke-colour: var(--skin-chart-finance-line);
}

/* FMLineChart creates its final marker as a separate visual element. Keep
 * invisible historical markers untouched and pair the visible endpoint with
 * the finance series, including its pointer state. */
.silinechart.fm-budget-chart .data_display-graphs-data_points-medium-circle-purple,
.silinechart.fm-budget-chart .data_display-graphs-data_points-medium-circle-purple:hover {
  background-color: var(--skin-chart-finance-line);
  border-color: var(--skin-chart-finance-line);
}

/* FM budget graph.
 * sets the background fill.
 * Source rule 342.
 */
.silinechart.fm-budget-graph {
  background-color: var(--skin-chart-finance-background);
  --line-width: 2;
  --line-colour: var(--skin-chart-finance-line);
  --fill-colour: var(--skin-chart-finance-fill);
  --axis-colour: var(--skin-chart-axis-foreground);
}

/* FM budget wage graph.
 * supplies local values read by the component styling.
 * Source rule 343.
 */
.silinechart.fm-budget-wage-graph {
  --line-width: 2;
  --line-colour: var(--skin-chart-finance-line);
  --fill-colour: var(--skin-chart-finance-fill);
  --axis-colour: var(--skin-chart-axis-foreground);
}

/* FM financial history chart.
 * supplies local values read by the component styling.
