/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Game Screens
 * Native game screens selectors, with adjacent shared rules in source order.
 */

/* FM match UI header.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 473.
 */
.fm-match-ui-header,
.fm-match-ui-menu-background {
  background-color: var(--colours-base-neutral-black);
}

/* FM match UI efl sky bet red.
 * sets the background fill.
 * Source rule 474.
 */
.fm-match-ui-efl-sky-bet-red {
  background-color: var(--colours-efl-sky-bet-red);
}

/* FM match UI efl red light.
 * sets the background fill.
 * Source rule 475.
 */
.fm-match-ui-efl-red-light {
  background-color: var(--colours-efl-red-light);
}

/* FM match UI efl sky bet gold.
 * sets the background fill.
 * Source rule 476.
 */
.fm-match-ui-efl-sky-bet-gold {
  background-color: var(--colours-efl-sky-bet-gold);
}

/* FM match UI efl sky bet gray.
 * sets the background fill.
 * Source rule 477.
 */
.fm-match-ui-efl-sky-bet-gray {
  background-color: var(--colours-efl-sky-bet-gray);
}

/* FM match UI efl sky bet red light.
 * sets the background fill.
 * Source rule 478.
 */
.fm-match-ui-efl-sky-bet-red-light {
  background-color: var(--colours-efl-sky-bet-red-light);
}

/* FM match UI efl carabao green.
 * sets the background fill.
 * Source rule 479.
 */
.fm-match-ui-efl-carabao-green {
  background-color: var(--colours-efl-carabao-green);
}

/* FM match UI efl carabao green light.
 * sets the background fill.
 * Source rule 480.
 */
.fm-match-ui-efl-carabao-green-light {
  background-color: var(--colours-efl-carabao-green-light);
}

/* FM match UI efl bristol blue.
 * sets the background fill.
 * Source rule 481.
 */
.fm-match-ui-efl-bristol-blue {
  background-color: var(--colours-efl-bristol-blue);
}

/* FM match UI efl bristol blue light.
 * sets the background fill.
 * Source rule 482.
 */
.fm-match-ui-efl-bristol-blue-light {
  background-color: var(--colours-efl-bristol-blue-light);
}

/* Ribbon top anim out.
 * defines how state changes animate.
 * Source rule 483.
 */
.ribbon-top-anim-out {
  transition-property: translate;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  translate: 0 -100px;
}

/* Ribbon bottom anim out.
 * defines how state changes animate.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 484.
 */
.ribbon-bottom-anim-out,
.shortcuts-panel-anim-out,
.panel--hide .shortcuts-panel {
  transition-property: translate;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  translate: 0 100px;
}

/* Ribbon.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 485.
 */
.ribbon {
  margin: 0px;
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  justify-content: flex-start;
  padding-right: 0;
}

/* Ribbon justify content left.
 * controls size/placement.
 * Source rule 486.
 */
.ribbon-justify-content-left {
  justify-content: flex-start;
}

/* Ribbon button icon.
 * controls size/placement.
 * Source rule 487.
 */
.ribbon__button-icon {
  width: 32px;
  height: 32px;
}

/* Ribbon button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 488.
 */
.ribbon__button {
  height: 40px;
  padding: 0 var(--spacing-padding-extra-small---4);
  border-width: 1px;
  border-color: var(--skin-component-ribbon-button-border-color);
  background-color: var(--skin-surface-page);
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-shell);
  flex-direction: var(--row-direction-normal);
}

/* Sibutton.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 489.
 */
.ribbon__button .sibutton {
  height: 32px;
  padding: 0;
  background-color: var(--skin-surface-page);
  justify-content: center;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* Ribbon template continue button.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 490.
 */
.ribbon-template-continue-button {
  margin-right: 8px;
  align-self: center;
}

/* Ribbon home continue button.
 * sets spacing around/inside the element.
 * Source rule 491.
 */
.ribbon-home-continue-button {
  margin-left: 32px;
  margin-right: 32px;
}

/* Calendar
 * Native calendar selectors, with adjacent shared rules in source order.
 */

/* Calendar processing.
 * supplies local values read by the component styling.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1499.
 */
.calendar---processing,
.messages---processing {
  --easing: "ease-out-cubic";
  --animation-duration: 1.5;
}

/* Unity group box.
 * sets spacing around/inside the element.
 * Source rule 1500.
 */
.calendar-button-group .unity-group-box {
  margin: 0 0 0 16px;
  padding: 0;
}

/* Calendar comp event background bundesliga bottomlayer.
 * sets the background fill.
 * Source rule 1501.
 */
.calendar-comp-event-background-bundesliga-bottomlayer {
  background-color: var(--skin-data-calendar-comp-event-background-bundesliga-bottomlayer-background);
}

/* Calendar comp event background bundesliga toplayer.
 * sets the gradient colours drawn by this component.
 * Source rule 1502.
 */
.calendar-comp-event-background-bundesliga-toplayer {
  --start-colour: var(--skin-data-calendar-comp-event-background-bundesliga-toplayer-start-colour);
  --end-colour: var(--skin-data-calendar-comp-event-background-bundesliga-toplayer-end-colour);
}

