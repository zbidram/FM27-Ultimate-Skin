}

/* Calendar day body.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1554.
 */
.calendar-min-res .calendar-day-general .calendar-day-body {
  width: 100%;
  padding: 2px 8px 4px 8px;
  flex-grow: 1;
  min-height: 108px;
}

/* Calendar day header.
 * controls size/placement; sets spacing around/inside the element.
