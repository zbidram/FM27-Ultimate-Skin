 */
.calendar-tile4x4 .calendar-day-header {
  width: 54px;
  padding: 0 0 0 8px;
  align-self: stretch;
  justify-content: center;
}

/* Calendar days.
 * sets the outline/corner shape.
 * Source rule 1579.
 */
.calendar-tile4x4 .calendar-days {
  border-width: 0 0 1px 0;
