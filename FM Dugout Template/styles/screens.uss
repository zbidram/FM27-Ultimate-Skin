/* Holiday's Jobs template explicitly removes all checkbox margins, leaving
 * its separate label touching the square. Restore only the missing label gap;
 * other checkbox layouts retain their own existing spacing. */
#GoOnHolidayWidget #JobsScope .sicheckbox {
  margin-right: var(--skin-field-label-gap);
}

/* Search/shortlist position filters reuse full-size planner points inside a
 * compact pitch. Keep the source compact geometry and dense label role here;
 * full Squad Planner cards retain their larger ability/star layout. */
#player-position-view-container #input-squad-planner-data-point-regular {
  width: var(--skin-search-pitch-point-width);
  height: var(--skin-search-pitch-point-height);
  background-color: var(--skin-planner-point-background);
  border-color: var(--skin-border-default);
}
#player-position-view-container #input-squad-planner-data-point-regular .sitext {
  font-size: var(--skin-search-pitch-label-size);
}
/* The mode's native active-true class means a usable point; the parent
 * position--filled--selected class carries the actual search selection. */
#player-position-view-container .position--filled--selected #input-squad-planner-data-point-regular {
  background-color: var(--skin-planner-point-selected);
  border-color: var(--skin-planner-point-selected-border);
}
#player-position-view-container #input-squad-planner-data-point-regular:hover {
  background-color: var(--skin-control-hover);
}

/* The start screen uses the same heading scale as reports. Its two-column
 * Load Game tile cannot fit the native 22px Poppins title; other menu tiles
 * follow the same role rather than shrinking individual English labels. */
#MainMenu .tile-title-color {
  font-size: var(--skin-menu-tile-heading-size);
  -unity-font-definition: var(--skin-font-section-heading);
  -unity-font-style: var(--skin-font-section-heading-weight);
}

#MainMenu .tile-title-frame {
  height: var(--skin-menu-tile-heading-height);
  min-height: var(--skin-menu-tile-heading-height);
  max-height: var(--skin-menu-tile-heading-height);
  padding-left: var(--skin-menu-title-inset);
  padding-right: var(--skin-menu-title-inset);
}

#MainMenu #description,
#MainMenu #SubDescription {
  font-size: var(--skin-menu-body-size);
  white-space: normal;
}

#MainMenu #club_name_data {
  font-size: var(--skin-menu-entity-size);
}

/* Promotional artwork is decorative; reserve it a lower corner rather than
 * letting the native full-height image paint over the heading or copy. */
#MainMenu #MainMenuStartNewCareerNationalTeam #ManagerImage,
#MainMenu #MainMenuStartNewCareerShuffleDraft .shuffle-draft-logo {
  width: var(--skin-menu-promo-art-width);
  max-width: var(--skin-menu-promo-art-width);
  height: var(--skin-menu-promo-art-height);
  max-height: var(--skin-menu-promo-art-height);
  margin-top: var(--skin-menu-tile-heading-height);
  top: auto;
  bottom: 0;
  right: var(--skin-menu-title-inset);
}

#MainMenu #MainMenuStartNewCareerShuffleDraft #SubDescription,
#MainMenu #MainMenuStartNewCareerNationalTeam #description {
  width: var(--skin-menu-promo-copy-width);
  max-width: 100%;
  height: auto;
  min-height: 0;
  flex-grow: 1;
  text-overflow: clip;
}

/* Saves8x2's native inline 33px cap outranks USS geometry. This dedicated
 * helper role fits two Poppins lines; values and other help keep their size. */
.preferences-card-tab-padding #tile-wide-8x2 #main-container .body-sm.overflow-text {
  font-size: var(--skin-preferences-compact-help-size);
}

/* Release notes: constrain the native row to its viewport. Fixed text and
 * non-shrinking artwork widths previously exceeded the dialog's inner width. */
/* Give percentage limits a full-screen containing block; the native switch
 * otherwise shrink-wraps the dialog, making 90% recursively shrink its frame. */
#WhatsNewDialog #DemoSwitch,
#WhatsNewDialog #DemoSwitch > .flex-grow-class,
#WhatsNewDialog #DemoSwitch > .flex-grow-class > .switch-element {
  width: 100%;
  height: 100%;
  align-self: stretch;
  align-items: center;
  justify-content: center;
}

.whatsnew-panel {
  width: var(--skin-release-notes-width);
  max-width: var(--skin-release-notes-max-width);
  max-height: var(--skin-release-notes-max-height);
  border-width: var(--skin-dialog-border-width);
  border-color: var(--skin-dialog-border);
  border-radius: var(--skin-dialog-radius);
  background-color: var(--skin-dialog-surface);
}

.whatsnew-panel > *,
.whatsnew-panel #BGImage {
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.whatsnew-panel #BGImage {
  background-color: var(--skin-dialog-surface);
  background-image: var(--skin-dialog-artwork);
  --unity-image-tint-color: var(--skin-transparent);
  -unity-background-image-tint-color: var(--skin-transparent);
}

/* This separate decorative pattern has no content children. */
.whatsnew-panel #TintPatternsImage {
  opacity: 0;
}

.whatsnew-panel #Body {
  padding: var(--skin-release-notes-padding);
  min-height: 0;
  flex-shrink: 1;
}

.whatsnew-panel #ContentScroll {
  min-height: 0;
  flex-shrink: 1;
}

.whatsnew-panel #Header #Title {
  font-size: var(--skin-release-notes-title-size);
  color: var(--skin-dialog-heading-foreground);
}

.whatsnew-panel .whatsnew-row-item {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  padding: var(--skin-release-notes-padding);
  border-radius: var(--skin-radius-card);
  background-color: var(--skin-surface-panel);
}

.whatsnew-panel .whatsnew-row-item #LHS {
  width: auto;
  min-width: 0;
  flex-grow: 1;
  flex-shrink: 1;
  margin-right: var(--skin-release-notes-gap);
}

.whatsnew-panel .whatsnew-row-item #Image {
  width: var(--skin-release-notes-image-width);
  min-width: 0;
  max-width: var(--skin-release-notes-image-width);
  flex-grow: 0;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
}

.whatsnew-panel .whatsnew-panel-title-colour {
  font-size: var(--skin-release-notes-heading-size);
  color: var(--skin-text-link);
}

.whatsnew-panel .whatsnew-row-item #Description {
  font-size: var(--skin-release-notes-body-size);
  color: var(--skin-text-primary);
  white-space: normal;
  height: auto;
  flex-shrink: 0;
}
