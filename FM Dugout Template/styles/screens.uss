 * Source rule 2465.
 */
.ige-attributes-input-field .unity-text-element--inner-input-field-component {
  width: 30px;
  -unity-text-align: middle-center;
  flex-grow: 0;
  flex-shrink: 1;
}

/* Ige attributes table.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2466.
 */
.ige-attributes-table,
.ige-ability-input-field {
  background-color: var(--skin-surface-raised);
}

/* Ige colour field button.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2467.
 */
.ige-colour-field-button {
  width: 116px;
  height: 24px;
  padding: 0;
  background-color: var(--skin-transparent);
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2468.
 */
.ige-dropdown.inputs-combobox-default-default-validation-default .si-dropdown__selection-field {
  height: auto;
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  min-width: auto;
  min-height: 32px;
  margin-bottom: 0;
  flex-grow: 0;
  max-height: 32px;
  padding-top: 0;
  padding-right: var(--global-padding-regular);
  padding-bottom: 0;
  padding-left: var(--global-padding-regular);
  align-items: center;
  border-radius: var(--buttons-global-radius-small);
  flex-direction: var(--row-direction-normal);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Sitext.
 * sets font/text presentation.
 * Source rule 2469.
 */
.ige-dropdown.inputs-combobox-default-default-validation-default .sitext {
  overflow: hidden;
  text-overflow: clip;
  white-space: normal;
}

/* Unity base text field input.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2470.
 */
.ige-input-field .unity-base-text-field__input {
  width: 120px;
  height: 32px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-on-media-alpha-04);
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
  border-radius: var(--buttons-global-radius-small);
}

/* Inputs text field default medium type filled.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2471.
 */
.ige-input-field-string.inputs-text-field-default-medium--type-filled,
.ige-input-field-string .bindableeditbox {
  width: 215px;
  min-width: 215px;
}

/* Ige input int field.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2472.
 */
.ige-input-int-field {
  width: auto;
  padding-top: 0;
  padding-bottom: 0;
  flex-direction: column-reverse;
  flex-grow: 0;
  align-self: flex-start;
}

/* Ige quick action panel.
 * controls size/placement.
 * Source rule 2473.
 */
