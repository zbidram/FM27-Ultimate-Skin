/* Calendar day body.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1573.
 */
.calendar-tile-small .calendar-day-body {
  width: 41px;
  height: 85px;
  padding: 3px 0 3px 0;
  align-items: center;
}

/* Calendar day header.
 * controls size/placement.
 * Source rule 1574.
 */
.calendar-tile-small .calendar-day-header {
  height: 21px;
  align-self: stretch;
