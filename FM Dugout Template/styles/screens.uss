  max-width: 190px;
  padding-top: var(--global-padding-regular);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-regular);
  padding-left: var(--global-padding-large);
  flex-direction: column;
  justify-content: space-between;
  align-items: stretch;
  border-right-width: 1px;
  border-right-color: var(--skin-surface-panel);
  border-bottom-width: 1px;
  border-bottom-color: var(--skin-surface-panel);
}

/* Calendar training weekly standard default type default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
