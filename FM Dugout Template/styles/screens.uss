  flex-direction: var(--row-direction-normal);
}

/* Calendar training fixture element.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 1591.
 */
.calendar-training-fixture-element {
  height: 32px;
  border-radius: var(--global-radius-small);
  overflow: hidden;
  flex-direction: var(--row-direction-normal);
}

/* Fixture background border.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1592.
 */
.calendar-training-fixture-element .calendar-event .fixture-background-border,
.calendar-training-fixture-edit-session-element .calendar-event .fixture-background-border {
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-top-right-radius: var(--global-radius-small);
  border-bottom-right-radius: var(--global-radius-small);
}

/* Calendar training session button element.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1593.
 */
.calendar-training-fixture-element > .calendar-training-session-button-element,
.calendar-training-fixture-edit-session-element > .calendar-training-session-button-element {
  padding-left: var(--global-padding-regular);
}

/* Calendar training session button element.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 1594.
 */
.calendar-training-session-button-element {
  padding: var(--global-padding-none) var(--global-padding-small);
  background-color: var(--none);
  flex-shrink: 1;
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  margin-left: var(--global-gap-none);
  margin-right: var(--global-gap-none);
  margin-top: var(--global-gap-none);
  margin-bottom: var(--global-gap-none);
  align-items: center;
}

/* Sitext.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1595.
 */
.calendar-training-session-button-element > .sitext,
.shuffle-draft-set-transition-anim-set-text {
