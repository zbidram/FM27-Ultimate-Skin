 */
.calendar-training-fixture-accent {
  position: absolute;
  width: var(--global-padding-small);
  background-color: var(--skin-border-subtle);
  top: 0;
  bottom: 0;
  left: 0;
}

/* Calendar training fixture edit session element.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 1590.
 */
.calendar-training-fixture-edit-session-element {
  height: 24px;
  border-radius: var(--global-radius-small);
