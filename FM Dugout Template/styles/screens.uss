  flex-grow: 0;
  align-self: stretch;
  min-height: 28px;
}

/* Calendar day body.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1556.
 */
.calendar-min-res .calendar-day-training .calendar-day-body {
  width: 124px;
  padding: 4px 0 4px 8px;
  flex-grow: 1;
  min-height: 100px;
}

/* Calendar day header.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1557.
 */
.calendar-min-res .calendar-day-training .calendar-day-header {
  padding: 4px 0 4px 8px;
  flex-grow: 0;
  align-self: stretch;
  min-height: 28px;
}

/* Calendar training focus card.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1558.
 */
.calendar-min-res .calendar-training-focus-card {
  width: 116px;
  margin: 12px 12px 12px 12px;
  padding: var(--global-padding-regular);
}

/* Calendar week general header.
 * controls size/placement.
 * Source rule 1559.
 */
.calendar-min-res .calendar-week-general-header {
  width: auto;
  flex-shrink: 0;
  min-width: 108px;
}

/* Calendar week training header.
 * controls size/placement.
 * Source rule 1560.
 */
.calendar-min-res .calendar-week-training-header {
  width: 117px;
  flex-shrink: 0;
}

/* Calendar mobile processing.
 * supplies local values read by the component styling.
 * Source rule 1561.
 */
.calendar-mobile---processing {
  --easing: "ease-out-cubic";
  --animation-duration: 3;
}

/* Calendar nation width.
 * controls size/placement.
 * Source rule 1562.
 */
.calendar-nation-width {
  max-width: 60px;
}

/* Calendar standard res.
 * controls size/placement.
 * Source rule 1563.
 */
.calendar-standard-res {
  width: auto;
  height: 552px;
}

/* Calendar day body.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1564.
 */
.calendar-standard-res .calendar-day-general .calendar-day-body {
  width: 100%;
  padding: 4px 8px 4px 8px;
  flex-grow: 1;
  min-height: 96px;
}

/* Calendar day body.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1565.
 */
.calendar-standard-res .calendar-day-training .calendar-day-body {
  width: 163px;
  padding: 4px 4px 4px 8px;
