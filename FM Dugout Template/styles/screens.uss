 */
.calender-event4x4,
.horizontal-list-margin-4 .virtualised-list__item {
  margin-right: var(--global-gap-close);
}

/* Game Screens
 * Native game screens selectors, with adjacent shared rules in source order.
 */

/* FM card grid paddings.
 * sets spacing around/inside the element.
 * Source rule 2175.
 */
.fm-card-grid-paddings {
  padding-top: var(--global-padding-none);
  padding-bottom: var(--global-padding-large);
  padding-left: var(--global-padding-large);
  padding-right: var(--global-padding-large);
}

/* SI card title bar header.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2176.
 */
.fm-card-header-large .si-card-title-bar-header {
  height: 40px;
  background-color: var(--skin-transparent);
  border-radius: var(--global-radius-small);
  margin-top: var(--global-gap-close);
  margin-bottom: var(--global-gap-close);
  flex-direction: var(--row-direction-normal);
  padding-top: var(--global-padding-regular);
  padding-right: var(--global-padding-extra-large);
  padding-left: var(--global-padding-extra-large);
}

/* SI card title bar header.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2177.
 */
.fm-card-header-small-standard .si-card-title-bar-header {
  height: 24px;
  background-color: var(--skin-transparent);
  border-radius: var(--global-radius-small);
  margin-top: var(--global-gap-close);
  margin-bottom: var(--global-gap-close);
  flex-direction: var(--row-direction-normal);
  padding-right: var(--global-padding-regular);
  padding-left: var(--global-padding-extra-large);
}

/* FM loading symbol pulse.
 * changes opacity for the whole element and its contents.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2178.
 */
.fm-loading-symbol-pulse,
.tactical-tweak-row--disabled .tactical-tweak-row__icon-badge {
  opacity: 0.4;
}

/* FM loading symbol pulse base.
 * defines how state changes animate.
 * Source rule 2179.
 */
.fm-loading-symbol-pulse-base {
  transition: opacity 0.8s ease-in-out;
}

/* Left Icon Indicator.
 * controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2180.
 */
.fm-menu-dropdown #LeftIconIndicator,
.fm-menu-dropdown #RightIconIndicator {
  width: 0px;
  height: 0px;
  margin: 0px;
  padding: 0px;
}

/* FM menu dropdown row.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2181.
 */
.fm-menu-dropdown-row {
  width: 195px;
  height: 32px;
  min-width: 195px;
  max-width: 195px;
  min-height: 32px;
  max-height: 32px;
  padding-left: 32px;
  padding-right: 8px;
}

/* Unity scroll view.
 * controls size/placement.
 * Source rule 2182.
 */
.fm-searchable-combobox-popup .unity-scroll-view {
  width: 100%;
  align-self: stretch;
}

/* Unity scroll view content viewport.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2183.
 */
.fm-searchable-combobox-popup .unity-scroll-view__content-viewport,
.fm-searchable-combobox-popup .unity-scroll-view__content-container {
  width: 100%;
  flex-grow: 1;
}

/* Unity scroll view vertical scroller.
 * controls size/placement.
 * Source rule 2184.
 */
.fm-searchable-combobox-popup .unity-scroll-view__vertical-scroller {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
}

/* FM searchable combobox popup.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2185.
 */
.fm-searchable-combobox-popup,
.fm-searchable-combobox-popup .unity-scroll-view {
  max-height: 200px;
}

/* FM searchable combobox chevron button.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2186.
 */
.fm-searchable-combobox__chevron-button {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-control-background);
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  align-items: center;
  justify-content: center;
  min-width: 44px;
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  border-top-right-radius: var(--interaction-input-field-border-radius-regular);
  border-bottom-right-radius: var(--interaction-input-field-border-radius-regular);
}

/* FM searchable combobox container.
 * controls size/placement.
 * Source rule 2187.
 */
.fm-searchable-combobox__container {
  flex-direction: var(--row-direction-normal);
  align-items: stretch;
  flex-grow: 1;
}

/* FM searchable combobox input — pointer hover.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2188.
 */
.fm-searchable-combobox__container:hover .fm-searchable-combobox__input,
.fm-searchable-combobox__container--focused .fm-searchable-combobox__input {
  color: var(--interaction-global-color-max-contrast);
}

/* FM searchable combobox input — pointer hover.
 * sets the outline/corner shape.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2189.
 */
.fm-searchable-combobox__container:hover .fm-searchable-combobox__input,
.fm-searchable-combobox__container:hover .fm-searchable-combobox__chevron-button,
.fm-searchable-combobox__container--focused .fm-searchable-combobox__input,
.fm-searchable-combobox__container--focused .fm-searchable-combobox__chevron-button {
  border-color: var(--interaction-global-color-max-contrast);
}

/* FM searchable combobox input.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2190.
 */
.fm-searchable-combobox__input {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-control-background);
  flex-grow: 1;
  flex-shrink: 1;
  min-height: var(--interaction-global-height-md);
  justify-content: center;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-right-width: 0;
  border-top-left-radius: var(--interaction-input-field-border-radius-regular);
  border-bottom-left-radius: var(--interaction-input-field-border-radius-regular);
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  padding-left: var(--global-padding-large);
  padding-right: var(--global-padding-small);
}

/* Unity text input.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2191.
 */
.fm-searchable-combobox__input #unity-text-input {
  margin: 0;
  padding: 0;
  border-width: 0;
  background-color: var(--skin-transparent);
  flex-grow: 1;
}

/* FM tactics bib image.
 * Hides these elements; controls size/placement.
 * Source rule 2192.
 */
.fm-tactics-bib-image {
  position: absolute;
  display: none;
  top: -2px;
  left: -2px;
  right: -2px;
  bottom: 0;
  -unity-background-scale-mode: scale-to-fit;
}

/* FM tactics shirt button.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2193.
 */
.fm-tactics-shirt-button {
  position: absolute;
  margin: 0px;
  padding: 0px;
  background-color: var(--skin-transparent);
  top: 0px;
  left: 0px;
  right: 0px;
  bottom: 0px;
}

/* FM tactics shirt kit image.
 * controls size/placement.
 * Source rule 2194.
 */
.fm-tactics-shirt-kit-image {
  flex-grow: 1;
  flex-shrink: 0;
  -unity-background-scale-mode: scale-to-fit;
}

/* FM tactics shirt name.
 * controls size/placement.
 * Source rule 2195.
 */
.fm-tactics-shirt-name {
  position: absolute;
  width: 100%;
  top: 10px;
}

/* FM tactics shirt number.
 * controls size/placement.
 * Source rule 2196.
 */
.fm-tactics-shirt-number {
  width: 100%;
  height: 100%;
