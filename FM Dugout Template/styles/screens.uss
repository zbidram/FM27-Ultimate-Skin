/* Shuffle draft player tile remove.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3563.
 */
.shuffle-draft-player-tile--remove,
.shuffle-draft-player-tile--remove > .shuffle-draft-player-tile-double-border {
  border-color: var(--colours-feature-draft-remove-base);
}

/* Data display draft player selection label.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3564.
 */
.shuffle-draft-player-tile--return .data_display-draft-player-selection-label {
  border-color: var(--colours-feature-draft-return-base);
  background-color: var(--colours-feature-draft-return-alpha-32);
}

/* Shuffle draft player tile return.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3565.
 */
.shuffle-draft-player-tile--return,
.shuffle-draft-player-tile--return > .shuffle-draft-player-tile-double-border {
  border-color: var(--colours-feature-draft-return-base);
}

/* Shuffle draft player tile shortlist.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3566.
 */
.shuffle-draft-player-tile--shortlist,
.shuffle-draft-player-tile--shortlist > .shuffle-draft-player-tile-double-border {
  border-color: var(--colours-feature-draft-shortlist-base);
}

/* Data display draft player selection label.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3567.
 */
.shuffle-draft-player-tile--you-drafted .data_display-draft-player-selection-label {
  border-color: var(--skin-action-primary-background);
  background-color: var(--skin-data-shuffle-draft-player-tile-you-drafted-data-display-draft-player-selection-label-background);
}

/* Shuffle draft player tile background.
 * sets the background artwork.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 3568.
 */
.shuffle-draft-player-tile-background {
  -unity-background-scale-mode: scale-and-crop;
}

/* Shuffle draft player tile background gradient.
 * sets the outline/corner shape; sets the gradient colours drawn by this component.
 * Source rule 3569.
 */
.shuffle-draft-player-tile-background-gradient {
  --start-colour: var(--skin-surface-page-alpha-60);
  --end-colour: var(--skin-surface-page);
  border-radius: var(--global-radius-regular);
}

/* Shuffle draft player tile double border.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3570.
 */
.shuffle-draft-player-tile-double-border {
  position: absolute;
  border-width: var(--global-border-width-thin);
  top: -3px;
  left: -3px;
  right: -3px;
  bottom: -3px;
  border-radius: var(--border-radius-radius-10);
}

/* Shuffle draft player tile unselected tint.
 * sets the background fill; tints background artwork.
 * Source rule 3571.
 */
.shuffle-draft-player-tile-unselected-tint {
  background-color: var(--skin-surface-canvas-alpha-25);
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Shuffle draft remove button background.
 * sets the background fill.
 * Source rule 3572.
 */
.shuffle-draft-remove-button-background {
  background-color: var(--colours-feature-draft-remove-base);
}

/* Visual Element.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3573.
 */
.shuffle-draft-removing-indicator > #data_display-graph-progress_timeline-progress_indicator > #VisualElement {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-data-shuffle-draft-removing-indicator-data-display-graph-progress-timeline-progress-indicator-visualelement-background);
}

/* Shuffle draft return button background.
 * sets the background fill.
 * Source rule 3574.
 */
.shuffle-draft-return-button-background {
  background-color: var(--colours-feature-draft-return-base);
}

/* Visual Element.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3575.
 */
.shuffle-draft-returning-indicator > #data_display-graph-progress_timeline-progress_indicator > #VisualElement {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--colours-tactics-base-20);
}

/* Shuffle draft set transition anim frame container.
 * controls size/placement.
 * Source rule 3576.
 */
.shuffle-draft-set-transition-anim-frame-container {
  position: absolute;
  height: 100%;
  align-self: center;
  flex-direction: var(--row-direction-always-normal);
  align-items: center;
}

/* Shuffle draft set transition anim last text container.
 * controls size/placement.
 * Source rule 3577.
 */
.shuffle-draft-set-transition-anim-last-text-container {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  align-items: center;
  justify-content: center;
}

/* Shuffle draft set transition anim left tactical area.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3578.
 */
.shuffle-draft-set-transition-anim-left-tactical-area {
  width: 112px;
  height: 248px;
  scale: -1 1;
  margin-right: 32px;
}

/* Shuffle draft set transition anim next text container.
 * controls size/placement.
 * Source rule 3579.
 */
.shuffle-draft-set-transition-anim-next-text-container {
  height: 100%;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* Shuffle draft set transition anim right tactical area.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3580.
 */
.shuffle-draft-set-transition-anim-right-tactical-area {
  width: 112px;
  height: 248px;
  margin-left: 32px;
}

/* Shuffle draft set transition anim round container.
 * controls size/placement.
 * Source rule 3581.
 */
.shuffle-draft-set-transition-anim-round-container {
  flex-grow: 1;
  bottom: 200px;
  align-self: center;
  justify-content: center;
}

/* Shuffle draft set transition anim set text container.
 * controls size/placement.
 * Source rule 3582.
 */
.shuffle-draft-set-transition-anim-set-text-container {
  height: 100%;
  justify-content: center;
}

/* Shuffle draft set transition anim texts container.
 * controls size/placement.
 * Source rule 3583.
 */
.shuffle-draft-set-transition-anim-texts-container {
  position: absolute;
  height: 100%;
  align-self: center;
}

/* Shuffle draft shortlist button background.
 * sets the background fill.
 * Source rule 3584.
 */
.shuffle-draft-shortlist-button-background {
  background-color: var(--colours-feature-draft-shortlist-base);
}

/* Shuffledraft explainer card rect.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3585.
 */
.shuffledraft-explainer-card-rect {
  background-color: var(--skin-surface-page-alpha-100);
  min-height: 180px;
  max-height: 280px;
  border-radius: var(--skin-radius-card);
  align-self: stretch;
}

/* Shuffledraft help panel background.
 * sets the background fill.
 * Source rule 3586.
 */
.shuffledraft-help-panel-background {
  background-color: var(--skin-surface-page-alpha-90);
}

/* Shuffledraft help section.
 * controls size/placement.
 * Source rule 3587.
 */
.shuffledraft-help-section {
  max-width: 320px;
  align-items: center;
  align-self: stretch;
  flex-grow: 1;
}

/* Game Screens
 * Native game screens selectors, with adjacent shared rules in source order.
 */

/* Tutorial floating continue chevron.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4233.
 */
.tutorial-floating-continue-chevron {
  height: 16px;
  padding: 0 var(--numbers-border-radius-medium, 16px);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Tutorial floating main frame.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4234.
 */
.tutorial-floating-main-frame {
  padding: 12px 16px;
  background-color: var(--skin-text-primary);
  flex-grow: 1;
  max-width: 640px;
  padding-left: 12px;
  padding-right: 12px;
  border-radius: var(--skin-radius-card);
}

/* Tutorial floating main frame phone.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4235.
 */
.tutorial-floating-main-frame-phone {
  width: 296px;
  padding: 16px 24px;
  background-color: var(--skin-text-primary);
  justify-content: flex-end;
  align-items: stretch;
  border-radius: var(--skin-radius-card);
}

/* Tutorial floating top frame.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4236.
 */
.tutorial-floating-top-frame {
  justify-content: space-between;
  align-items: flex-end;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
  margin-bottom: 16px;
}

/* Tutorial floating top frame phone.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4237.
 */
.tutorial-floating-top-frame-phone {
  justify-content: space-between;
  align-items: flex-end;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
  margin-bottom: 4px;
}

/* Tutorial popup background.
 * controls size/placement.
 * Source rule 4238.
 */
.tutorial-popup-background {
  flex-grow: 1;
  justify-content: center;
  align-items: center;
}

/* Tutorial text color.
 * Changes text/foreground colour.
 * Source rule 4239.
 */
.tutorial-text-color {
  color: var(--skin-surface-page);
}

/* Tutorial text step color.
 * Changes text/foreground colour.
 * Source rule 4240.
 */
.tutorial-text-step-color {
  color: var(--skin-action-primary-background);
}

/* Tutorial text underline colour.
 * sets the outline/corner shape.
 * Source rule 4241.
 */
.tutorial-text-underline-colour {
  border-color: var(--skin-surface-page);
}

/* UI concepts calendar size small.
 * controls size/placement; sets spacing around/inside the element; changes opacity for the whole element
 * and its contents.
 * Source rule 4242.
 */
.ui-concepts-calendar-size-small {
  opacity: 0.5;
  width: 16px;
  height: 16px;
  padding: 1px;
  justify-content: center;
  align-items: center;
  margin-right: 4px;
  flex-direction: var(--row-direction-normal);
}

/* UI concepts notifications indicator.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 4243.
 */
.ui-concepts-notifications-indicator {
  height: var(--height-height-14);
  background-color: var(--skin-notification-badge-background);
  color: var(--skin-notification-badge-foreground);
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius-radius-8);
}

/* The count leaf carries global-text-primary, so inherited ink is insufficient.
 * Keep the filled notification badge paired through parent button states. */
.ui-concepts-notifications-indicator .sitext,
.ui-concepts-notifications-indicator #IndicatorCount {
  color: var(--skin-notification-badge-foreground);
}

/* UI concepts notifications indicator single digit and plus.
 * controls size/placement.
 * Source rule 4244.
 */
.ui-concepts-notifications-indicator-single-digit-and-plus {
  width: var(--width-height-20);
}

/* UI concepts object preview small.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Source rule 4245.
 */
.ui-concepts-object-preview_small {
  opacity: 0.65;
  transition: opacity 0.15s ease;
}

/* UI concepts placeholder size small.
 * Hides these elements; controls size/placement; sets spacing around/inside the element.
 * Source rule 4246.
 */
.ui-concepts-placeholder-size-small {
  display: none;
  width: 16px;
  height: 16px;
  margin-right: 4px;
}

/* UI concepts tick size small.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4247.
 */
.ui-concepts-tick-size-small {
  width: 16px;
  height: 16px;
  margin-right: var(--spacing-extra-small---4);
}

/* UI concepts warning icon colour.
 * tints background artwork.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4248.
 */
.ui-concepts-warning-icon-colour,
.youth-atmosphere-poor-image,
.tint-color-linear-ranges-7-values-3 {
  -unity-background-image-tint-color: var(--linear-ranges-7-values-3);
}

/* UI icon no fill background.
 * sets the background fill; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4249.
 */
.ui-icon-no-fill-background,
.ui-icon-no-fill-background:disabled {
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
}

/* Unavailable players property 1 default.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4250.
 */
.unavailable-players-property-1-default {
  padding: 8px var(--spacing-padding-small---8);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 0;
}

/* Units block unit details.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4251.
 */
.units-block-unit-details,
.mentoring-frame {
  padding: 16px;
}

/* Unity radio button.
 * sets the background fill; defines how state changes animate.
 * Source rule 4252.
 */
.unity-radio-button {
  background-color: var(--skin-transparent);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-radius var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Unity radio button checkmark background — keyboard focus.
 * sets the outline/corner shape.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4253.
 */
.unity-radio-button > .unity-radio-button__input:focus:enabled > .unity-radio-button__checkmark-background,
.unity-base-text-field:hover:enabled > .unity-base-text-field__input,
.unity-base-text-field:focus:enabled > .unity-base-text-field__input {
  border-color: var(--colours-base-neutral-white);
}

/* Unity radio button container.
 * controls size/placement.
 * Source rule 4254.
 */
.unity-radio-button__container {
  width: 100%;
  align-self: center;
}

