}

/* Calendar training session button element min res.
 * sets spacing around/inside the element.
 * Source rule 1596.
 */
.calendar-training-session-button-element-min-res {
  padding: 2px;
  padding-left: var(--global-padding-small);
}

/* Calendar training session button element standard res.
 * sets spacing around/inside the element.
 * Source rule 1597.
 */
.calendar-training-session-button-element-standard-res {
  padding: var(--global-gap-small);
}

/* Calendar training session edit session element.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 1598.
 */
.calendar-training-session-edit-session-element {
  display: flex;
  height: 24px;
  padding: var(--global-padding-none);
  border-width: var(--global-border-regular);
  border-color: var(--calendar-training-border-colour, var(--colours-base-neutral-white));
  flex-direction: var(--row-direction-normal);
  border-left-width: var(--border-width-border-width-4);
  border-radius: var(--global-radius-small);
}

/* Calendar training session edit session label.
 * sets font/text presentation; controls size/placement; sets spacing around/inside the element.
 * Source rule 1599.
 */
.calendar-training-session-edit-session-label {
  height: 24px;
  margin-bottom: var(--global-gap-small);
  -unity-text-align: middle-left;
}

/* Calendar training session gradient element.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 1600.
 */
.calendar-training-session-gradient-element {
  display: flex;
  height: 32px;
  padding: var(--none);
  border-width: 1px;
  border-color: var(--calendar-training-border-colour, var(--skin-border-subtle));
  border-radius: var(--global-radius-small);
  border-left-width: var(--border-width-border-width-4);
  flex-direction: var(--row-direction-normal);
}

/* Calendar training session icon element.
 * controls size/placement.
 * Source rule 1601.
 */
.calendar-training-session-icon-element {
  width: 16px;
  height: 16px;
  align-self: center;
}

/* Calendar training session selection ring.
 * Hides these elements; sets the outline/corner shape; controls size/placement.
 * Source rule 1602.
 */
.calendar-training-session-selection-ring {
  position: absolute;
  display: none;
  border-width: var(--border-width-border-width-2);
  border-color: var(--colours-base-neutral-white);
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: var(--global-radius-small);
}

/* Date selector calendar row.
