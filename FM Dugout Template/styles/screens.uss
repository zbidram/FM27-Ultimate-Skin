/* Calendar date labels default active.
 * sets the background fill.
 * Source rule 1517.
 */
/* Today uses a compact Volt date marker, paired with dark ink. */
.calendar-date-labels-default-active {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}
.calendar-date-labels-default-active .sitext,
.calendar-day-current .calendar-day-text,
.calendar-day-current .calendar-day-header .sitext {
  color: var(--skin-selection-foreground);
}

/* Calendar date labels default future.
 * sets the background fill.
 * Source rule 1518.
 */
.calendar-date-labels-default-future {
  background-color: var(--skin-surface-canvas);
}

/* Calendar date labels default property.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1519.
 */
.calendar-date-labels-default-property {
  height: 18px;
  min-width: 45px;
  padding-top: var(--global-padding-extra-small);
  padding-right: var(--global-padding-regular);
  padding-bottom: var(--global-padding-extra-small);
  padding-left: var(--global-padding-regular);
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  border-radius: 9px;
}

/* Calendar event.
 * sets the outline/corner shape.
 * Source rule 1520.
 */
.calendar-day-block .calendar-event {
  border-radius: var(--global-radius-extra-small);
  overflow: hidden;
}

/* Calendar day current.
 * sets the background fill.
 * Source rule 1521.
 */
.calendar-day-current {
  background-color: var(--colours-brand-primary-08);
}

/* Calendar header gradient.
 * sets the gradient colours drawn by this component.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1522.
 */
.calendar-day-current .calendar-header-gradient,
.speakto-button-interaction-button-tag-advice-gradient {
  --start-colour: var(--skin-brand-primary);
  --end-colour: var(--skin-brand-primary);
}

/* Calendar day general.
 * sets the outline/corner shape.
 * Source rule 1523.
 */
.calendar-day-general {
  border-width: 0 0 1px 1px;
  border-color: var(--skin-on-media-alpha-08);
}

/* Calendar day highlighted.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1524.
 */
.calendar-day-highlighted {
  /* Highlight the day without competing with session category colours. */
  background-color: var(--skin-selection-muted);
}

/* Calendar day body.
 * changes opacity for the whole element and its contents.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1525.
 */
.calendar-day-passed .calendar-day-body,
.calendar-day-passed .calendar-event-list,
.menu-element--selected .main-menu-navigation-default .navigation-tab-dropdown,
.navigation-tab-portal-default-active-false:hover .navigation-chip {
  opacity: 0.65;
}

/* Fixture background border.
 * sets the outline/corner shape; changes opacity for the whole element and its contents.
 * Source rule 1526.
 */
.calendar-day-passed .calendar-event .fixture-background-border {
  opacity: 0.35;
  border-radius: var(--global-radius-extra-small);
}

/* Calendar day passed.
 * sets the background fill.
 * Shared rule for 7 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1527.
 */
.calendar-day-passed,
.scroller-default #unity-slider,
.calendar-day-passed .calendar-event-border,
.calendar-day-passed .calendar-day-future,
.calendar-day-future .calendar-day-future,
.nav-on-light .nonDiegeticButton,
.nav-on-light .nonDiegeticButton #SelectionField {
  background-color: var(--skin-transparent);
}

/* Unity scroll view content viewport vertical.
 * sets spacing around/inside the element.
 * Source rule 1528.
 */
.calendar-days .unity-scroll-view__content-viewport--vertical {
  padding-top: var(--global-padding-none);
  padding-bottom: var(--global-padding-none);
}

/* Calendar days.
 * sets the background fill; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1529.
 */
.calendar-days,
.message-container-frame {
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  border-radius: var(--layout-modules-block-radius);
  overflow: hidden;
}

/* Fixture background border.
 * sets the outline/corner shape.
 * Source rule 1530.
 */
.calendar-event .fixture-background-border {
  border-radius: var(--global-radius-extra-small);
}

/* Calendar event border.
 * sets the outline/corner shape.
 * Source rule 1531.
 */
.calendar-event-border {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  border-radius: var(--global-radius-extra-small);
  overflow: hidden;
}

/* Calendar event content.
 * sets spacing around/inside the element.
 * Source rule 1532.
 */
.calendar-event-content {
  padding: 4px 6px;
}

/* Calendar event content standard res.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1533.
 */
.calendar-event-content-standard-res,
.player-search-filter-preview-item {
  padding: 4px 8px 4px 8px;
}

/* Calendar event content tile.
 * sets spacing around/inside the element.
 * Source rule 1534.
 */
.calendar-event-content-tile {
  padding: 3px;
}

/* Calendar event8x4.
 * sets spacing around/inside the element.
 * Source rule 1535.
 */
.calendar-event8x4 {
  padding: 3px 4px 3px 4px;
  margin-bottom: var(--global-gap-close);
}

/* Calendar events list padding.
 * sets spacing around/inside the element.
 * Source rule 1536.
 */
.calendar-events-list-padding {
  padding: 2px 0 2px 0;
}

/* Fixture background border.
 * sets the outline/corner shape.
 * Source rule 1537.
 */
.calendar-fixture-card .fixture-background-border {
  border-radius: var(--skin-radius-card) var(--skin-radius-card) 0 0;
}

/* Calendar fixture comp width.
 * controls size/placement.
 * Source rule 1538.
 */
.calendar-fixture-comp-width {
  max-width: 120px;
}

/* Calendar fixtures table cell.
 * sets spacing around/inside the element.
 * Source rule 1539.
 */
.calendar-fixtures-table-cell {
  margin: 0 8px 0 8px;
}

/* Calendar fixtures table cell border.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 1540.
 */
.calendar-fixtures-table-cell-border {
  padding: 2px 8px 2px 8px;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  border-radius: var(--global-radius-extra-small);
}

/* Calendar grid.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 1541.
 */
.calendar-grid {
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  border-radius: var(--layout-modules-block-radius);
  overflow: hidden;
}

/* Calendar line height 12.
 * controls size/placement.
 * Source rule 1542.
 */
.calendar-line-height-12 {
  min-height: 12px;
  max-height: 20px;
}

/* Calendar line height 14.
 * controls size/placement.
 * Source rule 1543.
 */
.calendar-line-height-14 {
  min-height: 14px;
  max-height: 20px;
}

/* Calendar line height 16.
 * controls size/placement.
 * Source rule 1544.
 */
.calendar-line-height-16 {
  min-height: 16px;
  max-height: 20px;
}

/* Calendar max res.
 * controls size/placement.
 * Source rule 1545.
 */
.calendar-max-res {
  width: auto;
  height: 732px;
}

/* Calendar day body.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1546.
 */
.calendar-max-res .calendar-day-general .calendar-day-body {
  width: 100%;
  padding: 8px 12px 8px 12px;
  flex-grow: 1;
  min-height: 168px;
}

/* Calendar day header.
 * controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1547.
 */
.calendar-max-res .calendar-day-general .calendar-day-header,
.calendar-max-res .calendar-day-training .calendar-day-header {
  padding: 8px 0 4px 12px;
  flex-grow: 0;
  align-self: stretch;
  min-height: 28px;
}

/* Calendar day body.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1548.
 */
.calendar-max-res .calendar-day-training .calendar-day-body {
  width: 209px;
  padding: 8px 0 8px 12px;
  flex-grow: 1;
  min-height: 136px;
}

/* Calendar training focus card.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1549.
 */
.calendar-max-res .calendar-training-focus-card {
  width: 134px;
  margin: 12px 12px 12px 12px;
  padding: var(--global-padding-regular);
}

/* Calendar training week header.
 * sets spacing around/inside the element.
 * Source rule 1550.
 */
.calendar-max-res .calendar-training-week-header {
  margin-left: 250px;
}

/* Calendar week general header.
 * controls size/placement.
 * Source rule 1551.
