.calendar-max-res .virtualised-list__item,
.calendar-standard-res .virtualised-list__item,
.calendar-min-res .virtualised-list__item,
.training-week .virtualised-list__item,
.calendar-tile8x4 .calendar-day-body .virtualised-list__item,
