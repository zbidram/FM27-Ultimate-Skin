  padding-right: var(--global-padding-regular);
  padding-bottom: var(--global-padding-regular);
  padding-left: var(--global-padding-regular);
  flex-direction: column;
  align-items: flex-start;
  border-right-width: 1px;
  border-right-color: var(--skin-surface-panel);
  border-bottom-width: 1px;
  border-bottom-color: var(--skin-surface-panel);
}

/* Calendar training events min.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1587.
 */
.calendar-training-events-min {
  width: auto;
  height: 24px;
  margin-bottom: var(--global-gap-close);
}

/* Calendar training events standard.
 * controls size/placement.
