/* Penalty-taker list sits within a report card. Use a theme surface rather
 * than a white overlay, so its depth survives dark and light palettes. */
.penaltied-block-bg {
  padding: var(--global-padding-extra-large);
  background-color: var(--skin-surface-raised);
  border-radius: var(--skin-radius-card);
}

/* Personalised opposition controls identify the instruction target. The
 * person glyph needs the same ink as its filled selected surface. */
.tactics-opposition-instruction-personalised-left-active:enabled .game-concepts-training-tactics_small,
.tactics-opposition-instruction-personalised-right-active:enabled .game-concepts-player-instructions_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* Position interactions use shared neutral controls; role swatches remain data. */
.tactics-visualiser-player-position-type-attacking-midfield:hover:enabled,
.tactics-visualiser-player-position-type-defenders:hover:enabled,
.tactics-visualiser-player-position-type-defensive-midfield:hover:enabled,
.tactics-visualiser-player-position-type-gk:hover:enabled,
.tactics-visualiser-player-position-type-midfield:hover:enabled,
.tactics-visualiser-player-position-type-striker:hover:enabled,
.tactics-visualiser-player-position-type-attacking-midfield #RoleButton:hover:enabled,
.tactics-visualiser-player-position-type-defenders #RoleButton:hover:enabled,
.tactics-visualiser-player-position-type-defensive-midfield #RoleButton:hover:enabled,
.tactics-visualiser-player-position-type-gk #RoleButton:hover:enabled,
.tactics-visualiser-player-position-type-midfield #RoleButton:hover:enabled,
.tactics-visualiser-player-position-type-striker #RoleButton:hover:enabled {
  background-color: var(--skin-tactics-position-hover);
  color: var(--skin-tactics-position-foreground);
}
.tactics-visualiser-player-position-type-attacking-midfield:hover:enabled .sitext,
.tactics-visualiser-player-position-type-defenders:hover:enabled .sitext,
.tactics-visualiser-player-position-type-defensive-midfield:hover:enabled .sitext,
.tactics-visualiser-player-position-type-gk:hover:enabled .sitext,
.tactics-visualiser-player-position-type-midfield:hover:enabled .sitext,
.tactics-visualiser-player-position-type-striker:hover:enabled .sitext,
.tactics-visualiser-player-position-type-attacking-midfield #RoleButton:hover:enabled .sitext,
.tactics-visualiser-player-position-type-defenders #RoleButton:hover:enabled .sitext,
.tactics-visualiser-player-position-type-defensive-midfield #RoleButton:hover:enabled .sitext,
.tactics-visualiser-player-position-type-gk #RoleButton:hover:enabled .sitext,
.tactics-visualiser-player-position-type-midfield #RoleButton:hover:enabled .sitext,
.tactics-visualiser-player-position-type-striker #RoleButton:hover:enabled .sitext {
  color: var(--skin-tactics-position-foreground);
}
.tactics-visualiser-player-position-type-attacking-midfield:active:enabled,
.tactics-visualiser-player-position-type-defenders:active:enabled,
.tactics-visualiser-player-position-type-defensive-midfield:active:enabled,
.tactics-visualiser-player-position-type-gk:active:enabled,
.tactics-visualiser-player-position-type-midfield:active:enabled,
.tactics-visualiser-player-position-type-striker:active:enabled,
.tactics-visualiser-player-position-type-attacking-midfield #RoleButton:active:enabled,
.tactics-visualiser-player-position-type-defenders #RoleButton:active:enabled,
.tactics-visualiser-player-position-type-defensive-midfield #RoleButton:active:enabled,
.tactics-visualiser-player-position-type-gk #RoleButton:active:enabled,
.tactics-visualiser-player-position-type-midfield #RoleButton:active:enabled,
.tactics-visualiser-player-position-type-striker #RoleButton:active:enabled {
  background-color: var(--skin-tactics-position-pressed);
  color: var(--skin-tactics-position-foreground);
}
.tactics-visualiser-player-position-type-attacking-midfield:active:enabled .sitext,
.tactics-visualiser-player-position-type-defenders:active:enabled .sitext,
.tactics-visualiser-player-position-type-defensive-midfield:active:enabled .sitext,
.tactics-visualiser-player-position-type-gk:active:enabled .sitext,
.tactics-visualiser-player-position-type-midfield:active:enabled .sitext,
.tactics-visualiser-player-position-type-striker:active:enabled .sitext,
.tactics-visualiser-player-position-type-attacking-midfield #RoleButton:active:enabled .sitext,
.tactics-visualiser-player-position-type-defenders #RoleButton:active:enabled .sitext,
.tactics-visualiser-player-position-type-defensive-midfield #RoleButton:active:enabled .sitext,
.tactics-visualiser-player-position-type-gk #RoleButton:active:enabled .sitext,
.tactics-visualiser-player-position-type-midfield #RoleButton:active:enabled .sitext,
.tactics-visualiser-player-position-type-striker #RoleButton:active:enabled .sitext {
  color: var(--skin-tactics-position-foreground);
}

/* The routine picker authors its value and gauge below an absolute dropdown
 * interaction layer. Keep that layer clear so the existing value can show. */
#SelectBar #parent-anchor > #active #tactics-picker-focusser > #SIDropdown_SelectRoutine.buttons-dropdown-base-regular .si-dropdown__selection-field {
  background-color: var(--skin-transparent);
}
