/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Tactics
 * Native tactics selectors, with adjacent shared rules in source order.
 */

/* Dropdown text frame.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3494.
 */
.set-piece-instruction-row-dropdown .dropdown-text-frame {
  flex-grow: 1;
  padding-left: var(--global-padding-extra-extra-large);
}

/* Set piece pitch category a.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3495.
 */
.set-piece-pitch-category-a,
.stadium-stand-sponsor,
.transfer-offer-colour-future {
  background-color: var(--colours-base-orange-strong);
}

/* Set piece pitch category b.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3496.
 */
.set-piece-pitch-category-b,
.sponsor-back {
  background-color: var(--colours-base-green-strong);
}

/* Set piece pitch category c.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3497.
 */
.set-piece-pitch-category-c,
.sponsor-secondary,
.transfer-offer-colour-due {
  background-color: var(--colours-base-cyan-strong);
}

/* Set piece pitch category corner taker.
 * sets the background fill; controls size/placement.
 * Source rule 3498.
 */
.set-piece-pitch-category-corner-taker {
  background-color: var(--colours-base-grey-soft);
  flex-direction: column;
}

/* Set piece pitch category d.
 * sets the background fill; controls size/placement.
 * Source rule 3499.
 */
.set-piece-pitch-category-d {
  background-color: var(--colours-base-red-soft);
  flex-direction: column;
}

/* Set piece pitch text category a.
 * Changes text/foreground colour.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3500.
 */
.set-piece-pitch-text-category-a,
.set-piece-pitch-text-category-b,
.set-piece-pitch-text-category-c,
.set-piece-pitch-text-category-d {
  color: var(--colours-base-neutral-black);
}

/* Set piece pitch tile widget.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3501.
 */
.set-piece-pitch-tile-widget {
  width: 381px;
  height: 100%;
  padding: 1px;
  background-color: var(--pitch-tile-default-background);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: 7px;
}

/* Set piece pitch tile widget phone.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3502.
 */
.set-piece-pitch-tile-widget-phone {
  padding: 1px;
  background-color: var(--pitch-tile-default-background);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: 7px;
}

/* Set piece routine category a.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3503.
 */
.set-piece-routine-category-a {
  width: 24px;
  padding: 4px;
  background-color: var(--colours-base-orange-strong);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  margin-right: var(--spacing-padding-small---8);
}

/* Set piece routine category b.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3504.
 */
.set-piece-routine-category-b {
  width: 24px;
  padding: 4px;
  background-color: var(--colours-base-green-strong);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  margin-right: var(--spacing-padding-small---8);
}

/* Set piece routine category c.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3505.
 */
.set-piece-routine-category-c {
  width: 24px;
  padding: 4px;
  background-color: var(--colours-base-cyan-strong);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  margin-right: var(--spacing-padding-small---8);
}

/* Set piece routine category corner taker.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3506.
 */
.set-piece-routine-category-corner-taker {
  width: 24px;
  padding: 4px;
  background-color: var(--colours-base-grey-soft);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  margin-right: var(--spacing-padding-small---8);
}

/* Set piece routine category d.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3507.
 */
.set-piece-routine-category-d {
  width: 24px;
  padding: 4px;
  background-color: var(--colours-base-red-soft);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  margin-right: var(--spacing-padding-small---8);
}

/* Set piece routine one.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3508.
 */
.set-piece-routine-one {
  width: 16px;
  height: 16px;
  background-color: var(--colours-base-green-soft);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: var(--spacing-padding-small---8);
}

/* Set piece routine preview radio button.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3509.
 */
.set-piece-routine-preview-radio-button {
  width: 135px;
  margin: 0 1px;
  padding: 4px 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  align-items: center;
  border-radius: var(--skin-radius-card);
  flex-direction: var(--row-direction-always-normal);
}

/* Set piece routine three.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3510.
 */
.set-piece-routine-three {
  width: 16px;
  height: 16px;
  background-color: var(--colours-base-cyan-soft);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: var(--spacing-padding-small---8);
}

/* Set piece routine two.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3511.
 */
.set-piece-routine-two {
  width: 16px;
  height: 16px;
  background-color: var(--colours-base-blue-soft);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: var(--spacing-padding-small---8);
}

/* Set pieces buttons ios.
 * sets spacing around/inside the element.
 * Source rule 3512.
 */
.set-pieces-buttons-ios {
  margin-left: var(--global-gap-regular);
}

/* Set pieces header 2x1 tile.
 * controls size/placement.
 * Source rule 3513.
 */
.set-pieces-header-2x1-tile {
  width: 146px;
  height: 66px;
}

/* Tactics
 * Native tactics selectors, with adjacent shared rules in source order.
 */

/* Tactical effectiveness player warning.
 * tints background artwork.
 * Source rule 3794.
 */
.tactical-effectiveness-player-warning {
  -unity-background-image-tint-color: var(--interaction-input-switch-border-color-warning);
}

/* Tactical effectiveness provisional score container.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3795.
 */
.tactical-effectiveness-provisional-score-container {
  display: flex;
  height: var(--interaction-global-height-md, 32px);
  margin: 4px var(--global-gap-close, 4px);
  padding: var(--interaction-global-padding-vertical) var(--interaction-global-padding-horizontal-md);
  background-color: var(--theme-color-purple-soft-surface, var(--skin-data-tactical-effectiveness-provisional-score-container-background));
  justify-content: center;
  align-items: center;
  align-content: center;
  flex-wrap: wrap;
  border-radius: var(--interaction-global-radius-md, var(--skin-radius-small));
}

/* Tactical effectiveness tile table column right.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3796.
 */
.tactical-effectiveness-tile-table-column-right {
  width: 72px;
  padding-right: var(--global-padding-extra-small);
  justify-content: center;
  align-items: flex-end;
}

/* Tactical effectiveness tile table header.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3797.
 */
.tactical-effectiveness-tile-table-header {
  height: var(--interaction-global-height-sm);
  padding: var(--padding-padding-4) var(--padding-padding-4);
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Tactical effectiveness tile table row height large.
 * controls size/placement.
 * Source rule 3798.
 */
.tactical-effectiveness-tile-table-row-height-large {
  height: var(--interaction-global-height-lg);
}

/* Tactical effectiveness tile table row height regular.
 * controls size/placement.
 * Source rule 3799.
 */
.tactical-effectiveness-tile-table-row-height-regular {
  height: var(--interaction-global-height-md);
}

/* Tactical shout icon container dark.
 * sets the background fill; controls size/placement.
 * Source rule 3800.
 */
.tactical-shout-icon-container-dark {
  width: 24px;
  height: 24px;
  background-color: var(--skin-surface-canvas-alpha-65);
  align-self: center;
  justify-content: center;
  align-items: center;
}

/* Tactical shout icon container light.
 * sets the background fill; controls size/placement.
 * Source rule 3801.
 */
.tactical-shout-icon-container-light {
  width: 24px;
  height: 24px;
  background-color: var(--skin-on-media-alpha-08);
  align-self: center;
  justify-content: center;
  align-items: center;
}

/* Tactical shout row.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3802.
 */
.tactical-shout-row {
  background-color: var(--skin-on-media-alpha-08);
  min-height: 32px;
  padding-left: 8px;
  padding-right: 8px;
}

/* Tactical tweak player row.
 * controls size/placement.
 * Source rule 3803.
 */
.tactical-tweak-player-row {
  min-height: 32px;
  flex-direction: column;
  align-self: stretch;
}

/* Tactical tweak player row active count.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 3804.
 */
.tactical-tweak-player-row__active-count {
  color: var(--skin-data-tactical-tweak-player-row-active-count-foreground);
  font-size: var(--skin-font-size-12);
  margin-left: 4px;
  -unity-font-style: bold;
}

/* Tactical tweak player row header.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3805.
 */
.tactical-tweak-player-row__header {
  background-color: var(--skin-on-media-alpha-08);
  min-height: 24px;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 4px;
  padding-bottom: 4px;
  flex-direction: var(--row-direction-normal);
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
}

/* Tactical tweak player row name.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 3806.
 */
.tactical-tweak-player-row__name {
  color: var(--skin-text-primary);
  font-size: var(--skin-font-size-12);
  margin-left: 4px;
}

/* Tactical tweak player row picker.
 * Hides these elements; controls size/placement.
 * Source rule 3807.
 */
.tactical-tweak-player-row__picker {
  display: none;
  flex-direction: column;
  align-self: stretch;
}

/* Tactical tweak player row row button.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3808.
 */
.tactical-tweak-player-row__row-button,
.tactical-tweak-row__row-button {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

/* Tactical tweak player row shirt badge.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3809.
 */
.tactical-tweak-player-row__shirt-badge {
  width: 24px;
  height: 24px;
  margin-right: var(--global-gap-regular);
}

/* Tactical tweak player row shirt badge fill.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3810.
 */
.tactical-tweak-player-row__shirt-badge-fill {
  border-width: 1px;
  border-color: var(--skin-transparent);
  flex-grow: 1;
  align-self: stretch;
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius-radius-4);
}

/* Tactical tweak player row shirt number.
 * sets font/text presentation.
 * Source rule 3811.
 */
.tactical-tweak-player-row__shirt-number {
  font-size: var(--skin-font-size-12);
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

/* Tactical tweak row.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3812.
 */
.tactical-tweak-row {
  background-color: var(--skin-on-media-alpha-08);
  min-height: 32px;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 4px;
  padding-bottom: 4px;
  flex-direction: column;
  align-self: stretch;
}

/* Tactical tweak row icon badge.
 * sets the outline/corner shape.
 * Source rule 3813.
 */
.tactical-tweak-row--active .tactical-tweak-row__icon-badge {
  border-color: var(--skin-data-tactical-tweak-row-active-tactical-tweak-row-icon-badge-border-color);
}

/* Tactical tweak row indicator.
 * Shows these elements; sets the background fill.
 * Source rule 3814.
 */
.tactical-tweak-row--active .tactical-tweak-row__indicator {
  display: flex;
  background-color: var(--skin-data-tactical-tweak-row-active-tactical-tweak-row-indicator-background);
}

/* Tactical tweak row title.
 * Changes text/foreground colour.
 * Source rule 3815.
 */
.tactical-tweak-row--active .tactical-tweak-row__title {
  color: var(--skin-data-tactical-tweak-row-active-tactical-tweak-row-title-foreground);
}

/* Tactical tweak row icon badge.
 * sets the outline/corner shape.
 * Source rule 3816.
 */
.tactical-tweak-row--active.tactical-tweak-row--conflict .tactical-tweak-row__icon-badge {
  border-color: var(--skin-data-tactical-tweak-row-active-tactical-tweak-row-conflict-tactical-tweak-row-icon-badge-border-color);
}

/* Tactical tweak row icon badge.
 * sets the outline/corner shape.
 * Source rule 3816.
 */
.tactical-tweak-row--pending-apply.tactical-tweak-row--conflict .tactical-tweak-row__icon-badge {
  border-color: var(--skin-data-tactical-tweak-row-pending-apply-tactical-tweak-row-conflict-tactical-tweak-row-icon-badge-border-color);
}

/* Tactical tweak row indicator.
 * sets the background fill.
 * Source rule 3817.
 */
.tactical-tweak-row--active.tactical-tweak-row--conflict .tactical-tweak-row__indicator {
  background-color: var(--skin-data-tactical-tweak-row-active-tactical-tweak-row-conflict-tactical-tweak-row-indicator-background);
}

/* Tactical tweak row indicator.
 * sets the background fill.
 * Source rule 3817.
 */
.tactical-tweak-row--pending-apply.tactical-tweak-row--conflict .tactical-tweak-row__indicator {
  background-color: var(--skin-data-tactical-tweak-row-pending-apply-tactical-tweak-row-conflict-tactical-tweak-row-indicator-background);
}

/* Tactical tweak row title.
 * Changes text/foreground colour.
 * Source rule 3818.
 */
.tactical-tweak-row--active.tactical-tweak-row--conflict .tactical-tweak-row__title {
  color: var(--skin-data-tactical-tweak-row-active-tactical-tweak-row-conflict-tactical-tweak-row-title-foreground);
}

/* Tactical tweak row title.
 * Changes text/foreground colour.
 * Source rule 3818.
 */
.tactical-tweak-row--pending-apply.tactical-tweak-row--conflict .tactical-tweak-row__title {
  color: var(--skin-data-tactical-tweak-row-pending-apply-tactical-tweak-row-conflict-tactical-tweak-row-title-foreground);
}

/* Tactical tweak row disabled.
 * sets the background fill.
 * Source rule 3819.
 */
.tactical-tweak-row--disabled {
  background-color: var(--skin-on-media-alpha-02);
}

/* Tactical tweak row title.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 3820.
 */
.tactical-tweak-row--disabled .tactical-tweak-row__title {
  color: var(--skin-text-secondary);
  -unity-font-style: normal;
}

/* Tactical tweak row icon badge.
 * sets the outline/corner shape.
 * The two badges keep their existing border width; the tile frames below
 * restore a separate width only for the pending status.
 * Source rule 3821.
 */
.tactical-tweak-row--pending-apply .tactical-tweak-row__icon-badge,
.tactical-tweak-row--pending-remove .tactical-tweak-row__icon-badge {
  border-color: var(--colours-tactics-tweak-pending);
}

/* Pending tactic tiles retain their status outline after the ordinary shared
 * card border is removed. The badge above keeps its own native width. */
.player-instruction-tile--pending .surfaces-card-tile-border,
.team-instruction-tile--pending .surfaces-card-tile-border,
.team-instruction-tile--phase-relevant .team-instruction-tile--pending .surfaces-card-tile-border {
  border-width: var(--global-border-width-tile-card);
  border-color: var(--colours-tactics-tweak-pending);
}

/* Tactical tweak row indicator.
 * Shows these elements; sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3822.
 */
.tactical-tweak-row--pending-apply .tactical-tweak-row__indicator,
.tactical-tweak-row--pending-remove .tactical-tweak-row__indicator {
  display: flex;
  background-color: var(--colours-tactics-tweak-pending);
}

/* Tactical tweak row title.
 * Changes text/foreground colour.
 * Shared rule for 8 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3823.
 */
.tactical-tweak-row--pending-apply .tactical-tweak-row__title,
.tactical-tweak-row--pending-remove .tactical-tweak-row__title,
.player-instruction-tile--pending .tile-title-color,
.team-instruction-tile--pending .tile-title-color,
.team-instruction-cell--pending #text-second,
.team-instruction-tile--pending .mentality-text,
.team-instruction-tile--pending #name,
.player-instruction-tile--pending #name {
  color: var(--colours-tactics-tweak-pending);
}

/* Tactical tweak row cancel button.
 * Hides these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3824.
 */
.tactical-tweak-row__cancel-button {
  display: none;
  width: 24px;
  height: 24px;
  background-color: var(--skin-on-media-alpha-10);
  align-items: center;
  justify-content: center;
  border-top-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
}

/* Tactical tweak row header.
 * controls size/placement.
 * Source rule 3825.
 */
.tactical-tweak-row__header {
  min-height: 24px;
  flex-direction: var(--row-direction-normal);
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
}

/* Tactical tweak row icon badge.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3826.
 */
.tactical-tweak-row__icon-badge {
  width: 24px;
  height: 24px;
  border-width: 1px;
  border-color: var(--skin-transparent);
  background-color: var(--skin-surface-canvas-alpha-65);
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius-radius-4);
  margin-right: var(--global-gap-regular);
}

/* Tactical tweak row indicator.
 * Hides these elements; controls size/placement.
 * Source rule 3827.
 */
.tactical-tweak-row__indicator {
  position: absolute;
  display: none;
  width: 3px;
  height: 100%;
  left: 0;
  top: 0;
}

/* Tactical tweak row instruct pill.
 * sets the background fill.
 * Source rule 3828.
 */
.tactical-tweak-row__instruct-pill {
  background-color: var(--skin-data-tactical-tweak-row-instruct-pill-background);
}

/* Tactical tweak row instructing pill.
 * sets the background fill.
 * Source rule 3829.
 */
.tactical-tweak-row__instructing-pill {
  background-color: var(--skin-on-media-alpha-10);
}

/* Tactical tweak row pill.
 * Hides these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 3830.
 */
.tactical-tweak-row__pill {
  display: none;
  height: 24px;
  padding-left: 8px;
  padding-right: 8px;
  align-items: center;
  justify-content: center;
  border-top-left-radius: var(--skin-radius-card);
  border-top-right-radius: var(--skin-radius-card);
  border-bottom-left-radius: var(--skin-radius-card);
  border-bottom-right-radius: var(--skin-radius-card);
}

/* Tactical tweak row pill label.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 3831.
 */
.tactical-tweak-row__pill-label {
  color: var(--skin-on-media);
  font-size: var(--skin-font-size-11);
  -unity-font-style: bold;
}

/* Tactical tweak row stop pill.
 * sets the background fill.
 * Source rule 3832.
 */
.tactical-tweak-row__stop-pill {
  background-color: var(--skin-data-tactical-tweak-row-stop-pill-background);
}

/* Tactical tweak row stop pill.
 * sets the background fill.
 * Source rule 3832.
 */
.tactical-tweak-row__stopping-pill {
  background-color: var(--skin-data-tactical-tweak-row-stopping-pill-background);
}

/* Tactical tweak row title.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 3833.
 */
.tactical-tweak-row__title {
  color: var(--skin-text-primary);
  font-size: var(--skin-font-size-12);
  -unity-font-style: bold;
}

/* Tactical tweaks badge.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 3834.
 */
.tactical-tweaks-badge {
  height: 18px;
  background-color: var(--skin-data-tactical-tweaks-badge-background);
  color: var(--skin-on-media);
  font-size: var(--skin-font-size-11);
  min-width: 18px;
  padding-left: 5px;
  padding-right: 5px;
  -unity-text-align: middle-center;
  -unity-font-style: bold;
  border-top-left-radius: 9px;
  border-top-right-radius: 9px;
  border-bottom-left-radius: 9px;
  border-bottom-right-radius: 9px;
}

/* Tactical tweaks list.
 * sets the background fill; controls size/placement.
 * Source rule 3835.
 */
.tactical-tweaks-list {
  background-color: var(--skin-surface-raised);
  align-self: stretch;
}

/* Tactical tweaks panel.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3836.
 */
.tactical-tweaks-panel {
  width: 360px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-12);
  background-color: var(--skin-surface-page);
  border-radius: var(--global-radius-small);
}

/* Tactical tweaks tab.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3837.
 */
.tactical-tweaks-tab {
  background-color: var(--none);
  border-bottom-width: 2px;
  border-bottom-color: var(--skin-transparent);
  padding-left: var(--global-padding-regular);
  padding-right: var(--global-padding-regular);
  flex-direction: var(--row-direction-normal);
  align-items: center;
  justify-content: center;
}

/* Tactical tweaks tab active true.
 * sets the outline/corner shape.
 * Source rule 3838.
 */
.tactical-tweaks-tab--active-true {
  border-bottom-color: var(--skin-data-tactical-tweaks-tab-active-true-border-bottom-color);
}

/* Tactical tweaks tab badge.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3839.
 */
.tactical-tweaks-tab__badge {
  width: 16px;
  height: 16px;
  background-color: var(--skin-data-tactical-tweaks-tab-badge-background);
  border-radius: var(--border-radius-radius-8);
  max-width: 16px;
  max-height: 16px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Tactical tweaks tabs.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3840.
 */
.tactical-tweaks-tabs {
  height: 36px;
  align-items: center;
  margin-right: 8px;
  margin-left: 8px;
}

/* Tactics accent pitch.
 * controls size/placement.
 * Source rule 3841.
 */
.tactics-accent-pitch {
  position: absolute;
  width: 60px;
  height: 42px;
  left: 0px;
  top: 0px;
}

/* Tactics accent pitch 2 2.
 * controls size/placement.
