}

/* Tactics visualiser phases tile active.
 * sets the background artwork; changes opacity for the whole element and its contents.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 3923.
 */
.tactics-visualiser-phases-tile-active {
  opacity: 0.35;
  -unity-background-scale-mode: scale-to-fit;
  background-repeat: repeat repeat;
  background-position-x: left 0;
  background-position-y: top 0;
}

/* Tactics visualiser phases tile inactive.
 * changes opacity for the whole element and its contents.
 * Source rule 3924.
 */
.tactics-visualiser-phases-tile-inactive {
  opacity: 0.05;
}

/* Tactics visualiser pitch.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
