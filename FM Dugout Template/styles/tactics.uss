}

/* Tactics collapsable pitch container.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3854.
 */
.tactics-collapsable-pitch-container {
  padding: 12px;
  border-width: 2px;
  border-color: var(--skin-data-tactics-collapsable-pitch-container-border-color);
  background-color: var(--skin-data-tactics-collapsable-pitch-container-background);
  border-radius: var(--skin-radius-control);
  flex-shrink: 1;
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  align-self: flex-start;
}

/* Tactics collapsable pitch container with darker header.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3855.
 */
.tactics-collapsable-pitch-container-with-darker-header {
  border-width: 1px;
  border-color: var(--skin-data-tactics-collapsable-pitch-container-with-darker-header-border-color);
  background-color: var(--skin-data-tactics-collapsable-pitch-container-with-darker-header-background);
  border-bottom-right-radius: var(--skin-radius-control);
  border-bottom-left-radius: var(--skin-radius-control);
  flex-shrink: 1;
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  align-self: flex-start;
}

/* Tactics collapsable pitch expanded.
 * controls size/placement.
 * Source rule 3856.
 */
.tactics-collapsable-pitch-expanded {
  width: 452px;
  max-width: 452px;
  min-width: 452px;
  max-height: 660px;
}

/* Tactics collapsable pitch grass colour.
 * sets the background fill.
 * Source rule 3857.
 */
.tactics-collapsable-pitch-grass-colour {
  background-color: var(--colours-tactics-base-50);
}

/* Tactics collapsable pitch header.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3858.
 */
.tactics-collapsable-pitch-header {
  border-width: 1px;
  border-color: var(--skin-data-tactics-collapsable-pitch-header-border-color);
  background-color: var(--skin-data-tactics-collapsable-pitch-header-background);
  border-top-left-radius: var(--skin-radius-control);
  border-top-right-radius: var(--skin-radius-control);
  flex-shrink: 1;
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
}

/* Tactics collapsable pitch header button.
 * sets spacing around/inside the element.
 * Source rule 3859.
 */
.tactics-collapsable-pitch-header-button {
  margin: 0;
  padding: 8px;
}

/* Buttongroup button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3860.
 */
.tactics-collapsable-pitch-header-button-group .buttongroup__button {
  height: var(--interaction-global-height-md);
  margin: var(--global-gap-micro) var(--global-gap-none);
  padding: var(--interaction-global-padding-horizontal-xs);
  border-width: var(--global-border-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--none);
  min-height: 32px;
  min-width: 32px;
  align-items: center;
  justify-content: center;
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Sitext.
 * sets spacing around/inside the element.
 * Source rule 3861.
 */
.tactics-collapsable-pitch-header-button-group .buttongroup__button .sitext {
  margin: 0 4px 0 4px;
}

/* Buttongroup button active.
 * sets the background fill; sets the background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3862.
 */
.tactics-collapsable-pitch-header-button-group .buttongroup__button--active,
.tactics-collapsable-pitch-header-button-group .buttongroup__button--active:hover {
  background-color: var(--colours-tactics-base-20);
  background-image: none;
}

/* Tactics collapsable pitch header collapse button.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3863.
 */
.tactics-collapsable-pitch-header-collapse-button {
  background-color: var(--colours-tactics-base-20);
  border-radius: var(--interaction-global-radius-md);
}

/* Tactics collapsable pitch shrunk height.
 * controls size/placement.
 * Source rule 3864.
 */
.tactics-collapsable-pitch-shrunk-height {
  height: 240px;
  max-height: 240px;
  min-height: 240px;
}

/* Tactics collapsable pitch shrunk width.
 * controls size/placement.
 * Source rule 3865.
 */
.tactics-collapsable-pitch-shrunk-width {
  width: 198px;
  max-width: 198px;
  min-width: 198px;
}

/* Tactics creator stepper step.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3866.
 */
.tactics-creator-stepper-step {
  width: 24px;
  height: 4px;
  background-color: var(--skin-on-media-alpha-35);
  margin-right: 4px;
}

/* Tactics multiple choice option button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3867.
 */
.tactics-multiple-choice-option-button {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  flex-direction: var(--row-direction-normal);
  flex-wrap: nowrap;
  flex-grow: 1;
  justify-content: flex-start;
  align-self: stretch;
  align-content: stretch;
  border-radius: var(--skin-radius-tight);
  margin-bottom: 6px;
  padding-left: 12px;
  padding-right: 12px;
  padding-bottom: 8px;
  padding-top: 8px;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Tactics multiple choice option button selected.
 * sets the background fill.
 * Source rule 3868.
 */
.tactics-multiple-choice-option-button-selected {
  background-color: var(--colours-tactics-teaminstruction-background);
}

/* Tactics multiple choice option button unselected.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3869.
 */
.tactics-multiple-choice-option-button-unselected,
.tactics-subs-block-cell-unselected {
  border-color: var(--skin-on-media-alpha-16);
}

/* Tactics nav primary actions property 1 base.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3870.
 */
.tactics-nav-primary-actions-property-1-base {
  background-color: var(--skin-tactics-header);
  padding: 8px 4px 8px 8px;
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Tactics nav secondary actions property 1 team shape.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3871.
 */
.tactics-nav-secondary-actions-property-1-team-shape {
  background-color: var(--skin-tactics-surface);
  /* Fill the native fixed-height frame after its ordinary edge is removed;
   * otherwise its bound gradient remains exposed beneath this row. */
  flex-grow: 1;
  padding: var(--numbers-border-radius-extra-small);
  align-items: center;
  align-self: stretch;
  /* The outer gradient frame owns clipping. A second rounded backplate
   * blends its corner pixels with the bound green paint underneath. */
  border-radius: 0;
  flex-direction: var(--row-direction-normal);
}

/* Tactics opposition instruction personalised left.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3872.
 */
.tactics-opposition-instruction-personalised-left {
  height: 24px;
  border-width: 1px;
  border-color: var(--skin-border-default);
  background-color: var(--skin-transparent);
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius-leading-small);
  flex-direction: var(--row-direction-normal);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.tactics-opposition-instruction-personalised-left-active {
  height: 24px;
  border-width: 1px;
  border-color: var(--skin-border-default);
  background-color: var(--skin-selection-background);
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius-leading-small);
  flex-direction: var(--row-direction-normal);
  color: var(--skin-selection-foreground);
}

/* Tactics opposition instruction personalised right.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3874.
 */
.tactics-opposition-instruction-personalised-right {
