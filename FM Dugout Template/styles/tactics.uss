  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
  margin-top: 8px;
}

/* Tactics visualiser pitch default.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element; changes
 * opacity for the whole element and its contents.
