}

/* Tactics pitch widget constraints desktop.
 * controls size/placement.
 * Source rule 3884.
 */
.tactics-pitch-widget-constraints-pc {
  max-height: 482px;
  max-width: 322px;
  min-height: 482px;
  min-width: 322px;
}

/* Tactics pitch widget constraints desktop standard.
 * controls size/placement.
 * Source rule 3885.
 */
.tactics-pitch-widget-constraints-pc-standard:enabled {
  flex-shrink: 1;
  align-self: center;
  max-height: 402px;
  max-width: 277px;
  min-height: 402px;
  min-width: 277px;
}

/* Tactics position details layout.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3886.
 */
.tactics-position-details-layout {
  width: 80px;
  height: 44px;
  border-radius: var(--border-radius-radius-8);
  overflow: hidden;
}

/* FM star rating star.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3887.
 */
.tactics-position-details-layout .fm-star-rating-star {
  -unity-background-scale-mode: scale-to-fit;
  margin-right: -1px;
  max-height: 10px;
  max-width: 10px;
}

/* FM star rating star no margin.
 * controls size/placement.
 * Source rule 3888.
 */
.tactics-position-details-layout .fm-star-rating-star-no-margin {
  -unity-background-scale-mode: scale-to-fit;
  max-height: 10px;
  max-width: 10px;
}

/* Tactics position empty layout.
 * controls size/placement.
 * Source rule 3889.
 */
.tactics-position-empty-layout {
  height: 68px;
  justify-content: flex-end;
}

/* Tactics position layout.
 * controls size/placement.
 * Source rule 3890.
 */
.tactics-position-layout {
  width: 80px;
  height: 70px;
}

/* Unity radio button group child active.
 * sets the background fill; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3891.
 */
/* Instruction options are list choices. A neutral selected surface keeps
 * prose readable; the small marker and edge carry selection, not a Volt row.
 * The explanatory pitch/feedback keeps its separate tactics palette. */
.tactics-radio-buttons .unity-radio-button:hover {
  background-color: var(--skin-control-hover);
  color: var(--skin-choice-foreground);
}

.tactics-radio-buttons .unity-radio-button:active:enabled {
  background-color: var(--skin-control-pressed);
  color: var(--skin-choice-foreground);
}

.tactics-radio-buttons .unity-radio-button:hover .sitext,
.tactics-radio-buttons .unity-radio-button:active:enabled .sitext {
  color: var(--skin-choice-foreground);
}

.tactics-radio-buttons .unity-radio-button:hover .global-text-secondary,
.tactics-radio-buttons .unity-radio-button:active:enabled .global-text-secondary {
  color: var(--skin-text-secondary);
}

.tactics-radio-buttons .unity-radio-button.unity-radio-button-group__child-active {
  border-color: var(--skin-choice-marker);
  background-color: var(--skin-list-selection-background);
  color: var(--skin-choice-foreground);
}

.tactics-radio-buttons .unity-radio-button.unity-radio-button-group__child-active:hover {
  background-color: var(--skin-list-selection-hover);
}

.tactics-radio-buttons .unity-radio-button.unity-radio-button-group__child-active:active:enabled {
  background-color: var(--skin-control-pressed);
}

.tactics-radio-buttons .unity-radio-button.unity-radio-button-group__child-active .sitext {
  color: var(--skin-choice-foreground);
}

.tactics-radio-buttons .unity-radio-button.unity-radio-button-group__child-active .global-text-secondary {
  color: var(--skin-text-secondary);
}

.tactics-radio-buttons .unity-radio-button-group__child-active .unity-radio-button__checkmark {
  background-color: var(--skin-choice-marker);
  border-color: var(--skin-choice-marker);
}

/* Tactics report pitch name.
 * sets font/text presentation.
 * Source rule 3892.
 */
.tactics-report-pitch-name {
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Tactics row highlight highlighted.
 * sets the background fill.
 * Source rule 3893.
 */
.tactics-row-highlight-highlighted {
  background-color: var(--skin-data-tactics-row-highlight-highlighted-background);
}

/* Tactics row highlight sent off.
 * sets the background fill.
 * Source rule 3894.
 */
.tactics-row-highlight-sent-off {
  background-color: var(--skin-data-tactics-row-highlight-sent-off-background);
}

/* Tactics row highlight unavailable.
 * sets the background fill.
 * Source rule 3895.
 */
.tactics-row-highlight-unavailable {
  background-color: var(--skin-data-tactics-row-highlight-unavailable-background);
}

/* Tactics simplified position indicator bottom.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3896.
 */
.tactics-simplified-position-indicator-bottom {
  display: flex;
  width: 45px;
  height: 18px;
  padding: 0 2px 2px 2px;
  border-color: var(--skin-surface-canvas-alpha-20);
  background-color: var(--skin-surface-canvas-alpha-56);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  border-radius: 0 0 var(--skin-radius-control) var(--skin-radius-control);
  border-bottom-width: 1px;
  border-right-width: 1px;
  border-left-width: 1px;
}

/* Tactics simplified position indicator kit.
 * controls size/placement.
 * Source rule 3897.
 */
.tactics-simplified-position-indicator-kit {
  width: 23.699px;
  height: 23px;
  flex-shrink: 0;
}

/* Tactics simplified position indicator top.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 3898.
 */
.tactics-simplified-position-indicator-top {
  display: flex;
  width: 45px;
  height: 14px;
  padding: 0 10px;
  border-color: var(--skin-surface-canvas-alpha-20);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  align-self: stretch;
  border-radius: var(--skin-radius-control) var(--skin-radius-control) 0 0;
  border-top-width: 1px;
  border-right-width: 1px;
  border-left-width: 1px;
}

/* Tactics speak to combo left.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3899.
 */
.tactics-speak-to-combo-left {
  height: 32px;
  margin: var(--margin-leading-extra-small);
  padding: 8px;
  border-width: var(--global-border-width-thin) 0 var(--global-border-width-thin) var(--global-border-width-thin);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  flex-direction: var(--row-direction-normal);
  border-radius: var(--border-radius-leading-small);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons), color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3900.
 */
.tactics-speak-to-combo-right .si-dropdown__selection-field {
  height: 32px;
  margin: var(--margin-trailing-extra-small);
  padding: 2px;
  border-width: var(--global-border-width-thin) var(--global-border-width-thin) var(--global-border-width-thin) 0;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  flex-direction: var(--row-direction-normal);
  border-radius: var(--border-radius-trailing-small);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Tactics split button divider.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3901.
 */
.tactics-split-button-divider {
  margin: 0;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* SI dropdown selection field.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3902.
 */
.tactics-split-button-dropdown-right .si-dropdown__selection-field {
  margin: 0;
  padding: 0;
  align-items: center;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Tactics split button left.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3903.
 */
.tactics-split-button-left {
  margin: 0;
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  background-color: var(--none);
  max-height: 32px;
  flex-grow: 1;
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Scaling icons condition level injured size small 16px.
 * sets the background fill.
 * Source rule 3904.
 */
.tactics-statusicon .scaling-icons-condition-level-injured-size-small-16px {
  background-color: var(--skin-data-tactics-statusicon-scaling-icons-condition-level-injured-size-small-16px-background);
}

/* Scaling icons condition level injured size small 16px.
 * sets the background fill.
 * Source rule 3904.
 */
.tactics-statusicon .game-concepts-abroad-plane_small {
  background-color: var(--skin-data-tactics-statusicon-game-concepts-abroad-plane-small-background);
}

/* Scaling icons condition level injured size small 16px.
 * sets the background fill.
 * Source rule 3904.
 */
.tactics-statusicon .game-concepts-red-card_small {
  background-color: var(--skin-data-tactics-statusicon-game-concepts-red-card-small-background);
}

/* Scaling icons condition level injured size small 16px.
 * sets the background fill.
 * Source rule 3904.
 */
.tactics-statusicon .restricted-low {
  background-color: var(--skin-data-tactics-statusicon-restricted-low-background);
}

/* Tactics statusicon container.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3905.
 */
.tactics-statusicon_container {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: var(--skin-radius-control);
  left: 32px;
  right: 32px;
  bottom: 0;
  top: 12px;
  overflow: hidden;
}

/* Tactics subs block.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3906.
 */
.tactics-subs-block {
  padding: var(--global-padding-large);
  border-width: 2px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-data-tactics-subs-block-background);
  align-self: stretch;
  border-radius: var(--skin-radius-control);
}

/* Tactics subs block cell.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3907.
 */
.tactics-subs-block-cell {
  height: 24px;
  border-width: 1.5px;
  padding-top: var(--global-padding-small);
  padding-right: var(--global-padding-small);
  padding-bottom: var(--global-padding-small);
  padding-left: var(--global-padding-small);
  align-items: center;
  border-radius: var(--skin-radius-small);
  flex-direction: var(--row-direction-always-normal);
}

/* Tactics subs block cell fmc.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3908.
 */
.tactics-subs-block-cell-fmc {
  height: 36px;
