  background-color: var(--skin-transparent);
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius-trailing-small);
  flex-direction: var(--row-direction-normal);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.tactics-opposition-instruction-personalised-right-active {
  height: 24px;
  border-width: 1px;
  border-color: var(--skin-border-default);
  background-color: var(--skin-selection-background);
  justify-content: center;
  align-items: center;
  border-radius: var(--border-radius-trailing-small);
  flex-direction: var(--row-direction-normal);
