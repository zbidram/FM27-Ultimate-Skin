/* Tactics
 * Native tactics selectors, with adjacent shared rules in source order.
 */

/* Tactical effectiveness breakdown advice colour positive.
 * sets the background fill.
 * Source rule 4763.
 */
.tactical-effectiveness-breakdown-advice-colour-positive {
  background-color: var(--colours-base-green-base-16);
}

/* Sitext.
 * Changes text/foreground colour.
 * Source rule 4764.
 */
.tactical-effectiveness-breakdown-advice-colour-positive .sitext {
  color: var(--colours-base-green-soft);
}

/* Tactical effectiveness breakdown advice colour negative.
 * sets the background fill.
 * Source rule 4765.
 */
.tactical-effectiveness-breakdown-advice-colour-negative {
  background-color: var(--colours-base-red-base-16);
}

/* Sitext.
 * Changes text/foreground colour.
 * Source rule 4766.
 */
.tactical-effectiveness-breakdown-advice-colour-negative .sitext {
  color: var(--colours-base-red-soft);
}

/* All five report feedback lanes share this authored advice card. Keep its
 * fixed height, horizontal gutters and 32px action; reclaim only vertical
 * inset for wrapped feedback at the chosen body face. Runtime fit is audited
 * separately from the native/current allocation trace. */
#ReportBody #BreakdownContent .tactical-effectiveness-breakdown .te-advice-property-1 {
  padding-top: var(--skin-tactics-feedback-padding-y);
  padding-bottom: var(--skin-tactics-feedback-padding-y);
}

/* Tactical effectiveness 1.
 * sets the background fill.
 * Source rule 4767.
 */
.tactical-effectiveness-1 {
  background-color: var(--colours-data-linear-scale-strong-ondark-1);
}

/* Tactical effectiveness 2.
 * sets the background fill.
 * Source rule 4768.
 */
.tactical-effectiveness-2 {
  background-color: var(--colours-data-linear-scale-strong-ondark-2);
}

/* Tactical effectiveness 3.
 * sets the background fill.
 * Source rule 4769.
 */
.tactical-effectiveness-3 {
  background-color: var(--colours-data-linear-scale-strong-ondark-3);
}

/* Tactical effectiveness 4.
 * sets the background fill.
 * Source rule 4770.
 */
