}

/* Tactics tile 4x4.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3919.
 */
.tactics-tile-4x4 {
  margin-bottom: 8px;
  padding-bottom: 0;
  margin-top: 24px;
  max-height: 200px;
  overflow: visible;
  padding-top: 0;
}

/* Tactics visualiser ball.
 * controls size/placement.
