/* Typography
 * Native text families, weights and sizes. Asset-backed families require the native font resources.
 */

/* Body language morph label.
 * changes opacity for the whole element and its contents.
 * Shared rule for 10 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1246.
 */
.body-language-changed .body-language-morph-label,
.ios-navigation-tab-property-1-default--selected > #text,
.ui-concepts-object-preview_small:hover,
.ui-concepts-object-preview_small:active:enabled,
.match-focus-available,
.menu-element--selected .main-menu-navigation-default:hover .navigation-tab-dropdown,
.navigation-tab-portal-default-active-false:hover .portal-text,
.player-attribute-line-chart-color-point:hover:enabled,
.navigation-tab-portal-default-active-true .navigation-chip,
.object-preview-hover-hotspot:hover .ui-concepts-object-preview_small {
  opacity: 1;
}

/* Body language complacent background colour.
 * sets the background fill.
 * Source rule 1247.
 */
.body-language-complacent-background-colour {
  background-color: var(--colours-base-purple-deep);
}

/* Body language morph label.
 * controls size/placement; defines how state changes animate; changes opacity for the whole element and its
 * contents.
 * Source rule 1248.
 */
.body-language-morph-label {
  position: absolute;
  opacity: 0;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  align-items: center;
  justify-content: center;
  transition-property: opacity;
  transition-duration: 0.3s;
  transition-timing-function: ease-in-out;
}

/* Body language morph rest.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Source rule 1249.
 */
.body-language-morph-rest {
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.3s;
  transition-timing-function: ease-in-out;
}

/* Body language negative background colour.
 * sets the background fill.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1250.
 */
.body-language-negative-background-colour,
.body-language-slightly-negative-background-colour,
.emoticon-background-colour-neutral-negative,
.grades-background-colour-disappointed {
  background-color: var(--theme-color-orange-soft-surface);
}

/* Body language neutral background colour.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1251.
 */
.body-language-neutral-background-colour,
.nav-on-light .calendar-widget-time-container {
  background-color: var(--colours-base-neutral-black);
}

/* Body language none background colour.
 * sets the background fill.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1252.
 */
.body-language-none-background-colour,
.body-language-mixed-background-colour,
.emoticon-background-colour-neutral,
.calendar-day-future.portal-messages-item-default-style-unread-property-1-message-property-2-default:hover {
  background-color: var(--skin-surface-panel);
}

/* Body language positive text colour.
 * Changes text/foreground colour.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1253.
 */
.body-language-positive-text-colour,
.emoticon-text-colour-slightly-positive,
.team-comparison-rating-above-average-text,
.transfer-interest-rating-label-very-interested {
  color: var(--theme-color-lime-soft-soft);
}

/* Body language sad background colour.
 * sets the background fill.
 * Source rule 1254.
 */
.body-language-sad-background-colour {
  background-color: var(--colours-base-blue-deep);
}

/* Body language slightly positive background colour.
 * sets the background fill.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1255.
 */
.body-language-slightly-positive-background-colour,
.emoticon-background-colour-slightly-positive,
.team-comparison-rating-average,
.emoticon-background-colour-positive-neutral {
  background-color: var(--status-linear-5-values-soft-3);
}

/* Body language slightly positive text colour.
 * Changes text/foreground colour.
 * Shared rule for 8 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1256.
 */
.body-language-slightly-positive-text-colour,
.player-injury-cell-recurring-injury .sitext,
.club-vision-text-colour-progress,
.injury-severity-text-colour-recurring,
.player-interest-purple,
.relationship-with-you-text-colour-neutral,
.happiness-content-text-colour,
.tactical-effectiveness-provisional-score-text {
  color: var(--colours-base-purple-soft);
}

/* Body language very negative background colour.
 * sets the background fill.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1257.
 */
.body-language-very-negative-background-colour,
.injury-risk-background-colour-very-high,
.team-comparison-rating-worst,
.match-outcome-chip-defeat {
  background-color: var(--theme-color-red-soft-surface);
}

/* Body language very negative text colour.
 * Changes text/foreground colour.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1258.
 */
.body-language-very-negative-text-colour,
.injury-risk-text-colour-very-high,
.relationship-with-you-text-colour-rival,
.team-comparison-rating-worst-text,
.transfer-interest-rating-label-prefers-stay,
.theme-color-red-soft-soft {
  color: var(--theme-color-red-soft-soft);
}

/* Body language very positive background colour.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1259.
 */
.body-language-very-positive-background-colour,
.team-comparison-rating-best {
  color: var(--theme-color-green-soft-surface);
}

/* Body language very positive text colour.
 * Changes text/foreground colour.
 * Shared rule for 7 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1260.
 */
.body-language-very-positive-text-colour,
.emoticon-text-colour-positive,
.team-comparison-rating-best-text,
.transfer-interest-rating-label-extremely-interested,
.data_knowledge_level_8_exceptional,
.theme-color-green-soft-soft {
  color: var(--theme-color-green-soft-soft);
}

/* Typography
 * Native text families, weights and sizes. Asset-backed families require the native font resources.
 */

/* Tifo dm.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4081.
 */
.tifo-dm {
  width: 100%;
  margin-top: var(--global-gap-regular);
  margin-bottom: var(--global-gap-regular);
}

/* Tifo dm l.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4082.
 */
.tifo-dm-l {
  width: 100%;
  margin-top: var(--global-gap-distant);
  margin-bottom: var(--global-gap-distant);
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4083.
 */
.tifo-dropdown-noborder .si-dropdown__selection-field {
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 0;
  border-color: var(--skin-border-subtle);
  color: var(--skin-text-primary);
  max-height: 32px;
  align-items: center;
  border-radius: 0;
  flex-direction: var(--row-direction-normal);
  min-height: 32px;
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 4087.
 */
.tifo-dropdown-nopadding .si-dropdown__selection-field {
  padding: 0;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  min-height: 32px;
  max-height: 32px;
  align-items: center;
  border-radius: var(--spacing-small---8);
  flex-direction: var(--row-direction-normal);
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4088.
 */
.tifo-dropdown-secondary .si-dropdown__selection-field,
.manager-creation-dropdown-secondary .si-dropdown__selection-field {
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-default);
  color: var(--skin-text-primary);
  max-height: 32px;
  align-items: center;
  border-radius: var(--spacing-small---8);
  flex-direction: var(--row-direction-normal);
  min-height: 32px;
}

/* Tifo icon brand horizon.
 * tints background artwork.
 * Source rule 4089.
 */
.tifo-icon-brand-horizon {
  -unity-background-image-tint-color: var(--colours-feature-draft-shortlist-base);
}

/* Tifo scale 080.
 * sets the native component presentation.
 * Source rule 4090.
 */
.tifo-scale-080 {
  scale: 0.8 0.8 1;
}

/* Tile 4x2 height.
 * controls size/placement.
 * Source rule 4091.
 */
.tile-4x2-height {
  min-height: 148px;
}

/* Tile background gradient to transparent.
 * sets the gradient colours drawn by this component.
 * Source rule 4092.
 */
.tile-background-gradient--to-transparent {
  --start-colour: var(--skin-surface-panel);
  --end-colour: var(--none);
}

/* Tile hierarchy squad 2x4 custom numbers on right.
 * controls size/placement.
 * Source rule 4093.
 */
.tile-hierarchy-squad-2x4--custom-numbers-on-right {
  flex-grow: 1;
  align-items: center;
  align-self: center;
  align-content: auto;
  flex-wrap: nowrap;
  flex-direction: var(--row-direction-normal);
}

/* Tile mockups navigation core primary hi res.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4094.
 */
.tile-mockups-navigation-core-primary-hi-res {
  width: 100%;
  min-height: 54px;
  max-height: 54px;
  padding-right: var(--global-padding-regular);
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* News page section headings use thematic-md without the tile-title hook.
 * Match the established Portal section face without changing nav/data labels.
 */
#ReportBody #ForYou > .sitext.thematic-md,
#ReportBody #AroundTheWorld > .sitext.thematic-md,
#ReportBody #TransferNews > .sitext.thematic-md,
#ReportBody .news-story-block-header-foreground-content-area > .buttons-button-tertiary-default .thematic-md,
#ReportBody .news-sub-content-block > .buttons-button-tertiary-default .thematic-md {
  -unity-font-definition: var(--skin-font-section-heading);
  -unity-font-style: var(--skin-font-section-heading-weight);
}

/* Competition overview links are section headings, not navigation/body copy. */
#ReportBody #LeagueTable > .buttons-button-tertiary-default .thematic-md,
#ReportBody #PlayerStats > .buttons-button-tertiary-default .thematic-md,
#ReportBody #TeamStatsVar > .buttons-button-tertiary-default .thematic-md,
#ReportBody #CompNews > .buttons-button-tertiary-default .thematic-md {
  -unity-font-definition: var(--skin-font-section-heading);
  -unity-font-style: var(--skin-font-section-heading-weight);
}

/* Club Info's green thematic labels are section headings, not action/status
 * indicators. Match the common section face and primary foreground. */
#ReportBody #ClubInfo .sitext.thematic-md.brand-foundation-horizon-color {
  color: var(--skin-text-primary);
  -unity-font-definition: var(--skin-font-section-heading);
  -unity-font-style: var(--skin-font-section-heading-weight);
}
