  -unity-font-style: var(--typography-weight-bold);
  white-space: normal;
  -unity-font-definition: var(--body-md-family);
  -unity-text-align: middle-left;
}

/* Content ellipsis.
 * sets font/text presentation.
 * Shared rule for 11 selectors. Editing a declaration here affects the whole group below.
 * Source rule 815.
 */
.tifo-p.content-ellipsis,
.tifo-ph.content-ellipsis,
.tifo-h.content-ellipsis,
.tifo-hp.content-ellipsis,
.match-simulation-player-10px-bold.content-ellipsis,
.body-regular-14px-regular.content-ellipsis,
.body-regular-13px-regular.content-ellipsis,
.body-small-12px-regular.content-ellipsis,
.heading-small-14px.content-ellipsis,
.heading-small-12px.content-ellipsis,
.heading-regular-16p.content-ellipsisx {
  white-space: nowrap;
}

