/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Typography
 * Native text families, weights and sizes. Asset-backed families require the native font resources.
 */

/* Body regular 13px regular.
 * sets font/text presentation.
 * Source rule 736.
 */
.body-regular-13px-regular {
  font-size: var(--typography-size-13);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-left;
}

/* Body small.
 * sets font/text presentation.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 737.
 */
.body-sm,
.body-sm-regular,
.body-regular-12px-regular,
.body-small-12px-regular,
.tactics-advice-dropdown .sitext {
  font-size: var(--body-sm-size);
  white-space: normal;
  -unity-font-definition: var(--body-sm-family);
  -unity-text-align: middle-left;
}

/* Body small strong.
 * sets font/text presentation.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 738.
 */
.body-sm-strong,
.body-regular-12px-bold,
.body-small-12px-bold {
  font-size: var(--body-sm-size);
  white-space: normal;
  -unity-font-definition: var(--body-sm-family);
  -unity-text-align: middle-left;
  -unity-font-style: var(--typography-weight-bold);
}

/* Heading small.
 * sets font/text presentation.
 * Source rule 739.
 */
.heading-sm {
  font-size: var(--heading-sm-size);
  white-space: normal;
  -unity-font-style: var(--heading-sm-weight);
  -unity-font-definition: var(--heading-sm-family);
  -unity-text-align: middle-left;
}

/* Heading medium.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 740.
 */
.heading-md,
.heading-small-16px {
  font-size: var(--heading-md-size);
  white-space: normal;
  -unity-font-style: var(--heading-md-weight);
  -unity-font-definition: var(--heading-md-family);
  -unity-text-align: middle-left;
}

/* Heading large.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 741.
 */
.heading-lg,
.heading-regular-18px {
  font-size: var(--heading-lg-size);
  white-space: normal;
  -unity-font-definition: var(--heading-lg-family);
  -unity-text-align: middle-left;
  -unity-font-style: var(--heading-lg-weight);
}

/* Heading extra large.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 742.
 */
.heading-xl,
.heading-large-22px {
  font-size: var(--heading-xl-size);
  white-space: normal;
  -unity-font-definition: var(--heading-xl-family);
  -unity-text-align: middle-left;
  -unity-font-style: var(--heading-xl-weight);
}

/* Heading xxl.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 743.
 */
.heading-xxl,
.heading-xlarge-30px {
  font-size: var(--heading-xxl-size);
  -unity-font-definition: var(--heading-xxl-family);
  -unity-font-style: var(--heading-xxl-weight);
}

/* Body large 16px regular.
 * sets font/text presentation.
 * Source rule 744.
 */
.body-large-16px-regular {
  font-size: var(--heading-md-size);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-left;
}

/* Body large 16px bold.
 * Uses the mapped FM medium-heading family and weight; keep the size role unchanged.
 * Source rule 745.
 */
.body-large-16px-bold {
  font-size: var(--heading-md-size);
  white-space: normal;
  -unity-font-definition: var(--heading-md-family);
  -unity-font-style: var(--heading-md-weight);
  -unity-text-align: middle-left;
}

/* Text middle center.
 * sets font/text presentation.
 * Source rule 746.
 */
.text-middle-center {
  -unity-text-align: middle-center;
}

/* Text right.
 * sets font/text presentation.
 * Source rule 747.
 */
.body-small-12px-regular.text-right {
  -unity-text-align: middle-right;
}

/* Tactics overlay text container.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 748.
 */
.tactics-overlay-text-container {
  height: 70px;
  margin-top: 16px;
  padding-top: 24px;
}

/* Heading small 12px.
 * sets font/text presentation.
 * Source rule 749.
 */
.heading-small-12px {
  font-size: var(--body-sm-size);
  white-space: normal;
  -unity-font-definition: var(--body-md-family);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-left;
}

/* Body medium strong.
 * sets font/text presentation.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 750.
 */
.body-md-strong,
.body-regular-14px-bold,
.heading-small-14px,
.heading-xsmall-14px {
  font-size: var(--body-md-size);
  white-space: normal;
  -unity-font-definition: var(--body-md-family);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-left;
}

/* Body extra small strong.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 751.
 */
.body-xs-strong,
.body-xsmall-10px-bold {
  font-size: var(--body-xs-size);
  white-space: normal;
  -unity-font-definition: var(--body-xs-family);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-left;
}

/* Typography
 * Native text families, weights and sizes. Asset-backed families require the native font resources.
