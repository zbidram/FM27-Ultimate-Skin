  --interaction-tactics-surface-default: var(--colours-feature-tactics-base-40);
  --interaction-tactics-surface-disabled: var(--skin-surface-canvas);
  --interaction-tactics-surface-hover: var(--colours-feature-tactics-base-20);
  --interaction-global-color-aa-contrast: var(--skin-text-secondary);
  --interaction-global-radius-lg: var(--skin-radius-card);
  --interaction-global-radius-md: var(--skin-radius-control);
  --interaction-global-radius-sm: var(--skin-radius-tight);
  --interaction-global-height-xxl: var(--width-height-64);
  --interaction-global-height-xl: var(--width-height-48);
  --interaction-global-height-lg: var(--width-height-40);
  --interaction-global-height-md: var(--width-height-32);
  --interaction-global-height-sm: var(--width-height-24);
  --interaction-global-height-xs: var(--width-height-20);
  --interaction-base-height-md-max-height-regular: 18px;
  --interaction-base-surface-icon-surface: var(--skin-surface-panel);
  --interaction-base-surface-icon-surface-hover: var(--colours-brand-tints-horizon-alpha-20);
  --interaction-global-padding-horizontal-lg: var(--padding-padding-12);
  --interaction-global-padding-horizontal-md: var(--padding-padding-8);
  --interaction-global-padding-horizontal-sm: var(--padding-padding-4);
  --interaction-global-padding-horizontal-xs: var(--padding-padding-2);
  --interaction-global-padding-vertical: var(--padding-padding-0);
  --interaction-global-text-base: var(--skin-text-primary);
  --interaction-global-text-soft: var(--skin-text-secondary);
  --interaction-global-text-disabled: var(--skin-text-disabled);
}

/* FM global-colour contract adapter.
 * Core text, icon, background and border roles point to skin-tokens.uss.
 * Game-specific gender, status and competition roles keep their own semantics.
 */
:root {
  --global-surface-icon-standard: var(--skin-text-primary);
  --global-surface-icon-alternate: var(--skin-brand-on-primary);
  --global-border-focus-regular: var(--border-width-border-width-2);
  --global-border-focus-thick: var(--border-width-border-width-4);
  --global-text-primary-alt: var(--skin-brand-on-primary);
  --global-text-primary-mens: var(--skin-native-global-text-primary-mens);
  --global-text-primary-womens: var(--skin-native-global-text-primary-womens);
  --global-text-secondary-mens: var(--skin-native-global-text-secondary-mens);
  --global-text-secondary-womens: var(--skin-native-global-text-secondary-womens);
  --global-background: var(--skin-surface-page);
  --global-border-color: var(--skin-border-subtle);
  --global-border-width-thick: var(--border-width-border-width-2);
  --global-border-width-regular: var(--border-width-border-width-1);
  --global-border-width-medium-thin: var(--border-width-border-width-1-5);
  --global-border-width-thin: var(--border-width-border-width-1);
  --global-border-width-tile-card: var(--border-width-border-width-0-5);
  --global-border-width-none: 0;
  --global-height-large: var(--height-height-40);
  --global-height-regular: var(--height-height-32);
  --global-height-small: var(--height-height-24);
  --global-border-focus: var(--border-width-border-width-2);
  --global-gap-extra-huge: var(--gap-gap-64);
  --global-gap-huge: var(--gap-gap-48);
  --global-gap-spacious: var(--gap-gap-32);
  --global-gap-generous: var(--gap-gap-24);
  --global-gap-seperation: var(--gap-gap-16);
  --global-gap-distant: var(--gap-gap-12);
  --global-gap-regular: var(--gap-gap-8);
  --global-gap-close: var(--gap-gap-4);
  --global-gap-micro: var(--gap-gap-2);
  --global-gap-none: var(--gap-gap-0);
  --global-padding-tile-padding: var(--padding-padding-12);
  --global-padding-preferences-tabs: var(--padding-padding-16);
  --global-padding-new-ex: 6px;
  --global-padding-standard-padding-y: var(--padding-padding-8);
  --global-padding-extra-huge: var(--padding-padding-64);
  --global-padding-huge: var(--padding-padding-32);
  --global-padding-extra-extra-large: var(--padding-padding-24);
  --global-padding-extra-large: var(--padding-padding-12);
  --global-padding-large: var(--padding-padding-8);
  --global-padding-regular: var(--padding-padding-8);
  --global-padding-small: var(--padding-padding-4);
  --global-padding-extra-small: var(--padding-padding-2);
  --global-padding-none: var(--padding-padding-0);
  --global-radius-large: var(--border-radius-radius-12);
  --global-radius-regular: var(--border-radius-radius-8);
  --global-radius-small: var(--border-radius-radius-4);
  --global-radius-extra-small: var(--border-radius-radius-2);
  --global-radius-none: var(--border-radius-radius-0);
  --global-icon-surface: var(--colours-ui-text-strong);
  --global-icon-surface-alt: var(--colours-ui-deep);
  --global-icon-surface-transparency: var(--skin-text-disabled);
  --global-text-primary: var(--skin-text-primary);
  --global-text-secondary: var(--skin-text-secondary);
  --global-text-men-primary: var(--skin-native-global-text-men-primary);
  --global-text-men-secondary: var(--skin-native-global-text-men-secondary);
  --global-text-women-primary: var(--colours-base-teal-soft);
  --global-text-women-secondary: var(--skin-native-global-text-women-secondary);
  --global-transition-long: var(--transition-03);
  --global-transition-medium: var(--transition-025);
  --global-transition-short: var(--transition-01);
  --global-transition-buttons: var(--transition-snappy);
  --global-transition-animation-buttons: var(--transition-ease-out);
  --global-lift-surface-soft: var(--colours-ui-soft);
  --global-lift-surface-base: var(--colours-ui-soft);
  --global-lift-surface-strong: var(--colours-ui-strong);
  --global-sink-surface-soft: var(--colours-ui-deep);
  --global-sink-surface-base: var(--colours-ui-deep);
  --global-sink-surface-strong: var(--colours-ui-deep);
  --global-border-thick: var(--border-width-border-width-2);
  --global-border-regular: var(--border-width-border-width-1);
  --global-gap-extra-large: var(--gap-gap-16);
  --global-gap-large: var(--gap-gap-12);
  --global-gap-small: var(--gap-gap-4);
}

/* Shared variables for other match.
 * Change the value directly below each note. Names are native game contracts.
 */
:root {
  --match-simulation-2d-squad-expanded-inset: 160px;
}

/* Shared variables for cursors motion.
 * Change the value directly below each note. Names are native game contracts.
 */
:root {
  --cursor-default-1x-hotspot-x: 12;
  --cursor-default-1x-hotspot-y: 4;
  --cursor-clickable-1x-hotspot-x: 12;
  --cursor-clickable-1x-hotspot-y: 4;
  --cursor-size-left-right-1x-hotspot-x: 15;
  --cursor-size-left-right-1x-hotspot-y: 8;
  --cursor-size-top-buttom-1x-hotspot-x: 11;
  --cursor-size-top-buttom-1x-hotspot-y: 12;
  --transition-03: 0.3s;
  --transition-025: 0.25s;
  --transition-02: 0.2s;
  --transition-018: 0.18s;
  --transition-015: 0.15s;
  --transition-01: 0.1s;
  --transition-ease-out: ease-out;
  --transition-slow: var(--transition-03);
  --transition-normal: var(--transition-025);
  --transition-snappy: var(--transition-01);
  --transition-cb-ui: var(--transition-ease-out);
  --transition-props-paint: color, background-color, border-color, border-top-color, border-right-color, border-bottom-color, border-left-color, border-radius, border-top-left-radius, border-top-right-radius, border-bottom-left-radius, border-bottom-right-radius, -unity-background-image-tint-color, -unity-text-outline-color, opacity, scale, rotate, translate;
  --transition-props-continuous: color, background-color, border-color, border-top-color, border-right-color, border-bottom-color, border-left-color, border-radius, border-top-left-radius, border-top-right-radius, border-bottom-left-radius, border-bottom-right-radius, -unity-background-image-tint-color, -unity-text-outline-color, opacity, scale, rotate, translate, width, height, min-width, min-height, max-width, max-height, top, right, bottom, left, margin, margin-top, margin-right, margin-bottom, margin-left, padding, padding-top, padding-right, padding-bottom, padding-left, border-width, border-top-width, border-right-width, border-bottom-width, border-left-width, flex-grow, flex-shrink, flex-basis, font-size, letter-spacing, word-spacing, -unity-paragraph-spacing;
}

/* Shared variables for calendar.
 * Change the value directly below each note. Names are native game contracts.
 */
:root {
  --calendar-surface-future: var(--skin-on-media-alpha-08);
  --calendar-surface-past: var(--skin-surface-canvas-alpha-56);
  --calendar-surface-present: var(--skin-brand-accent-alpha-20);
}

/* FM typography contract adapter.
 * Font families, supported styles and the full typography size scale are editable
 * in theme.uss / styles/fm-defaults.uss; this sheet maps FM contracts back to those roles.
 */
:root {
  /* Keep FM's original primary/thematic/condensed FontAssets externally owned.
   * The skin's own typography roles above use its selected family directly;
   * native scoreboards can therefore retain their original font resources. */
  --typography-weight-regular: var(--skin-font-weight-regular);
  --typography-weight-bold: var(--skin-font-weight-bold);
  --typography-weight-italic: var(--skin-font-weight-italic);
  --typography-size-10: var(--skin-font-size-10);
  --typography-size-12: var(--skin-font-size-12);
  --typography-size-13: var(--skin-font-size-13);
  --typography-size-14: var(--skin-font-size-14);
  --typography-size-15: var(--skin-font-size-15);
  --typography-size-16: var(--skin-font-size-16);
  --typography-size-18: var(--skin-font-size-18);
  --typography-size-20: var(--skin-font-size-20);
  --typography-size-22: var(--skin-font-size-22);
  --typography-size-24: var(--skin-font-size-24);
  --typography-size-30: var(--skin-font-size-30);
  --typography-size-40: var(--skin-font-size-40);
  --typography-size-7: var(--skin-font-size-7);
  --typography-size-8: var(--skin-font-size-8);
  --typography-size-9: var(--skin-font-size-9);
  --typography-size-26: var(--skin-font-size-26);
  --typography-size-32: var(--skin-font-size-32);
  --typography-size-36: var(--skin-font-size-36);
  --typography-size-50: var(--skin-font-size-50);
  --typography-size-56: var(--skin-font-size-56);
  --typography-size-64: var(--skin-font-size-64);
  --typography-size-70: var(--skin-font-size-70);
  --typography-size-128: var(--skin-font-size-128);
  --typography-size-132: var(--skin-font-size-132);
  --typography-size-240: var(--skin-font-size-240);
  --typography-size-6: var(--skin-font-size-6);
  --typography-size-11: var(--skin-font-size-11);
  --typography-size-19: var(--skin-font-size-19);
  --typography-size-377: var(--skin-font-size-377);
}

/* Shared variables for other native.
 * Change the value directly below each note. Names are native game contracts.
 */
:root {
  --list-item-margin-bottom: var(--numbers-border-radius-medium);
