/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* FM semantic colour contract adapters.
 * Actual Football Manager-specific palette values live in theme.uss / styles/fm-defaults.uss.
 * Keep these native-facing names mapped so components preserve their semantic contracts.
 */
:root {
  --skin-component-fm-news-label-foreground: var(--skin-semantic-component-fm-news-label-foreground);
  /* General interface copy/selection follows the theme. Native
   * cyan/red and purple fallbacks remain archived in fm-defaults.uss only;
   * error/status classes keep their separate football/feedback contracts. */
