  margin-left: 8px;
  margin-right: 8px;
  margin-top: 8px;
  margin-bottom: 8px;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
}

/* Sitabheader open.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 228.
 */
.sitabheader__open {
  background-color: var(--skin-transparent);
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  border-left-color: var(--skin-on-media-alpha-25);
  border-right-color: var(--skin-on-media-alpha-25);
  border-top-color: var(--skin-on-media-alpha-25);
  border-bottom-color: var(--skin-on-media-alpha-25);
  border-right-width: 2px;
}

/* Sitabheader closed.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 229.
 */
.sitabheader__closed {
  background-color: var(--skin-transparent);
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  border-left-color: var(--skin-on-media-alpha-25);
  border-right-color: var(--skin-on-media-alpha-25);
  border-top-color: var(--skin-on-media-alpha-25);
  border-bottom-color: var(--skin-on-media-alpha-25);
  border-right-width: 2px;
  border-bottom-width: 2px;
}

/* Sitimeline markersroot.
 * controls size/placement.
 * Source rule 230.
 */
.sitimeline-markersroot {
  position: absolute;
  width: 100%;
  height: 100%;
  translate: 0 0;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  flex-direction: var(--row-direction-normal);
  align-self: center;
}

/* Sitimelinemarker markerup.
 * controls size/placement.
 * Source rule 231.
 */
.sitimelinemarker-markerup {
  scale: 1 -1;
  align-self: center;
  translate: -50% -25%;
}

/* Sitimelinemarker markerdown.
 * controls size/placement.
 * Source rule 232.
 */
.sitimelinemarker-markerdown {
  scale: 1 1;
  align-self: center;
  translate: -50% 25%;
}

/* Sitimelinemarker.
 * controls size/placement.
 * Source rule 233.
 */
.sitimelinemarker {
  position: absolute;
  width: 12px;
  height: 22px;
  flex-shrink: 0;
  align-self: center;
}

/* Sitimeline dragger.
 * controls size/placement.
 * Source rule 234.
 */
.sitimeline-dragger {
  width: 4px;
}

/* Sipreferencesbox.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 235.
 */
.sipreferencesbox {
  background-color: var(--skin-on-media-alpha-11);
  flex-grow: 1;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 8px;
  padding-bottom: 8px;
  border-top-left-radius: var(--skin-radius-control);
  border-bottom-left-radius: var(--skin-radius-control);
  border-top-right-radius: var(--skin-radius-control);
  border-bottom-right-radius: var(--skin-radius-control);
  margin-bottom: 4px;
}

/* Sipreferencessubtitle.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 236.
 */
.sipreferencessubtitle {
  color: var(--skin-component-sipreferencessubtitle-foreground);
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-regular);
  margin-bottom: 8px;
  margin-top: 8px;
}

/* Sipreferencestab.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 237.
 */
.sipreferencestab {
  height: 38px;
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  -unity-font-style: var(--typography-weight-regular);
  justify-content: center;
  margin-left: 0;
  margin-right: 0;
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
  -unity-font-definition: var(--skin-font-body);
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 4px;
}

/* Sipreferencestab selected.
 * sets the background artwork.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 238.
 */
.sipreferencestab--selected {
  -unity-slice-left: 19;
  -unity-slice-top: 0;
  -unity-slice-right: 19;
  -unity-slice-bottom: 0;
  -unity-slice-scale: 0.1px;
  -unity-background-scale-mode: stretch-to-fill;
}

/* Sicharttextsmall.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 239.
 */
.sicharttextsmall {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-8);
  -unity-font-style: var(--typography-weight-regular);
  -unity-font-definition: var(--skin-font-body);
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
  padding-bottom: 0;
  white-space: nowrap;
  -unity-text-align: middle-center;
  align-items: auto;
  align-self: center;
  justify-content: flex-start;
  text-overflow: clip;
}

/* FM finance chart.
 * controls size/placement.
 * Source rule 240.
 */
.silinechart.fm-finance-chart {
  height: 133px;
  --line-width: 2;
  --line-colour: var(--skin-brand-accent);
