  margin-right: 2px;
}

/* Setup game list title.
 * sets font/text presentation; controls size/placement.
 * Source rule 309.
 */
.setup_game_list_title {
  white-space: normal;
  flex-basis: 5%;
}

/* Setup game list body.
 * controls size/placement; sets spacing around/inside the element.
