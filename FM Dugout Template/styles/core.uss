/* Panel fade.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 555.
 */
.panel--open .panel-fade,
.panel--show .panel-fade,
.panel--open .sipopup-container,
.panel--show .sipopup-container {
  opacity: 1;
  transition-property: opacity;
