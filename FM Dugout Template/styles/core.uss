  flex-shrink: 0;
}

/* Quick flick button extra small.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 5076.
 */
.quick-flick-button-extra-small {
  opacity: 0.75;
  width: 14px;
  height: 11px;
  margin: 0;
  padding: 0;
  border-width: 0;
  background-color: var(--skin-surface-panel);
  border-radius: var(--border-radius-radius-2);
  flex-shrink: 0;
}

/* Quick flick margin adjustment.
 * sets spacing around/inside the element.
 * Source rule 5077.
 */
.quick-flick-button-extra-small.quick-flick-margin-adjustment {
  margin-bottom: 2px;
}

/* Quick flick button extra small — pointer hover.
 * sets the background fill.
 * Source rule 5078.
 */
.quick-flick-button-extra-small:hover {
  background-color: var(--skin-surface-raised);
}

/* UI concepts chevron top small.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5079.
 */
.quick-flick-button-extra-small > .ui-concepts-chevron-top_small,
.quick-flick-button-extra-small > .ui-concepts-chevron-down_small {
  width: 8px;
  height: 8px;
}

/* No icon.
 * Hides these elements.
 * Source rule 5080.
 */
.no-icon {
  display: none;
}

/* Sliding content.
 * controls size/placement.
 * Source rule 5081.
 */
.sliding-content {
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
}

/* Club selection button size.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 5082.
 */
.club-selection-button-size {
  flex-grow: 1;
  align-self: stretch;
  margin-right: var(--global-gap-large);
}

/* Club selection button size large.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 5083.
 */
.club-selection-button-size-large {
  flex-grow: 1;
  align-self: stretch;
  margin-right: var(--global-gap-large);
}

/* Selected shortcut.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 5084.
 */
.selected-shortcut {
  margin: 2px 4px;
  padding: 6px 12px;
  border-top-color: var(--skin-on-media-alpha-35);
  border-bottom-color: var(--skin-on-media-alpha-35);
  border-right-color: var(--skin-on-media-alpha-35);
  border-left-color: var(--skin-on-media-alpha-35);
  border-radius: var(--skin-radius-control);
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  flex-grow: 1;
  flex-shrink: 0;
}

/* Vertical radio group.
 * controls size/placement.
 * Source rule 5085.
 */
.vertical-radio-group {
  flex-direction: column;
}

/* Buttongroup button.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5086.
 */
.vertical-radio-group .buttongroup__button,
.vertical-radio-group.Default .buttongroup__button {
  padding-top: 0;
}

/* Buttongroup button active.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5087.
 */
.vertical-radio-group .buttongroup__button--active,
.vertical-radio-group.Default .buttongroup__button--active {
  border-width: 0;
  padding-top: 0;
}

/* Navigation tab portal default active false.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5088.
 */
.navigation-tab-portal-default-active-false,
.navigation-tab-portal-default-active-true {
  border-width: 0;
}

/* Pitch positions background.
 * sets the background fill; sets the background artwork; sets the outline/corner shape; controls
 * size/placement.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 5089.
 */
.pitch-positions-background {
  background-color: var(--colours-base-teal-deep);
  justify-content: space-between;
  flex-grow: 1;
  border-top-left-radius: 20%;
  border-bottom-left-radius: 20%;
  border-top-right-radius: 20%;
  border-bottom-right-radius: 20%;
}

/* FMPitch Position Tagged Element.
 * sets the background fill; sets the background artwork; tints background artwork; controls size/placement.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 5090.
 */
FMPitchPositionTaggedElement {
  background-color: var(--none);
  flex-grow: 1;
  -unity-background-image-tint-color: var(--colours-linear-scale-strong-10);
}

/* Pitch.
 * sets the background artwork; controls size/placement; sets spacing around/inside the element.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 5091.
 */
.pitch {
  flex-grow: 1;
  padding-top: 10%;
  padding-bottom: 0;
  align-self: stretch;
  flex-shrink: 0;
}

/* Pitch small.
 * sets the background fill; sets the background artwork; sets the outline/corner shape; controls
 * size/placement.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 5092.
 */
.pitch-small {
  background-color: var(--colours-base-teal-deep);
  justify-content: space-between;
  flex-grow: 1;
  border-top-left-radius: 20%;
  border-bottom-left-radius: 20%;
  border-top-right-radius: 20%;
  border-bottom-right-radius: 20%;
}

/* Pitch small bg.
