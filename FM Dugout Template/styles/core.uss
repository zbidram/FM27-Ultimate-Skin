  align-items: flex-start;
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-short) ease-out;
  padding-top: 16px;
  padding-bottom: 16px;
  padding-right: 12px;
  padding-left: 8px;
}

/* Portal messages item message text unread.
