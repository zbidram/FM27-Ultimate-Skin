}

/* Sigradient quickstart.
 * controls size/placement; changes opacity for the whole element and its contents.
 * Source rule 612.
 */
.sigradient-quickstart {
  position: absolute;
  opacity: 0.1;
  width: 100%;
  height: 100%;
  right: auto;
  left: auto;
  top: auto;
  bottom: auto;
  overflow: hidden;
  flex-grow: 1;
}

/* Sivisible quickstart interactionpanel.
 * controls size/placement.
 * Source rule 613.
 */
.sivisible-quickstart-interactionpanel {
  position: absolute;
  width: 100%;
  height: 100%;
  flex-grow: 1;
}

/* Speakto header base.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 614.
 */
.speakto-header-base {
  height: 18px;
  border-left-width: var(--global-border-width-regular);
  padding-right: var(--global-padding-regular);
  padding-left: var(--global-padding-regular);
}

/* Speakto header none.
 * sets the outline/corner shape.
 * Source rule 615.
 */
.speakto-header-none {
  border-color: var(--none);
}

/* Speakto header positive.
 * sets the outline/corner shape.
 * Source rule 616.
 */
.speakto-header-positive {
  border-color: var(--communication-feedback-positive);
}

/* Speakto header neutral.
 * sets the outline/corner shape.
 * Source rule 617.
 */
.speakto-header-neutral {
  border-color: var(--communication-feedback-information);
}

/* Speakto header target.
 * sets the outline/corner shape.
 * Source rule 618.
 */
.speakto-header-target {
  border-color: var(--communication-feedback-alert);
}

/* Speakto header negative.
 * sets the outline/corner shape.
 * Source rule 619.
 */
.speakto-header-negative {
  border-color: var(--communication-feedback-negative);
}

/* Radio button navigatable element.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 620.
 */
.radio-button__navigatable-element {
  padding: 4px;
  border-radius: var(--skin-radius-card);
  align-self: center;
}

/* Unity radio button container.
 * sets spacing around/inside the element.
 * Source rule 621.
 */
.manager-creation-height-unit .unity-radio-button > .unity-radio-button__container {
  margin-left: var(--global-gap-small);
}

/* Menubar buttongroup.
 * controls size/placement.
 * Source rule 622.
 */
.menubar-buttongroup {
  height: 48px;
}

/* Speak To Left Dropdown Arrow.
 * Hides these elements.
 * Source rule 625.
 */
.sub-dropdown-content-container #SpeakToLeftDropdownArrow {
  display: none;
}

/* Speak To Right Dropdown Arrow.
 * Hides these elements.
 * Source rule 626.
 */
.sub-dropdown-content-container #SpeakToRightDropdownArrow {
  display: none;
}

/* Col full width no grow.
 * controls size/placement.
 * Source rule 627.
 */
.col-full-width-no-grow {
  width: 100%;
  overflow: hidden;
  flex-grow: 0;
}

/* Col full width grow.
 * controls size/placement.
 * Source rule 628.
 */
.col-full-width-grow {
  width: 100%;
  overflow: hidden;
  flex-grow: 1;
}

/* Unity toggle checkmark — keyboard focus.
 * sets the outline/corner shape.
 * Source rule 629.
 */
.inputs-switch-toggle-default-switch-false.unity-toggle:focus:enabled > .unity-toggle__input > .unity-toggle__checkmark {
  border-color: var(--skin-switch-marker-current);
}

/* Unity toggle checkmark — keyboard focus, checked/selected.
 * sets the background artwork; sets the outline/corner shape.
 * Source rule 630.
 */
.inputs-switch-toggle-default-switch-false.unity-toggle:focus:enabled > .unity-toggle__input:checked > .unity-toggle__checkmark {
  border-color: var(--skin-switch-marker-current);
  background-image: none;
}

/* Unity toggle checkmark — checked/selected.
 * sets the background artwork.
 * Source rule 631.
 */
.inputs-switch-toggle-default-switch-false > .unity-toggle__input:checked > .unity-toggle__checkmark {
  background-image: none;
}

/* Dragged object.
 * defines how state changes animate.
 * Source rule 632.
 */
.dragged-object {
  transition-property: translate;
  transition-duration: 0.15s;
  transition-timing-function: ease-in-out;
}

/* Dragged object with pointer.
 * defines how state changes animate.
 * Source rule 633.
 */
.dragged-object--with-pointer {
  transition-property: none;
}

/* Left Indicator Section.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 634.
 */
#LeftIndicatorSection {
  width: 16px;
  height: 16px;
  margin-left: var(--global-gap-small);
  margin-right: var(--global-gap-small);
}

/* Right Indicator Section.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 635.
 */
#RightIndicatorSection {
  width: 16px;
  height: 16px;
  margin-left: var(--global-gap-small);
  margin-right: var(--global-gap-small);
}

/* Left Icon Indicator.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 636.
 */
#LeftIconIndicator {
  width: 16px;
  height: 16px;
  margin-left: var(--global-gap-small);
  margin-right: var(--global-gap-small);
}

/* Right Icon Indicator.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 637.
 */
#RightIconIndicator {
  width: 16px;
  height: 16px;
  margin-left: var(--global-gap-small);
  margin-right: var(--global-gap-small);
}

/* Tactics position draggable.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 638.
 */
.tactics-position__draggable {
  border-radius: var(--skin-radius-control);
  margin-top: 31px;
  flex-shrink: 0;
}

/* Tactics position shirt and icons.
 * controls size/placement.
 * Source rule 639.
 */
.tactics-position__shirt-and-icons {
  position: absolute;
  width: 100%;
  height: 38px;
  top: -33px;
}

/* Siscrollview repeat button.
 * Hides these elements; sets the background fill; tints background artwork; controls size/placement.
 * Source rule 640.
 */
.siscrollview--repeat-button {
  display: none;
  width: 12px;
  height: 12px;
  background-color: var(--skin-surface-canvas);
  -unity-background-image-tint-color: var(--skin-on-media);
}

/* Siscrollview tracker.
 * sets the background fill; sets the outline/corner shape; controls size/placement; chooses the pointer and
 * hotspot.
 * Source rule 641.
 */
.unity-base-slider .siscrollview--tracker {
  background-color: var(--skin-transparent);
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
  align-items: center;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Siscrollview slider vertical.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 642.
 */
.siscrollview .siscrollview--slider__vertical {
  width: 8px;
  margin-top: 1px;
  margin-bottom: 1px;
  min-width: 8px;
}

/* Siscrollview slider horizontal.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 643.
 */
.siscrollview .siscrollview--slider__horizontal {
  height: 8px;
  min-height: 8px;
  margin-left: 1px;
  margin-right: 1px;
}

/* Siscrollview vertical scroller.
 * controls size/placement.
 * Source rule 644.
 */
.siscrollview--vertical-scroller {
  width: 8px;
  min-width: 8px;
}

/* Siscrollview vertical scroller.
 * controls size/placement.
 * Source rule 645.
 */
StreamedDropdownList .siscrollview--vertical-scroller {
  width: 0;
  min-width: 0;
}

/* Keep an overflowing scroll view discoverable without pointer hover.
 * This changes only the native idle state: display:none/zero-size rules for
 * non-overflowing views, hidden grid scrollers and dropdowns remain intact.
 * Source rule 646.
 */
.siscrollview--vertical-scroller__idle {
  visibility: visible;
}

/* Siscrollview horizontal scroller.
 * controls size/placement.
 * Source rule 647.
 */
.siscrollview--horizontal-scroller {
  height: 8px;
  min-height: 8px;
}

/* Siscrollview dragger.
 * sets the background fill; sets the outline/corner shape; defines how state changes animate; chooses the
 * pointer and hotspot.
 * Source rule 648.
 */
.siscrollview .siscrollview--dragger {
  border-width: 0;
  background-color: var(--skin-scrollbar-thumb);
  border-radius: var(--skin-scrollbar-radius);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
  transition-property: background-color;
  transition-duration: var(--transition-snappy);
  transition-timing-function: var(--transition-cb-ui);
  transition-delay: 0s;
}

/* Siscrollview dragger — pointer hover.
 * sets the background fill.
 * Source rule 649.
 */
.siscrollview .siscrollview--dragger:hover:enabled {
  background-color: var(--skin-scrollbar-thumb-hover);
}

/* Siscrollview dragger — pressed.
 * sets the background fill.
 * Source rule 650.
 */
.siscrollview .siscrollview--dragger:active:enabled {
  background-color: var(--skin-scrollbar-thumb-pressed);
}

/* Siscrollview dragger.
 * controls size/placement.
 * Source rule 651.
 */
.siscrollview--vertical-scroller .siscrollview--dragger {
  width: 4px;
}

/* Siscrollview dragger.
 * controls size/placement.
 * Source rule 652.
 */
.siscrollview--horizontal-scroller .siscrollview--dragger {
  height: 4px;
}

/* Unity scrollers use the same thumb roles as SI scroll views. Keep this
 * scoped to scrollers so sliders for settings/attributes retain their states.
 */
.unity-scroller .unity-base-slider__dragger {
  border-width: 0;
  background-color: var(--skin-scrollbar-thumb);
  border-radius: var(--skin-scrollbar-radius);
}

/* Unity base slider dragger — pointer hover.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 653.
 */
.unity-scroller .unity-base-slider__dragger:hover:enabled {
  border-color: var(--skin-transparent);
  background-color: var(--skin-scrollbar-thumb-hover);
}

/* Unity base slider tracker — pointer hover.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 654.
 */
.unity-scroller .unity-base-slider__tracker:hover:enabled {
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
}

/* A dragged thumb must stay visible when the pointer leaves its bounds.
 * Cover direct thumb press and the slider's captured drag state. The enabled
 * guard preserves the game's disabled-control treatment.
 */
.unity-scroller .unity-base-slider__dragger:active:enabled,
.unity-scroller .unity-base-slider:active:enabled .unity-base-slider__dragger {
  background-color: var(--skin-scrollbar-thumb-pressed);
}

/* Expand toggle visual element holder.
 * controls size/placement.
 * Source rule 655.
 */
.expand-toggle-visual-element-holder {
  position: absolute;
  flex-direction: var(--row-direction-normal);
  flex-grow: 0;
  flex-shrink: 1;
  top: 8px;
  justify-content: flex-end;
  align-self: center;
}

/* Portal messages action padding.
 * sets spacing around/inside the element.
 * Source rule 656.
 */
.portal-messages-action-padding {
  padding-top: var(--global-padding-large);
}

/* Basic Dropdown.
 * controls size/placement.
 * Source rule 657.
 */
.place-of-birth-dropdown-class #BasicDropdown {
  align-self: var(--flex-start-normal);
}

/* SI dropdown selection field.
 * sets spacing around/inside the element.
 * Source rule 658.
 */
.place-of-birth-dropdown-class #BasicDropdown .si-dropdown__selection-field {
  padding: var(--spacing-padding-extra-small---4) var(--spacing-padding-medium---16);
}

/* No border color.
 * sets the outline/corner shape.
 * Source rule 659.
 */
.no-border-color {
  border-color: var(--skin-transparent);
}

/* Default layer style.
 * controls size/placement.
 * Source rule 660.
 */
.default-layer-style {
  width: 100%;
  height: 100%;
  align-self: center;
}

/* Version watermark layer.
 * controls size/placement.
 * Source rule 661.
 */
.version-watermark-layer {
  width: 100%;
  height: 30px;
  left: auto;
  right: auto;
  top: auto;
  bottom: 0;
}

/* Ios data display expanded table.
 * sets the outline/corner shape.
 * Source rule 662.
 */
.expanded-table-no-block-border .ios-data-display-expanded-table {
  border-width: 0px;
}

/* Player comparison header.
 * controls size/placement.
 * Source rule 663.
 */
.player-comparison-header {
  width: 100%;
  flex-direction: var(--row-direction-normal);
  align-items: flex-start;
  justify-content: center;
  align-self: stretch;
}

/* Attributes key ip size min.
 * Hides these elements.
 * Source rule 664.
 */
.playerreportminiitooltip .attributes-key-ip-size-min {
  display: none;
}

/* Player comparison player widget.
 * controls size/placement.
 * Source rule 665.
 */
.player-comparison-player-widget {
  width: 50%;
}

/* Player comparison header.
 * controls size/placement.
 * Source rule 666.
 */
.player-comparison-header-compact .player-comparison-header {
  flex-direction: column;
}

/* Player comparison player widget.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 667.
 */
.player-comparison-header-compact .player-comparison-player-widget {
  width: 100%;
  margin-left: 0px;
  margin-right: 0px;
  margin-bottom: 12px;
}

/* Content ellipsis.
 * sets font/text presentation.
 * Source rule 668.
 */
.position-indicator-rating-text-no-ellipsis .content-ellipsis {
  overflow: visible;
  text-overflow: clip;
}

/* Invisible shortcut.
 * controls size/placement.
 * Source rule 669.
 */
.invisible-shortcut {
  width: 1px;
  height: 1px;
  min-width: 1px;
  max-width: 1px;
  max-height: 1px;
  min-height: 1px;
}

/* Active nation checkbox.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 670.
 */
.active-nation-checkbox {
  min-height: 24px;
  padding-left: 4px;
  padding-right: 4px;
}

/* Start unemployed checkbox.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 671.
 */
.start-unemployed-checkbox {
  height: 24px;
  padding-left: 4px;
  padding-right: 4px;
}

/* Transparent background checkbox.
 * sets the outline/corner shape.
 * Source rule 672.
 */
.transparent-background-checkbox {
  border-width: 0;
}

/* Unity toggle checkmark.
 * sets the background fill; sets the outline/corner shape; controls size/placement; chooses the pointer and
 * hotspot.
 * Source rule 673.
 */
.transparent-background-checkbox > .unity-toggle__input > .unity-toggle__checkmark {
  width: 16px;
  height: 16px;
  border-color: var(--skin-text-primary);
  background-color: var(--skin-transparent);
  flex-shrink: 0;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-top-left-radius: var(--skin-radius-micro);
  border-top-right-radius: var(--skin-radius-micro);
  border-bottom-right-radius: var(--skin-radius-micro);
  border-bottom-left-radius: var(--skin-radius-micro);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Unity toggle checkmark — keyboard focus.
 * sets the outline/corner shape.
 * Source rule 674.
 */
.transparent-background-checkbox.unity-toggle:focus:enabled > .unity-toggle__input > .unity-toggle__checkmark {
  border-color: var(--skin-text-primary);
}

/* Sink containment.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 675.
 */
.sink_containment {
  padding: var(--global-gap-regular) var(--global-gap-distant);
  background-color: var(--skin-surface-canvas);
  border-radius: var(--border-radius-radius-4);
  margin-bottom: var(--global-gap-regular);
}

/* Processingpanelheader.
 * controls size/placement.
 * Source rule 676.
 */
.processingpanelheader {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0px;
  top: 0px;
}

/* Sigradient.
 * sets the gradient colours drawn by this component.
 * Source rule 677.
 */
.processingpanelheader.sigradient {
  --start-colour: var(--skin-processing-header-background);
  --end-colour: var(--skin-processing-header-background);
}

/* Entity links retain native white rich-text paint despite computed colour.
 * Use a neutral processing surface with light copy throughout. Keep the
 * incoming-message section and club/competition artwork independent. */
#ProcessingHeader,
#ProcessingHeader .sitext {
  color: var(--skin-processing-header-foreground);
}
#ProcessingHeader #Date {
  color: var(--skin-processing-header-secondary);
}
#ProcessingHeader #ProcessingIcon {
  color: var(--skin-processing-header-foreground);
  -unity-background-image-tint-color: var(--skin-processing-header-foreground);
}

/* Unity toggle checkmark — pointer hover.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 678.
 */
.transparent-background-checkbox.unity-toggle > .unity-toggle__input:hover:enabled > .unity-toggle__checkmark {
  border-color: var(--skin-text-primary);
  background-color: var(--skin-transparent);
}

/* Unity toggle checkmark — pointer hover, checked/selected.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 679.
 */
.transparent-background-checkbox.unity-toggle > .unity-toggle__input:hover:enabled:checked > .unity-toggle__checkmark {
  border-color: var(--skin-text-primary);
  background-color: var(--skin-surface-raised);
}

/* Recruitment squad planner player indicator.
 * controls size/placement.
 * Source rule 680.
 */
.recruitment-squad-planner-player-indicator {
  width: 108px;
  align-items: flex-start;
}

/* Colour picker element.
 * controls size/placement.
 * Source rule 681.
 */
.colour-picker-element {
  height: 618px;
}

/* Colour picker element gradient area.
 * controls size/placement.
 * Source rule 682.
 */
.colour-picker-element__gradient-area {
  flex-direction: column;
  align-items: center;
}

/* Colour picker element gradient field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 683.
 */
.colour-picker-element__gradient-field {
  width: 214px;
  height: 214px;
  margin: 0px;
  padding: 0px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-surface-canvas);
  border-radius: var(--skin-radius-card);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Colour picker element spectrum slider.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 684.
 */
.colour-picker-element__spectrum-slider {
  width: 208px;
  height: 32px;
  margin: 16px 0px 16px 0px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-surface-canvas);
  overflow: visible;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
}

/* Colour picker element spectrum slider dragger.
 * sets the background fill; sets the outline/corner shape; controls size/placement; chooses the pointer and
 * hotspot.
 * Source rule 685.
 */
.colour-picker-element__spectrum-slider-dragger {
  width: 8px;
  height: 26px;
  border-width: 2px;
  border-color: var(--skin-text-secondary);
  background-color: var(--skin-surface-canvas-alpha-16);
  border-radius: var(--skin-radius-small);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Gradient field.
 * sets the background fill.
 * Source rule 686.
 */
.gradient-field {
  background-color: var(--skin-surface-canvas);
  overflow: visible;
}

/* Gradient field dragger.
 * sets the background fill; sets the outline/corner shape; controls size/placement; chooses the pointer and
 * hotspot.
 * Source rule 687.
 */
.gradient-field__dragger {
  position: absolute;
  width: 16px;
  height: 16px;
  border-width: 2px;
  border-color: var(--skin-text-secondary);
  background-color: var(--skin-surface-canvas-alpha-16);
  border-radius: var(--skin-radius-small);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Swatch.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 688.
 */
.swatch {
  width: 24px;
  height: 24px;
  margin: 4px;
  background-color: var(--skin-surface-raised);
  border-radius: var(--skin-radius-small);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.set-piece-segmented-button-active .sitext,
.set-piece-segmented-button-active .sitextmedium,
.set-piece-segmented-button-active .sitextsmall,
.tactic-position-overview-widget-item__sub > .tactic-position-overview-widget-item__filled .sitext,
.tactic-position-overview-widget-item__sub > .tactic-position-overview-widget-item__filled .sitextmedium,
.tactic-position-overview-widget-item__sub > .tactic-position-overview-widget-item__filled .sitextsmall,
.setpiece-scenario-toggle-selected .sitext,
.setpiece-scenario-toggle-selected .sitextmedium,
.setpiece-scenario-toggle-selected .sitextsmall,
.setpiece-scenario-toggle-inactive .sitext,
.setpiece-scenario-toggle-inactive .sitextmedium,
.setpiece-scenario-toggle-inactive .sitextsmall,
.radio-group-like-button .sitext,
.radio-group-like-button .sitextmedium,
.radio-group-like-button .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Spacing Layout
 * Reusable geometry, spacing, borders and colour helper classes.
 */

/* Color field.
 * controls size/placement.
 * Source rule 689.
 */
.color-field {
  align-items: center;
}

/* Color field reset button.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 690.
 */
.color-field__reset-button {
  height: 28px;
  margin: 0px 0px 0px 5px;
  padding: 0px 8px;
}

/* Color field input.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 691.
 */
.color-field__input {
  height: 28px;
  border-width: 1px;
  border-color: var(--color-primary);
  border-radius: var(--skin-radius-compact);
}

/* Color field input — pointer hover.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 692.
 */
.color-field__input:hover,
.color-field:hover > .color-field__input {
  border-color: var(--color-primary);
}

/* Color field input RGB.
 * sets the background fill; controls size/placement.
 * Source rule 693.
 */
.color-field__input-rgb {
  width: 100%;
  background-color: var(--skin-surface-canvas);
  flex-grow: 1;
}

/* Color field input alpha container.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 694.
 */
.color-field__input-alpha-container {
  width: 100%;
  height: 6px;
  background-color: var(--skin-surface-canvas);
  border-top-width: 1px;
  border-top-color: var(--skin-border-subtle);
}

/* Color field input alpha.
 * sets the background fill; controls size/placement.
 * Source rule 695.
 */
.color-field__input-alpha {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: var(--skin-surface-raised);
  flex-grow: 0;
  flex-shrink: 0;
}

/* Colour component.
 * controls size/placement.
 * Source rule 696.
 */
.colour-component {
  flex-grow: 0;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  align-items: stretch;
  justify-content: flex-start;
  align-self: flex-start;
  align-content: flex-start;
}

/* Sibutton.
 * chooses the pointer and hotspot.
 * Source rule 698.
 */
.unity-disabled .sibutton {
  cursor: var(--none);
}

/* Go on holiday widget.
 * controls size/placement.
 * Source rule 699.
 */
.go-on-holiday-widget {
  width: 640px;
}

/* Text title.
 * sets font/text presentation; sets spacing around/inside the element.
 * Source rule 700.
 */
.text-title {
  font-size: var(--typography-size-12);
  -unity-text-align: middle-left;
  -unity-font-style: var(--typography-weight-regular);
  -unity-font-definition: var(--skin-font-body);
  margin-left: 8px;
  margin-right: 8px;
  margin-top: 8px;
  margin-bottom: 8px;
}

/* Text bold.
 * sets font/text presentation.
 * Source rule 701.
 */
.text-bold {
  font-size: var(--typography-size-14);
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-regular);
}

/* Text large bold.
 * sets font/text presentation.
 * Source rule 702.
 */
.text-large-bold {
  font-size: var(--typography-size-16);
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-regular);
}

/* Text regular.
 * sets font/text presentation.
 * Source rule 703.
 */
.text-regular {
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-regular);
  -unity-text-align: middle-left;
  -unity-font-definition: var(--skin-font-body);
  overflow: hidden;
}

/* Text single line.
 * sets font/text presentation; controls size/placement.
 * Source rule 704.
 */
.text-single-line {
  white-space: nowrap;
  text-overflow: clip;
  overflow: hidden;
  flex-shrink: 0;
}

/* Text faded.
 * changes opacity for the whole element and its contents.
 * Source rule 705.
 */
.text-faded {
  opacity: 0.65;
}

/* Customcontent.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 706.
 */
.customcontent {
  flex-grow: 1;
  overflow: hidden;
  margin-left: 8px;
  margin-right: 8px;
  margin-bottom: 8px;
}

/* Attributesrow.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 707.
 */
.attributesrow {
  flex-direction: var(--row-direction-normal);
  justify-content: flex-start;
  padding-bottom: 16px;
}

/* Attributecontainer.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 708.
 */
.attributecontainer {
  width: 33%;
  flex-basis: auto;
  min-height: 36px;
  justify-content: space-around;
  padding-right: 4px;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Bottomcontainer.
 * controls size/placement.
