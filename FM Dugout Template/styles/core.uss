  border-radius: var(--skin-radius-small);
}

/* Data display cell combo cell default type default icon size large orientation horizontal combo 1 cell 1
 * string.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3146.
 */
.opposition-instructions-best-performers-small .data_display-cell-combo_cell-default-type-default-icon-size-large-orientation-horizontal-combo-1-cell-1-string,
.calendar-training-session-edit-session {
  height: 24px;
}

/* Over wage value.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3147.
 */
.over-wage-value {
  position: absolute;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
