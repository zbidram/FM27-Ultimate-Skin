}

/* Item separator.
 * sets the background fill; sets the outline/corner shape; controls size/placement; defines how state
 * changes animate.
 * Source rule 5016.
 */
.item-separator {
  position: absolute;
  opacity: 1;
  background-color: var(--colours-base-neutral-black);
  translate: 6% 0;
  border-left-color: var(--none);
  border-right-color: var(--none);
  border-top-color: var(--none);
  border-bottom-color: var(--none);
  transition-property: opacity;
  transition-duration: 0.25s;
}

/* Element expanded.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Source rule 5017.
 */
.element-expanded {
  opacity: 1;
  translate: -50% 0;
  transition-property: opacity, translate;
  transition-duration: 0.3s;
  transition-timing-function: ease-in;
}

/* Element collapsed.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Source rule 5018.
 */
.element-collapsed {
  opacity: 0;
  translate: -100% 0;
  transition-property: opacity, translate;
  transition-duration: 0.3s;
  transition-timing-function: ease-in;
}

/* Element collapsed first.
