/* Figma base card template inner frame.
 * sets the background fill; sets the background artwork; tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Decorative native artwork is explicitly removed; content images are separate.
 * Source rule 291.
 */
.figma-base-card-modal-surface.figma-base-card-template-inner-frame,
.figma-base-card-modal-surface .figma-base-card-template-inner-frame {
  background-color: var(--skin-dialog-surface);
  background-image: var(--skin-dialog-artwork);
  -unity-background-scale-mode: scale-and-crop;
  -unity-background-image-tint-color: var(--skin-on-media-alpha-35);
  overflow: hidden;
}

/* Textwrap.
 * sets font/text presentation.
 * Source rule 292.
 */
