  border-radius: var(--skin-radius-small);
}

/* Surfaces card block border.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3769.
 */
/* Ordinary block cards use surface depth; keep semantic/state outlines on their specific selectors. */
.surfaces-card-block-border {
  position: absolute;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-transparent);
  border-radius: var(--layout-modules-block-radius);
}

/* The shared card-tile frame spans Portal widgets, report cards and tactics tiles.
 * Ordinary tiles use the raised surface for depth, so hide their native outline.
 * Tactics state selectors restore a thin border where colour communicates a change.
 * Source rule 3770.
 */
.surfaces-card-tile-border {
  position: absolute;
  border-width: var(--global-border-width-none);
  border-color: var(--skin-on-media-alpha-20);
  border-radius: var(--layout-modules-block-radius);
}

/* Startscreen Var.
 * sets the background fill; defines how state changes animate.
 * Source rule 3771.
 */
.surfaces-card-tile-border.startscreenVar {
  background-color: var(--skin-transparent);
  transition: background-color 0.15s ease;
}

/* Tab button group.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3772.
 */
.tab-button-group {
  margin: 0;
  padding: 0;
