.dual-progress-bar-negative-secondary-colour .sitextmedium,
.dual-progress-bar-negative-secondary-colour .sitextsmall,
.dual-progress-bar-positive-secondary-colour .sitext,
.dual-progress-bar-positive-secondary-colour .sitextmedium,
.dual-progress-bar-positive-secondary-colour .sitextsmall {
  color: var(--skin-selection-foreground);
}

