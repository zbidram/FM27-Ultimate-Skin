  border-color: var(--skin-on-media-alpha-16);
  align-items: flex-end;
  flex: 1 0 0;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
  justify-content: flex-start;
  flex-grow: 0;
  flex-basis: auto;
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-bottom-left-radius: 0;
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
}

/* Shot map string.
 * sets font/text presentation.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3526.
 */
.shot-map-string,
.modal-text-alignment,
.text-align-center,
.text-center-align {
  -unity-text-align: middle-center;
}

/* Shuffle draft background.
 * sets the background artwork.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 3527.
 */
.shuffle-draft-background {
  -unity-background-scale-mode: scale-and-crop;
}

/* Shuffle draft background overlay 65.
 * sets the background fill.
 * Source rule 3528.
 */
.shuffle-draft-background-overlay-65 {
  background-color: var(--skin-surface-page-alpha-65);
}

/* Shuffle draft background overlay default.
 * sets the background fill.
 * Source rule 3529.
 */
.shuffle-draft-background-overlay-default {
  background-color: var(--skin-surface-canvas-alpha-20);
}

/* Shuffle draft block.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 3530.
 */
.shuffle-draft-block {
  padding: var(--global-padding-extra-large);
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  border-radius: var(--layout-modules-block-radius);
}

/* Shuffle draft block dark.
 * sets the background fill.
 * Source rule 3531.
 */
.shuffle-draft-block--dark {
  background-color: var(--skin-surface-canvas-alpha-65);
}

/* Shuffle draft block light.
 * sets the background fill.
 * Source rule 3532.
 */
.shuffle-draft-block--light {
  background-color: var(--skin-surface-canvas-alpha-32);
}

/* Shuffle draft club and nickname.
 * Changes text/foreground colour; controls size/placement; sets spacing around/inside the element.
 * Source rule 3533.
 */
.shuffle-draft-club-and-nickname {
  padding: 0 var(--spacing-small---8);
  color: var(--skin-text-secondary);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Shuffle draft continue button paused.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3534.
 */
.shuffle-draft-continue-button-paused {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-feedback-warning);
}

/* Shuffle draft continue button waiting.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3535.
 */
.shuffle-draft-continue-button-waiting {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-component-shuffle-draft-continue-button-waiting-background);
}

/* Continue button gradient.
 * sets the gradient colours drawn by this component.
 * Source rule 3536.
 */
.shuffle-draft-continue-button-waiting .continue-button---gradient {
  --start-colour: var(--skin-component-shuffle-draft-continue-button-waiting-continue-button-gradient-start-colour);
  --end-colour: var(--skin-component-shuffle-draft-continue-button-waiting-continue-button-gradient-end-colour);
}

/* Continue button gradient.
