  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  -unity-text-outline-width: 0;
  letter-spacing: 0;
}

/* Tooltip default.
 * controls size/placement; defines how state changes animate; changes opacity for the whole element and its
 * contents.
 * Source rule 5124.
 */
.tooltip-default {
  position: absolute;
  opacity: 1;
  left: auto;
  max-width: none;
  min-width: auto;
  transition-property: translate;
  transition-duration: 0.25s;
  transition-timing-function: ease-out-bounce;
  transition-delay: 0s;
}

/* Tooltip financial history.
 * controls size/placement.
 * Source rule 5125.
 */
.tooltip-financial-history {
  position: absolute;
  right: 10px;
  top: 10px;
  left: auto;
}

/* Financial pie chart data label.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 5126.
 */
.financial-pie-chart-data-label {
  color: var(--skin-text-secondary);
  font-size: var(--typography-size-16);
  -unity-font-definition: var(--skin-font-body);
