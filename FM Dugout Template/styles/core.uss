  border-right-color: var(--skin-surface-canvas-alpha-20);
  border-top-color: var(--skin-surface-canvas-alpha-20);
  border-bottom-color: var(--skin-surface-canvas-alpha-20);
  min-width: 312px;
  min-height: 312px;
  max-width: 100%;
  max-height: 100%;
}

/* Sireport.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 279.
 */
.sireport {
  display: flex;
  width: 1328px;
  height: 744px;
  background-color: var(--skin-surface-strong);
  padding-bottom: 16px;
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--skin-radius-card);
}

/* Tool container.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 280.
 */
.tool-no-border .tool-container {
  padding: 0px;
  background-color: var(--skin-surface-page-alpha-65);
  flex-grow: 1;
  justify-content: center;
  align-items: center;
}

/* Report container.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 281.
 */
.report-container,
.tool-container {
  padding: var(--none);
  background-color: var(--skin-surface-page-alpha-65);
  flex-grow: 1;
  justify-content: center;
  align-items: center;
}

/* Sicard container large.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
