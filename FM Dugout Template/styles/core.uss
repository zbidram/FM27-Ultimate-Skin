/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Bookmark bar reorder anim.
 * defines how state changes animate.
 * Source rule 1261.
 */
.bookmark-bar-reorder-anim {
  transition-property: scale;
  transition-duration: 0.2s;
  transition-timing-function: ease-out-back;
  scale: 1.25 1.25;
}

/* Bookmark displaced anim.
 * defines how state changes animate.
 * Source rule 1262.
 */
.bookmark-displaced-anim {
  transition-property: scale;
  transition-duration: 0.2s;
  transition-timing-function: ease-out;
  scale: 0.9 0.9;
}

/* Bookmark drop indicator.
 * Hides these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1263.
 */
.bookmark-drop-indicator {
  position: absolute;
  display: none;
  width: 3px;
  background-color: var(--skin-text-primary);
  top: 4px;
  bottom: 4px;
  border-radius: var(--skin-radius-micro);
}

/* Bookmark drop indicator vertical.
 * Hides these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1264.
 */
.bookmark-drop-indicator-vertical {
  position: absolute;
  display: none;
  height: 3px;
  background-color: var(--skin-text-primary);
  left: 4px;
  right: 4px;
  border-radius: var(--skin-radius-micro);
}

/* Bookmark edit panel.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 1265.
 */
.bookmark-edit-panel {
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  border-radius: var(--layout-modules-block-radius);
  overflow: hidden;
}

/* Bookmark edit panel floating element.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1266.
 */
.bookmark-edit-panel-floating-element {
  flex-direction: var(--row-direction-normal);
  padding-bottom: var(--global-gap-close);
  padding-right: var(--global-gap-close);
}

/* Bookmark item icon.
 * controls size/placement.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1267.
 */
.bookmark-item-icon,
.team-instruction-option__tweak-icon,
.navigation-tab-dropdown-small {
  width: 16px;
  height: 16px;
}

/* Bookmark move button container.
 * controls size/placement.
 * Source rule 1268.
 */
.bookmark-move-button-container {
  width: 32px;
  height: 24px;
  flex-shrink: 0;
}

/* Bookmark reorder anim.
 * defines how state changes animate.
 * Source rule 1269.
 */
.bookmark-reorder-anim {
  transition-property: scale;
  transition-duration: 0.2s;
  transition-timing-function: ease-out-back;
  scale: 1.1 1.1;
}

/* Bookmark reorder base.
 * defines how state changes animate.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1270.
 */
.bookmark-reorder-base,
.bookmark-displaced-base {
  transition-property: scale;
  transition-duration: 0.2s;
  transition-timing-function: ease-out;
  scale: 1 1;
}

/* Bookmarks area large width.
 * controls size/placement.
 * Source rule 1271.
 */
.bookmarks-area-large-width {
  max-width: 717px;
}

/* Bookmarks area small width.
 * controls size/placement.
 * Source rule 1272.
 */
.bookmarks-area-small-width {
  max-width: 286px;
}

/* Bookmarks area standard width.
 * controls size/placement.
 * Source rule 1273.
 */
.bookmarks-area-standard-width {
  max-width: 445px;
}

/* Bookmarks bar large width.
 * controls size/placement.
 * Source rule 1274.
 */
.bookmarks-bar-large-width {
  min-width: auto;
}

/* Bookmarks bar small width.
 * controls size/placement.
 * Source rule 1275.
 */
.bookmarks-bar-small-width {
  min-width: 192px;
}

/* Bookmarks bar standard width.
 * controls size/placement.
 * Source rule 1276.
 */
.bookmarks-bar-standard-width {
  min-width: 288px;
}

/* Bookmarks button.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 1277.
 */
.bookmarks-button {
  margin: var(--global-gap-none);
  border-width: var(--global-border-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  padding-top: var(--global-padding-none);
  padding-right: var(--interaction-global-padding-horizontal-md);
  padding-bottom: var(--global-padding-none);
  padding-left: var(--interaction-global-padding-horizontal-md);
  flex-direction: var(--row-direction-normal);
  align-items: center;
  border-radius: var(--interaction-global-radius-md);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons), color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Bookmarks button.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 1277.
 */
.buttons-button-base-soft {
  margin: var(--global-gap-none);
  border-width: var(--global-border-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  padding-top: var(--global-padding-none);
  padding-right: var(--interaction-global-padding-horizontal-md);
  padding-bottom: var(--global-padding-none);
  padding-left: var(--interaction-global-padding-horizontal-md);
  flex-direction: var(--row-direction-normal);
  align-items: center;
  border-radius: var(--skin-radius-control);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons), color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Bookmarks button container.
 * sets spacing around/inside the element.
 * Source rule 1278.
 */
.bookmarks-button-container {
  margin: 0 4px 0 0;
}

/* Bookmarks button — pointer hover.
 * sets the background fill.
 * Source rule 1279.
 */
.bookmarks-button:hover {
  background-color: var(--skin-control-hover);
}

/* Bookmarks table.
 * Shows these elements; controls size/placement.
 * Source rule 1280.
 */
.bookmarks-table {
  display: flex;
  height: 508px;
  align-items: flex-start;
  flex-shrink: 0;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
}

/* Bookmarks table container.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 1281.
 */
.bookmarks-table-container {
  display: flex;
  padding: var(--spacing-padding-medium---16) var(--spacing-padding-small---8);
  align-items: flex-start;
  align-self: stretch;
  flex-grow: 1;
  border-radius: var(--global-radius-small, var(--skin-radius-small));
}

/* Spacing Layout
 * Reusable geometry, spacing, borders and colour helper classes.
 */

/* Border bottom divider.
 * sets the outline/corner shape.
 * Source rule 1282.
 */
.border-bottom-divider {
  border-color: var(--skin-border-subtle);
  border-bottom-width: var(--global-border-width-thin);
}

/* Border choose club or nation.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1283.
 */
.border-choose-club-or-nation {
  display: flex;
  height: 76px;
  padding: 16px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  min-height: 76px;
  border-radius: var(--skin-radius-card) var(--skin-radius-card) 0 0;
}

/* Border color layout modules block border colour transparent.
 * sets the outline/corner shape.
 * Source rule 1284.
 */
.border-color-layout-modules-block-border-colour-transparent {
  border-color: var(--skin-transparent);
}

/* Border left divider.
 * sets the outline/corner shape.
 * Source rule 1285.
 */
.border-left-divider {
  border-color: var(--skin-border-subtle);
  border-left-width: var(--global-border-width-thin);
}

/* Border radius 4.
 * sets the outline/corner shape.
 * Source rule 1286.
 */
.border-radius-4 {
  border-radius: var(--border-radius-radius-4);
}

/* Border radius 8.
 * sets the outline/corner shape.
 * Source rule 1287.
 */
