  padding-bottom: 16px;
  padding-left: 16px;
  border-left-color: var(--skin-card-border-colour);
  border-right-color: var(--skin-card-border-colour);
  border-top-color: var(--skin-card-border-colour);
  border-bottom-color: var(--skin-card-border-colour);
  border-top-left-radius: var(--skin-radius-card);
  border-top-right-radius: var(--skin-radius-card);
  border-bottom-right-radius: var(--skin-radius-card);
  border-bottom-left-radius: var(--skin-radius-card);
  border-top-width: var(--skin-card-border-width);
  border-right-width: var(--skin-card-border-width);
  border-bottom-width: var(--skin-card-border-width);
  border-left-width: var(--skin-card-border-width);
