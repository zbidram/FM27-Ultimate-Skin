 * Source rule 3749.
 */
.store-grid-selector .selectable--selected {
  padding: 0;
  border-width: var(--numbers-border-radius-null);
  border-radius: var(--skin-radius-shell);
}

/* Store playstation logo space.
 * sets spacing around/inside the element.
