  border-width: var(--layout-modules-block-border-thickness);
  background-color: var(--skin-surface-panel);
  flex-grow: 1;
  flex-direction: column;
  align-items: var(--flex-start-normal);
  align-self: stretch;
  border-radius: var(--layout-modules-block-radius);
  border-left-color: var(--skin-on-media-alpha-20);
  border-right-color: var(--skin-on-media-alpha-20);
  border-top-color: var(--skin-on-media-alpha-20);
  border-bottom-color: var(--skin-on-media-alpha-20);
}

/* Figma base report template inner frame no background.
