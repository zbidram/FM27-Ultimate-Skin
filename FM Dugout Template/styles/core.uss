  align-content: auto;
  padding-right: 24px;
}

/* Preferences essentials setting block.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 3298.
 */
.preferences-essentials-setting-block {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  border-radius: var(--skin-radius-card);
  padding-top: 12px;
  padding-right: 12px;
  padding-bottom: 12px;
  padding-left: 12px;
}

/* Preferences fmc setting block.
 * sets spacing around/inside the element.
 * Source rule 3299.
 */
.preferences-fmc-setting_block {
  padding: 12px 12px 12px 0;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Prematch lineup pitch icon efl.
 * controls size/placement.
 * Source rule 3300.
 */
.prematch-lineup-pitch-icon-efl {
  width: 36px;
  height: 36px;
  justify-content: center;
}

/* Prematch lineup tactics position layout.
 * controls size/placement.
 * Source rule 3301.
 */
.prematch-lineup-tactics-position-layout {
  width: 100%;
  height: 92px;
  max-width: 170px;
}

/* Prematch lineup tactics position layout premier league.
 * controls size/placement.
 * Source rule 3302.
 */
.prematch-lineup-tactics-position-layout-premier-league {
  width: 128px;
  height: 112px;
}

/* Prematch lineup tactics position player name.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 3303.
 */
.prematch-lineup-tactics-position-player-name {
  color: var(--skin-surface-page-alpha-100);
  font-size: var(--typography-size-16);
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-center;
}

/* Press conference can respond stepper style.
 * sets the background fill.
 * Source rule 3304.
 */
.press-conference-can-respond-stepper-style {
  background-color: var(--skin-component-press-conference-can-respond-stepper-style-background);
}

/* Press conference can respond stepper style.
 * sets the background fill.
 * Source rule 3304.
 */
.progress-timeline-player-target .progress-timeline-handle {
  background-color: var(--skin-data-progress-timeline-player-target-progress-timeline-handle-background);
}

/* Press conference can respond stepper style.
 * sets the background fill.
 * Source rule 3304.
 */
.progress-timeline-player-target .progress-timeline-value {
  background-color: var(--skin-data-progress-timeline-player-target-progress-timeline-value-background);
}

/* Press conference tiles top panel.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element. Its joined lower edge stays square beneath the shared card-radius top corners.
 * Source rule 3305.
 */
.press-conference-tiles-top-panel {
  display: flex;
  padding: 2px 8px 0 8px;
  justify-content: center;
  align-self: stretch;
  border-radius: var(--skin-radius-card) var(--skin-radius-card) 0 0;
}

/* Pro item.
 * tints background artwork.
 * Source rule 3306.
 */
.pro-item {
  -unity-background-image-tint-color: var(--skin-component-pro-item-image-tint);
}

/* Progress bar track.
 * sets the background fill; sets the outline/corner shape; controls size/placement; defines how state
 * changes animate.
 * Source rule 3307.
 */
.progress-bar-track {
  width: 100px;
  height: 8px;
  background-color: var(--skin-on-media-alpha-16);
  border-radius: var(--skin-radius-small);
  transition-property: var(--transition-props-continuous);
  transition-duration: var(--global-transition-short);
  transition-timing-function: ease-out-bounce;
}

/* Progress bar track no radius.
 * sets the background fill; controls size/placement; defines how state changes animate.
 * Source rule 3308.
 */
.progress-bar-track-no-radius {
  width: 100px;
  height: 8px;
  background-color: var(--skin-on-media-alpha-16);
  transition-property: var(--transition-props-continuous);
  transition-duration: var(--global-transition-short);
  transition-timing-function: ease-out-bounce;
}

/* Progress bar value.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3309.
 */
.progress-bar-value {
  position: absolute;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--data-progress-indicator-foreground);
  border-radius: var(--skin-radius-small);
}

/* Progress bar value green.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3310.
 */
.progress-bar-value-green {
  position: absolute;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--communication-feedback-positive);
  border-radius: var(--skin-radius-small);
}

/* Progress bar value green right radius.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3311.
 */
.progress-bar-value-green-right-radius {
  position: absolute;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--communication-feedback-positive);
  border-top-right-radius: var(--numbers-border-radius-small);
  border-bottom-right-radius: var(--numbers-border-radius-small);
}

/* Progress bar value red left radius.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3312.
 */
.progress-bar-value-red-left-radius {
  position: absolute;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--communication-feedback-negative);
  border-top-left-radius: var(--numbers-border-radius-small);
  border-bottom-left-radius: var(--numbers-border-radius-small);
}

/* Progress label property 1 in progress.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3313.
 */
.progress-label-property-1-in-progress {
  padding: 4px 6px;
  justify-content: center;
  align-items: center;
  border-radius: 60px;
  flex-direction: var(--row-direction-always-normal);
}

/* Progress timeline base.
 * Changes text/foreground colour; sets the outline/corner shape; sets font/text presentation; sets spacing
 * around/inside the element.
 * Source rule 3314.
 */
.progress-timeline-base {
  border-width: 1.5px;
  border-color: var(--skin-on-media-alpha-08);
  color: var(--skin-text-primary);
  font-size: var(--typography-size-10);
  -unity-text-align: middle-center;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  padding-right: 4px;
  padding-left: 4px;
  border-radius: var(--skin-radius-small);
}

/* Progress timeline base — pointer hover.
 * sets the outline/corner shape.
 * Source rule 3315.
 */
.progress-timeline-base:hover {
  border-color: var(--skin-on-media-alpha-20);
}

/* Progress timeline handle.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3316.
 */
.progress-timeline-handle {
  position: absolute;
  width: 12px;
  height: 12px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-brand-accent);
  right: -6px;
  top: -4px;
  border-radius: var(--skin-radius-control);
}

/* Progress timeline track.
 * controls size/placement.
 * Source rule 3317.
 */
.progress-timeline-player-target .progress-timeline-track {
  width: 197px;
}

/* Progress timeline selected.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 3318.
 */
.progress-timeline-selected {
  border-width: 1.5px;
  border-color: var(--communication-feedback-positive);
  background-color: var(--staff-recruitment-director-of-football-16);
  color: var(--communication-feedback-positive);
  font-size: var(--typography-size-10);
  -unity-text-align: middle-center;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  padding-right: 4px;
  padding-left: 4px;
  border-radius: var(--skin-radius-small);
}

/* Progress timeline track.
 * Shows these elements; tints background artwork; controls size/placement.
 * Source rule 3319.
 */
.progress-timeline-track {
  display: flex;
  height: 2px;
  -unity-background-image-tint-color: var(--skin-on-media-alpha-35);
  justify-content: flex-start;
  flex-direction: var(--row-direction-normal);
  align-items: center;
}

/* Progress timeline value.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3320.
 */
.progress-timeline-value {
  height: 4px;
  background-color: var(--skin-brand-accent);
  border-radius: var(--skin-radius-micro);
  flex-shrink: 0;
}

/* Promise name text.
 * Changes text/foreground colour; controls size/placement; sets spacing around/inside the element.
 * Source rule 3321.
 */
.promise-name-text {
  color: var(--skin-text-secondary);
  margin-right: 6px;
  flex-shrink: 0;
}

/* Proposal frame states custom active league setup inputs switch checkbox property.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3322.
 */
.proposal-frame-states-custom-active-league-setup-inputs-switch-checkbox-property {
  width: 200px;
  height: 36px;
  align-items: center;
  margin-right: var(--spacing-padding-tiles);
  flex-direction: var(--row-direction-normal);
}

/* Game concepts size small.
 * controls size/placement.
 * Source rule 3323.
 */
.pseudo-header .game-concepts-size-small {
  width: 0;
  height: 0;
}

/* Manager creation thumbnail.
 * sets the outline/corner shape.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3324.
 */
.quick_start-club-selected-tile-Border .virtualised-list__item--selected > .manager-creation-thumbnail,
.quick_start-club-selected-tile-Border .virtualised-list__item--selected > .manager-accessory-selection-thumbnail,
.quick_start-club-selected-tile-Border .virtualised-list__item--selected > .manager-preset-button-bg-border {
  border-width: 2px;
  border-color: var(--colours-base-neutral-white);
  border-radius: 8px;
}

/* Radio button element no border.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3325.
 */
.radio-button-element-no-border {
  border-width: 0;
  flex-direction: var(--row-direction-normal);
  flex-wrap: nowrap;
}

/* Unity radio button.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3326.
 */
.radio-group-tight .unity-radio-button {
  padding-top: var(--padding-padding-2);
  padding-bottom: var(--padding-padding-2);
  min-width: 100%;
  max-width: 100%;
  border-radius: var(--global-radius-small);
}

/* Unity radio button checkmark.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 3327.
 */
.radio-group-tight .unity-radio-button__checkmark {
  display: flex;
  width: 6px;
  height: 6px;
  padding: 0;
  border-radius: 6px;
  align-self: center;
}

/* Unity radio button checkmark background.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 3328.
 */
.radio-group-tight .unity-radio-button__checkmark-background {
  display: flex;
  width: 12px;
  height: 12px;
  padding: 0;
  border-radius: 12px;
  align-self: center;
  align-items: center;
  justify-content: center;
}

/* Radio toggle.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3329.
 */
.radio-toggle {
  margin: 0;
  align-self: center;
}

/* Unity toggle checkmark.
 * Hides these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3330.
 */
.radio-toggle .unity-toggle__input > .unity-toggle__checkmark {
  position: relative;
  display: none;
  width: 6px;
  height: 6px;
  border-color: var(--colours-base-neutral-white);
  background-color: var(--colours-base-neutral-white);
  flex-grow: 0;
  flex-shrink: 0;
  border-radius: 3px;
  border-top-width: 3px;
  border-right-width: 3px;
  border-bottom-width: 3px;
  border-left-width: 3px;
}

/* Unity toggle input.
 * sets the outline/corner shape; controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3331.
 */
.radio-toggle .unity-toggle__input,
.manager-preset-button-active-toggle .unity-toggle__input {
  width: 16px;
  height: 16px;
  border-color: var(--colours-base-neutral-white);
  flex-grow: 0;
  flex-shrink: 0;
  min-width: 16px;
  min-height: 16px;
  border-top-width: var(--global-border-width-regular);
  border-right-width: var(--global-border-width-regular);
  border-bottom-width: var(--global-border-width-regular);
  border-left-width: var(--global-border-width-regular);
  border-radius: var(--global-radius-regular);
  align-items: center;
  justify-content: center;
}

/* Unity toggle checkmark — checked/selected.
 * Shows these elements; sets the background fill; sets the outline/corner shape.
 * Source rule 3332.
 */
.radio-toggle .unity-toggle__input:checked:enabled > .unity-toggle__checkmark {
  display: flex;
  border-color: var(--colours-base-neutral-white);
  background-color: var(--colours-base-neutral-white);
}

/* Unity toggle checkmark — pointer hover, checked/selected.
 * sets the background fill; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3333.
 */
.radio-toggle:hover:enabled .unity-toggle__input:checked:enabled > .unity-toggle__checkmark,
.radio-toggle:focus:enabled .unity-toggle__input:checked:enabled > .unity-toggle__checkmark {
  border-color: var(--colours-base-neutral-white);
  background-color: var(--colours-base-neutral-white);
}

/* Radio group horizontal align.
 * sets the outline/corner shape; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3334.
 */
.radio_group_horizontal_align {
  padding: 16px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-14);
  font-size: var(--typography-size-14);
  margin-bottom: 12px;
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  flex-direction: var(--row-direction-normal);
  flex-wrap: nowrap;
  border-radius: var(--skin-radius-card);
  overflow: hidden;
}

/* Radius bottom left regular.
 * sets the outline/corner shape.
 * Source rule 3335.
 */
.radius-bottom-left-regular {
  border-bottom-left-radius: var(--global-radius-regular);
}

/* Radius bottom right regular.
 * sets the outline/corner shape.
 * Source rule 3336.
 */
.radius-bottom-right-regular {
  border-bottom-right-radius: var(--global-radius-regular);
}

/* Radius top left regular.
 * sets the outline/corner shape.
 * Source rule 3337.
 */
.radius-top-left-regular {
  border-top-left-radius: var(--global-radius-regular);
}

/* Radius top right regular.
 * sets the outline/corner shape.
 * Source rule 3338.
 */
.radius-top-right-regular {
  border-top-right-radius: var(--global-radius-regular);
}

/* Recomended match prep session label.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3339.
 */
.recomended-match-prep-session-label {
  padding: var(--padding-padding-2) var(--global-gap-regular);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
  justify-content: center;
  border-radius: var(--border-radius-radius-16);
  flex-direction: var(--row-direction-normal);
  align-self: flex-start;
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.rectangle-729 {
  height: 30px;
  background-color: var(--skin-selection-background);
  border-radius: var(--skin-radius-small);
  color: var(--skin-selection-foreground);
}

/* Rectangle 925.
 * sets the background fill; controls size/placement.
 * Source rule 3370.
 */
.rectangle-925 {
  width: 1366px;
  height: 900px;
  background-color: var(--skin-surface-canvas-alpha-40);
  flex-shrink: 0;
}

/* Red card block.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3372.
 */
.red-card-block {
  background-color: var(--skin-component-red-card-block-background);
  border-radius: 0;
}

/* Red card block bundesliga.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3373.
 */
.red-card-block-bundesliga {
  height: 100%;
  background-color: var(--skin-data-red-card-block-bundesliga-background);
  border-radius: 0;
}

/* Red card block efl.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3374.
 */
.red-card-block-efl {
  height: 100%;
  background-color: var(--skin-data-red-card-block-efl-background);
  border-radius: 0;
}

/* Red card block eufa.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3375.
 */
.red-card-block-eufa {
  height: 100%;
  background-color: var(--skin-component-red-card-block-eufa-background);
  border-radius: 0;
}

/* Red card block fifa.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3376.
 */
.red-card-block-fifa {
  width: 6px;
  height: 8px;
  background-color: var(--skin-component-red-card-block-fifa-background);
  border-radius: 0;
  flex-shrink: 0;
  margin-left: 2px;
  margin-right: 2px;
}

/* Regular horizontal container.
 * controls size/placement.
 * Source rule 3377.
 */
.regular-horizontal-container {
  height: 24px;
  flex-direction: var(--row-direction-normal);
}

/* Regular horizontal container center all.
 * controls size/placement.
 * Source rule 3378.
 */
.regular-horizontal-container-center-all {
  height: 24px;
  justify-content: center;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* Relationship with you icon colour close.
 * tints background artwork.
 * Source rule 3379.
 */
.relationship-with-you-icon-colour-close {
  -unity-background-image-tint-color: var(--colours-base-teal-soft);
}

/* Relationship with you icon colour no relationship.
 * tints background artwork.
 * Source rule 3380.
 */
.relationship-with-you-icon-colour-no-relationship {
  -unity-background-image-tint-color: var(--colours-base-blue-soft);
}

/* Relationship with you text colour close.
 * Changes text/foreground colour.
 * Source rule 3381.
 */
.relationship-with-you-text-colour-close {
  color: var(--colours-base-teal-soft);
}

/* Report card FM menu load game.
 * controls size/placement.
 * Source rule 3382.
 */
.report-card-fm-menu_load-game {
  width: 1000px;
  height: 704px;
  align-items: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.rectangle-729 .sitext,
.rectangle-729 .sitextmedium,
.rectangle-729 .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Spacing Layout
 * Reusable geometry, spacing, borders and colour helper classes.
 */

/* Scaling icon grades background colour a.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3425.
 */
.scaling-icon-grades-background-colour-a {
  height: 20px;
  padding: 0 var(--spacing-padding-small---8);
  background-color: var(--colours-linear-scale-strong-10-alpha-16);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--numbers-border-radius-medium-small);
}

/* Scaling icon grades background colour b.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3426.
 */
.scaling-icon-grades-background-colour-b {
  height: 20px;
  padding: 0 var(--spacing-padding-small---8);
  background-color: var(--colours-linear-scale-strong-8-alpha-16);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--numbers-border-radius-medium-small);
}

/* Scaling icon grades background colour c.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
