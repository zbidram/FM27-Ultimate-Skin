/* Advance start info block warning.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1007.
 */
.advance-start-info-block-warning {
  padding: 12px 16px;
  border-width: 1px;
  border-color: var(--skin-component-advance-start-info-block-warning-border-color);
  background-color: var(--skin-component-advance-start-info-block-warning-background);
  align-items: center;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
}

/* Stepper step selected.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1008.
 */
.advance-start-leagues-stepper-color-negative .stepper-step--selected,
.match-rule-failing-progressbar-bg-colour .progress-bar-value,
.transfer-window-progress-timeline-closed:enabled {
  background-color: var(--communication-feedback-negative);
}

/* Stepper step selected.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1009.
 */
.advance-start-leagues-stepper-color-positive .stepper-step--selected,
.transfer-window-progress-timeline-open:enabled {
  background-color: var(--communication-feedback-positive);
}

/* Advanced start bottom panel phone color.
 * sets the background fill.
 * Source rule 1010.
 */
.advanced-start-bottom-panel-phone-color {
  background-color: var(--skin-surface-canvas-alpha-85);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1011.
 */
.advanced-start-date-dropdown .si-dropdown__selection-field {
  padding: 0px var(--spacing-tiles);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  align-items: center;
  border-radius: var(--spacing-small---8);
  flex-direction: var(--row-direction-normal);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Aerial threats property 1 default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1012.
 */
.aerial-threats-property-1-default {
  padding: 4px;
  background-color: var(--colours-base-grey-strong);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-small);
  margin-right: var(--spacing-padding-small---8);
}

/* Selectable selected.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1013.
 */
.affiliated-club-entry-selectable .selectable--selected,
.meeting-cell-selectable .selectable--selected {
  padding: 0;
  border-width: 0;
  border-radius: 0;
