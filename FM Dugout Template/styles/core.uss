/* Base layer content.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 549.
 */
.panel--open .base-layer-content,
.panel--show .base-layer-content {
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.2s;
  transition-delay: 0.3s;
  transition-timing-function: ease-in-out-sine;
}

/* Base layer content.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 550.
 */
.panel--close .base-layer-content,
.panel--hide .base-layer-content {
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.2s;
  transition-delay: 0.3s;
  transition-timing-function: ease-in-out-sine;
}

/* Card frame.
 * changes opacity for the whole element and its contents.
