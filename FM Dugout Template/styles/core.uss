}

/* Border top divider.
 * sets the outline/corner shape.
 * Source rule 1292.
 */
.border-top-divider {
  border-color: var(--skin-border-subtle);
  border-top-width: var(--global-border-width-thin);
}

/* Breadcrumbs section button.
 * Changes text/foreground colour; sets the background fill; tints background artwork; sets the
 * outline/corner shape.
 * Source rule 1293.
 */
.breadcrumbs-section-button {
  opacity: 1;
  width: auto;
  background-color: var(--skin-transparent);
  color: var(--skin-transparent);
  flex-grow: 1;
  padding-top: 7px;
  padding-bottom: 7px;
  margin-right: 0;
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-bottom-left-radius: 0;
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
  -unity-background-image-tint-color: var(--skin-transparent);
  -unity-text-outline-color: var(--skin-transparent);
  margin-left: 0;
  padding-left: 0;
  border-top-left-radius: 0;
  padding-right: 0;
}

/* Breadcrumbs section name.
 * Changes text/foreground colour; controls size/placement.
 * Source rule 1294.
 */
.breadcrumbs-section-name {
  color: var(--skin-text-primary);
  align-items: center;
}

/* Breadcrumbs section seperation.
 * Changes text/foreground colour; controls size/placement; sets spacing around/inside the element; changes
 * opacity for the whole element and its contents.
 * Source rule 1295.
 */
.breadcrumbs-section-seperation {
  opacity: 0.25;
