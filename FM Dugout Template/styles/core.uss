}

/* Tactics pitch block.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 317.
 */
.tactics-pitch-block {
  border-width: 2px;
  background-color: var(--pitch-tile-default-background);
  margin-left: 4px;
  margin-right: 4px;
  margin-top: 4px;
  margin-bottom: 4px;
  flex-direction: column;
  flex-wrap: nowrap;
  border-radius: var(--skin-radius-medium);
  border-left-color: var(--skin-data-tactics-pitch-block-border-left-color);
  border-right-color: var(--skin-data-tactics-pitch-block-border-right-color);
  border-top-color: var(--skin-data-tactics-pitch-block-border-top-color);
  border-bottom-color: var(--skin-data-tactics-pitch-block-border-bottom-color);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-top-left-radius: var(--skin-radius-card);
  border-bottom-left-radius: var(--skin-radius-card);
  border-top-right-radius: var(--skin-radius-card);
  border-bottom-right-radius: var(--skin-radius-card);
  overflow: hidden;
  padding-top: 12px;
  padding-right: 12px;
  padding-bottom: 12px;
  padding-left: 12px;
}

/* Segment.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 318.
 */
.default-segmented-display-selector .segment {
  height: 2px;
  background-color: var(--skin-on-media-alpha-25);
  border-radius: var(--skin-radius-micro);
  margin-left: 2px;
  margin-right: 2px;
  align-self: center;
}

/* Segment selected.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 319.
 */
.default-segmented-display-selector .segment--selected {
  height: 4px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-component-default-segmented-display-selector-segment-selected-background);
  border-radius: var(--skin-radius-small);
  margin-left: 2px;
  margin-right: 2px;
  align-self: center;
}

/* Stepper.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 320.
 */
.stepper {
  min-height: 4px;
  flex-direction: var(--row-direction-normal);
  border-radius: var(--skin-radius-micro);
  overflow: hidden;
}

/* Stepper step.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 321.
 */
.stepper-step {
  width: 100%;
  height: 4px;
  background-color: var(--skin-on-media-alpha-25);
  margin-right: 3px;
  align-self: center;
  min-width: 10px;
}

/* Interest cell stepper.
 * controls size/placement.
 * Source rule 322.
 */
.interest-cell-stepper {
  flex-direction: column-reverse;
}

/* Stepper step.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 323.
 */
.interest-cell-stepper .stepper-step {
  height: 4px;
  margin-bottom: 1px;
  margin-right: 2px;
  margin-left: 2px;
  border-radius: var(--numbers-border-radius-extra-small);
}

/* Interest cell.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 324.
 */
.interest-cell {
  width: 24px;
  height: 24px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-16);
  border-radius: var(--numbers-border-radius-small);
}

/* Stepper step selected.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 326.
 */
.stepper-step--selected {
  height: 4px;
  background-color: var(--skin-component-stepper-step-selected-background);
  margin-right: 3px;
  align-self: center;
}

/* Stepper step last.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 327.
 */
.stepper-step--selected .stepper-step--last,
.stepper-step .stepper-step--last {
  margin-right: 0px;
}

/* Stepper step last.
 * sets the outline/corner shape.
 * Source rule 328.
 */
.stepper-step--last {
  border-top-right-radius: var(--skin-radius-micro);
  border-top-left-radius: 0px;
  border-bottom-right-radius: var(--skin-radius-micro);
  border-bottom-left-radius: 0px;
}

/* Stepper step first.
 * sets the outline/corner shape.
 * Source rule 329.
 */
.stepper-step--first {
  border-top-right-radius: 0px;
  border-top-left-radius: var(--skin-radius-micro);
  border-bottom-right-radius: 0px;
  border-bottom-left-radius: var(--skin-radius-micro);
}

/* Item border style.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 330.
 */
.item_border_style {
  border-top-right-radius: var(--skin-radius-medium);
  border-top-left-radius: var(--skin-radius-medium);
  border-bottom-right-radius: var(--skin-radius-medium);
  border-bottom-left-radius: var(--skin-radius-medium);
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  margin-left: 5px;
  margin-right: 5px;
  margin-top: 5px;
  margin-bottom: 5px;
}

/* Stepper step selected border.
 * sets the outline/corner shape.
 * Source rule 331.
 */
.stepper-step--selected-border {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  border-radius: var(--skin-radius-micro);
}

/* Card header.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 332.
 */
.card-header {
  height: 30px;
  background-color: var(--skin-transparent);
  margin-left: 12px;
  margin-right: 12px;
  margin-top: 8px;
  margin-bottom: 8px;
  flex-direction: var(--row-direction-normal);
}

/* Siradialgauge.
 * controls size/placement.
 * Source rule 333.
 */
.siradialgauge {
  width: 32px;
  height: 32px;
  flex-direction: var(--row-direction-normal);
  justify-content: center;
  --track-width: 4;
  --track-colour: var(--skin-on-media-alpha-35);
  --current-colour: var(--skin-component-siradialgauge-current-colour);
  --increasing-colour: var(--skin-component-siradialgauge-increasing-colour);
  --decreasing-colour: var(--skin-component-siradialgauge-decreasing-colour);
}

/* Siradialgauge xlarge.
 * controls size/placement.
 * Source rule 334.
 */
.siradialgauge_xlarge {
  width: 64px;
  height: 64px;
  --track-width: 8;
}

/* Sigradient.
 * sets the gradient colours drawn by this component.
 * Source rule 335.
 */
.sigradient {
  overflow: hidden;
  --start-colour: var(--skin-surface-raised);
  --end-colour: var(--skin-transparent);
}

/* Neutral selected rows retain each child's foreground contract. Do not force
 * primary text onto every descendant: player-status pills need dark ink on
 * pale/bright fills, and football/status values keep their semantic colours.
 * The selected row's own foreground and surface are paired in its native rule. */

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Siscatterchart.
 * sets font/text presentation; controls size/placement.
 * Source rule 350.
 */
.siscatterchart {
  width: 100%;
  flex-grow: 1;
  flex-shrink: 1;
  flex-direction: var(--row-direction-normal);
  justify-content: center;
  --axis-colour: var(--skin-on-media-alpha-60);
  --axis-font-size: 12;
  --axis-width: 1;
  --positive-text-colour: var(--skin-data-siscatterchart-positive-text-colour);
  --neutral-text-colour: var(--skin-data-siscatterchart-neutral-text-colour);
  --negative-text-colour: var(--skin-data-siscatterchart-negative-text-colour);
  -unity-font-definition: var(--skin-font-body);
}

/* Sixgchart.
 * sets font/text presentation; controls size/placement.
 * Source rule 351.
 */
.sixgchart {
  width: 100%;
  flex-grow: 1;
  flex-shrink: 1;
  flex-direction: var(--row-direction-normal);
  --axis-colour: var(--skin-on-media-alpha-60);
  --axis-font-size: 12;
  --axis-width: 1;
  --xg-line-width: 2;
  -unity-font-definition: var(--skin-font-body);
}

/* SI match momentum chart.
 * sets font/text presentation; controls size/placement.
 * Source rule 352.
 */
.si-match-momentum-chart {
  width: 100%;
  flex-grow: 1;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  --axis-colour: var(--skin-on-media-alpha-65);
  --axis-font-size: 12;
  --axis-width: 1;
  --momentum-block-outline-colour: var(--skin-on-media-alpha-35);
  --momentum-block-outline-size: 1;
  -unity-font-definition: var(--skin-font-body);
}

/* SI match momentum chart goal icon size.
 * controls size/placement.
 * Source rule 353.
 */
.si-match-momentum-chart-goal-icon-size {
  width: 16px;
  height: 16px;
  flex-grow: 1;
  flex-shrink: 0;
}

/* Icon size small.
 * controls size/placement.
 * Source rule 354.
 */
.icon-size-small {
  width: 16px;
  height: 16px;
}

/* Icon size medium.
 * controls size/placement.
 * Source rule 355.
 */
.icon-size-medium {
  width: 24px;
  height: 24px;
}

/* Highlighting.
 * Changes text/foreground colour; defines how state changes animate.
 * Source rule 356.
 */
.highlighting {
  color: var(--skin-surface-canvas-alpha-48);
  transition-property: opacity;
  transition-duration: 0.33s;
  transition-timing-function: ease-in-out-sine, ease-in-out-sine;
}

/* Highlighting frame.
 * sets the outline/corner shape.
 * Source rule 357.
 */
.highlighting-frame {
  border-width: 3px;
  border-color: var(--colours-base-teal-50);
  border-radius: var(--skin-radius-control);
}

/* Unity radio button group container.
 * controls size/placement.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 358.
 */
.horizontal-radio-group .unity-radio-button-group__container,
.wrap-buttons-mode .unity-radio-button-group__container,
.wrapped-object-list {
  flex-direction: var(--row-direction-normal);
  flex-wrap: wrap;
}

/* Unity radio button — checked/selected.
 * sets the outline/corner shape.
 * Source rule 359.
 */
.horizontal-radio-group .unity-radio-button:checked {
  border-color: var(--skin-component-horizontal-radio-group-unity-radio-button-checked-border-color);
}

/* Toggle group checkbox style.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 360.
 */
.enumtogglegroup-selector .toggle_group-checkbox-style {
  width: 16px;
  height: 16px;
  border-color: var(--skin-text-primary);
  flex-shrink: 0;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-top-left-radius: var(--skin-radius-micro);
  border-top-right-radius: var(--skin-radius-micro);
  border-bottom-right-radius: var(--skin-radius-micro);
  border-bottom-left-radius: var(--skin-radius-micro);
  align-self: center;
}

/* Unity toggle checkmark.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 361.
 */
.enumtogglegroup-selector .toggle_group-checkbox-style .unity-toggle__checkmark {
  width: 16px;
  height: 16px;
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* Unity toggle input.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 362.
 */
.enumtogglegroup-selector .toggle_group-checkbox-style .unity-toggle__input {
  width: 16px;
  height: 16px;
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
}

/* Unity toggle checkmark — checked/selected.
 * sets the background fill.
 * Source rule 363.
 */
.enumtogglegroup-selector .toggle_group-checkbox-style:checked .unity-toggle__checkmark {
  background-color: var(--skin-text-primary);
}

/* Toggle group checkbox style — pressed, checked/selected.
 * sets the background fill.
 * Source rule 364.
 */
.enumtogglegroup-selector .toggle_group-checkbox-style:checked:active {
  background-color: var(--skin-on-media-alpha-35);
}

/* Toggle group checkbox style — pointer hover, checked/selected.
 * sets the background fill.
 * Source rule 365.
 */
.enumtogglegroup-selector .toggle_group-checkbox-style:checked:hover {
  background-color: var(--skin-on-media-alpha-16);
}

/* Toggle group checkbox style — pointer hover.
 * sets the background fill.
 * Source rule 366.
 */
.enumtogglegroup-selector .toggle_group-checkbox-style:hover {
  background-color: var(--skin-surface-panel);
}

/* Unity content container.
 * controls size/placement.
 * Source rule 367.
 */
.principletogglegroup-selector > .siscrollview > #unity-content-and-vertical-scroll-container > #unity-content-viewport > #unity-content-container {
  flex-direction: var(--row-direction-normal);
}

/* Item container style.
 * controls size/placement.
 * Source rule 368.
 */
.principletogglegroup-selector .item_container_style {
  flex-wrap: wrap;
  flex-direction: var(--row-direction-normal);
}

/* Item style.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 369.
 */
.principletogglegroup-selector .item_style {
  height: 80px;
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  border-radius: var(--skin-radius-card);
  flex-basis: 40%;
  flex-grow: 1;
  margin-left: 8px;
  margin-right: 8px;
  margin-top: 4px;
  margin-bottom: 4px;
}

/* Item style selected.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 370.
 */
.principletogglegroup-selector .item_style__selected {
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
}

/* Item style selected — pointer hover.
 * sets the outline/corner shape.
 * Source rule 371.
 */
.principletogglegroup-selector .item_style__selected:hover {
  border-width: 1px;
  border-radius: var(--skin-radius-card);
}

/* SI visible flex autosize vertical.
 * controls size/placement.
 * Source rule 372.
 */
.si-visible-flex-autosize-vertical {
  flex-grow: initial;
  flex-shrink: 0;
  flex-direction: column;
}

/* SI visible flex autosize horizontal.
 * controls size/placement.
 * Source rule 373.
 */
.si-visible-flex-autosize-horizontal {
  flex-grow: initial;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* SI visible justify start.
 * controls size/placement.
 * Source rule 374.
 */
.si-visible-justify-start {
  justify-content: flex-start;
}

/* SI visible justify center.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 375.
 */
.si-visible-justify-center,
.sibutton-centered-content > .sibutton {
  justify-content: center;
}

/* SI visible justify end.
 * controls size/placement.
 * Source rule 376.
 */
.si-visible-justify-end {
  justify-content: flex-end;
}

/* SI radial menu.
 * supplies local values read by the component styling.
 * Source rule 377.
 */
.si-radial-menu {
  --highlight-colour-transparent: var(--skin-component-si-radial-menu-highlight-colour-transparent);
  --highlight-colour-opaque: var(--skin-brand-accent);
  --base-colour: var(--skin-surface-panel-alpha-75);
  --divider-start-colour: var(--skin-surface-canvas-alpha-30);
  --divider-end-colour: var(--skin-surface-canvas-alpha-20);
  --divider-start-time: 0.1;
  --divider-end-time: 0.9;
  --divider-width: 4;
}

/* SI radial menu background.
 * sets the background fill.
 * Source rule 378.
 */
.si-radial-menu-background {
  background-color: var(--skin-surface-canvas-alpha-75);
}

/* SI radial menu selector.
 * controls size/placement.
 * Source rule 379.
 */
.si-radial-menu-selector > TemplateContainer {
  position: absolute;
  transform-origin: center;
  top: -1%;
  right: 0;
  left: 0;
  align-items: center;
}

/* Sitext.
 * sets font/text presentation.
 * Source rule 380.
 */
.si-radial-menu-selector > TemplateContainer > * > .sitext {
  font-size: var(--typography-size-16);
  -unity-text-align: middle-center;
}

/* SI combobox.
 * controls size/placement.
 * Source rule 381.
 */
.si-combobox {
  flex-direction: column;
  flex-shrink: 1;
  min-height: 25px;
  min-width: 180px;
  overflow: visible;
}

/* SI combobox preview element.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 382.
 */
.si-combobox__preview-element {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-bold);
  padding-left: 5px;
  padding-right: 24px;
  padding-top: 5px;
  padding-bottom: 5px;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 1;
  white-space: nowrap;
  -unity-text-align: middle-left;
  -unity-font-definition: var(--skin-font-body);
  flex-grow: 1;
}

/* SI combobox selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 383.
 */
.si-combobox__selection-field {
  background-color: var(--skin-transparent);
  border-left-width: 2px;
  border-right-width: 2px;
  border-top-width: 2px;
  border-bottom-width: 2px;
  border-left-color: var(--skin-on-media-alpha-40);
  border-right-color: var(--skin-on-media-alpha-40);
  border-top-color: var(--skin-on-media-alpha-40);
  border-bottom-color: var(--skin-on-media-alpha-40);
  border-radius: var(--skin-radius-small);
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
}

/* SI combobox input field.
 * sets the outline/corner shape; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 384.
 */
.si-combobox__input-field {
  margin: 0;
  padding: 0;
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  padding-top: 5px;
  padding-right: 5px;
  padding-bottom: 5px;
  padding-left: 5px;
  border-top-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
  border-top-width: 2px;
  border-right-width: 2px;
  border-bottom-width: 2px;
  border-left-width: 2px;
  border-left-color: var(--skin-on-media-alpha-40);
  border-right-color: var(--skin-on-media-alpha-40);
  border-top-color: var(--skin-on-media-alpha-40);
  border-bottom-color: var(--skin-on-media-alpha-40);
}

/* Unity text input.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 385.
 */
.si-combobox__input-field #unity-text-input {
  padding: 0;
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-right-radius: 0;
  border-bottom-left-radius: 0;
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* SI combobox binding root.
 * controls size/placement.
 * Source rule 386.
 */
.si-combobox__binding-root {
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
}

/* SI combobox button.
 * Changes text/foreground colour; sets the outline/corner shape; sets font/text presentation; controls
 * size/placement.
 * Source rule 387.
 */
.si-combobox__button {
  color: var(--skin-text-primary);
  border-top-width: 2px;
  border-right-width: 2px;
  border-bottom-width: 2px;
  border-left-width: 2px;
  border-top-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
  border-left-color: var(--skin-on-media-alpha-40);
  border-right-color: var(--skin-on-media-alpha-40);
  border-top-color: var(--skin-on-media-alpha-40);
  border-bottom-color: var(--skin-on-media-alpha-40);
  flex-grow: 0;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  overflow: visible;
  -unity-text-align: middle-center;
  margin-top: 0;
  margin-bottom: 0;
  margin-right: 0;
  margin-left: 0;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
  flex-direction: column;
  min-width: 32px;
  min-height: 32px;
}

/* SI bindable text edit box password button.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 388.
 */
.si-bindable-text-edit-box-password__button {
  width: 16px;
  height: 16px;
  padding: 0;
  background-color: var(--skin-transparent);
  flex-direction: var(--row-direction-normal);
  align-self: center;
  flex-grow: 0;
  flex-shrink: 0;
  margin-top: 0;
  margin-bottom: 0;
  margin-right: 0;
  margin-left: 4px;
}

/* SI combobox lower button.
 * controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 389.
 */
.si-combobox__lower-button,
.si-combobox__raise-button {
  align-self: flex-start;
  margin-right: 2px;
  margin-left: 2px;
  margin-top: 0;
  margin-bottom: 0;
}

/* Section button iphone.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 390.
 */
.section-button-iphone {
  width: 52px;
  height: 52px;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-page);
  border-radius: 360px;
  justify-content: center;
}

/* Section button iphone image.
 * controls size/placement.
 * Source rule 391.
 */
.section-button-iphone__image {
  width: 26px;
  height: 26px;
  align-self: center;
}

/* Item style.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 392.
 */
.inputs-hybrid-ios-combobox-type-multi-selector .item_style {
  width: auto;
  height: auto;
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  align-items: center;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
  margin-bottom: 8px;
  flex-direction: var(--row-direction-normal);
}

/* Item style selected.
 * sets the background fill.
 * Source rule 393.
 */
.inputs-hybrid-ios-combobox-type-multi-selector .item_style__selected {
  background-color: var(--skin-on-media-alpha-14);
}

/* Unity toggle.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 394.
 */
.inputs-hybrid-ios-combobox-type-multi-selector .unity-toggle,
.inputs-hybrid-ios-combobox-type-multi-selector .unity-toggle__checkmark {
  width: 16px;
  height: 16px;
}

/* Controller shortcut list.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 395.
 */
.controller-shortcut-list {
  align-items: flex-end;
  min-height: 32px;
  margin-bottom: 8px;
}

/* SI dropdown selection field.
 * sets the background fill; sets the background artwork; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 396.
 */
.si-card-title-bar .si-dropdown__selection-field {
  border-width: 0;
  background-color: var(--skin-transparent);
  background-image: none;
  border-radius: 0;
  padding-bottom: 1px;
  padding-right: 3px;
  padding-left: 3px;
  padding-top: 1px;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  flex-grow: 1;
}

/* Sitexttitle.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 397.
 */
.sitexttitle {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-30);
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
}

/* Unity radio button group child active.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 398.
 */
.mentoring-group-list .unity-radio-button-group__child-active {
  border-color: var(--skin-component-mentoring-group-list-unity-radio-button-group-child-active-border-color);
  background-color: var(--skin-component-mentoring-group-list-unity-radio-button-group-child-active-background);
}

/* Notification.
 * sets the native component presentation.
 * Source rule 399.
 */
.panel .notification {
  translate: 0 -200px;
}

/* Notification.
 * defines how state changes animate.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 400.
 */
.panel--open .notification,
.panel--show .notification,
.panel--show .shortcuts-panel {
  transition-property: translate;
  transition-duration: 0.33s;
  transition-timing-function: ease-in-out;
  translate: 0 0;
}

/* Notification.
 * defines how state changes animate.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 401.
 */
.panel--close .notification,
.panel--hide .notification {
  transition-property: translate;
  transition-duration: 0.33s;
  transition-timing-function: ease-in-out;
  translate: 0 -200px;
}

/* Navigation header gradient.
 * controls size/placement.
 * Source rule 402.
 */
.navigation-header-gradient {
  position: absolute;
  height: 100%;
  left: 0;
  flex-grow: 1;
}

/* Messages header gradient.
 * controls size/placement.
 * Source rule 403.
 */
.messages-header-gradient {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  flex-grow: 1;
}

/* Messages header time stamp.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 404.
 */
.messages-header-time-stamp {
  height: 32px;
  padding: var(--padding-padding-0) var(--padding-padding-8);
  background-color: var(--skin-surface-page);
  border-radius: var(--border-radius-radius-4);
  align-items: center;
  justify-content: center;
}

/* Messages header texture club.
 * controls size/placement.
 * Source rule 405.
 */
.messages-header-texture-club {
  position: absolute;
  width: 240px;
  height: 60px;
  right: 0;
  top: 0;
  flex-grow: 1;
}

/* Navigation texture width.
 * controls size/placement.
 * Source rule 406.
 */
.navigation-texture-width {
  width: 120px;
}

/* Notification card.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 407.
 */
.notification-card {
  position: absolute;
  width: 700px;
  height: 100px;
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-08);
  background-color: var(--skin-surface-canvas-alpha-58);
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-card);
  border-left-color: var(--skin-text-secondary);
  border-right-color: var(--skin-text-secondary);
  border-top-color: var(--skin-text-secondary);
  border-bottom-color: var(--skin-text-secondary);
  border-top-width: 4px;
  border-right-width: 4px;
  border-bottom-width: 4px;
  border-left-width: 4px;
  margin-top: 20px;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
  padding-top: 16px;
  padding-right: 16px;
  padding-bottom: 16px;
  padding-left: 16px;
  left: -350px;
}

/* Notification description.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 408.
 */
.notification-description {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-regular);
  padding-left: 10px;
  padding-right: 75px;
  padding-top: 10px;
  padding-bottom: 10px;
  white-space: normal;
  -unity-text-align: upper-left;
  -unity-font-definition: var(--skin-font-body);
  flex-grow: 1;
}

/* Notification title.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 409.
 */
.notification-title {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-bold);
  padding-left: 10px;
  padding-right: 75px;
  padding-top: 10px;
  padding-bottom: 0;
  white-space: nowrap;
  -unity-text-align: middle-left;
  -unity-font-definition: var(--skin-font-body);
}

/* Dialog card.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 410.
 */
.dialog-card {
  width: 300px;
  height: 174px;
  background-color: var(--skin-surface-strong);
  border-top-left-radius: var(--skin-radius-shell);
  border-bottom-left-radius: var(--skin-radius-shell);
  border-top-right-radius: var(--skin-radius-shell);
  border-bottom-right-radius: var(--skin-radius-shell);
  border-left-width: 4px;
  border-right-width: 4px;
  border-top-width: 4px;
  border-bottom-width: 4px;
  border-left-color: var(--skin-on-media-alpha-62);
  border-right-color: var(--skin-on-media-alpha-62);
  border-top-color: var(--skin-on-media-alpha-62);
  border-bottom-color: var(--skin-on-media-alpha-62);
}

/* Dialog card title.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 411.
 */
.dialog-card-title {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-16);
  margin-top: 16px;
  margin-right: 8px;
  margin-bottom: 8px;
  margin-left: 8px;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: upper-center;
}

/* Dialog body.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 412.
 */
.dialog-body {
  color: var(--skin-text-primary);
  flex-wrap: wrap;
  margin-top: 8px;
  margin-right: 8px;
  margin-bottom: 8px;
  margin-left: 8px;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: upper-center;
  padding-top: 8px;
  flex-grow: 1;
}

/* Dialog button.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 413.
 */
.dialog-button {
  width: 100px;
  height: 30px;
  background-color: var(--skin-on-media-alpha-21);
  color: var(--skin-text-primary);
  margin-top: 4px;
  margin-right: 4px;
  margin-bottom: 4px;
  margin-left: 4px;
  bottom: 12px;
  align-self: center;
  padding-top: 8px;
  padding-right: 8px;
  padding-bottom: 8px;
  padding-left: 8px;
  -unity-font-definition: var(--skin-font-body);
  border-left-color: var(--skin-text-secondary);
  border-right-color: var(--skin-text-secondary);
  border-top-color: var(--skin-text-secondary);
  border-bottom-color: var(--skin-text-secondary);
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-top-left-radius: var(--skin-radius-control);
  border-top-right-radius: var(--skin-radius-control);
  border-bottom-right-radius: var(--skin-radius-control);
  border-bottom-left-radius: var(--skin-radius-control);
}

/* Unity toggle checkmark.
 * sets the background fill; sets the background artwork; tints background artwork; sets the outline/corner
 * shape.
 * Source rule 414.
 */
.multi-selection-dropdown-row .unity-toggle__checkmark {
  width: 16px;
  height: 16px;
  border-width: 0;
  background-color: var(--skin-transparent);
  background-image: none;
  -unity-background-image-tint-color: var(--skin-on-media);
}

/* Multi selection dropdown row.
 * sets spacing around/inside the element.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 415.
 */
.multi-selection-dropdown-row,
.date-selector-grid-element__active,
.date-selector-grid-element__inactive {
  margin: 0;
}

/* Unity toggle input.
 * controls size/placement.
 * Source rule 416.
 */
.multi-selection-dropdown-row .unity-toggle__input {
  flex-grow: 0;
  flex-basis: auto;
}

/* Tabbed grid layout tab button container default.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 417.
 */
.tabbed-grid-layout-tab-button-container-default {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  align-self: center;
  justify-content: center;
  margin-bottom: 8px;
  margin-top: 8px;
}

/* Tabbed grid layout tab button container default no margin.
 * controls size/placement.
 * Source rule 418.
 */
.tabbed-grid-layout-tab-button-container-default-no-margin {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  align-self: center;
  justify-content: center;
}

/* Tabbed grid layout tab button container flex start no margin no padding.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 419.
 */
.tabbed-grid-layout-tab-button-container-flex-start-no-margin-no-padding {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  align-self: var(--flex-start-normal);
  padding-bottom: 0px;
  padding-top: 0px;
  margin-bottom: 0px;
  margin-top: 2px;
}

/* Tabbed grid layout tab button container flex start centered.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 420.
 */
.tabbed-grid-layout-tab-button-container-flex-start-centered {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  align-self: var(--flex-start-normal);
  align-items: center;
  margin-left: var(--global-gap-large);
}

/* Tabbed grid layout tab button container flex start.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 421.
 */
.tabbed-grid-layout-tab-button-container-flex-start {
  padding: 0px;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  align-self: var(--flex-start-normal);
  margin-left: var(--global-padding-regular);
  margin-right: var(--global-padding-huge);
  overflow: hidden;
  margin-top: var(--global-padding-extra-large);
}

/* UI concepts chevron down small.
 * Hides these elements; sets spacing around/inside the element.
 * Source rule 422.
 */
.dropdowniconremove .ui-concepts-chevron-down_small {
  display: none;
  margin-left: 0px;
  margin-right: 0px;
}

/* Entity background header.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 423.
 */
.entity-background-header {
  background-color: var(--skin-surface-canvas-alpha-20);
  border-bottom-width: 1px;
  border-bottom-color: var(--skin-surface-canvas-alpha-20);
}

/* Assist styling match events.
 * controls size/placement; changes opacity for the whole element and its contents.
 * Source rule 424.
 */
.assist-styling-match-events {
  opacity: 0.54;
  max-width: 10px;
  max-height: 10px;
}

/* Lift background block.
 * sets the background fill.
 * Source rule 425.
 */
.lift-background-block {
  background-color: var(--skin-surface-strong);
}

/* Tabbed grid layout tab button container flex start.
 * sets spacing around/inside the element.
 * Source rule 426.
 */
.preferences-card-tab-padding .tabbed-grid-layout-tab-button-container-flex-start {
  padding-left: var(--global-padding-preferences-tabs);
}

/* Tabbed grid layout tab button container flex start extra tab flex end.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 427.
 */
.tabbed-grid-layout-tab-button-container-flex-start-extra-tab-flex-end {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  align-self: stretch;
  padding-left: 12px;
}

/* Extra Tab Template.
 * controls size/placement.
 * Source rule 428.
 */
.tabbed-grid-layout-tab-button-container-flex-start-extra-tab-flex-end > #ExtraTabTemplate {
  align-self: stretch;
  align-items: var(--flex-end-normal);
  flex-grow: 1;
}

/* Status Flags.
 * controls size/placement.
 * Source rule 429.
 */
#StatusFlags > TemplateContainer {
  flex-shrink: 0;
}

/* Extra Tab Template.
 * sets spacing around/inside the element.
 * Source rule 430.
 */
#ExtraTabTemplate {
  padding-right: 12px;
}

/* Tabbed grid layout tab button container space between.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 431.
 */
.tabbed-grid-layout-tab-button-container-space-between {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  flex-grow: 1;
  align-self: stretch;
  justify-content: space-between;
  margin-bottom: 16px;
}

/* Tabbed grid layout tab button extra tab flex end.
 * controls size/placement.
 * Source rule 432.
 */
.tabbed-grid-layout-tab-button-extra-tab-flex-end {
  align-self: var(--flex-end-normal);
}

/* SI news message read.
 * tints background artwork.
 * Source rule 433.
 */
.si-news-message-read {
  -unity-background-image-tint-color: var(--skin-component-si-news-message-read-image-tint);
}

/* Pivotal moment answer button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 434.
 */
.pivotal-moment-answer-button {
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  flex-direction: column;
  justify-content: center;
  align-items: var(--flex-start-normal);
  align-self: stretch;
  border-radius: var(--skin-radius-control);
  margin-bottom: var(--spacing-small---8, 8px);
}

/* Match event away.
 * controls size/placement.
 * Source rule 435.
 */
.match-event-away {
  flex-direction: var(--row-direction-reverse);
}

/* Unity text element inner input field component.
 * controls size/placement.
 * Source rule 436.
 */
.bindableeditbox > .unity-text-element--inner-input-field-component {
  flex-grow: 1;
  flex-shrink: 0;
}

/* Sicontainer two columns align.
 * sets the outline/corner shape; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 437.
 */
.sicontainer_two_columns_align {
  width: 42%;
  border-width: 2px;
  font-size: var(--typography-size-14);
  margin-left: 4px;
  margin-right: 4px;
  margin-top: 4px;
  margin-bottom: 4px;
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  flex-direction: var(--row-direction-reverse);
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  border-radius: var(--skin-radius-medium);
  border-left-color: var(--skin-on-media-alpha-25);
  border-right-color: var(--skin-on-media-alpha-25);
  border-top-color: var(--skin-on-media-alpha-25);
  border-bottom-color: var(--skin-on-media-alpha-25);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-top-left-radius: var(--skin-radius-card);
  border-bottom-left-radius: var(--skin-radius-card);
  border-top-right-radius: var(--skin-radius-card);
  border-bottom-right-radius: var(--skin-radius-card);
  overflow: hidden;
  padding-top: 12px;
  padding-right: 12px;
  padding-bottom: 12px;
  padding-left: 12px;
}

/* SI combobox preview element chevron.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 438.
 */
.si-combobox__preview-element-chevron {
  position: absolute;
  width: 16px;
  height: 100%;
  margin-right: 8px;
  -unity-background-scale-mode: scale-to-fit;
  transform-origin: center;
  right: 0;
  flex-direction: var(--row-direction-normal);
  align-self: flex-end;
  align-items: flex-end;
  flex-grow: 0;
}

/* SI enabled full opacity.
 * changes opacity for the whole element and its contents.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 439.
 */
.si-enabled-full-opacity,
.panel--visible .panel-fade,
.panel--visible .sipopup-container,
.panel--visible .base-layer-content {
  opacity: 1;
}

/* SI enabled opacity 0 7 — disabled.
 * changes opacity for the whole element and its contents.
 * Source rule 440.
 */
.si-enabled-opacity-0_7:disabled {
  opacity: 0.7;
}

/* Title Text.
 * sets font/text presentation.
 * Source rule 441.
 */
BindingExpect > * #TitleText {
  font-size: var(--typography-size-14);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-center;
}

/* Unity scroller.
 * controls size/placement.
 * Source rule 442.
 */
.hide-scroll-bar .unity-scroller {
  width: 0;
  height: 0;
}

/* Virtualised list view.
 * controls size/placement.
 * Source rule 443.
 */
.wrapped_list .virtualised-list__view {
  width: 100%;
  flex-wrap: wrap;
  max-width: 100%;
}

/* Unity scroll view content container.
 * controls size/placement.
 * Source rule 444.
 */
.wrapped_list .unity-scroll-view__content-container {
  max-width: 100%;
}

/* Virtualised list view.
 * controls size/placement.
 * Source rule 445.
 */
.stretched_vertical_list .virtualised-list__view {
  height: 100%;
  align-self: stretch;
  min-height: 100%;
  max-height: 100%;
}

/* Unity scroll view content container.
 * controls size/placement.
 * Source rule 446.
 */
.stretched_vertical_list .unity-scroll-view__content-container {
  height: 100%;
  align-self: stretch;
  min-height: 100%;
  max-height: 100%;
}

/* Streamed object list item.
 * controls size/placement.
 * Source rule 447.
 */
.stretched_vertical_list .streamed-object-list-item {
  flex-grow: 1;
}

/* Sislider.
 * controls size/placement.
 * Source rule 448.
 */
.sislider {
  justify-content: center;
  align-items: center;
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
}

/* Sislider step.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 449.
 */
.sislider--step {
  width: 2px;
  height: 2px;
  background-color: var(--skin-on-media-alpha-35);
  border-radius: var(--skin-radius-micro);
  margin-left: 2px;
  margin-right: 2px;
  align-self: center;
}

/* Sislider step parent.
 * controls size/placement.
 * Source rule 450.
 */
.sislider--step-parent {
  width: 100%;
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  justify-content: space-between;
  align-items: center;
}

/* Sislider tracker.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 451.
 */
.sislider-purple-fill .sislider--tracker:enabled {
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
}

/* Unity base slider fill.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 452.
 */
.sislider-purple-fill .unity-base-slider__fill {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--communication-feedback-information);
}

/* Sislider drag container — pointer hover.
 * chooses the pointer and hotspot.
 * Source rule 453.
 */
.sislider--drag-container:hover {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sislider drag container.
 * controls size/placement.
 * Source rule 454.
 */
.sislider--drag-container {
  flex-direction: column;
  justify-content: center;
  align-items: stretch;
  flex: 1 0 0;
}

/* Bindable uxml list row.
 * sets spacing around/inside the element.
 * Source rule 455.
 */
.fmpedia_tile_link .bindable-uxml-list__row {
  padding-top: 16px;
  padding-right: 16px;
  padding-bottom: 16px;
}

/* Fmpedia tile height.
 * controls size/placement.
 * Source rule 456.
 */
.fmpedia_tile_height {
  height: 148px;
}

/* Tool content container.
 * Shows these elements; controls size/placement.
 * Source rule 457.
 */
.tool-content-container {
  display: flex;
  align-self: stretch;
  flex-grow: 1;
}

/* Report card content.
 * Shows these elements; controls size/placement.
 * Source rule 458.
 */
.report-card-content {
  display: flex;
  flex-grow: 1;
  align-self: stretch;
}

/* Date selector calendar row.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 459.
 */
.date-selector__calendar-row {
  flex-grow: 1;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  align-items: stretch;
  justify-content: space-around;
  align-content: center;
  padding-bottom: 10px;
  padding-top: 10px;
}

/* Date selector floating widget.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 460.
 */
.date-selector__floating-widget {
  /* Inherit this local radius into the painted host below; keep ordinary
   * dropdowns compact while the larger calendar matches its card frame. */
  --skin-popup-radius: var(--skin-calendar-popup-radius);
  border-radius: var(--skin-popup-radius);
  background-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
  min-height: 550px;
}

/* Data display cell standard small type standard.
 * sets spacing around/inside the element.
 * Source rule 461.
 */
.top_five_item_style .data_display-cell-standard-small--type-standard {
  margin-right: 8px;
  margin-bottom: 8px;
}

/* SI visible full grow.
 * Shows these elements; controls size/placement.
 * Source rule 462.
 */
.si-visible-full-grow {
  display: flex;
  flex-grow: 1;
}

/* SI visible no grow.
 * Shows these elements; controls size/placement.
 * Source rule 463.
 */
.si-visible-no-grow {
  display: flex;
  flex-grow: 0;
}

/* Carousel page.
 * controls size/placement.
 * Source rule 464.
 */
.carousel-page {
  position: relative;
  width: 100%;
  height: 100%;
  flex-grow: 1;
  flex-shrink: 0;
}

/* Carousel viewport.
 * controls size/placement.
 * Source rule 465.
 */
.carousel-viewport {
  flex-direction: var(--row-direction-always-normal);
  flex-grow: 1;
}

/* Carousel page indicator.
 * controls size/placement.
 * Source rule 466.
 */
.carousel-page-indicator {
  position: absolute;
  flex-direction: var(--row-direction-normal);
  right: 10px;
  top: 10px;
  align-items: center;
}

/* Carousel next button.
 * sets the background fill; controls size/placement; changes opacity for the whole element and its
 * contents.
 * Source rule 467.
 */
.carousel-next-button {
  position: absolute;
  opacity: 0;
  width: 120%;
  height: 100%;
  background-color: var(--skin-transparent);
  flex-direction: var(--row-direction-normal);
  right: -15px;
  top: -10px;
}

/* Carousel indicator.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 468.
 */
.carousel-indicator {
  width: 10px;
  height: 10px;
  background-color: var(--skin-on-media-alpha-65);
  max-height: 10px;
  min-height: 10px;
  max-width: 10px;
  min-width: 10px;
  margin-right: 8px;
  border-radius: 5px;
  transition-property: background-color, border-radius, width, height, min-width, min-height, max-width, max-height;
  transition-duration: 0.15s;
  transition-timing-function: ease-in-out;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Carousel indicator — pointer hover.
 * sets the background fill.
 * Source rule 469.
 */
.carousel-indicator:hover {
  background-color: var(--skin-surface-raised);
}

/* Carousel indicator current.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 470.
 */
.carousel-indicator-current {
  width: 14px;
  height: 14px;
  background-color: var(--layout-surfaces-breadcrumb-divider-active);
  border-radius: 7px;
  max-height: 14px;
  min-height: 14px;
  max-width: 14px;
  min-width: 14px;
}

/* Expand widget viewport animated.
 * defines how state changes animate.
 * Source rule 471.
 */
.expand-widget-viewport-animated {
  transition-property: translate;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  transition: translate 0.5s ease-out;
}

/* Expand version.
 * Hides these elements; controls size/placement.
 * Source rule 472.
 */
.expand-version {
  position: relative;
  display: none;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Unity scroll view content viewport vertical.
