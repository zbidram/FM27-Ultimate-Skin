/* Data point hover.
 * Shows these elements; Controls visibility while retaining the layout space; Changes text/foreground
 * colour; sets the background fill.
 * Source rule 5144.
 */
.data-point-hover {
  display: flex;
  visibility: visible;
  opacity: 1;
  width: 100%;
  height: 100%;
  background-color: var(--none);
  color: var(--skin-text-primary);
  font-size: var(--typography-size-10);
  -unity-font-style: var(--typography-weight-regular);
  -unity-text-align: middle-center;
  white-space: nowrap;
  padding-left: 0;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 0;
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  -unity-text-outline-width: 0;
  letter-spacing: 0;
  border-top-left-radius: 7.5px;
  border-bottom-left-radius: 7.5px;
  border-top-right-radius: 7.5px;
  border-bottom-right-radius: 7.5px;
  border-left-width: 2px;
  border-right-width: 2px;
  border-top-width: 2px;
  border-bottom-width: 2px;
  border-left-color: var(--colours-base-pink-deep);
  border-right-color: var(--colours-base-pink-deep);
  border-top-color: var(--colours-base-pink-deep);
  border-bottom-color: var(--colours-base-pink-deep);
  overflow: visible;
}

