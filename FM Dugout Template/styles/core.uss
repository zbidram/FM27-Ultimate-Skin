/* Minor components secondary action section.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2968.
 */
.minor-components-secondary-action-section,
.text-section-property-1-default {
  padding: 12px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  border-radius: var(--layout-modules-block-radius);
}

/* Mls trade terms block.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2969.
 */
.mls-trade-terms-block {
  padding: 16px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  flex: 1 0 0;
  align-self: stretch;
  border-radius: var(--layout-modules-block-radius);
}

/* Modal sheet background.
 * sets the background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 2970.
 */
.modal-sheet-background,
.meeting-tiles--background-active {
  -unity-background-scale-mode: scale-and-crop;
}

/* More info colour.
 * tints background artwork.
 * Source rule 2971.
 */
.more-info-colour {
  -unity-background-image-tint-color: var(--skin-on-media-alpha-65);
}

/* Content speakto response frame default default.
 * controls size/placement.
 * Source rule 2972.
 */
.multi-npc .content-speakto-response-frame-default-default {
  max-height: 341px;
  flex-direction: column;
  align-items: stretch;
}

/* Padding horizontal global padding small.
 * sets spacing around/inside the element.
 * Source rule 2973.
 */
.nation-cell-medium-override .padding-horizontal-global-padding-small {
  padding-left: var(--global-gap-none);
  padding-right: var(--global-gap-none);
}

/* Default cell start.
 * controls size/placement.
 * Source rule 2974.
 */
.nation-cell-short-reversed-override .default-cell-start {
  height: auto;
  align-items: flex-start;
}

/* Nation cell summary.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2975.
 */
.nation-cell-summary {
  width: 136px;
  height: 36px;
  padding-left: 8px;
}

/* Nation flag large 32px.
 * controls size/placement.
 * Source rule 2976.
 */
.nation-flag-large-32px {
  width: 32px;
  height: 20px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* Nation flag medium 24px.
 * controls size/placement.
 * Source rule 2977.
 */
.nation-flag-medium-24px {
  width: 24px;
  height: 15px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* Nation flag small 16px.
 * controls size/placement.
 * Source rule 2978.
 */
.nation-flag-small-16px {
  width: 16px;
  height: 10px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* Nation flag xlarge 48px.
 * controls size/placement.
 * Source rule 2979.
 */
.nation-flag-xlarge-48px {
  width: 48px;
  height: 30px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* Nation flag xxlarge 64px.
 * controls size/placement.
 * Source rule 2980.
 */
.nation-flag-xxlarge-64px {
  width: 64px;
  height: 40px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* Nation flag xxxlarge 128px.
 * controls size/placement.
 * Source rule 2981.
 */
.nation-flag-xxxlarge-128px {
  width: 128px;
  height: 80px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* Nation headers site nation banner max.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2982.
 */
.nation-headers-site-nation-banner-max {
  width: 100%;
  height: 82px;
  padding-top: var(--global-padding-large);
  padding-right: var(--global-padding-extra-large);
  padding-bottom: var(--global-padding-large);
  padding-left: var(--global-padding-extra-large);
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Nation site team rankings negative gradient.
 * sets the gradient colours drawn by this component.
 * Source rule 2983.
 */
.nation-site-team-rankings-negative-gradient {
  --end-colour: var(--skin-transparent);
  --start-colour: var(--skin-component-nation-site-team-rankings-negative-gradient-start-colour);
}

/* Nation site team rankings neutral gradient.
 * sets the gradient colours drawn by this component.
 * Source rule 2984.
 */
.nation-site-team-rankings-neutral-gradient {
  --end-colour: var(--skin-transparent);
  --start-colour: var(--skin-on-media-alpha-20);
}

/* Nation site team rankings positive gradient.
 * sets the gradient colours drawn by this component.
 * Source rule 2985.
 */
.nation-site-team-rankings-positive-gradient {
  --end-colour: var(--skin-transparent);
  --start-colour: var(--skin-component-nation-site-team-rankings-positive-gradient-start-colour);
}

/* Nationalsquadcolouredcell.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 2986.
 */
.nationalsquadcolouredcell {
  padding: 0 8px 0 8px;
  background-color: var(--skin-brand-primary);
  border-radius: var(--skin-radius-small);
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Negative icon colour.
 * tints background artwork.
 * Source rule 3061.
 */
.negative-icon-colour {
  -unity-background-image-tint-color: var(--communication-feedback-negative);
}

/* Negative string colour.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3062.
 */
.negative-string-colour,
.transfer-window-closed {
  color: var(--communication-feedback-negative);
}

/* Negotiation lock dropdown row.
 * controls size/placement.
 * Source rule 3063.
 */
.negotiation-lock-dropdown-row {
  height: 32px;
  justify-content: flex-start;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* Negotiation term fill frame.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3064.
 */
.negotiation-term-fill-frame {
  width: 4px;
  height: 32px;
  background-color: var(--communication-feedback-information);
  align-self: stretch;
  flex-direction: column;
  margin-right: 12px;
  border-top-left-radius: var(--skin-radius-micro);
  border-top-right-radius: var(--skin-radius-micro);
  border-bottom-right-radius: var(--skin-radius-micro);
  border-bottom-left-radius: var(--skin-radius-micro);
}

/* Negotiations active.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3065.
 */
.negotiations-active {
  height: 100%;
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  border-radius: var(--skin-radius-card);
}

/* Negotiations button height.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3066.
 */
.negotiations-button-height {
  height: 32px;
}

/* Neutral support players bar.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3067.
 */
.neutral-support-players-bar {
  position: absolute;
  height: 8px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--colours-base-grey-soft);
  border-radius: var(--skin-radius-small);
}

/* New badge.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3068.
 */
.new-badge {
  height: 28px;
  border-width: 2px;
  border-color: var(--skin-on-media-alpha-16);
  background-color: var(--skin-component-new-badge-background);
  min-width: 58px;
  max-width: none;
  border-radius: 14px;
}

/* New components club list row element.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3069.
 */
.new-components-club-list-row-element {
  width: 286px;
  padding: 0 8px;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  flex-direction: var(--row-direction-normal);
}

/* New components staff attributes key.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3070.
 */
.new-components-staff-attributes-key {
  position: absolute;
  padding: 5px var(--spacing-tiles);
  justify-content: center;
  align-items: center;
  left: 248px;
  bottom: -11px;
  border-radius: var(--skin-radius-card) var(--skin-radius-card) 0 0;
  border-top-width: 1px;
  border-top-color: var(--skin-border-subtle);
  border-right-width: 1px;
  border-right-color: var(--skin-border-subtle);
  border-left-width: 1px;
  border-left-color: var(--skin-border-subtle);
  flex-direction: var(--row-direction-normal);
}

/* News dynamic bg tile margin.
 * sets spacing around/inside the element.
 * Source rule 3071.
 */
.news-dynamic-bg-tile-margin {
  margin: 1px;
}

/* News inner item size 100px.
 * controls size/placement.
 * Source rule 3072.
 */
.news-inner-item-size_100px {
  width: 100px;
  height: 100px;
  overflow: hidden;
}

/* News inner item size 120px.
 * controls size/placement.
 * Source rule 3073.
 */
.news-inner-item-size_120px {
  width: 120px;
  height: 120px;
  overflow: hidden;
}

/* News inner item size 16px.
 * controls size/placement.
 * Source rule 3074.
 */
.news-inner-item-size_16px {
  width: 16px;
  height: 16px;
  overflow: hidden;
}

/* Inputs text field default default validation default.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3102.
 */
.no-margin-grow-input-text-field .inputs-text-field-default-default-validation-default,
.no-margin-grow-input-text-field .unity-base-text-field {
  margin: 0;
  border-width: 0;
  flex-grow: 1;
}

/* No margin no padding.
 * sets spacing around/inside the element.
 * Source rule 3103.
 */
.no-margin-no-padding {
  margin: 0 0 0 0;
  padding: 0 0 0 0;
}

/* No margin padding bg.
 * sets the background fill; sets spacing around/inside the element.
 * Source rule 3104.
 */
.no-margin-padding-bg {
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
}

/* Non plating role radio group container.
 * controls size/placement.
 * Source rule 3106.
 */
.non-plating-role-radio-group-container {
  flex-grow: 1;
  justify-content: space-between;
  align-self: stretch;
}

/* Layout layout divider solid horizontal.
 * sets spacing around/inside the element.
 * Source rule 3107.
 */
.non-player-info-divider .layout-layout-divider-solid-horizontal {
  margin-bottom: 11px;
}

/* Non player info header.
 * sets spacing around/inside the element.
 * Source rule 3108.
 */
.non-player-info-header {
  margin-top: 8px;
  margin-bottom: 8px;
}

/* Non player report property 1 variant7.
 * controls size/placement.
 * Source rule 3109.
 */
.non-player-report-property-1-variant7 {
  width: 100%;
  height: 100%;
  align-items: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Unity radio button container.
 * sets font/text presentation; controls size/placement.
 * Source rule 3110.
 */
.non-playing-role-radio-group .unity-radio-button__container {
  flex-grow: 1;
  -unity-font-style: var(--typography-weight-regular);
}

/* Notificationmessagestatus.
 * controls size/placement.
 * Source rule 3113.
 */
.notificationmessagestatus {
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Notificationmessagestatus action colour.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3114.
 */
.notificationmessagestatus-action-colour {
  background-color: var(--none);
  border-top-width: 4px;
  border-top-color: var(--colours-brand-tints-horizon-120);
  border-radius: 0;
}

/* Action header.
 * Changes text/foreground colour.
 * Source rule 3115.
 */
.notificationmessagestatus-action-colour .action-header {
  color: var(--colours-brand-tints-horizon-120);
}

/* Notificationmessagestatus action performed colour.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3116.
 */
.notificationmessagestatus-action-performed-colour {
  background-color: var(--none);
  border-top-width: 4px;
  border-top-color: var(--colours-base-neutral-white);
  border-radius: 0;
}

/* A response is needed, so use Dugout's warning role rather than FM's claret brand tint.
 * The shaded surface and warning glyph carry the status without a bright panel border.
 * Source rule 3117.
 */
.notificationmessagestatus-action-required-colour {
  background-color: var(--skin-feedback-warning-surface);
  border-top-width: var(--global-border-width-none);
  border-top-color: var(--skin-transparent);
  border-bottom-left-radius: var(--skin-radius-card);
  border-bottom-right-radius: var(--skin-radius-card);
}

/* The response-required warning icon follows the paired warning foreground.
 * Source rule 3118.
 */
.notificationmessagestatus-action-required-colour .action-icon {
  -unity-background-image-tint-color: var(--skin-feedback-warning-foreground);
}

/* Other native icon treatments retain their existing meanings.
 * Shared rule for 2 selectors. Source rule 3118.
 */
.tactics-position-circle-outfielder,
.secondary-navigation-tab-dropdown:hover > .si-dropdown__arrow {
  -unity-background-image-tint-color: var(--colours-base-neutral-white);
}

/* Notifications notifications modal dialog checkbox message setting default.
 * controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3119.
 */
.notifications--notifications-modal-dialog-checkbox-message-setting-default,
.notifications-modal-dialog-checkbox-message-setting-default {
  padding: 0 32px;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
}

/* Notification dialogs share neutral artwork/surface/edge roles; these are
 * floating chrome, not content images or ordinary report cards.
 * Notifications notifications modal dialog default default.
 * sets the background fill; sets the background artwork; tints background artwork; sets the outline/corner
 * shape.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 3120.
 */
.notifications--notifications-modal-dialog-default-default,
.notifications-modal-dialog-default-default,
.notifications-modal-large-default-default,
.notifications-modal-dialog-online-default {
  width: 484px;
  border-width: var(--skin-dialog-border-width);
  border-color: var(--skin-dialog-border);
  background-color: var(--skin-dialog-surface);
  background-image: var(--skin-dialog-artwork);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--skin-dialog-radius);
  -unity-background-scale-mode: scale-and-crop;
  -unity-background-image-tint-color: var(--skin-on-media-alpha-35);
  overflow: hidden;
}

/* Notifications notifications modal dialog dropdown menu default.
 * controls size/placement.
 * Source rule 3121.
 */
.notifications--notifications-modal-dialog-dropdown-menu-default {
  width: 400px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Notifications notifications modal dialog dynamic content default.
 * controls size/placement.
 * Source rule 3122.
 */
.notifications--notifications-modal-dialog-dynamic-content-default {
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Notifications notifications modal dialog midnight.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3123.
 */
.notifications--notifications-modal-dialog-midnight {
  background-color: var(--skin-surface-raised);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--numbers-border-radius-medium);
}

/* Notifications notifications modal large default default.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3124.
 */
.notifications--notifications-modal-large-default-default,
.notifications--notifications-modal-large-default-ige {
  width: 672px;
  height: auto;
  border-width: var(--skin-dialog-border-width);
  border-color: var(--skin-dialog-border);
  background-color: var(--skin-dialog-surface);
  background-image: var(--skin-dialog-artwork);
  flex-direction: column;
  flex-grow: 0;
  align-items: flex-start;
  align-self: center;
  justify-content: center;
  border-radius: var(--skin-dialog-radius);
}

/* Notifications notifications toast default default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3125.
 */
.notifications--notifications-toast-default-default {
  width: 460px;
