}

/* Sisubtitle.
 * sets font/text presentation.
 * Source rule 225.
 */
.sisubtitle {
  -unity-font-definition: var(--skin-font-body);
}

/* Sitile button.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 226.
 */
.sitile__button {
  display: flex;
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
  padding-bottom: 0;
  flex-grow: 1;
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
}

/* Sitile title tiny.
 * sets font/text presentation; sets spacing around/inside the element.
 * Source rule 227.
 */
.sitile__title-tiny {
  font-size: var(--typography-size-12);
  -unity-text-align: middle-center;
