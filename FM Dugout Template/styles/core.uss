}

/* Scatter chart.
 * sets the outline/corner shape.
 * Source rule 973.
 */
#scatter_chart {
  border-radius: var(--global-radius-small);
  overflow: hidden;
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element; defines
 * how state changes animate.
 * Source rule 974.
 */
#swap-tile-dropdown .si-dropdown__selection-field {
  opacity: 0.65;
  padding: var(--global-padding-small);
  border-width: var(--none);
  background-color: var(--none);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), opacity var(--global-transition-buttons) var(--global-transition-animation-buttons);
  border-radius: var(--global-radius-small);
}

/* SI dropdown selection field — pressed.
 * sets the background fill; changes opacity for the whole element and its contents.
 * Source rule 975.
 */
#swap-tile-dropdown .si-dropdown__selection-field:active:enabled {
  opacity: 1;
  background-color: var(--skin-on-media-alpha-12);
}

/* SI dropdown selection field — pointer hover.
 * sets the background fill; changes opacity for the whole element and its contents.
 * Source rule 976.
 */
#swap-tile-dropdown .si-dropdown__selection-field:hover {
  opacity: 1;
  background-color: var(--skin-on-media-alpha-20);
}

