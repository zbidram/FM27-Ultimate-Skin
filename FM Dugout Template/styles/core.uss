}

/* Sicheckboxvisual partial.
 * sets the background fill; sets the background artwork; tints background artwork; controls size/placement.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 538.
 */
.sicheckboxvisual_partial {
  width: 14px;
  height: 14px;
  background-color: var(--skin-surface-raised);
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Checkbox as button transparent.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 539.
 */
.sicheckbox.checkbox-as-button-transparent {
  margin: 0;
  padding: var(--global-gap-distant);
  border-width: 0;
  background-color: var(--skin-transparent);
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  border-radius: var(--interaction-global-radius-md);
  transition-property: var(--transition-props-paint);
  transition-duration: 0.15s;
  transition-timing-function: ease;
}

/* Checkbox as button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 540.
 */
.sicheckbox.checkbox-as-button {
  margin: 0;
  padding: var(--global-gap-distant);
  border-width: 0;
  background-color: var(--skin-control-background);
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  border-radius: var(--interaction-global-radius-md);
  transition: background-color 0.15s ease;
}

/* Checkbox as button — pointer hover.
 * sets the background fill.
 * Source rule 541.
 */
.sicheckbox.checkbox-as-button:hover {
  background-color: var(--skin-control-hover);
}

/* Unity toggle checkmark.
 * sets the background fill; sets the background artwork; sets the outline/corner shape.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 542.
 */
.sicheckbox.checkbox-as-button > .unity-toggle__input > .unity-toggle__checkmark,
.sicheckbox.checkbox-as-button > .unity-toggle__input:checked > .unity-toggle__checkmark,
.sicheckbox.checkbox-as-button:focus:enabled > .unity-toggle__input > .unity-toggle__checkmark,
.sicheckbox.checkbox-as-button:focus:enabled > .unity-toggle__input:checked > .unity-toggle__checkmark {
  border-width: 0;
  background-color: var(--skin-transparent);
  background-image: none;
}

/* Unity toggle input.
 * controls size/placement.
 * Source rule 543.
 */
.sicheckbox.checkbox-as-button > .unity-toggle__input {
