.financial-history-chart-y-axis-name {
  opacity: 1;
  width: auto;
  background-color: var(--colours-base-green-base);
  color: var(--colours-base-teal-strong);
  font-size: var(--typography-size-12);
  -unity-font-definition: var(--skin-font-body);
