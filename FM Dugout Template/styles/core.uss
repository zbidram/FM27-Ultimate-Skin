  padding-top: 0;
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* Tabgroup tab.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3775.
 */
.tab-button-group .tabgroup__tab,
.tab-button-group .buttongroup__button {
  height: 38px;
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  -unity-font-style: var(--typography-weight-regular);
  justify-content: center;
  margin-left: 0;
  margin-right: 0;
  -unity-font-definition: var(--skin-font-body);
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 4px;
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* Navigation tab default default active false.
 * sets spacing around/inside the element.
 * Source rule 3776.
 */
.tab-button-group .unity-radio-button-group__child-active .navigation-tab-default-default--active-false {
  -unity-slice-left: 19;
  -unity-slice-top: 0;
  -unity-slice-right: 19;
  -unity-slice-bottom: 0;
  -unity-slice-scale: 0.1px;
  -unity-background-scale-mode: stretch-to-fill;
  padding-top: 0;
  margin-top: 0;
}

/* Heading medium.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 3777.
 */
.tab-button-group .unity-radio-button-group__child-active .navigation-tab-default-default--active-false .heading-md {
