 */
.neutral-background-image-tint-colour {
  -unity-background-image-tint-color: var(--skin-on-media-alpha-35);
}

/* No action background image tint colour.
 * tints background artwork.
 * Source rule 258.
 */
.no-action-background-image-tint-colour {
  -unity-background-image-tint-color: var(--skin-on-media);
}

/* Scout match background image tint colour.
 * tints background artwork.
 * Source rule 259.
 */
.scout-match-background-image-tint-colour {
  -unity-background-image-tint-color: var(--skin-component-scout-match-background-image-tint-colour-image-tint);
}

/* Attend match background image tint colour.
 * tints background artwork.
 * Source rule 260.
 */
.attend-match-background-image-tint-colour {
  -unity-background-image-tint-color: var(--skin-component-attend-match-background-image-tint-colour-image-tint);
}

/* Match event owngoal text colour.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 261.
 */
.match-event-owngoal-text-colour,
.match-event-missedshootoutpenalty-text-colour {
  color: var(--skin-on-media-alpha-65);
}

/* Match event redcard text colour.
 * Changes text/foreground colour.
 * Source rule 262.
 */
.match-event-redcard-text-colour {
  color: var(--skin-component-match-event-redcard-text-colour-foreground);
}

/* Training session label.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 263.
 */
.training-session-label {
  flex-grow: 1;
  margin-left: 0;
  margin-right: 0;
  margin-top: 1px;
  margin-bottom: 1px;
  border-top-left-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Weak area lozenge.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 264.
 */
.weak-area-lozenge {
  background-color: var(--skin-on-media-alpha-06);
  justify-content: center;
  padding-left: 8px;
  padding-right: 8px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-top-left-radius: var(--skin-radius-medium);
  border-bottom-left-radius: var(--skin-radius-medium);
  border-top-right-radius: var(--skin-radius-medium);
  border-bottom-right-radius: var(--skin-radius-medium);
  margin-left: 2px;
  margin-right: 2px;
}

/* Siactionbutton.
 * sets the background fill; sets the outline/corner shape; sets font/text presentation; sets spacing
 * around/inside the element.
 * Source rule 267.
 */
.siactionbutton {
  background-color: var(--skin-on-media-alpha-08);
  margin-left: 0;
  margin-right: 0;
  margin-top: 8px;
  margin-bottom: 0;
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 6px;
  padding-bottom: 6px;
  border-top-left-radius: var(--skin-radius-medium);
  border-bottom-left-radius: var(--skin-radius-medium);
  border-top-right-radius: var(--skin-radius-medium);
  border-bottom-right-radius: var(--skin-radius-medium);
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
  -unity-font-style: var(--typography-weight-regular);
}

/* SI foldout.
 * Changes text/foreground colour; sets font/text presentation; changes opacity for the whole element and
 * its contents.
 * Source rule 268.
 */
.si-foldout {
  opacity: 1;
  color: var(--skin-component-si-foldout-foreground);
  font-size: var(--typography-size-14);
  white-space: nowrap;
  -unity-font-style: var(--typography-weight-bold);
}

/* Text regular.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 269.
 */
.text-regular {
  color: var(--skin-text-primary);
  -unity-font-definition: var(--skin-font-body);
}

/* Report Background.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 270.
 */
.ReportBackground {
  background-color: var(--skin-surface-strong);
  flex-grow: 1;
  border-top-left-radius: var(--skin-radius-shell);
  border-top-right-radius: var(--skin-radius-shell);
  align-items: stretch;
  justify-content: space-between;
  border-bottom-left-radius: var(--skin-radius-shell);
  border-bottom-right-radius: var(--skin-radius-shell);
}

/* Close button.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 271.
 */
.close-button {
  background-color: var(--skin-on-media-alpha-13);
  color: var(--skin-text-primary);
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  flex-grow: 1;
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
  border-top-left-radius: var(--skin-radius-control);
  border-bottom-left-radius: var(--skin-radius-control);
  border-top-right-radius: var(--skin-radius-control);
  border-bottom-right-radius: var(--skin-radius-control);
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sicarouselprogresscontainer.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 272.
 */
.sicarousel-small-margins .sicarouselprogresscontainer {
  width: 100%;
  height: 10px;
  background-color: var(--skin-transparent);
  margin-top: var(--global-gap-small);
  margin-bottom: var(--global-gap-small);
  justify-content: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Sicarouselprogresscontainer.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 273.
 */
.sicarouselprogresscontainer {
  width: 100%;
  height: 10px;
  background-color: var(--skin-transparent);
  margin-top: 12px;
  margin-bottom: 12px;
  justify-content: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Sicarouselprogressbar.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 274.
 */
.sicarouselprogressbar {
  height: 7px;
  background-color: var(--skin-on-media-alpha-12);
