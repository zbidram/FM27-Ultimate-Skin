/* Agent report.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1020.
 */
/* Inline agent reports are content cards on a raised list surface.
 * Preserve their content geometry and use the shared card depth/edge roles. */
.agent-report {
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  background-color: var(--skin-surface-panel);
  padding-top: var(--padding-padding-0);
  padding-right: var(--padding-padding-0);
  padding-bottom: var(--padding-padding-0);
  padding-left: var(--padding-padding-0);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--layout-surfaces-border-radius);
}

