}

/* Overlay black 60.
 * sets the background fill.
 * Source rule 3148.
 */
.overlay-black-60 {
  background-color: var(--skin-surface-canvas-alpha-60);
}

/* Page 1 notification.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3162.
 */
.page-1-notification {
  padding: 12px 16px 12px 16px;
  background-color: var(--skin-surface-page-alpha-80);
  align-items: flex-start;
  border-radius: var(--spacing-padding-small---8);
  flex-direction: var(--row-direction-normal);
}

/* Pagination compact table.
 * controls size/placement.
 * Source rule 3163.
 */
.pagination-compact-table {
  min-height: 24px;
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
  align-self: center;
}

/* Pagination page marker ellipse.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3164.
 */
.pagination-page-marker-ellipse {
  width: 12px;
  height: 12px;
  margin: 4px;
  border-width: 1px;
  border-color: var(--colours-base-grey-deep);
  border-radius: 6px;
  flex-grow: 0;
}

/* Pagination priority.
 * controls size/placement.
 * Source rule 3165.
 */
.pagination-priority {
  flex-grow: 0;
  flex-shrink: 0;
  flex-direction: column;
  align-self: stretch;
}

/* Pagination with buttons block.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Only the outer right corners round; the left edge remains joined to the adjacent control.
 * Source rule 3166.
 */
.pagination-with-buttons-block {
  width: 24px;
  background-color: var(--skin-on-media-alpha-08);
  border-radius: 0 var(--skin-radius-control) var(--skin-radius-control) 0;
}

/* Panel load game style bar.
 * sets the background fill; sets the background artwork; tints background artwork; sets the outline/corner
 * shape.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 3167.
 */
.panel-load-game-style-bar {
  width: 672px;
  padding: var(--spacing-padding-large---32);
  border-width: var(--skin-dialog-border-width);
  border-color: var(--skin-dialog-border);
  background-color: var(--skin-dialog-surface);
  background-image: var(--skin-dialog-artwork);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-dialog-radius);
  -unity-background-scale-mode: scale-and-crop;
  -unity-background-image-tint-color: var(--skin-on-media);
  overflow: hidden;
}

/* This loading-only legacy font class bypasses the ordinary sitext family. */
.panel-load-game-style-bar .fm-universe-regular-18px {
  -unity-font-definition: var(--skin-font-body);
}

/* Panel load game style bar phone.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3168.
 */
.panel-load-game-style-bar-phone {
  width: 580px;
  margin-top: 32px;
  padding-bottom: 0;
}

/* Panel transfer types type transfer.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3169.
 */
.panel-transfer-types-type-transfer {
  width: 100%;
  height: 100%;
  border-width: var(--none);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-on-media-alpha-04);
  align-self: stretch;
  padding-top: var(--global-padding-large);
  padding-right: var(--global-padding-extra-large);
  padding-bottom: var(--global-padding-large);
  padding-left: var(--global-padding-extra-large);
  flex-direction: var(--row-direction-always-normal);
  flex: 1 0 0;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Pass map block inlay background.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3170.
 */
.pass-map-block-inlay-background {
  display: flex;
  padding: 4px;
  background-color: var(--skin-on-media-alpha-04);
  justify-content: center;
  align-items: center;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
}

/* Passive toggle outline.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3171.
 */
.passive-toggle-outline {
  width: 16px;
  height: 16px;
  border-color: var(--skin-text-primary);
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-radius: var(--skin-radius-medium);
}

/* General light overlay. Penalty lists use an opaque themed layer in tactics.uss.
 * Source rule 3172.
 */
.light-block {
  padding: 12px;
  background-color: var(--skin-on-media-alpha-08);
  border-radius: var(--skin-radius-card);
}

/* Pending tweaks badge.
 * sets the background fill; sets the outline/corner shape; sets font/text presentation; controls
 * size/placement.
 * Source rule 3173.
 */
.pending-tweaks-badge {
  height: 18px;
  background-color: var(--colours-base-cyan-deep);
  min-width: 18px;
  align-items: center;
  padding-left: 5px;
  padding-right: 5px;
  border-top-left-radius: 9px;
  border-top-right-radius: 9px;
  border-bottom-left-radius: 9px;
  border-bottom-right-radius: 9px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

/* Person picture 120px.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3174.
 */
.person_picture_120px {
  width: 120px;
  height: 120px;
  background-color: var(--skin-on-media-alpha-12);
  border-radius: 60px;
  overflow: hidden;
}

/* Person picture 24px.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3175.
 */
.person_picture_24px {
  width: 24px;
  height: 24px;
  background-color: var(--skin-on-media-alpha-12);
  border-radius: 12px;
  overflow: hidden;
}

/* Person picture 80px.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3176.
 */
.person_picture_80px {
  width: 80px;
  height: 80px;
  background-color: var(--skin-on-media-alpha-12);
  border-radius: 40px;
  overflow: hidden;
}

/* Phases tile tactics.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3177.
 */
.phases-tile-tactics {
  position: relative;
  width: auto;
  height: auto;
  flex-grow: 1;
  align-self: stretch;
  align-items: stretch;
  margin-top: 0;
  margin-bottom: 0;
}

/* Game summary info block.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 3178.
 */
.phone-game-summary-info-block-panel .game-summary-info-block {
  padding: 8px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-on-media-alpha-12);
  border-radius: var(--layout-modules-block-radius);
}

/* Phone interaction header.
 * controls size/placement.
 * Source rule 3179.
 */
.phone-interaction-header {
  min-height: 38px;
}

/* Phone interaction header contracted.
 * defines how state changes animate.
 * Source rule 3180.
 */
.phone-interaction-header-contracted {
  transition-property: translate;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  translate: 0 -55px;
}

/* Phone interaction header expanded.
 * defines how state changes animate.
 * Source rule 3181.
 */
.phone-interaction-header-expanded {
  transition-property: translate;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  translate: 0 0;
}

/* Phone interaction header hidden.
 * defines how state changes animate.
 * Source rule 3182.
 */
.phone-interaction-header-hidden {
  transition-property: translate;
  transition-duration: 1.5s;
  transition-timing-function: ease-in-out;
  translate: 0 -400px;
}

/* Picked position border clip.
 * sets the outline/corner shape.
 * Source rule 3185.
 */
.picked_position-border-clip {
  overflow: hidden;
  border-radius: var(--interaction-global-radius-md);
}

/* Pitch indicator label below.
 * controls size/placement.
 * Source rule 3186.
 */
.pitch-indicator-label-below {
  position: absolute;
  top: 100%;
  left: 50%;
  translate: -50% 0;
}

/* Pitch indicator label overlap.
 * sets spacing around/inside the element.
 * Source rule 3187.
 */
.pitch-indicator-label-overlap {
  margin-top: -4px;
}

/* Pitch lines FM.
 * supplies local values read by the component styling.
 * Source rule 3188.
 */
.pitch-lines-fm {
  --pitch-line-color: var(--skin-pitch-lines);
  --pitch-line-width: 2;
}

/* Placeholder.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3189.
 */
.placeholder {
  padding: 0.98px;
  align-items: flex-start;
  margin-right: 8px;
  flex-direction: var(--row-direction-normal);
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Playing time indicators key.
