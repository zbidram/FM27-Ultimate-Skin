}

/* Sicontainer horizontal align.
 * Changes text/foreground colour; sets the background fill; tints background artwork; sets the
 * outline/corner shape.
 * Source rule 3486.
 */
.segmented-horizontal-radio-group .sicontainer_horizontal_align {
  height: 34px;
