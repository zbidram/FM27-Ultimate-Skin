/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Tactic position overview widget item filled.
 * sets the background fill.
 * Source rule 578.
 */
.tactic-position-overview-widget-item__first-team > .tactic-position-overview-widget-item__filled {
  background-color: var(--colours-base-teal-60);
}

/* Setpiece scenario toggle.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 579.
 */
.setpiece-scenario-toggle {
  padding: var(--spacing-padding-extra-small---4) var(--spacing-padding-tiles) var(--spacing-padding-extra-small---4) var(--spacing-padding-tiles);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  border-radius: var(--numbers-border-radius-small);
}

/* Selected filter chips and highlighted labels retain their existing fill role.
 * Explicit text pairing beats generic primary-text helpers on child labels.
 * Native disabled opacity is preserved; disabled selections use neutral ink/surface. */
.filter-tags-property-selected .sitext,
.group-heading-highlighted-true .sitext,
.recomended-match-prep-session-label .sitext {
  color: var(--skin-selection-foreground);
}

/* Passive highlighted headings/recommendation labels keep their resting fill;
 * only the selected filter chip receives interactive hover/press feedback. */
.filter-tags-property-selected:hover:enabled {
  background-color: var(--skin-selection-hover);
}

.filter-tags-property-selected:active:enabled {
  background-color: var(--skin-selection-pressed);
}

.filter-tags-property-selected:disabled,
.group-heading-highlighted-true:disabled,
.recomended-match-prep-session-label:disabled {
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-action-disabled-foreground);
}

.filter-tags-property-selected:disabled .sitext,
.group-heading-highlighted-true:disabled .sitext,
.recomended-match-prep-session-label:disabled .sitext {
  color: var(--skin-action-disabled-foreground);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.set-piece-segmented-button-active,
.tactic-position-overview-widget-item__sub > .tactic-position-overview-widget-item__filled,
.setpiece-scenario-toggle-selected,
.setpiece-scenario-toggle-inactive {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}

/* Tactic position overview widget item.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 584.
 */
.tactic-position-overview-widget-item {
  padding: var(--spacing-padding-extra-small---4);
  border-width: 2px;
  border-color: var(--skin-border-subtle);
  max-height: 32px;
  min-width: 32px;
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-small);
  flex-direction: var(--row-direction-always-normal);
  margin-left: var(--global-gap-small);
  margin-right: var(--none);
}

/* Tactic position overview widget item — pointer hover.
 * sets the outline/corner shape.
 * Source rule 585.
 */
.tactic-position-overview-widget-item:hover {
  border-color: var(--skin-on-media-alpha-35);
}

/* Fixture root.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 586.
 */
.fixture-root {
  height: 28px;
  margin-right: 8px;
  margin-left: 8px;
}

/* Fixture cell default.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 587.
 */
.fixture-cell--default {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  border-radius: var(--numbers-border-radius-extra-small);
  align-items: center;
  justify-content: center;
}

/* Fixture cell live.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 588.
 */
.fixture-cell--live {
  border-color: var(--communication-status-positive);
  background-color: var(--skin-component-fixture-cell-live-background);
}

/* Checkbox invisible.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 589.
 */
.checkbox-invisible {
  margin: 0;
  border-width: 0;
}

/* Fixture cell attend.
 * sets the background fill.
 * Source rule 590.
 */
.fixture-cell--attend {
  background-color: var(--skin-action-primary-background);
  color: var(--skin-action-primary-foreground);
}

/* Attend cells use the Volt action fill. Native text classes can override
 * inheritance, so keep their foreground paired at the leaf as well. */
.fixture-cell--attend .sitext,
.fixture-cell--attend .sitextmedium,
.fixture-cell--attend .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.radio-group-like-button {
  display: flex;
  margin: 0 2px 0 0;
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-default);
  background-color: var(--skin-selection-background);
  max-height: 32px;
  align-items: center;
  color: var(--skin-selection-foreground);
}

/* Radio group like button.
 * sets the outline/corner shape.
