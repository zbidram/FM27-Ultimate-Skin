}

/* Interactable.
 * sets the outline/corner shape. Match the parent shell to keep interaction corners concentric.
 * Source rule 3748.
 */
.store-grid-selector .block-margin .interactable {
  border-radius: var(--skin-radius-shell);
}

/* Selectable selected.
 * sets the outline/corner shape; sets spacing around/inside the element.
