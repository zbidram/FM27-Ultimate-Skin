 * Source rule 1792.
 */
.control-bar-action-button {
  width: 100%;
  height: 66px;
  margin: var(--global-padding-none);
  padding: var(--global-padding-none);
  border-width: 0;
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
  overflow: visible;
  justify-content: center;
  align-self: stretch;
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1793.
 */
.control-bar-action-dropdown__selection-field > .si-dropdown__selection-field {
  width: 100%;
  height: 66px;
  margin: var(--global-padding-none);
  padding: var(--global-padding-none);
  border-width: 0;
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
  overflow: visible;
  justify-content: flex-end;
  align-self: stretch;
}

/* Control bar button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1794.
 */
.control_bar_button {
  height: 66px;
  margin: var(--global-padding-none);
  background-color: var(--skin-surface-panel);
  min-width: 98px;
  padding-top: var(--global-padding-none);
  padding-bottom: var(--global-padding-extra-small);
  padding-left: var(--global-padding-extra-small);
  padding-right: var(--global-padding-large);
  align-items: center;
  border-radius: var(--global-radius-small);
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Control bar button — pressed.
 * sets the background fill.
 * Source rule 1795.
 */
.control_bar_button:active:enabled {
  background-color: var(--skin-surface-panel);
}

/* Control bar button — pointer hover.
 * sets the background fill.
 * Source rule 1796.
 */
.control_bar_button:hover {
  background-color: var(--skin-surface-raised);
}

/* Control bar button container max.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1797.
 */
.control_bar_button_container_max {
  height: 58px;
  border-width: var(--global-border-width-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-raised);
  min-width: 220px;
  padding-top: var(--global-padding-small);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-small);
  padding-left: var(--global-padding-small);
  align-items: center;
  border-radius: var(--global-radius-extra-small);
  flex-direction: var(--row-direction-normal);
}

/* Control bar button container min.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1798.
 */
