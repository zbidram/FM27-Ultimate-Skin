.sitool-layout {
  margin-left: 20px;
  margin-right: 20px;
  margin-top: 20px;
  margin-bottom: 20px;
}

/* Setup game dialog.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 296.
 */
.setup_game_dialog {
  background-color: var(--skin-surface-strong);
  align-self: center;
  flex-shrink: 0;
  align-items: stretch;
  justify-content: space-between;
  border-bottom-left-radius: var(--skin-radius-shell);
  border-bottom-right-radius: var(--skin-radius-shell);
  border-top-left-radius: var(--skin-radius-shell);
  border-top-right-radius: var(--skin-radius-shell);
  flex-direction: column;
  flex-grow: 1;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
  max-width: 70%;
  max-height: 80%;
  min-width: 70%;
  min-height: 80%;
}

/* Setup game fullscreen.
 * controls size/placement.
 * Source rule 297.
 */
.setup_game_fullscreen {
  max-width: 100%;
  max-height: 100%;
}

/* Setup game info.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 298.
 */
.setup_game_info {
  width: 200px;
