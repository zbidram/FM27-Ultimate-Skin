 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3757.
 */
.streamed-table__checkbox .unity-toggle__checkmark,
.inputs-switch-checkbox-default-switch-false--icon-none .unity-toggle__checkmark {
  width: 14px;
  height: 14px;
  margin: 0;
  padding: 0;
  background-color: var(--skin-transparent);
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* Unity toggle input.
 * sets the background fill; controls size/placement; sets spacing around/inside the element; chooses the
 * pointer and hotspot.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3758.
 */
