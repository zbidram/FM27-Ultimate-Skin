  max-width: 200px;
  min-width: 200px;
  justify-content: flex-start;
  align-items: center;
  flex-grow: 1;
  flex-shrink: 0;
  border-top-right-radius: var(--skin-radius-shell);
}

/* No padding.
 * sets spacing around/inside the element.
 * Source rule 299.
 */
.no_padding {
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
}

/* No margin.
 * sets spacing around/inside the element.
 * Source rule 300.
 */
.no_margin {
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
}

/* Background transparent.
 * sets the background fill.
 * Source rule 301.
 */
.background_transparent {
  background-color: var(--skin-transparent);
}

/* Button no border.
 * sets the outline/corner shape.
 * Source rule 302.
 */
.button_no_border {
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* Button fill.
 * controls size/placement.
 * Source rule 303.
 */
.button_fill {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

/* Segmented graph default bar style.
 * sets the outline/corner shape.
 * Source rule 304.
 */
.segmented_graph_default_bar_style {
