 */
.cup-tree-column,
.date-selector-grid-element__inactive > ComponentElement,
.date-selector-grid-element__inactive > ComponentElement > TemplateContainer,
.player-fitness-active-injury-types-legend,
.calendar-training-style-override .date-selector-grid-element__active,
.calendar-training-style-override .date-selector-grid-element__inactive,
.calendar-training-style-override .date-selector-grid-element__highlighted,
.game-creation-quick-setup-radio-group .unity-radio-button__container,
.base-template-grow,
.data_display-graphs-tile-line_chart,
.data_display-graphs-tile-line_chart_container,
.data_display-graphs-tile-scatter_chart_container,
.expanded-table-root,
.inputs-hybrid-task_switch_button_alt-regular--status-none .unity-radio-button__container,
.radio_group_horizontal_align .unity-radio-button__container,
.segmented-button-group-colorless .unity-radio-button__container,
.segmented-button-group-colorless .unity-radio-button__container > TemplateContainer,
.speakto-container,
.tab-view-grow > #BindingRoot,
.tab-view-grow > #BindingRoot > #TemplateContainer,
.set-pieces-radio-container .unity-radio-button__container,
.game-creation-dynamic-step-flex-grow,
.game-creation-dynamic-step-flex-grow > TemplateContainer,
.calendar-training-style-override .date-grid-prefix__template,
.calendar-training-style-override .date-grid-prefix__root,
#LeagueTableStageRemapper #StagesBlock_BindingExpect,
.fm-searchable-combobox {
  flex-grow: 1;
}

/* Cup tree columns.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1823.
 */
.cup-tree-columns > ComponentElement,
.cup-tree-columns > .cup-tree-column {
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0;
  overflow: hidden;
}

/* Wrapped object list.
 * controls size/placement.
 * Source rule 1824.
 */
.cup-tree-columns.wrapped-object-list {
  flex-wrap: nowrap;
}

/* Cup tree connector bottom.
 * sets the outline/corner shape; controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1825.
 */
.cup-tree-connector-bottom,
.cup-tree-connector-top {
  border-color: var(--skin-border-subtle);
  flex-grow: 1;
}

/* Cup tree connector top.
 * sets the outline/corner shape.
 * Source rule 1826.
 */
.cup-tree-connector-bottom-feeder > .cup-tree-connector-top {
  border-bottom-width: var(--global-border-width-regular);
  border-right-width: var(--global-border-width-regular);
}

/* Cup tree connector bottom.
 * sets the outline/corner shape.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1827.
 */
.cup-tree-connector-junction > .cup-tree-connector-bottom,
.cup-tree-connector-junction > .cup-tree-connector-top,
.cup-tree-connector-top-feeder > .cup-tree-connector-bottom,
.cup-tree-connector-vertical > .cup-tree-connector-bottom,
.cup-tree-connector-vertical > .cup-tree-connector-top {
  border-right-width: var(--global-border-width-regular);
}

/* Cup tree connector lane.
 * controls size/placement.
 * Source rule 1828.
 */
.cup-tree-connector-lane {
  width: var(--global-gap-large);
  flex-shrink: 0;
}

/* Cup tree connector top.
 * sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1829.
 */
.cup-tree-connector-straight > .cup-tree-connector-top,
.cup-tree-connector-top-feeder > .cup-tree-connector-top {
  border-bottom-width: var(--global-border-width-regular);
}

/* Custom alternate item odd.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1830.
 */
.message-tool-background,
.manager-persona-summary-step-panel {
  background-color: var(--skin-on-media-alpha-04);
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Date selector.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2045.
 */
.date_selector {
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
}

/* Default cell center.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2046.
 */
.default-cell-center {
  height: 28px;
  padding: var(--numbers-border-radius-null) var(--global-padding-small);
  justify-content: center;
  align-items: center;
}

/* Default cell start.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2047.
 */
.default-cell-start {
  height: 28px;
  padding: var(--numbers-border-radius-null) var(--global-padding-small);
  flex-direction: var(--row-direction-normal);
  justify-content: flex-start;
  align-items: center;
}

/* Delegation containment.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 2048.
 */
.delegation_containment {
  padding: var(--global-gap-close) var(--global-gap-regular);
  border-radius: var(--border-radius-radius-0);
}

/* Detailed preferences button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2049.
 */
.detailed-preferences-button {
  padding: var(--spacing-extra-small---4) var(--spacing-tiles);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  min-width: 180px;
  flex-direction: var(--row-direction-normal);
  align-items: center;
  align-self: stretch;
  justify-content: flex-start;
  border-radius: var(--numbers-border-radius-small);
}

/* Button text.
 * Changes text/foreground colour.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2050.
 */
.disabled-look .button-text,
.faded-text-colour {
  color: var(--skin-text-disabled);
}

/* A missing grade still conveys useful data. Do not apply the generic
 * 35%-white disabled paint to its text or its outlined grade marker. */
.scaling-icon-grades-text-colour-unknown {
  color: var(--skin-grade-unknown-foreground);
}

/* Divider direction horizontal.
 * controls size/placement.
 * Source rule 2051.
 */
.divider-direction-horizontal {
  height: 0.98px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Divider horizontal margin 16.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2052.
 */
.divider-horizontal-margin-16 {
  margin-top: 16px;
  margin-bottom: 16px;
  align-self: stretch;
  flex-shrink: 0;
}

/* Divider horizontal margin 8.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2053.
 */
.divider-horizontal-margin-8 {
  margin-top: 8px;
  margin-bottom: 8px;
  align-self: stretch;
  flex-shrink: 0;
}

/* Divider horizontal margin large.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2054.
 */
.divider-horizontal-margin-large {
  margin-top: var(--global-gap-distant);
  margin-bottom: var(--global-gap-distant);
  align-self: stretch;
  flex-shrink: 0;
}

/* Dof recommended thumbs up.
 * tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2055.
 */
.dof-recommended-thumbs-up,
.relationship-with-you-icon-colour-neutral {
  -unity-background-image-tint-color: var(--colours-base-purple-soft);
}

/* Done deals property 1 default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2056.
 */
.done-deals-property-1-default {
  width: 410px;
  padding: var(--spacing-tiles);
  background-color: var(--skin-surface-raised);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--numbers-border-radius-small);
}

/* Done deals property 1 messages.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2057.
 */
.done-deals-property-1-messages {
  width: 200px;
  padding: var(--spacing-tiles);
  background-color: var(--skin-surface-raised);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--numbers-border-radius-small);
}

/* Done deals property 1 small.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2058.
 */
.done-deals-property-1-small {
  width: 254px;
  padding: var(--spacing-tiles);
  background-color: var(--skin-surface-raised);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--numbers-border-radius-small);
}

/* Done deals property 1 standard.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2059.
 */
.done-deals-property-1-standard {
  width: 320px;
  padding: var(--spacing-tiles);
  background-color: var(--skin-surface-raised);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--numbers-border-radius-small);
}

/* Dot container.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2060.
 */
.dot-container {
  width: 16px;
  height: 16px;
  flex-grow: 0;
  margin-right: 8px;
  align-items: auto;
  justify-content: flex-start;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  flex-basis: auto;
  align-self: flex-start;
}

/* Grid Layout Element Content.
 * sets the native component presentation.
 * Source rule 2061.
 */
.downscaled-dynamic-portal-message-grid .dynamic-portal-message-grid .unity-scroll-view #GridLayoutElementContent {
  scale: 0.96 0.96;
}

/* Draft player pool overview tile standard selected type presents.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2062.
 */
.draft-player-pool-overview-tile-standard-selected-type-presents {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-on-media-alpha-08);
  padding-top: 12px;
  padding-right: 12px;
  padding-bottom: 12px;
  padding-left: 12px;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
}

/* Draft team size default.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2063.
 */
.draft_team-size-default {
  padding: 8px;
  flex-direction: column;
  align-items: center;
  flex: 1 0 0;
}

/* Bookmark drop indicator.
 * Shows these elements; controls size/placement.
 * Source rule 2064.
 */
.drag-over > .bookmark-drop-indicator {
  display: flex;
  left: -2px;
  right: auto;
}

/* Bookmark drop indicator vertical.
 * Shows these elements; controls size/placement.
 * Source rule 2065.
 */
.drag-over > .bookmark-drop-indicator-vertical {
  display: flex;
  top: -2px;
  bottom: auto;
}

/* Bookmark drop indicator.
 * controls size/placement.
 * Source rule 2066.
 */
.drag-over.drag-over-trailing-x > .bookmark-drop-indicator {
  left: auto;
  right: -2px;
}

/* Bookmark drop indicator vertical.
 * controls size/placement.
 * Source rule 2067.
 */
.drag-over.drag-over-trailing-y > .bookmark-drop-indicator-vertical {
  top: auto;
  bottom: -2px;
}

/* Dropdown base no background.
 * controls size/placement.
 * Source rule 2068.
 */
.dropdown-base-no-background {
  flex-grow: 1;
  align-self: stretch;
  align-items: flex-end;
  justify-content: center;
}

/* Dropdown combo button base transparent.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2069.
 */
.dropdown-combo-button-base-transparent {
  width: 120px;
  height: 48px;
  margin-left: 4px;
  padding-top: 8px;
  padding-bottom: 8px;
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2070.
 */
.dropdown-combo-button-base-transparent .si-dropdown__selection-field {
  height: 24px;
  padding: var(--spacing-extra-small---4) var(--spacing-small---8);
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-transparent);
  max-height: 32px;
  align-items: center;
  align-self: stretch;
  border-radius: var(--spacing-small---8);
  flex-direction: var(--row-direction-normal);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2071.
 */
.dropdown-primary-default .si-dropdown__selection-field {
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 2px;
  border-color: var(--skin-action-primary-border);
  background-color: var(--skin-action-primary-background);
  max-height: 32px;
  min-height: 32px;
  align-items: center;
  border-radius: var(--spacing-small---8);
  flex-direction: var(--row-direction-normal);
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
}

/* SI dropdown selection field.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2072.
 */
.dropdown-secondary-default .si-dropdown__selection-field {
  padding: var(--spacing-small---8) var(--spacing-medium---16);
  border-width: 2px;
  border-color: var(--skin-border-default);
  max-height: 32px;
  min-height: 32px;
  align-items: center;
  border-radius: var(--spacing-small---8);
  flex-direction: var(--row-direction-always-normal);
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
}

/* Dugout tile size.
 * controls size/placement.
 * Source rule 2073.
 */
.dugout-tile-size {
  width: 312px;
  height: 148px;
}

/* Dugout event pass map pitch 4x4.
 * controls size/placement.
 * Source rule 2074.
 */
.dugout_event_pass_map_pitch_4x4 {
  width: 136px;
  height: 194px;
}

/* Dugout event substitution off player 4x4.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2075.
 */
.dugout_event_substitution_off_player_4x4 {
  width: 116px;
  height: 116px;
  border-width: 1px;
  border-color: var(--skin-data-dugout-event-substitution-off-player-4x4-border-color);
  background-color: var(--skin-data-dugout-event-substitution-off-player-4x4-background);
  border-radius: var(--skin-radius-small);
  overflow: hidden;
}

/* Dugout event substitution on player 4x4.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2076.
 */
.dugout_event_substitution_on_player_4x4 {
  width: 116px;
  height: 116px;
  border-width: 1px;
  border-color: var(--skin-data-dugout-event-substitution-on-player-4x4-border-color);
  background-color: var(--skin-data-dugout-event-substitution-on-player-4x4-background);
  border-radius: var(--skin-radius-small);
  overflow: hidden;
}

/* Duplicate controller remap.
 * sets the background fill.
 * Source rule 2077.
 */
.duplicate-controller-remap {
  background-color: var(--skin-component-duplicate-controller-remap-background);
}

/* Dynamics mindset relaxed size small.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2078.
 */
.dynamics-mindset-relaxed-size-small {
  width: 40px;
  height: 40px;
  padding: 1px 1px 1px 1px;
  justify-content: center;
  align-items: center;
  margin-right: var(--spacing-small---8);
  flex-direction: var(--row-direction-normal);
}

/* Edit bookmark draggable.
 * controls size/placement.
 * Source rule 2079.
 */
.edit-bookmark-draggable {
  position: relative;
  flex-grow: 1;
}

/* Edit bookmark item container.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2080.
 */
.edit-bookmark-item-container {
  height: 32px;
  padding: 8px;
  background-color: var(--skin-transparent);
  min-width: 195px;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Edit bookmark item container — pointer hover.
 * sets the background fill.
 * Source rule 2081.
 */
.edit-bookmark-item-container:hover {
  background-color: var(--skin-on-media-alpha-20);
}

/* Edit bookmark item trailing container.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2082.
 */
.edit-bookmark-item-trailing-container {
  padding-left: 8px;
  justify-content: center;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* Sibutton.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2083.
 */
.edit-bookmark-item-trailing-container .sibutton {
  width: 24px;
  height: 24px;
  padding: 0;
  border-width: 0;
  margin-left: 8px;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
}

/* Edit bookmarks title button.
 * sets spacing around/inside the element.
 * Source rule 2084.
 */
.edit-bookmarks-title-button {
  margin-right: var(--global-gap-seperation, 16px);
}

/* Edit bookmarks title frame.
 * Shows these elements; controls size/placement.
 * Source rule 2085.
 */
.edit-bookmarks-title-frame {
  display: flex;
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Edit manager button position.
 * controls size/placement.
 * Source rule 2086.
 */
.edit-manager-button-position {
  position: absolute;
  bottom: var(--global-padding-extra-extra-large);
  right: var(--global-padding-extra-extra-large);
}

/* Edit search button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2087.
 */
.edit-search-button {
  margin: 0;
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-action-primary-border);
  background-color: var(--skin-action-primary-background);
  padding-top: 0;
  padding-right: var(--global-padding-large);
  padding-bottom: 0;
  padding-left: var(--global-padding-large);
  align-items: center;
  border-top-left-radius: var(--global-radius-small);
  border-bottom-left-radius: var(--global-radius-small);
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
  color: var(--skin-action-primary-foreground);
  --buttons-icons-default: var(--skin-action-primary-foreground);
}

/* Search and its split dropdown are one Volt control. Pair the icon/label
 * with dark ink on default and hover, including the icon's own tint. */
.edit-search-button .sitext,
.edit-search-dropdown .si-dropdown__selection-field .sitext {
  color: var(--skin-action-primary-foreground);
}

.edit-search-button .unity-image,
.edit-search-dropdown .si-dropdown__selection-field .unity-image {
  -unity-background-image-tint-color: var(--skin-action-primary-foreground);
}

.edit-search-button:hover:enabled,
.edit-search-dropdown .si-dropdown__selection-field:hover:enabled {
  background-color: var(--skin-action-primary-hover);
}

.edit-search-button:active:enabled,
.edit-search-dropdown .si-dropdown__selection-field:active:enabled {
  background-color: var(--skin-action-primary-pressed);
}

/* Edit search button — disabled.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2088.
 */
.edit-search-button:disabled,
.edit-search-dropdown:disabled .si-dropdown__selection-field:disabled {
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-action-disabled-foreground);
}

.edit-search-button:disabled .sitext,
.edit-search-dropdown:disabled .si-dropdown__selection-field:disabled .sitext {
  color: var(--skin-action-disabled-foreground);
}

.edit-search-button:disabled .unity-image,
.edit-search-dropdown:disabled .si-dropdown__selection-field:disabled .unity-image {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2089.
 */
.edit-search-dropdown .si-dropdown__selection-field {
  width: 24px;
  height: var(--buttons-global-height-regular);
  padding: 0 var(--global-padding-extra-small);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-action-primary-border);
  background-color: var(--skin-action-primary-background);
  align-items: center;
  border-top-right-radius: var(--global-radius-small);
  border-bottom-right-radius: var(--global-radius-small);
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-long) ease-in-out;
  color: var(--skin-action-primary-foreground);
}

/* Embedded button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2090.
 */
.embedded-button {
  height: var(--interaction-global-height-sm);
  margin: var(--global-gap-none);
  padding: var(--interaction-global-padding-vertical) var(--interaction-global-padding-horizontal-md);
  border-width: var(--global-border-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--interaction-global-radius-md);
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-short) ease-out;
}

/* Embedded button misc.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2091.
 */
.embedded-button-misc {
  height: var(--interaction-global-height-sm);
  margin: var(--global-gap-none);
  padding: var(--interaction-global-padding-vertical) var(--interaction-global-padding-horizontal-sm);
  border-width: var(--global-border-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--interaction-global-radius-md);
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-medium) ease-in-out, border-color var(--global-transition-medium) ease-in-out, border-radius var(--global-transition-medium) ease-in-out;
}

/* Player form cell.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2092.
 */
.embedded-button-misc.player-form-cell,
.embedded-button-misc.team-form-cell {
  padding: var(--global-padding-none);
  border-width: var(--global-border-width-none);
  background-color: var(--interaction-base-surface-icon-surface);
  max-height: var(--interaction-base-height-md-max-height-regular);
  border-radius: var(--interaction-global-radius-sm);
  overflow: hidden;
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Player form cell — pressed.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2093.
 */
.embedded-button-misc.player-form-cell:active:enabled,
.embedded-button-misc.team-form-cell:active:enabled {
  background-color: var(--interaction-base-surface-icon-surface);
}

/* Player form cell — pointer hover.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2094.
 */
.embedded-button-misc.player-form-cell:hover,
.embedded-button-misc.team-form-cell:hover {
  background-color: var(--interaction-base-surface-icon-surface-hover);
}

/* Embedded button misc — pointer hover.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2095.
 */
.embedded-button-misc:hover {
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-hover);
}

/* Embedded button — pointer hover.
 * sets the background fill.
 * Source rule 2096.
 */
.embedded-button:hover:enabled {
  background-color: var(--skin-control-hover);
}

/* Pressed is stronger than hover, with neutral ink/surface pairing. */
.embedded-button:active:enabled {
  background-color: var(--skin-control-pressed);
}

/* Emoticon background colour negative.
 * sets the background fill.
 * Source rule 2097.
 */
.emoticon-background-colour-negative {
