  padding-left: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-top: 0;
  padding-top: 0;
  padding-bottom: 0;
  align-items: center;
  flex-shrink: 1;
  margin-left: 0;
  padding-right: 0;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Breadcrumbs section visible.
