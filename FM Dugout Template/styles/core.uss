/* Neutral informational badges pair their nested copy with the shared surface. */
.badge-string-thematic-default-size-large-status-strong-neutral .sitext,
.badge-string-thematic-default-size-medium-status-strong-neutral .sitext {
  color: var(--skin-badge-neutral-foreground);
}

/* Generated alternating lists and static generic rows share report table stripes.
 * Keep joined cells square and leave status/highlight colours to their own rules. */
.custom-alternate__item.custom-alternate__item--odd {
  background-color: var(--skin-table-row-alternate-background);
}
.generic-row-odd {
  background-color: var(--skin-table-row-background);
}
