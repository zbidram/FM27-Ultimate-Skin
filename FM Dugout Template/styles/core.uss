.stepper-step-purple .stepper-step--selected {
  height: 4px;
  background-color: var(--skin-brand-accent);
}

/* Store dropdown.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3746.
 */
.store-dropdown {
  width: 375px;
  height: 32px;
  padding: 0 0 0 2px;
  margin-bottom: 16px;
}

/* Block margin.
 * sets the outline/corner shape; sets spacing around/inside the element.
