.si-radio-button-group-selector .unity-radio-button-group__container > * > .unity-radio-button__input {
  flex-grow: 0;
}

/* Unity radio button input.
 * Hides these elements.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 316.
 */
#ContinentTabs .unity-radio-button__input,
#ContinentTabs .unity-radio-button__checkmark-background,
