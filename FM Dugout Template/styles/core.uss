 * Source rule 938.
 */
#GoOnHolidayWidget .unity-radio-button-group__child-active {
  /* This native high-specificity exception must consume the same state role
   * as plain form radios, otherwise it cancels their neutral hover fill. */
  background-color: var(--skin-choice-background);
}

/* Card Container.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 939.
 */
#HalfTimeReport #CardContainer,
.full-time-report-in-match #CardContainer {
  margin: var(--global-padding-extra-large);
}

/* Grid Safe Area.
 * sets spacing around/inside the element.
 * Source rule 940.
 */
