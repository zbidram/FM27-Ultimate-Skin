  margin-left: 8px;
  margin-right: 8px;
  margin-top: 8px;
  margin-bottom: 8px;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
}

/* Sicell.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 720.
 */
.sicell {
  margin: 4px;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  flex-direction: column;
  flex-wrap: nowrap;
  border-radius: var(--numbers-border-radius-extra-small);
  overflow: hidden;
  min-height: 28px;
  padding-left: 6px;
  padding-right: 6px;
  padding-top: 2px;
  padding-bottom: 2px;
}

/* Sicell — pointer hover.
 * sets the background fill.
 * Source rule 721.
 */
.sicell:hover {
  background-color: var(--skin-surface-canvas-alpha-08);
}

/* Sicell button.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 722.
 */
.sicell__button {
  display: flex;
