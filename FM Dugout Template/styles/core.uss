/* Z border hover selection.
 * sets the background fill; sets the outline/corner shape; defines how state changes animate.
 * Source rule 4335.
 */
.z-border-hover-selection {
  background-color: var(--skin-transparent);
  border-radius: 0;
  border-right-width: 4px;
  border-right-color: var(--skin-transparent);
  transition: background-color 0.15s ease-in, border-right-color 0.15s ease-in;
}

/* Z border hover selection — pointer hover.
