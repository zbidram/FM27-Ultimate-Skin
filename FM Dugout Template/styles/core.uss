/* Agent offer player item.
 * Ordinary nested report card: use theme card edges, never a fixed outline.
 * Source rule 1014.
 */
.agent-offer-player-item {
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
