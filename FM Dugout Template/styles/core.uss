  align-items: center;
  flex-shrink: 0;
  border-bottom-width: 1px;
  border-bottom-color: var(--skin-on-media-alpha-16);
  flex-direction: var(--row-direction-normal);
  transition-property: background-color;
  transition-duration: var(--global-transition-long);
  transition-timing-function: ease-in;
  transition-delay: 0s;
}

/* Portal agenda list item default type default last child false — pointer hover.
