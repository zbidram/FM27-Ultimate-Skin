}

/* Posessionproximitywarning.
 * sets the background fill.
 * Source rule 941.
 */
#IsSuggestedSubBorder .posessionproximitywarning {
  background-color: var(--skin-transparent);
}

/* Sigradient.
 * controls size/placement; sets the gradient colours drawn by this component.
