  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-raised);
  min-width: 110px;
  max-width: 200px;
  padding-top: var(--global-padding-small);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-small);
  padding-left: var(--global-padding-small);
  align-items: center;
  border-radius: var(--global-radius-extra-small);
  flex-direction: var(--row-direction-normal);
}

/* Control bar button container standard.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1799.
 */
.control_bar_button_container_standard {
  height: 58px;
  border-width: var(--global-border-width-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-raised);
  min-width: 140px;
  max-width: 251px;
  padding-top: var(--global-padding-small);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-small);
  padding-left: var(--global-padding-small);
  align-items: center;
  border-radius: var(--global-radius-extra-small);
  flex-direction: var(--row-direction-normal);
}

/* Control bar popup dialog container.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1800.
 */
.control_bar_popup_dialog_container {
  width: 968px;
  height: 588px;
  padding: var(--global-padding-large);
  border-width: var(--skin-dialog-border-width);
  border-color: var(--skin-dialog-border);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--skin-popup-radius);
}

/* Control bar wrapper.
 * sets the outline/corner shape; controls size/placement; defines how state changes animate; sets the
 * gradient colours drawn by this component.
 * Source rule 1801.
 */
.control_bar_wrapper {
  position: absolute;
  width: 100%;
  height: 100%;
  border-width: var(--none);
  border-color: var(--none);
  --start-colour: var(--skin-component-control-bar-wrapper-start-colour);
  --end-colour: var(--skin-component-control-bar-wrapper-end-colour);
  left: 0px;
  top: 0px;
  border-radius: var(--global-radius-small);
  transition-property: opacity;
  transition-duration: var(--transition-snappy);
  transition-timing-function: var(--transition-cb-ui);
}

/* Control bar wrapper border.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 1802.
 */
.control_bar_wrapper_border {
  position: absolute;
  width: 100%;
  height: 100%;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  top: 0px;
  left: 0px;
  border-radius: var(--global-radius-small);
}

/* Control button panel clip.
 * sets the outline/corner shape.
 * Source rule 1803.
 */
.control_button_panel_clip {
  border-radius: var(--numbers-border-radius-small);
  overflow: hidden;
}

