/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Grid edit control.
 * Small edit-mode control attached to a grid element. This is not a normal gameplay action button.
 * Source rule 1.
 */
.grid-element__controls-button {
  width: 24px;
  height: 24px;
  margin: 4px;
  padding: 0;
  border-width: 0;
  background-color: var(--skin-surface-canvas-alpha-75);
  color: var(--skin-text-primary);
  font-size: var(--skin-font-size-18);
  align-self: flex-end;
  -unity-font-style: bold;
  border-radius: 50%;
}

/* Grid element controls button — pointer hover.
 * Changes text/foreground colour; sets the background fill.
 * Source rule 2.
 */
.unity-button.grid-element__controls-button:hover {
  background-color: var(--skin-surface-canvas-alpha-75);
  color: var(--skin-text-primary);
}

/* Grid element controls button — pressed.
 * Changes text/foreground colour; sets the background fill.
 * Source rule 3.
 */
.unity-button.grid-element__controls-button:active {
  background-color: var(--skin-surface-canvas-alpha-75);
  color: var(--skin-text-secondary);
}

/* Grid element controls button — disabled.
 * Changes text/foreground colour; sets the background fill.
 * Source rule 4.
 */
.unity-button.grid-element__controls-button:disabled {
  background-color: var(--skin-surface-canvas-alpha-75);
  color: var(--skin-text-disabled);
}

/* Grid element cycle page.
 * Changes text/foreground colour; controls size/placement; sets spacing around/inside the element.
 * Source rule 5.
 */
.grid-element__cycle-page {
  padding: 2px 3px 2px 3px;
  color: var(--skin-text-disabled);
  align-self: flex-end;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Siimage.
 * sets font/text presentation; controls size/placement; sets spacing around/inside the element.
 * Source rule 7.
 */
.siimage {
  width: 20px;
  height: 20px;
  padding-left: 5px;
  padding-right: 5px;
  padding-top: 5px;
  padding-bottom: 5px;
  white-space: nowrap;
  -unity-text-align: middle-left;
}

/* Standard text label.
 * Default text styling reused throughout the interface. Prefer a local class override for a one-screen
 * change.
 * Source rule 8.
 */
.sitext {
  color: var(--global-text-primary);
  -unity-font-definition: var(--skin-font-body);
}

/* Medium text label.
 * Shared medium label styling. A change here can reach many controls and screens.
 * Source rule 9.
 */
.sitextmedium {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-bold);
  padding-left: 5px;
  padding-right: 5px;
  padding-top: 5px;
  padding-bottom: 5px;
  white-space: normal;
  -unity-text-align: middle-left;
  -unity-font-definition: var(--skin-font-body);
}

/* Small text label.
 * Shared small label styling. Check dense tables and secondary labels after changing it.
 * Source rule 10.
 */
.sitextsmall {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-8);
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  padding-left: 5px;
  padding-right: 5px;
  padding-top: 5px;
  padding-bottom: 5px;
  white-space: nowrap;
  -unity-text-align: middle-left;
}

/* Sibutton.
 * sets the background fill; sets font/text presentation; sets spacing around/inside the element; chooses
 * the pointer and hotspot.
 * Source rule 11.
 */
.sibutton {
  margin: 2px 4px;
  padding: 8px 12px;
  background-color: var(--skin-on-media-alpha-08);
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-center;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
  white-space: nowrap;
  overflow: hidden;
  flex: 0 0 auto;
  -unity-text-generator: advanced;
}

/* Sibutton background colour.
 * sets the background fill.
 * Source rule 12.
 */
.sibutton-background-colour {
  background-color: var(--skin-on-media-alpha-08);
}

/* Small padding.
 * sets spacing around/inside the element.
 * Source rule 13.
 */
.sibutton.small-padding {
  margin: 2px 2px;
  padding: 2px 2px;
}

/* Is active.
 * sets the background fill.
 * Source rule 14.
 */
.sibutton.is_active {
  background-color: var(--colours-base-blue-base);
}

/* Tabgroup tabs.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 15.
 */
.tabgroup__tabs {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  margin-bottom: 0;
}

/* Buttongroup.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 16.
 */
.buttongroup {
  height: auto;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  margin-bottom: 0;
}

/* Tabgroup tabscontent.
 * controls size/placement.
 * Source rule 17.
 */
.tabgroup .tabgroup__tabscontent {
  flex-grow: 1;
}

/* Simenu.
 * controls size/placement.
 * Source rule 18.
 */
.simenu {
  flex-grow: 1;
}

/* Simenu.
 * controls size/placement.
 * Source rule 19.
 */
.simenu > BindingRoot > StreamedMenuList {
  flex-grow: 1;
}

/* Binding Root.
 * controls size/placement.
 * Source rule 20.
 */
SITabView > BindingRoot {
  flex-grow: 1;
}

/* Tabgroup tab — pointer hover.
 * chooses the pointer and hotspot.
 * Source rule 21.
 */
.tabgroup .tabgroup__tab:hover {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Buttongroup button — pointer hover.
 * chooses the pointer and hotspot.
 * Source rule 22.
 */
.buttongroup .buttongroup__button:hover {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Buttongroup button active — pointer hover.
 * chooses the pointer and hotspot.
 * Source rule 23.
 */
.buttongroup.Default .buttongroup__button--active:hover {
  cursor: var(--cursor-default-1x-url) var(--cursor-default-1x-hotspot-x) var(--cursor-default-1x-hotspot-y);
}

/* Tabgroup tab active.
 * Changes text/foreground colour; sets the outline/corner shape.
 * Source rule 24.
 */
.tabgroup__tab--active {
  color: var(--skin-text-primary);
  border-bottom-width: 1.5px;
  border-bottom-color: var(--colours-base-neutral-white);
  -unity-slice-left: 19;
  -unity-slice-top: 0;
  -unity-slice-right: 19;
  -unity-slice-bottom: 0;
  -unity-slice-scale: 0.1px;
  -unity-background-scale-mode: stretch-to-fill;
}

/* Buttongroup button active.
 * Changes text/foreground colour; sets the outline/corner shape.
 * Source rule 25.
 */
.buttongroup__button--active {
  color: var(--skin-text-primary);
  border-bottom-width: 1.5px;
  border-bottom-color: var(--colours-base-neutral-white);
  -unity-slice-left: 19;
  -unity-slice-top: 0;
  -unity-slice-right: 19;
  -unity-slice-bottom: 0;
  -unity-slice-scale: 0.1px;
  -unity-background-scale-mode: stretch-to-fill;
}

/* Tabgroup tab.
 * sets the background fill; sets the outline/corner shape; sets font/text presentation; controls
 * size/placement.
 * Source rule 26.
 */
.tabgroup.Default > .tabgroup__tabs .tabgroup__tab {
  height: 38px;
  background-color: var(--none);
  -unity-font-style: var(--typography-weight-regular);
  justify-content: center;
  margin-left: 0;
  margin-right: 0;
  -unity-font-definition: var(--skin-font-body);
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 4px;
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* Buttongroup button.
 * sets the background fill; sets the outline/corner shape; sets font/text presentation; controls
 * size/placement.
 * Source rule 27.
 */
.buttongroup.Default .buttongroup__button {
  height: 32px;
  background-color: var(--none);
  -unity-font-style: var(--typography-weight-bold);
  justify-content: center;
  margin-left: var(--global-gap-regular);
  margin-right: var(--global-gap-regular);
  -unity-font-definition: var(--skin-font-body);
  padding-left: 0px;
  padding-right: 0px;
  padding-top: 4px;
  border-top-width: 0;
  border-right-width: 0;
  border-left-width: 0;
  border-bottom-width: 1.5px;
  border-bottom-color: var(--none);
}

/* Buttongroup button leading.
 * sets spacing around/inside the element.
 * Source rule 28.
 */
.buttongroup.Default .buttongroup__button.buttongroup__button--leading {
  margin-left: var(--global-gap-none);
}

/* Tabgroup tab active.
 * sets the outline/corner shape.
 * Source rule 29.
 */
.tabgroup.Default .tabgroup__tabs .tabgroup__tab--active {
  border-bottom-width: 1.5px;
  border-bottom-color: var(--colours-base-neutral-white);
  -unity-slice-left: 19;
  -unity-slice-top: 0;
  -unity-slice-right: 19;
  -unity-slice-bottom: 0;
  -unity-slice-scale: 0.1px;
  -unity-background-scale-mode: stretch-to-fill;
}

/* Buttongroup button active.
 * sets the outline/corner shape.
 * Source rule 30.
 */
.buttongroup.Default .buttongroup__button--active {
  border-bottom-width: 1.5px;
  border-bottom-color: var(--colours-base-neutral-white);
  -unity-slice-left: 19;
  -unity-slice-top: 0;
  -unity-slice-right: 19;
  -unity-slice-bottom: 0;
  -unity-slice-scale: 0.1px;
  -unity-background-scale-mode: stretch-to-fill;
}

/* Heading medium.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 31.
 */
.tabgroup.Default .tabgroup__tabs .tabgroup__tab--active .heading-md {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-16);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-left;
}

/* Heading medium.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 32.
 */
.buttongroup.Default .buttongroup__button--active .heading-md {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-16);
  white-space: normal;
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-left;
}

/* Tabgroup tab.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 33.
 */
.tabgroup.SegmentedButtonRow > .tabgroup__tabs .tabgroup__tab {
  margin: 0 2px 0 0;
  padding: 0 8px;
  border-width: 1px;
  border-color: var(--skin-border-default);
  background-color: var(--none);
  color: var(--skin-text-primary);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

/* Buttongroup button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 34.
 */
.buttongroup.SegmentedButtonRow .buttongroup__button {
  height: var(--global-height-regular);
  margin: 0 1px 0 1px;
  padding: var(--global-padding-regular) var(--global-padding-large);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  transition-property: background-color, border-color, color;
  transition-duration: var(--global-transition-long);
  transition-timing-function: ease-in-out;
}

/* Buttongroup button.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 35.
 */
.buttongroup.SegmentedButtonRow.segmented-buttons-compact .buttongroup__button {
  padding: var(--global-padding-regular);
  flex-shrink: 1;
}

/* Buttongroup button.
 * controls size/placement.
 * Source rule 36.
 */
.buttongroup.SegmentedButtonRow.segmented-buttons-fill .buttongroup__button {
  flex-grow: 1;
  flex-basis: 0;
  justify-content: center;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Buttons button navigation default.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 52.
 */
.simenu .virtualised-list__item--selected .buttons-button-navigation-default {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-action-primary-hover);
  color: var(--skin-action-primary-foreground);
}

/* The virtual-list selection uses the same Volt fill as the standalone
 * selected navigation button; its nested text needs the paired ink too. */
.simenu .virtualised-list__item--selected .buttons-button-navigation-default .sitext {
  color: var(--skin-action-primary-foreground);
}

/* Simenu.
 * Shows these elements; controls size/placement.
 * Source rule 53.
 */
.simenu > BindingRoot {
  display: flex;
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  justify-content: center;
}

/* Unity scroll view content container.
 * controls size/placement.
 * Source rule 54.
 */
.simenu .unity-scroll-view__content-container {
  justify-content: center;
}

/* Menu element.
 * sets spacing around/inside the element.
 * Source rule 55.
 */
.simenu .menu-element {
  padding-left: 4px;
  padding-right: 4px;
}

/* Buttongroup button.
 * controls size/placement.
 * Source rule 56.
 */
.fmc_store_tab.buttongroup__button {
  height: 100%;
}

/* Header button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 57.
 */
.header-button {
  background-color: var(--none);
  flex-grow: 1;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
  border-top-width: 0;
  border-right-width: 0;
  border-bottom-width: 0;
  border-left-width: 0;
}

/* Reorder indicator left.
 * sets the outline/corner shape.
 * Source rule 58.
 */
.reorder-indicator-left {
  border-color: var(--colours-base-neutral-white);
  border-left-width: 3px;
}

/* Reorder indicator right.
 * sets the outline/corner shape.
 * Source rule 59.
 */
.reorder-indicator-right {
  border-color: var(--colours-base-neutral-white);
  border-right-width: 3px;
}

/* Sort icon hidden.
 * Hides these elements.
 * Source rule 60.
 */
.sort-icon--hidden {
  display: none;
}

/* Streamed table cell.
 * controls size/placement.
 * Source rule 61.
 */
.streamed-table-cell-top-aligned .streamed-table__cell {
  justify-content: flex-start;
}

/* Streamed table cell.
 * sets font/text presentation; controls size/placement.
 * Source rule 62.
 */
.streamed-table__cell {
  align-self: stretch;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  flex-wrap: nowrap;
  white-space: nowrap;
  --custom-focus-background: var(--skin-selection-background);
}

/* Streamed table header.
 * Changes text/foreground colour; sets the background fill; sets font/text presentation.
 * Source rule 63.
 */
.streamed-table__header {
  background-color: var(--none);
  color: var(--skin-text-primary);
  -unity-font-style: var(--typography-weight-regular);
  -unity-text-align: middle-center;
}

/* Streamed table header scroll View.
 * controls size/placement.
 * Source rule 64.
 */
.streamed-table__header-scrollView {
  flex-shrink: 0;
}

/* Streamed table footer scroll View.
 * controls size/placement.
 * Source rule 65.
 */
.streamed-table__footer-scrollView {
  flex-shrink: 0;
}

/* Streamed table cell.
 * controls size/placement.
 * Source rule 66.
 */
.table-cell-grow .streamed-table__cell > * > TemplateContainer {
  flex-grow: 1;
}

/* Virtualised list view.
 * controls size/placement.
 * Source rule 67.
 */
.virtualised-list--stretched .virtualised-list__view {
  align-items: stretch;
}

/* Virtualised list view.
 * controls size/placement.
 * Source rule 68.
 */
.streamed-table .virtualised-list__view {
  align-items: flex-start;
}

/* Scroll view hover cursor.
 * chooses the pointer and hotspot.
 * Source rule 69.
 */
.scroll-view__hover-cursor {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Nested list item children.
 * Hides these elements.
 * Source rule 70.
 */
.nested-list__item__children {
  display: none;
}

/* Nested list item children.
 * Shows these elements; sets spacing around/inside the element.
 * Source rule 71.
 */
.nested-list__item--expanded > .nested-list__item__children {
  display: flex;
  margin-left: 10px;
}

/* Nested list item selected.
 * sets the background fill.
 * Source rule 72.
 */
.nested-list__item--selected {
  background-color: var(--skin-on-media-alpha-20);
}

/* Bindableeditbox.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 73.
 */
.ige-field .bindableeditbox {
  width: 120px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  min-width: 120px;
  justify-content: space-between;
  align-items: center;
  border-radius: var(--skin-radius-small);
}

/* Unity base field input.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 74.
 */
.ige-field .bindableeditbox .unity-base-field__input {
  padding: 0;
  border-width: 0px;
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
}

/* Unity base field.
 * sets spacing around/inside the element.
 * Source rule 75.
 */
.ige-field-margin .unity-base-field {
  margin: 0;
}

/* Sibutton.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 76.
 */
.ige-action-button-margin-bottom .sibutton,
.ige-action-button .si-dropdown__selection-field {
  margin-bottom: var(--global-gap-distant);
}

/* Rotate manager shortcut.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 77.
 */
.rotate-manager-shortcut {
  position: absolute;
  padding: var(--padding-padding-4);
  background-color: var(--skin-surface-page-alpha-70);
  border-radius: var(--border-radius-radius-8);
  bottom: 50%;
  right: 5%;
}

/* Title.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement.
 * Source rule 78.
 */
.title {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-20);
  align-items: auto;
  justify-content: flex-start;
  -unity-text-align: upper-center;
  -unity-font-definition: var(--skin-font-body);
}

/* Sicheckbox.
 * sets the background fill; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 79.
 */
.sicheckbox,
.sicheckboxgroupparent {
  background-color: var(--skin-transparent);
  border-left-color: var(--skin-text-secondary);
  border-right-color: var(--skin-text-secondary);
  border-top-color: var(--skin-text-secondary);
  border-bottom-color: var(--skin-text-secondary);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-top-left-radius: var(--skin-radius-compact);
  border-bottom-left-radius: var(--skin-radius-compact);
  border-top-right-radius: var(--skin-radius-compact);
  border-bottom-right-radius: var(--skin-radius-compact);
}

/* Expanded checkbox overflow.
 * controls size/placement; chooses the pointer and hotspot.
 * Source rule 80.
 */
.sicheckbox .expanded-checkbox-overflow {
  position: absolute;
  width: var(--expanded-checkbox-width-percentage);
  height: var(--expanded-checkbox-height-percentage);
  left: var(--expanded-checkbox-left-offset);
  align-self: center;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Unity toggle checkmark — checked/selected.
 * sets the background fill; sets the background artwork; tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 81.
 */
.sicheckbox > .unity-toggle__input:checked > .unity-toggle__checkmark,
.sicheckbox > .unity-toggle__input:checked:hover > .unity-toggle__checkmark {
  background-color: var(--skin-surface-raised);
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Silabel.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 82.
 */
.silabel {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-10);
  margin-left: 4px;
  margin-right: 4px;
  margin-top: 4px;
  margin-bottom: 4px;
  padding-left: 4px;
  padding-right: 4px;
  padding-top: 4px;
  padding-bottom: 4px;
  -unity-text-align: middle-center;
  -unity-font-style: var(--typography-weight-bold);
  white-space: normal;
  -unity-text-outline-width: 0;
}

/* Sitile.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 83.
 */
.sitile {
  border-width: 0;
  font-size: var(--typography-size-14);
  margin-left: 4px;
  margin-right: 4px;
  margin-top: 4px;
  margin-bottom: 4px;
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  flex-direction: column;
  flex-wrap: nowrap;
  border-radius: var(--skin-radius-medium);
  border-top-left-radius: var(--skin-radius-card);
  border-bottom-left-radius: var(--skin-radius-card);
  border-top-right-radius: var(--skin-radius-card);
  border-bottom-right-radius: var(--skin-radius-card);
  overflow: hidden;
  flex-grow: 1;
}

/* Sitile — pointer hover.
 * chooses the pointer and hotspot.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 84.
 */
.sitile:hover,
.sipreferencestab:hover,
.embeddablehover {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sitiles padding.
 * sets spacing around/inside the element.
 * Source rule 85.
 */
.sitiles-padding {
  padding: var(--spacing-padding-tiles);
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* SI dropdown selection field.
 * controls size/placement; chooses the pointer and hotspot.
 * Source rule 101.
 */
.secondary-navigation-tab-dropdown .si-dropdown__selection-field {
  height: 100%;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
  align-self: stretch;
}

/* Sicalendar hover cursor.
 * chooses the pointer and hotspot.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 102.
 */
.sicalendar-hover-cursor,
.sicalendar-hover-cursor .unity-scroll-view,
.sicalendar-hover-cursor .unity-scroll-view__content-and-vertical-scroll-container,
.sicalendar-hover-cursor .unity-scroll-view__content-viewport,
.sicalendar-hover-cursor .unity-scroll-view__content-container {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Speakto widget hover cursor.
 * chooses the pointer and hotspot.
 * Source rule 103.
 */
.speakto-widget-hover-cursor {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Siscreentitle.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 104.
 */
.siscreentitle {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-64);
  -unity-text-align: upper-center;
  text-shadow: 3px 3px 3px var(--skin-surface-canvas);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-outline-width: 0;
}

/* Fadein.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Source rule 105.
 */
.fadein {
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
}

/* Fadeout.
 * defines how state changes animate; changes opacity for the whole element and its contents.
 * Source rule 106.
 */
.fadeout {
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
}

/* Start Faded Out.
 * changes opacity for the whole element and its contents.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 107.
 */
.startFadedOut,
.panel .panel-fade,
.panel .sipopup-container,
.panel .base-layer-content {
  opacity: 0;
}

/* Scalein.
 * defines how state changes animate.
 * Source rule 108.
 */
.scalein {
  transition-property: scale;
  transition-duration: 1s;
  transition-timing-function: ease-in-out;
  scale: 1 1;
  transition-delay: 0.5s;
}

/* Scaleout.
 * defines how state changes animate.
 * Source rule 109.
 */
.scaleout {
  transition-property: scale;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out;
  scale: 0 0;
}

/* Start scaled out.
 * changes opacity for the whole element and its contents.
 * Source rule 110.
 */
.start-scaled-out {
  opacity: 0;
  scale: 0 0;
}

/* Search item style.
 * sets spacing around/inside the element.
 * Source rule 111.
 */
.search-item-style {
  margin-bottom: 16px;
  margin-left: 16px;
}

/* Search item style tab.
 * sets spacing around/inside the element.
 * Source rule 112.
 */
.search-item-style-tab {
  margin-bottom: 12px;
  margin-left: 12px;
}

/* Navigation focus element.
 * defines how state changes animate.
 * Source rule 113.
 */
.navigation-focus-element {
  transition-property: top, left, width, height;
  transition-duration: 0.15s;
  transition-timing-function: ease-out-sine;
}

/* Navigation focus element border.
 * sets the outline/corner shape; defines how state changes animate.
 * Source rule 114.
 */
.navigation-focus-element-border {
  border-width: 2px;
  transition-property: border-color;
  transition-duration: 0.5s;
  transition-timing-function: ease-in-out-sine;
  --custom-border-color1: var(--skin-focus-ring);
  --custom-border-color2: var(--skin-text-secondary);
  --border-color1-delay: 0.3;
  --border-color2-delay: 0.6;
}

/* Unity radio button checkmark background.
 * controls size/placement.
 * Source rule 115.
 */
.tactics-extra-options-list .unity-radio-button__checkmark-background {
  max-width: 16px;
  max-height: 16px;
}

/* Tactics multiple choice options button.
 * sets the background fill; sets spacing around/inside the element.
 * Source rule 116.
 */
.tactics-multiple-choice-options-button SIButton {
  padding: 0;
  background-color: var(--skin-transparent);
  padding-top: 0;
}

/* Tactics option base.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 117.
 */
.tactics-option-base {
  padding: 0;
  border-color: var(--skin-on-media-alpha-65);
  background-color: var(--skin-transparent);
  flex-grow: 1;
  padding-top: 0;
}

/* Tactics option selected.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 118.
 */
.tactics-option-selected {
  padding: 0;
  border-color: var(--colours-brand-accent);
  background-color: var(--colours-brand-accent-alpha-20);
  flex-grow: 1;
  padding-top: 0;
}

/* Selectable selected.
 * sets spacing around/inside the element.
 * Source rule 119.
 */
.selectable--selected {
  padding: 0px;
}

/* Selectable selected — pointer hover.
 * sets spacing around/inside the element.
 * Source rule 120.
 */
.selectable--selected:hover {
  padding: 0;
}

/* Floating element root.
 * controls size/placement.
 * Source rule 121.
 */
.floating-element-root {
  position: absolute;
  width: 100%;
  height: 100%;
  flex-grow: 1;
}

/* Full screen floating block anchor primary layer root.
 * sets the background fill.
 * Source rule 122.
 */
.floating-element-root.full-screen-floating-block-anchor-primary-layer-root {
  background-color: var(--colours-brand-tints-midnight-85);
}

/* Floating element.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 123.
 */
.floating-element {
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-strong);
  border-radius: var(--skin-popup-radius);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  overflow: hidden;
  flex-direction: var(--row-direction-normal);
}

/* Edge rows paint their own hover fill. Mirror the popup's corner token on
 * those fills as well as clipping the parent; middle rows keep square joins. */
.floating-element .virtualised-list__item--first,
.floating-element .virtualised-list__item--first .sub-dropdown-content-container {
  border-top-left-radius: var(--skin-popup-radius);
  border-top-right-radius: var(--skin-popup-radius);
}
.floating-element .virtualised-list__item--last,
.floating-element .virtualised-list__item--last .sub-dropdown-content-container {
  border-bottom-left-radius: var(--skin-popup-radius);
  border-bottom-right-radius: var(--skin-popup-radius);
}

/* Floating element mouse padding.
 * controls size/placement.
 * Source rule 124.
 */
.floating-element-mouse-padding {
  position: absolute;
  width: 100%;
  height: 100%;
}

/* List popup list.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 125.
 */
.list-popup__list {
  border-width: 1px;
  border-color: var(--skin-border-default);
  padding-top: 0;
  padding-bottom: 0;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  overflow: hidden;
}

/* List popup item.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 126.
 */
.list-popup__item {
  margin: 0;
  padding: 5px 2px;
  color: var(--skin-text-primary);
  font-size: var(--typography-size-12);
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  white-space: nowrap;
  -unity-text-align: middle-left;
}

/* List popup item — pointer hover.
 * sets the background fill.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 127.
 */
.list-popup__item:hover,
.list-popup__item:selected,
.list-popup__item:active:enabled,
.list-popup__item.unity-collection-view__item--alternative-background:hover,
.list-popup__item.unity-collection-view__item--alternative-background:selected,
.list-popup__item.unity-collection-view__item--alternative-background:active:enabled {
  background-color: var(--skin-surface-canvas-alpha-48);
}

/* Unity collection view item alternative background.
 * sets the background fill.
 * Source rule 128.
 */
.list-popup__item.unity-collection-view__item--alternative-background {
  background-color: var(--skin-surface-canvas-alpha-12);
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Cascading menu folder entry.
 * Shows these elements; sets the background fill; sets font/text presentation; controls size/placement.
 * Source rule 148.
 */
.cascading-menu__folder__entry {
  display: flex;
  height: 32px;
  background-color: var(--skin-surface-page);
  white-space: nowrap;
  flex-direction: var(--row-direction-normal);
  align-items: flex-start;
  flex-shrink: 0;
}

/* Cascading menu folder separator.
 * sets the outline/corner shape.
 * Source rule 149.
 */
.cascading-menu__folder__separator {
  border-top-color: var(--skin-divider-colour);
  border-top-width: var(--skin-divider-width);
}

/* Sub dropdown content container.
 * controls size/placement.
 * Source rule 150.
 */
.sub-dropdown-content-container:enabled {
  width: 100%;
  flex-direction: var(--row-direction-normal);
  align-items: center;
}

/* Sub dropdown content container — pointer hover.
 * sets the background fill.
 * Source rule 151.
 */
/* Menu selection is indicated by its tick; the resting row stays neutral.
 * Pair the actual hover/press fill with dark ink, including nested text and
 * monochrome indicators, rather than dimming the complete menu row. */
.sub-dropdown-content-container:enabled,
.sub-dropdown-content-container:enabled .sitext {
  color: var(--skin-text-primary);
}
.sub-dropdown-content-container:enabled .indicator {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
/* Disabled dropdown placeholders can also be the selected list item. Their
 * row is neutral, not Volt: cancel generic selection ink and retain the
 * native disabled-row opacity rather than dimming the text a second time. */
.sub-dropdown-content-container:disabled,
.sub-dropdown-content-container:disabled .sitext {
  color: var(--skin-text-primary);
}
.sub-dropdown-content-container:disabled .indicator,
.sub-dropdown-content-container:disabled .ui-concepts-tick_small,
.sub-dropdown-content-container:disabled > .indicator-arrow {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
.sub-dropdown-content-container:hover:enabled,
.sub-dropdown-content-container:active:enabled {
  background-color: var(--skin-selection-hover);
  color: var(--skin-selection-foreground);
}
.sub-dropdown-content-container:hover:enabled .sitext,
.sub-dropdown-content-container:active:enabled .sitext,
.sub-dropdown-content-container.visual-highlighted:enabled .sitext {
  color: var(--skin-selection-foreground);
}
.sub-dropdown-content-container:hover:enabled .indicator,
.sub-dropdown-content-container:active:enabled .indicator,
.sub-dropdown-content-container.visual-highlighted:enabled .indicator,
.sub-dropdown-content-container:hover:enabled > .indicator-arrow,
.sub-dropdown-content-container:active:enabled > .indicator-arrow,
.sub-dropdown-content-container.visual-highlighted:enabled > .indicator-arrow {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* An open parent menu keeps this class after the pointer enters its child.
 * It is a persistent navigation state, separate from pointer hover. */
.sub-dropdown-content-container.visual-highlighted:enabled {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}

/* Visual highlighted.
 * sets the background fill.
 * Source rule 152.
 */
.visual-highlighted:enabled {
  background-color: var(--skin-brand-primary);
}

/* Indicator.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 153.
 */
.cascading-menu__folder .indicator,
.sub-dropdown-content-container .indicator {
  width: 25px;
  height: 100%;
  align-self: center;
}

/* Sub dropdown content container.
 * chooses the pointer and hotspot.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 154.
 */
.sub-dropdown-content-container:enabled,
.sub-dropdown-content-container:enabled .sub-dropdown-content-hitbox,
.sub-dropdown-content-container:enabled .indicator {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Indicator.
 * Hides these elements.
 * Shared rule for 8 selectors. Editing a declaration here affects the whole group below.
 * Source rule 155.
 */
.setpiece-routine-dropdown-item .indicator,
.hide-scroll-bar .unity-scroller__low-button,
.hide-scroll-bar .unity-scroller__high-button,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container > SIRadioButton > .unity-radio-button__input,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container > SIRadioButton #tick,
.hide_card_header #Header,
.checkbox-invisible .unity-toggle__input,
.setpieceswizardradiogroup .unity-radio-button .sigradient {
  display: none;
}

/* Right Indicator Section.
 * Shows these elements; controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 156.
 */
.cascading-menu__folder__entry__has_children > #RightIndicatorSection,
.sub-dropdown-content-container > .indicator-arrow {
  display: flex;
  width: 16px;
  height: 16px;
  background-size: contain;
  background-position-x: right 2px;
}

/* Indicator arrow.
 * sets the native component presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 157.
 */
.cascading-menu__folder__entry.reverse-order > .indicator-arrow,
.si-dropdown .virtualised-list__item.reverse-order > .indicator-arrow {
  rotate: 180deg;
}

/* Left Indicator Section.
 * Shows these elements.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 158.
 */
.cascading-menu__folder__entry__selected > #LeftIndicatorSection,
.sub-dropdown-content-container > .indicator-tick {
  display: flex;
  background-size: contain;
}

/* SI dropdown preview element.
 * sets font/text presentation; controls size/placement.
 * Source rule 159.
 */
.si-dropdown__preview-element {
  flex-grow: 1;
  flex-shrink: 1;
  flex-direction: var(--row-direction-normal);
  min-height: 25px;
  overflow: hidden;
  text-overflow: ellipsis;
  align-items: center;
}

/* Left Indicator Section.
 * Shows these elements.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 160.
 */
.cascading-menu__folder__entry__opens > #LeftIndicatorSection,
.sub-dropdown-content-container > .indicator-open {
  display: flex;
  background-size: contain;
}

/* Embedded sub dropdown.
 * Hides these elements; controls size/placement.
 * Source rule 161.
 */
.embedded-sub-dropdown {
  position: absolute;
  display: none;
  width: 100%;
  height: 100%;
}

/* Unity label.
 * controls size/placement.
 * Source rule 162.
 */
.embedded-sub-dropdown .unity-label {
  position: absolute;
  height: 100%;
  left: 5px;
  align-self: center;
}

/* SI dropdown selection field.
 * sets the outline/corner shape.
 * Source rule 163.
 */
.embedded-sub-dropdown .si-dropdown__selection-field {
  border-width: 0;
}

/* SI dropdown selection arrow.
 * Shows these elements.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 164.
 */
.si-dropdown-iphone .si-dropdown__selection-arrow,
.sub-dropdown-content-container .arrow-right-enabled,
.enabled-sub-dropdown,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container > SIRadioButton.unity-radio-button-group__child-active #tick,
.setpieceswizardradiogroup .unity-radio-button-group__child-active .sigradient {
  display: flex;
}

/* Cascading menu folder.
 * Changes text/foreground colour; controls size/placement.
 * Source rule 165.
 */
.cascading-menu__folder {
  color: var(--skin-text-primary);
  flex-direction: var(--row-direction-normal);
}

/* Floating element for cascading menu child.
 * sets the native component presentation.
 * Source rule 166.
 */
.floating-element-for-cascading-menu-child {
  overflow: visible;
}

/* Full screen floating block anchor root.
 * controls size/placement.
 * Source rule 167.
 */
.full-screen-floating-block-anchor-root {
  justify-content: center;
  align-items: center;
}

/* Full screen floating block anchor container.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 168.
 */
.full-screen-floating-block-anchor-root .full-screen-floating-block-anchor-container {
  width: 600px;
  height: 441px;
  padding: 10px;
  border-width: 0;
  background-color: var(--skin-transparent);
  flex-direction: column;
  max-height: 441px;
  transition-property: translate;
  transition-duration: 0.2s;
  transition-timing-function: ease-out;
}

/* Indicator.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 169.
 */
.full-screen-floating-block-anchor-container .indicator {
  max-height: 16px;
  max-width: 16px;
  margin-left: 8px;
  margin-right: 8px;
  align-self: center;
}

/* Virtualised list item.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 170.
 */
.full-screen-floating-block-anchor-container .si-dropdown__binding-root .virtualised-list__item,
.full-screen-floating-block-anchor-container .cascading-menu__folder-list .virtualised-list__item {
  height: auto;
  border-color: var(--skin-border-subtle);
  padding-top: 8px;
  padding-bottom: 8px;
  min-height: 60px;
  border-bottom-width: 1px;
}

/* Full screen floating block anchor secondary layer.
 * sets the native component presentation.
 * Source rule 171.
 */
.full-screen-floating-block-anchor-secondary-layer {
  translate: -100% 0;
}

/* Full screen floating block anchor other layer.
 * sets the native component presentation.
 * Source rule 172.
 */
.full-screen-floating-block-anchor-other-layer {
  translate: -200% 0;
}

/* Full screen floating block anchor container.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 173.
 */
.full-screen-floating-block-anchor-container > CascadingMenu,
.full-screen-floating-block-anchor-container > FolderView,
.full-screen-floating-block-anchor-container > .si-dropdown__binding-root {
  background-color: var(--skin-surface-page);
  border-radius: var(--skin-radius-control);
  padding-top: 10px;
  padding-bottom: 10px;
  flex-grow: 0;
}

/* Cascading menu folder.
 * controls size/placement.
 * Shared rule for 9 selectors. Editing a declaration here affects the whole group below.
 * Source rule 174.
 */
.full-screen-floating-block-anchor-container .cascading-menu__folder,
.full-screen-floating-block-anchor-container .cascading-menu__folder-list,
.si-dropdown .streamed-list-view,
.si-radio-button-group-selector .unity-radio-button-group__container > * > TemplateContainer,
.game-creation-radiogroup .unity-radio-button-group__container > * > TemplateContainer,
.grow-scroll-view-content-container .unity-scroll-view__content-container,
SIScrollView > #TabButtons {
  flex-grow: 1;
}

/* Sub dropdown content base element.
 * controls size/placement.
 * Source rule 176.
 */
.sub-dropdown-content-base-element {
  height: 100%;
  flex-grow: 1;
}

/* Tactical shouts panel.
 * controls size/placement.
 * Source rule 179.
 */
.tactical-tweaks-panel.tactical-shouts-panel {
  height: auto;
}

/* Cascading menu folder.
 * controls size/placement.
 * Source rule 180.
 */
.full-screen-floating-block-anchor-container .cascading-menu__folder {
  width: 100%;
  flex-grow: 0;
  align-items: stretch;
}

/* Full screen floating block anchor close button.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 181.
 */
.full-screen-floating-block-anchor-close-button {
  width: 32px;
  height: 32px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-20);
  background-color: var(--skin-surface-page);
  align-items: center;
  justify-content: center;
  border-radius: var(--spacing-small---8);
}

/* Full screen floating block anchor close button container.
 * controls size/placement.
 * Source rule 182.
 */
.full-screen-floating-block-anchor-close-button-container {
  position: absolute;
  left: 10px;
  top: 10px;
}

/* Unity repeat button.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 183.
 */
.full-screen-floating-block-anchor-root .unity-repeat-button {
  background-color: var(--skin-surface-page);
  -unity-background-scale-mode: scale-to-fit;
  border-radius: var(--skin-radius-control);
  min-width: 600px;
}

/* Full screen floating block anchor scroll button down.
 * sets spacing around/inside the element.
 * Source rule 184.
 */
.full-screen-floating-block-anchor-scroll-button__down {
  margin-top: 8px;
}

/* Full screen floating block anchor scroll button up.
 * sets spacing around/inside the element.
 * Source rule 185.
 */
.full-screen-floating-block-anchor-scroll-button__up {
  margin-bottom: 8px;
}

/* Full screen floating block anchor scroll button.
 * controls size/placement.
 * Source rule 186.
 */
.full-screen-floating-block-anchor-scroll-button {
  min-height: 40px;
}

/* FM news label.
 * Changes text/foreground colour; sets font/text presentation; sets spacing around/inside the element.
 * Source rule 187.
 */
.fm-news-label {
  color: var(--skin-component-fm-news-label-foreground);
  font-size: var(--typography-size-12);
  -unity-text-align: middle-left;
  white-space: normal;
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
  padding-bottom: 0;
}

/* FM news link test.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 188.
 */
.fm-news-link-test {
  opacity: 1;
  background-color: var(--skin-transparent);
  color: var(--skin-text-link);
  font-size: var(--typography-size-12);
  -unity-text-align: middle-left;
  white-space: normal;
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
  flex-grow: 0;
  flex-wrap: wrap;
  flex-direction: var(--row-direction-normal);
  align-items: stretch;
  justify-content: flex-start;
  -unity-font-style: var(--typography-weight-bold);
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
}

/* FM news link test — pointer hover.
 * Changes text/foreground colour.
 * Source rule 189.
 */
.fm-news-link-test:hover {
  color: var(--skin-text-link-hover);
}

/* FM tactics row.
 * controls size/placement.
 * Source rule 190.
 */
.fm-tactics-row {
  min-height: 10%;
  flex-direction: var(--row-direction-normal);
  justify-content: center;
}

/* Pane.
 * controls size/placement.
 * Source rule 191.
 */
.pane {
  flex-grow: 0;
  flex-shrink: 0;
}

/* Pane container.
 * sets the native component presentation.
 * Source rule 192.
 */
.pane-container {
  overflow: hidden;
}

/* Pane drag anchor.
 * controls size/placement.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 193.
 */
.pane-drag-anchor,
.expand-instance-root {
  position: absolute;
}

/* Pane drag line.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 194.
 */
.pane-drag-line {
  flex-shrink: 0;
}

/* Pane drag line horizontal.
 * controls size/placement; chooses the pointer and hotspot.
 * Source rule 195.
 */
.pane-drag-line-horizontal {
  width: 5px;
  height: auto;
  cursor: var(--cursor-size-left-right-1x-url) var(--cursor-size-left-right-1x-hotspot-x) var(--cursor-size-left-right-1x-hotspot-y);
  top: -5px;
  left: -5px;
  flex-grow: 1;
}

/* Pane drag line vertical.
 * controls size/placement; chooses the pointer and hotspot.
 * Source rule 196.
 */
.pane-drag-line-vertical {
  width: auto;
  height: 5px;
  cursor: var(--cursor-size-top-buttom-1x-url) var(--cursor-size-top-buttom-1x-hotspot-x) var(--cursor-size-top-buttom-1x-hotspot-y);
  left: -5px;
  top: 5px;
  flex-grow: 1;
}

/* FM club primary color.
 * supplies local values read by the component styling.
 * Source rule 197.
 */
.fm-club-primary-color {
  --color-primary: true;
}

/* FM club secondary color.
 * supplies local values read by the component styling.
 * Source rule 198.
 */
.fm-club-secondary-color {
  --color-secondary: true;
}

/* FM star rating container.
 * controls size/placement.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 199.
 */
.fm-star-rating-container,
.match-event-home,
.tactics-suggested-visible,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container,
.sicheckboxparentcontainer {
  flex-direction: var(--row-direction-normal);
}

/* FM star rating star.
 * sets spacing around/inside the element.
 * Source rule 200.
 */
.fm-star-rating-star {
  margin-right: -2px;
}

/* FM star rating star.
 * sets spacing around/inside the element.
 * Source rule 201.
 */
.stars-zero-margin .fm-star-rating-star {
  margin-right: 0;
}

/* Resizable panes.
 * controls size/placement.
 * Source rule 203.
 */
.resizable-panes {
  flex-direction: var(--row-direction-normal);
  min-height: 0px;
}

/* Testin.
 * Changes text/foreground colour; controls size/placement.
 * Source rule 204.
 */
.testin {
  color: var(--skin-text-primary);
  flex-direction: var(--row-direction-reverse);
  justify-content: flex-end;
}

/* Simenubaritem.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 205.
 */
.simenubaritem {
  background-color: var(--skin-on-media-alpha-06);
  color: var(--skin-text-primary);
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
  border-top-left-radius: var(--skin-radius-control);
  border-bottom-left-radius: var(--skin-radius-control);
  border-top-right-radius: var(--skin-radius-control);
  border-bottom-right-radius: var(--skin-radius-control);
  -unity-background-scale-mode: scale-to-fit;
  margin-left: 4px;
  margin-right: 4px;
  margin-top: 4px;
  margin-bottom: 4px;
  min-width: 72px;
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 8px;
  padding-bottom: 8px;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Simenubaritem — pointer hover.
 * sets the background fill.
 * Source rule 206.
 */
.simenubaritem:hover {
  background-color: var(--skin-on-media-alpha-12);
}

/* Streamed table row.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 207.
 */
.streamed-table__row,
.virtualised-list__item {
  /* Ordinary rows show their owning card; the alternate row adds a tint. */
  background-color: var(--skin-table-row-background);
}

/* Virtualised list item odd.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 208.
 */
.streamed-table__row.virtualised-list__item--odd,
.virtualised-list__item--odd,
.unity-radio-button-group__item--odd {
  background-color: var(--skin-table-row-alternate-background);
}

/* Virtualised list item odd.
 * sets the background fill.
 * Source rule 209.
 */
#newsCarousel .virtualised-list__item--odd {
  background-color: var(--skin-surface-panel);
}

/* Virtualised list item odd.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 210.
 */
.interactable-tile .streamed-table__row.virtualised-list__item--odd,
.interactable-tile .virtualised-list__item--odd,
.interactable-tile .unity-radio-button-group__item--odd {
  background-color: var(--skin-table-row-alternate-background);
}

/* Virtualised list item odd — pointer hover.
 * sets the background fill.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 211.
 */
.interactable-tile .streamed-table__row.virtualised-list__item--odd:hover,
.streamed-table__row.virtualised-list__item--odd:hover,
.streamed-table__row.virtualised-list__item:hover,
.streamed-table__row:hover {
  background-color: var(--skin-control-hover);
}

/* Data/list rows use a quiet selected surface. Filled controls and menu
 * actions have their own paired Volt state; a wide data row is not an action. */
.streamed-table__row.virtualised-list__item--selected,
.virtualised-list__item--selected,
.virtualised-list__item--selected:hover,
.streamed-table__row.virtualised-list__item--selected:hover {
  background-color: var(--skin-list-selection-background);
  color: var(--skin-list-selection-foreground);
}

.streamed-table__row.virtualised-list__item--selected:hover,
.virtualised-list__item--selected:hover {
  background-color: var(--skin-list-selection-hover);
}

/* Cell selected.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape.
 * Source rule 213.
 */
.streamed-table-cell-selector .cell--selected {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-component-streamed-table-cell-selector-cell-selected-background);
  color: var(--skin-list-selection-foreground);
  border-left-width: 1.5px;
  border-right-width: 1.5px;
}

/* Streamed table cell selector.
 * controls size/placement.
 * Source rule 214.
 */
.streamed-table-cell-selector {
  align-self: stretch;
}

/* Unity base text field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 215.
 */
.ige-input-rgb > .unity-integer-field > .unity-base-text-field {
  margin: 0;
  padding: 0;
  border-width: 0;
  background-color: var(--skin-transparent);
  align-items: center;
  align-self: center;
}

/* Unity base field input.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 216.
 */
.ige-input-rgb > .unity-integer-field > .unity-base-field__input {
  margin: 0;
  padding: 0;
  border-width: 0;
  background-color: var(--skin-transparent);
  border-radius: 0;
  align-items: center;
  align-self: center;
}

/* Unity base field input.
 * controls size/placement.
 * Source rule 217.
 */
.sicheckbox .unity-base-field__input {
  align-self: center;
  align-content: stretch;
}

/* Unity text field input.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 218.
 */
.ige-input-rgb > .unity-integer-field > .unity-text-field__input {
  margin: 0;
  padding: 0;
  border-width: 0;
  background-color: var(--skin-transparent);
  border-radius: 0;
  align-items: center;
  align-self: center;
}

/* Bindableeditbox.
 * Changes text/foreground colour; sets the outline/corner shape; sets font/text presentation; controls
 * size/placement.
 * Source rule 219.
 */
.bindableeditbox {
  width: 296px;
  padding: var(--spacing-new-ex) var(--spacing-tiles);
  color: var(--skin-text-primary);
  align-items: auto;
  min-height: 32px;
  -unity-font-definition: var(--skin-font-body);
  border-top-left-radius: var(--skin-radius-control);
  border-bottom-left-radius: var(--skin-radius-control);
  border-top-right-radius: var(--skin-radius-control);
  border-bottom-right-radius: var(--skin-radius-control);
}

/* Bindableeditbox — pointer hover.
 * Changes text/foreground colour.
 * Source rule 220.
 */
.bindableeditbox:hover:enabled {
  color: var(--skin-component-bindableeditbox-hover-foreground);
}

/* Unity base text field.
 * supplies local values read by the component styling.
 * Source rule 221.
 */
.unity-base-text-field {
  --unity-cursor-color: var(--skin-field-foreground);
  --unity-selection-color: var(--skin-field-text-selection);
}

/* Sitile text bold.
 * sets font/text presentation.
 * Source rule 222.
 */
.sitile__text-bold {
  font-size: var(--typography-size-16);
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-bold);
  -unity-text-align: middle-center;
  letter-spacing: -8px;
}

/* Sitile title.
 * sets font/text presentation; sets spacing around/inside the element.
 * Source rule 223.
 */
.sitile__title {
  font-size: var(--typography-size-12);
  -unity-text-align: middle-left;
  -unity-font-style: var(--typography-weight-regular);
  -unity-font-definition: var(--skin-font-body);
  margin-left: 8px;
  margin-right: 8px;
  margin-top: 8px;
  margin-bottom: 8px;
}

/* Sitile text.
 * sets font/text presentation.
 * Source rule 224.
 */
.sitile__text {
  -unity-font-style: var(--typography-weight-regular);
  letter-spacing: 0;
  -unity-font-definition: var(--skin-font-body);
