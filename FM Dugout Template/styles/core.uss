/* Financial history chart x axis labels.
 * Changes text/foreground colour; sets the background fill; sets font/text presentation; controls
 * size/placement.
 * Source rule 5121.
 */
.financial-history-chart-x-axis-labels {
  opacity: 1;
  width: auto;
  background-color: var(--colours-base-red-deep);
  color: var(--skin-text-primary);
  font-size: var(--typography-size-12);
  -unity-font-definition: var(--skin-font-body);
  -unity-font-style: var(--typography-weight-regular);
  -unity-text-align: middle-center;
  white-space: nowrap;
  padding-left: 0;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 0;
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  -unity-text-outline-width: 0;
  letter-spacing: 0;
}

/* Financial history chart y axis labels.
