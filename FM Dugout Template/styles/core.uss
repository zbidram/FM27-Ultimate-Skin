.buttongroup.SegmentedButtonRow .buttongroup__button--active .sigradient,
.buttons-segmented-button-row-active-regular-placement-leading .sigradient,
.buttons-segmented-button-row-active-regular-placement-trailing .sigradient,
.buttons-segmented-button-row-active-regular-placement-middle .sigradient {
  position: absolute;
  width: 100%;
  height: 100%;
  --start-colour: var(--skin-transparent);
  --end-colour: var(--skin-transparent);
  left: 0;
  top: 0;
  flex-grow: 1;
  overflow: hidden;
}

