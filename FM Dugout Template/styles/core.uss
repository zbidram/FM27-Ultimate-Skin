 */
.divider-right {
  border-left-color: var(--skin-on-media-alpha-14);
  border-right-color: var(--skin-on-media-alpha-14);
  border-top-color: var(--skin-on-media-alpha-14);
  border-bottom-color: var(--skin-on-media-alpha-14);
  border-right-width: 2px;
}

/* Sitile.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 712.
 */
.sitile {
  border-width: 2px;
  background-color: var(--skin-on-media-alpha-04);
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  flex-direction: column;
  flex-wrap: nowrap;
  border-radius: var(--skin-radius-medium);
  overflow: hidden;
  flex-grow: 1;
  border-left-color: var(--skin-on-media-alpha-04);
  border-right-color: var(--skin-on-media-alpha-04);
  border-top-color: var(--skin-on-media-alpha-04);
  border-bottom-color: var(--skin-on-media-alpha-04);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-top-left-radius: var(--skin-radius-card);
  border-bottom-left-radius: var(--skin-radius-card);
  border-top-right-radius: var(--skin-radius-card);
  border-bottom-right-radius: var(--skin-radius-card);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sitile text bold.
 * sets font/text presentation.
 * Source rule 713.
 */
.sitile__text-bold {
  font-size: var(--typography-size-16);
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-center;
  letter-spacing: -8px;
}

/* Sitile title.
 * sets font/text presentation; controls size/placement; sets spacing around/inside the element.
 * Source rule 714.
 */
.sitile__title {
  font-size: var(--typography-size-12);
  -unity-text-align: middle-left;
  -unity-font-definition: var(--skin-font-body);
  text-shadow: 1px 1px 1px var(--skin-surface-canvas-alpha-48);
  margin-left: 8px;
  margin-right: 8px;
  margin-top: 8px;
  margin-bottom: 8px;
  flex-direction: var(--row-direction-normal);
}

/* Sitile text.
 * sets font/text presentation.
 * Source rule 715.
 */
.sitile__text {
  -unity-font-style: var(--typography-weight-regular);
  letter-spacing: 0;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-left;
}

/* Sisubtitle.
 * sets font/text presentation.
 * Source rule 716.
 */
.sisubtitle {
  -unity-font-definition: var(--skin-font-body);
}

/* Sitile button.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 717.
 */
.sitile__button {
  display: flex;
  background-color: var(--none);
  margin-left: 0;
  margin-right: 0;
  margin-top: 0;
  margin-bottom: 0;
  padding-left: 0;
  padding-right: 0;
  padding-top: 0;
  padding-bottom: 0;
  flex-grow: 1;
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0;
  border-radius: var(--skin-radius-medium);
}

/* Sitile button — pointer hover.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement; chooses the pointer
 * and hotspot.
 * Source rule 718.
 */
.sitile__button:hover {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-14);
  -unity-font-style: var(--typography-weight-bold);
  -unity-font-definition: var(--skin-font-body);
  flex-direction: column;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sitile title tiny.
