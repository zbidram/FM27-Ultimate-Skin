/* Transparency until hovered.
 * changes opacity for the whole element and its contents.
 * Source rule 604.
 */
.transparency-until-hovered {
  opacity: 0.35;
}

/* Transparency until hovered — pointer hover.
 * changes opacity for the whole element and its contents.
 * Source rule 605.
 */
.transparency-until-hovered:hover {
  opacity: 1;
}

/* Child hidden until hovered.
