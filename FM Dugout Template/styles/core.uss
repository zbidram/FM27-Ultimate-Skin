 */
.streamed-table-read-only-toggle .virtualised-list__item--selected .radio-toggle-read-only__checkmark,
.streamed-table__checkbox:checked:enabled .unity-toggle__checkmark,
.inputs-switch-checkbox-default-switch-false--icon-none:checked:enabled .unity-toggle__checkmark {
  background-color: var(--skin-text-primary);
}

/* Streamed table row direction normal.
 * controls size/placement.
 * Source rule 3754.
 */
.streamed-table-row-direction-normal TemplateContainer {
  flex-grow: 1;
  flex-direction: var(--row-direction-normal);
}

/* Streamed table checkbox.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3755.
 */
.streamed-table__checkbox {
  width: 16px;
  height: 16px;
  border-color: var(--skin-text-primary);
  flex-shrink: 0;
  border-top-width: var(--global-border-width-medium-thin);
  border-right-width: var(--global-border-width-medium-thin);
  border-bottom-width: var(--global-border-width-medium-thin);
  border-left-width: var(--global-border-width-medium-thin);
  border-radius: var(--skin-radius-micro);
}

/* Expanded checkbox overflow.
 * controls size/placement; chooses the pointer and hotspot.
 * Source rule 3756.
 */
.streamed-table__checkbox .expanded-checkbox-overflow {
  position: absolute;
  width: var(--expanded-checkbox-width-percentage-standard);
  height: var(--expanded-checkbox-height-percentage-standard);
