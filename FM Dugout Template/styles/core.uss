  padding-top: 8px;
  padding-left: 12px;
  padding-right: 12px;
  padding-bottom: 8px;
  flex-direction: column;
  align-items: stretch;
  align-self: stretch;
  border-radius: var(--skin-radius-card);
}

/* Ios data display expanded table.
