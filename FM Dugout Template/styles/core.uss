/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Title frame fitness match sharpness.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 4145.
 */
.title-frame-fitness-match-sharpness {
  width: 100%;
  height: 100%;
  padding: 12px;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  flex-grow: 1;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  border-radius: var(--skin-radius-card);
}

/* Section link underline tracks the primary brand in every state.
 */
.title-link-button {
  height: var(--height-height-16);
  margin: var(--none);
  padding: var(--none);
  background-color: var(--none);
  justify-content: center;
  align-items: flex-start;
  align-self: flex-start;
  border-bottom-width: var(--global-border-thick);
  flex-direction: var(--row-direction-normal);
  transition: border-bottom-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
  border-bottom-color: var(--skin-brand-primary);
}

/* Title link button height 20px.
 * controls size/placement.
 * Source rule 4147.
 */
.title-link-button-height-20px {
  height: var(--height-height-20);
}

/* Section link underline tracks the primary brand in every state.
 */
.title-link-button:active:enabled {
  border-bottom-color: var(--skin-brand-primary);
}

/* Section title text uses the same neutral/Volt roles as Dugout UI; no leftover native pink hover colour.
 */
.title-link-button:active:enabled .title-link-primary-text {
  color: var(--skin-brand-primary-hover);
}

/* Section link underline tracks the primary brand in every state.
 */
.title-link-button:hover {
  border-bottom-color: var(--skin-brand-primary-hover);
}

/* Section title text uses the same neutral/Volt roles as Dugout UI; no leftover native pink hover colour.
 */
.title-link-button:hover .title-link-primary-text {
  color: var(--skin-brand-primary-hover);
}

/* Section title text uses the same neutral/Volt roles as Dugout UI; no leftover native pink hover colour.
 */
.title-link-primary-text {
  transition: color var(--global-transition-buttons) var(--global-transition-animation-buttons);
  color: var(--skin-text-primary);
}

/* Tool background image.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 4153.
 */
.tool-background-image {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0px;
  left: 0px;
  right: 0px;
  bottom: 0px;
  border-radius: var(--global-radius-regular);
  overflow: hidden;
}

/* Tool messages list.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 4154.
 */
.tool-messages-list {
  border-width: 1px;
  border-color: var(--layout-ui-cell-focus-default-border);
  background-color: var(--skin-transparent);
}

/* Message last selected.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 4155.
 */
/* The selected message already has a dedicated leading marker. Use a raised Navy fill
 * and Dugout's control radius without a second full-box outline. */
.tool-messages-list .message-last-selected {
  border-width: var(--global-border-width-none);
  border-color: var(--skin-transparent);
  background-color: var(--skin-surface-strong);
  border-radius: var(--skin-radius-control);
}

/* Message last selected indicator.
 * Shows these elements; controls size/placement; sets spacing around/inside the element.
 * Source rule 4156.
 */
.tool-messages-list .message-last-selected .message-last-selected-indicator {
  position: absolute;
  display: flex;
  width: 2px;
  padding: 4px 0 4px 0;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
}

/* Tool states negotiate payoff property 1 default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4157.
 */
.tool-states-negotiate-payoff-property-1-default {
  width: 640px;
  height: 640px;
  padding: var(--spacing-padding-medium---16);
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--layout-modules-block-radius);
}

/* Tool states tool states transfer offer panel transfer embargo min res.
 * controls size/placement.
 * Source rule 4158.
 */
