/* Fmspiderchartlarge.
 * supplies local values read by the component styling.
 * Source rule 4616.
 */
.fmspiderchartlarge {
  --chart-outline-colour: var(--skin-on-media-alpha-35);
  --chart-axis-colour: var(--skin-on-media-alpha-08);
  --chart-inner-ring-colour: var(--skin-on-media-alpha-08);
  --chart-fill-colour: var(--communication-coaching-adjective-ratings-competent-surface);
  --chart-outline-line-width: 2;
  --chart-axis-line-width: 2;
  --chart-inner-ring-line-width: 1;
  --chart-graded-colour-1: var(--colours-linear-scale-strong-1);
  --chart-graded-colour-2: var(--colours-linear-scale-strong-3);
  --chart-graded-colour-3: var(--colours-brand-light);
  --chart-graded-colour-4: var(--colours-linear-scale-strong-8);
  --chart-graded-colour-5: var(--colours-linear-scale-strong-10);
  --series-line-width: 2;
  --series-fill-alpha: 0.35;
  --series-1-stroke-colour: var(--colours-base-orange-strong);
  --series-1-fill-colour: var(--colours-base-orange-base-35);
  --series-1-chartpoint-colour: var(--colours-base-orange-strong);
  --series-1-chartpoint-radius: 8;
  --series-2-stroke-colour: var(--colours-base-cyan-strong);
  --series-2-fill-colour: var(--colours-base-cyan-base-35);
  --series-2-chartpoint-colour: var(--colours-base-cyan-strong);
  --series-2-chartpoint-radius: 8;
}

/* Fmspiderchartmedium.
 * supplies local values read by the component styling.
 * Source rule 4617.
 */
.fmspiderchartmedium {
  --chart-outline-colour: var(--skin-on-media-alpha-35);
  --chart-axis-colour: var(--skin-on-media-alpha-08);
  --chart-inner-ring-colour: var(--skin-on-media-alpha-08);
  --chart-fill-colour: var(--communication-coaching-adjective-ratings-competent-surface);
  --chart-outline-line-width: 2;
  --chart-axis-line-width: 2;
  --chart-inner-ring-line-width: 1;
  --chart-graded-colour-1: var(--colours-linear-scale-strong-1);
  --chart-graded-colour-2: var(--colours-linear-scale-strong-3);
  --chart-graded-colour-3: var(--colours-brand-light);
  --chart-graded-colour-4: var(--colours-linear-scale-strong-8);
  --chart-graded-colour-5: var(--colours-linear-scale-strong-10);
  --series-line-width: 2;
  --series-fill-alpha: 0.35;
  --series-1-stroke-colour: var(--colours-base-orange-strong);
  --series-1-fill-colour: var(--colours-base-orange-base-35);
  --series-1-chartpoint-colour: var(--colours-base-orange-strong);
  --series-1-chartpoint-radius: 4;
  --series-2-stroke-colour: var(--colours-base-cyan-strong);
  --series-2-fill-colour: var(--colours-base-cyan-base-35);
  --series-2-chartpoint-colour: var(--colours-base-cyan-strong);
  --series-2-chartpoint-radius: 4;
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
