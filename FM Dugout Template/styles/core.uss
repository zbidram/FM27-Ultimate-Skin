 */
.scaling-icon-grades-background-colour-d {
  height: 20px;
  padding: 0 var(--spacing-padding-small---8);
  background-color: var(--colours-linear-scale-strong-3-alpha-16);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--numbers-border-radius-medium-small);
}

/* Scaling icon grades background colour e.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3429.
 */
.scaling-icon-grades-background-colour-e {
  height: 20px;
  padding: 0 var(--spacing-padding-small---8);
  background-color: var(--colours-linear-scale-strong-2-alpha-16);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--numbers-border-radius-medium-small);
}

/* Scaling icon grades background colour f.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3430.
 */
.scaling-icon-grades-background-colour-f,
.scaling-icon-grades-background-colour-g {
  height: 20px;
  padding: 0 var(--spacing-padding-small---8);
  background-color: var(--colours-linear-scale-strong-1-alpha-16);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--numbers-border-radius-medium-small);
}

/* Scaling icon grades background colour unknown.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3431.
 */
.scaling-icon-grades-background-colour-unknown {
  height: 20px;
  padding: 0 var(--spacing-padding-small---8);
  background-color: var(--skin-on-media-alpha-16);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--numbers-border-radius-medium-small);
}

/* Scaling icon grades circle filled colour a.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3432.
 */
.scaling-icon-grades-circle-filled-colour-a {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--linear-ranges-7-values-7);
}

/* Scaling icon grades circle filled colour b.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3433.
 */
.scaling-icon-grades-circle-filled-colour-b {
  border-color: var(--skin-on-media-alpha-35);
