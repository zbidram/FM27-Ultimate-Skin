 */
.fixturesstages-content-nation {
  padding: var(--spacing-padding-medium---16) var(--spacing-padding-small---8);
  justify-content: center;
  align-items: flex-start;
  align-self: stretch;
  flex-direction: var(--row-direction-always-normal);
}

/* Flex no shrink class.
 * controls size/placement.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2170.
 */
.constant-height-header-footer > #footer-scrollview,
.constant-height-header-footer > .unity-scroll-view,
.fm-searchable-combobox__chevron-button {
  flex-shrink: 0;
}

/* Floating block background.
 * sets the background fill.
 * Source rule 2174.
 */
.floating-block-background {
  background-color: var(--skin-surface-page-alpha-80);
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Fm27 spinner loading gif.
 * controls size/placement.
 * Source rule 2200.
 */
.fm27-spinner-loading-gif {
  position: absolute;
  width: 64px;
  height: 64px;
  right: 32px;
  bottom: 32px;
}

/* Fmc preferences detailed buttons.
 * sets spacing around/inside the element.
 * Source rule 2201.
 */
.fmc-preferences-detailed-buttons {
  margin: 12px 0 0 12px;
}

/* Buttongroup button.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2202.
 */
.fmc-preferences-radio-buttons.buttongroup__button:enabled {
  height: 42px;
  margin: 0;
  padding: 0;
  border-width: 2px;
  background-color: var(--skin-transparent);
  color: var(--skin-text-secondary);
  justify-content: center;
  align-items: center;
  flex-direction: var(--row-direction-normal);
  border-bottom-color: var(--skin-transparent);
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
}

/* Fmc recruitment focus filters list button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2203.
 */
.fmc-recruitment-focus-filters-list-button {
  height: 20px;
  padding: 0 var(--padding-padding-4);
  background-color: var(--theme-color-grey-soft-surface);
  justify-content: center;
  align-items: center;
  align-content: center;
  flex-shrink: 0;
  flex-wrap: wrap;
  border-radius: var(--global-radius-large);
  flex-direction: var(--row-direction-normal);
}

/* Sicontainer horizontal align.
 * sets the background fill.
 * Source rule 2204.
 */
.fmc-recruitment-focus-list-button .sicontainer_horizontal_align {
  background-color: var(--skin-component-fmc-recruitment-focus-list-button-sicontainer-horizontal-align-background);
}

/* Virtualised list item.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 2205.
 */
.fmc-recruitment-focus-list-button .virtualised-list__item {
  margin-bottom: var(--global-gap-regular);
  border-radius: var(--global-radius-large);
}

/* Virtualised list item selected.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2206.
 */
.fmc-recruitment-focus-list-button .virtualised-list__item--selected {
  background-color: var(--skin-component-fmc-recruitment-focus-list-button-virtualised-list-item-selected-background);
  border-radius: var(--global-radius-large);
}

/* Fmc responsibility toggle button.
 * sets spacing around/inside the element.
 * Source rule 2207.
 */
.fmc-responsibility-toggle-button {
  margin: 0 2px 0 0;
  padding: 8px 16px 8px 16px;
}

/* Fmc squad depth good.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2208.
 */
.fmc-squad-depth-good {
  width: 12px;
  height: 12px;
  border-width: 2px;
  border-color: var(--skin-component-fmc-squad-depth-good-border-color);
  background-color: var(--skin-component-fmc-squad-depth-good-background);
  align-self: center;
  border-radius: var(--skin-radius-card);
}

/* Fmc squad depth lacking.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2209.
 */
.fmc-squad-depth-lacking {
  width: 12px;
  height: 12px;
  border-width: 2px;
  border-color: var(--skin-surface-page-alpha-56);
  background-color: var(--skin-component-fmc-squad-depth-lacking-background);
  align-self: center;
  border-radius: var(--skin-radius-card);
}

/* Fmc squad depth reasonable.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2210.
 */
.fmc-squad-depth-reasonable {
  width: 12px;
  height: 12px;
  border-width: 2px;
  border-color: var(--skin-surface-page-alpha-56);
  background-color: var(--skin-component-fmc-squad-depth-reasonable-background);
  align-self: center;
  border-radius: var(--skin-radius-card);
}

/* Fmc training last8weeks graph.
 * sets the outline/corner shape.
 * Source rule 2211.
 */
.fmc-training-last8weeks-graph {
  border-width: 1px;
  border-radius: var(--skin-radius-card);
  border-left-color: var(--skin-on-media-alpha-20);
  border-right-color: var(--skin-on-media-alpha-20);
  border-top-color: var(--skin-on-media-alpha-20);
  border-bottom-color: var(--skin-on-media-alpha-20);
}

/* Fmc training schedule week marker.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2212.
 */
.fmc-training-schedule-week-marker {
  padding: 4px;
  border-radius: 15px;
  max-height: 40px;
  min-width: 100px;
  min-height: 24px;
}

/* Fmfc background.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2213.
 */
.fmfc-background {
  background-color: var(--skin-surface-page);
  border-radius: var(--numbers-border-radius-medium);
}

/* Buttons controls desktop default active true.
 * sets the background fill.
 * Source rule 2214.
 */
.fmfc-close-button-background-colour .buttons-controls-pc-default--active-true {
  background-color: var(--skin-surface-page);
}

/* Fmpedia text cell.
 * Changes text/foreground colour; sets spacing around/inside the element.
 * Source rule 2215.
 */
.fmpedia-text-cell {
  color: var(--skin-text-primary);
  margin-left: 4px;
}

/* Fmpedia tile container.
 * controls size/placement.
 * Source rule 2216.
 */
.fmpedia-tile-container {
  width: 312px;
  flex-shrink: 0;
  justify-content: flex-start;
  align-items: stretch;
}

/* Bindable uxml list subsequent row.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2217.
 */
.fmpedia-tiles-margin .bindable-uxml-list_subsequent__row {
  margin-top: 10px;
}

/* Layout tile base container.
 * controls size/placement.
 * Source rule 2218.
 */
.fmpedia-tiles-margin .layout-tile-base-container {
  height: 148px;
}

/* Fmpedia tile background image.
 * controls size/placement.
 * Source rule 2219.
 */
.fmpedia_tile_background_image {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  bottom: 0;
}

/* Fmpediabutton.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2220.
 */
.fmpediabutton {
  width: auto;
  height: 28px;
  background-color: var(--layout-ui-cell-focus-default-background-default);
  flex-grow: 1;
  padding-top: 0;
  padding-bottom: 0;
  padding-right: 8px;
  padding-left: 8px;
  margin-left: 1px;
  margin-top: 1px;
  margin-bottom: 4px;
  border-top-left-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
  border-left-color: var(--skin-on-media-alpha-06);
  border-right-color: var(--skin-on-media-alpha-06);
  border-top-color: var(--skin-on-media-alpha-06);
  border-bottom-color: var(--skin-on-media-alpha-06);
  flex-shrink: 1;
  flex-direction: var(--row-direction-normal);
  align-items: center;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  align-self: auto;
  justify-content: center;
  transition: background-color var(--global-transition-short) ease-out-bounce;
  margin-right: 4px;
}

/* Fmpediabutton — pointer hover.
 * sets the background fill.
 * Source rule 2221.
 */
.fmpediabutton:hover {
  background-color: var(--layout-ui-cell-focus-default-background-hover);
}

/* Fmpediatile placeholder.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element. Its tile silhouette follows the shared card radius without changing the local gradient.
 * Local gradient stops can cover the parent background fill.
 * Source rule 2222.
 */
.fmpediatile-placeholder {
  width: 148px;
  height: 148px;
  margin: -1px;
  padding: 0;
  border-width: 2px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-strong);
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-card);
  --start-colour: var(--skin-component-fmpediatile-placeholder-start-colour);
  --end-colour: var(--skin-surface-strong);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-long);
  transition-delay: 0.1s;
  transition-timing-function: ease-in-out;
}

/* Focus info property 1 default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2223.
 */
.focus-info-property-1-default {
  border-width: 1px;
  border-color: var(--colours-base-red-soft);
  background-color: var(--skin-component-focus-info-property-1-default-background);
  padding-top: 8px;
  padding-right: 12px;
  padding-bottom: 8px;
  padding-left: 12px;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
}

/* Sicontainer horizontal align.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2224.
 */
.football-career-radio-group .sicontainer_horizontal_align,
.non-playing-role-radio-group .sicontainer_horizontal_align {
  margin: 0 0 var(--spacing-medium---16) 0;
  padding: var(--spacing-small---8) var(--spacing-medium---16) var(--spacing-small---8) var(--spacing-medium---16);
}

/* Unity radio button group child last.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2225.
 */
.football-career-radio-group .unity-radio-button-group__child-last,
.non-playing-role-radio-group .unity-radio-button-group__child-last {
  margin: 0 0 0 0;
  padding: var(--spacing-small---8) var(--spacing-medium---16) var(--spacing-small---8) var(--spacing-medium---16);
}

/* Unity radio button checkmark.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2226.
 */
.football-career-radio-group .unity-radio-button__checkmark,
.non-playing-role-radio-group .unity-radio-button__checkmark,
.manager-background-highest-level-radiogroup .unity-radio-button__checkmark,
.manager-coaching-badge-radiobutton .unity-radio-button__checkmark {
  width: auto;
  height: auto;
  margin: var(--spacing-extra-small---4);
  background-color: var(--skin-radio-marker-foreground);
  align-self: stretch;
  flex-grow: 1;
}

/* Virtualised list item.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2227.
 */
.forced-highlight-list .virtualised-list__item,
.virtualised-list__item--odd .alternating-list__item-child--odd {
  background-color: var(--skin-surface-page);
}

/* Form.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2228.
 */
.form {
  height: 26px;
  padding: 6px var(--spacing-small---8);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  align-items: flex-end;
  align-content: center;
  justify-content: space-around;
  border-radius: var(--skin-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Form bar range 0 to 59.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2229.
 */
.form_bar_range_0_to_59 {
  height: 35%;
  background-color: var(--data-average-rating-surface-0-6);
  flex-grow: 0;
  margin-right: 0px;
}

/* Form bar range 60 to 70.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2230.
 */
.form_bar_range_60_to_70 {
  height: 50%;
  background-color: var(--data-average-rating-surface-6-7);
  flex-grow: 0;
  margin-right: 0px;
}

/* Form bar range 70 to 80.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2231.
 */
.form_bar_range_70_to_80 {
  height: 75%;
  background-color: var(--data-average-rating-surface-7-8);
  flex-grow: 0;
  margin-right: 0px;
}

/* Form bar range 80 to 90.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2232.
 */
.form_bar_range_80_to_90 {
  height: 90%;
  background-color: var(--data-average-rating-surface-8-9);
  flex-grow: 0;
  margin-right: 0px;
}

/* Form bar range 90 to 100.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2233.
 */
.form_bar_range_90_to_100 {
  height: 100%;
  background-color: var(--data-average-rating-surface-9-10);
  flex-grow: 1;
  margin-right: 0px;
}

/* Form bar range none.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2234.
 */
.form_bar_range_none {
  height: 5%;
  background-color: var(--skin-surface-strong);
  flex-grow: 0;
  margin-right: 0px;
}

/* Global Shared
 * Shared native selectors, grouped rules, and cross-component helpers. A grouped rule stays whole even when its selectors span several products.
 */

/* Gauge step.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2379.
 */
.gauge-step {
  width: 2px;
  height: 12px;
  background-color: var(--skin-on-media-alpha-20);
  min-width: 2px;
  max-width: 2px;
  margin-right: 2px;
  align-self: center;
}

/* Gauge step projected.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2380.
 */
.gauge-step--projected {
  width: 2px;
  height: 16px;
  background-color: var(--colours-base-grey-soft);
  min-width: 2px;
  max-width: 2px;
  margin-right: 2px;
  align-self: center;
}

/* Gauge step selected.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2381.
 */
.gauge-step--selected {
  width: 3px;
  height: 16px;
  min-width: 3px;
  max-width: 3px;
  margin-right: 2px;
  align-self: center;
}

/* Gauge step large.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2382.
 */
.gauge-step-large {
  width: 2px;
  height: 16px;
  background-color: var(--skin-on-media-alpha-20);
  min-width: 2px;
  max-width: 2px;
  margin-right: 2px;
  align-self: center;
}

/* Gauge step large projected.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2383.
 */
.gauge-step-large--projected {
  width: 2px;
  height: 22px;
  background-color: var(--colours-base-grey-soft);
  min-width: 2px;
  max-width: 2px;
  margin-right: 2px;
  align-self: center;
}

/* Gauge step large selected.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2384.
 */
.gauge-step-large--selected {
  width: 3px;
  height: 22px;
  min-width: 3px;
  max-width: 3px;
  margin-right: 2px;
  align-self: center;
}

/* Gauge step middle.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2385.
 */
.gauge-step.gauge-step--middle,
.gauge-step-large.gauge-step--middle {
  background-color: var(--skin-on-media-alpha-48);
}

/* Stepper step first.
 * sets the outline/corner shape.
 * Shared rule for 12 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2386.
 */
.gauge-step.stepper-step--first,
.gauge-step.stepper-step--last,
.gauge-step--projected.stepper-step--first,
.gauge-step--projected.stepper-step--last,
.gauge-step--selected.stepper-step--first,
.gauge-step--selected.stepper-step--last,
.gauge-step-large.stepper-step--first,
.gauge-step-large.stepper-step--last,
.gauge-step-large--projected.stepper-step--first,
.gauge-step-large--projected.stepper-step--last,
.gauge-step-large--selected.stepper-step--first,
.gauge-step-large--selected.stepper-step--last {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

/* General performance icon better.
 * tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2387.
 */
.general-performance-icon-better,
.relationship-with-you-icon-colour-acquaintance {
  -unity-background-image-tint-color: var(--colours-base-lime-soft);
}

/* General performance icon much better.
 * tints background artwork.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2388.
 */
.general-performance-icon-much-better,
.fitness-test-result-image-colour-pass,
.squad-dynamics-pro-con-positive .unity-image,
.relationship-with-you-icon-colour-very-close {
  -unity-background-image-tint-color: var(--colours-base-green-soft);
}

/* General performance icon worse.
 * tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2389.
 */
.general-performance-icon-worse,
.relationship-with-you-icon-colour-adversary {
  -unity-background-image-tint-color: var(--colours-base-orange-soft);
}

/* Generic row even.
 * sets the background fill; controls size/placement.
 * Source rule 2390.
 */
.generic-row-even {
  background-color: var(--skin-table-row-alternate-background);
  flex-direction: var(--row-direction-normal);
}

/* Half width element.
 * controls size/placement.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2391.
 */
.generic-row-even > .half-width-element,
.generic-row-odd > .half-width-element,
.shuffle-draft-live-picks-two-columns-normal > .shuffle-draft-live-picks-list-item,
.shuffle-draft-live-picks-two-columns-short > .shuffle-draft-live-picks-list-item {
  width: 50%;
}

/* Global footers tile bottom bar template.
 * sets spacing around/inside the element.
 * Source rule 2392.
 */
.global-footers-tile-bottom-bar-template {
  padding-top: var(--global-padding-small);
  padding-bottom: var(--global-padding-small);
  padding-left: 12px;
  padding-right: 12px;
}

/* Spacing Layout
 * Reusable geometry, spacing, borders and colour helper classes.
 */

/* Global footers tile t template supplementry 2 string.
 * controls size/placement.
 * Source rule 2393.
 */
.global-footers-tile-t-template-supplementry-2-string {
  height: 26px;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
}

/* Global footers tile t template supplementry 35 icon and string.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2394.
 */
.global-footers-tile-t-template-supplementry-35-icon-and-string,
.global-footers-tile-t-template-supplementry-35-string {
  height: 45.5px;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
}

/* Global nav secondary texture entity viewer.
 * controls size/placement; changes opacity for the whole element and its contents.
 * Source rule 2395.
 */
.global-nav_secondary-texture-entity-viewer {
  position: absolute;
  opacity: 0.65;
  width: 142px;
  height: 30px;
  left: 0px;
  top: 0px;
}

/* Global padding extra large.
 * sets spacing around/inside the element.
 * Source rule 2396.
 */
.global-padding-extra-large {
  padding: var(--global-padding-extra-large);
}

/* Global search button.
 * controls size/placement.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2397.
 */
.global-search-button,
.data_display-chart-radial_gauge-positive-to-negative-direction-clockwise-size-large-position-1-8,
.global-search-card-close-button,
.nation-flag-32 #NationFlag,
.quick-actions-overflow-button,
.data_display-happiness-scale-data-points-expecation-circle {
  width: 32px;
  height: 32px;
}

/* Global search buttons panel.
 * controls size/placement.
 * Source rule 2398.
 */
.global-search-buttons-panel {
  position: absolute;
  bottom: 0;
  top: 0;
  justify-content: var(--flex-end-normal);
}

/* Icon switch.
 * controls size/placement.
 * Source rule 2399.
 */
.global-search-card-close-button #icon-switch {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

/* Buttons controls desktop default active true.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2400.
 */
.global-search-card-close-button .buttons-controls-pc-default--active-true {
  width: 32px;
  height: 32px;
  background-color: var(--skin-surface-page);
  border-radius: var(--numbers-border-radius-extra-small);
}

/* Bindableeditbox.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2401.
 */
.global-search-edit-box #unity-text-input.bindableeditbox {
  width: 120px;
  height: 48px;
  border-width: 1.8px;
  border-color: var(--communication-accessibility-focus);
  background-color: var(--midnight);
  color: var(--skin-text-primary);
  transition: border-color 0.15s ease-in;
  padding-top: var(--global-padding-new-ex);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-new-ex);
  padding-left: var(--global-padding-large);
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
}

/* Bindableeditbox — disabled.
 * sets the outline/corner shape.
 * Source rule 2402.
 */
.global-search-edit-box #unity-text-input:disabled.bindableeditbox {
  border-color: var(--skin-border-subtle);
}

/* Bindableeditbox — pointer hover.
 * sets the outline/corner shape.
 * Source rule 2403.
 */
.global-search-edit-box #unity-text-input:hover.bindableeditbox {
  border-width: 2px;
}

/* Bindableteditbox.
 * controls size/placement.
 * Source rule 2404.
 */
.global-search-edit-box > .bindableteditbox {
  width: 672px;
}

/* Global search edit box.
 * sets spacing around/inside the element.
 * Source rule 2405.
 */
.global-search-edit-box > TextField {
  margin: 0px;
  --unity-cursor-color: var(--skin-surface-raised);
}

/* Global search result button.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2406.
 */
.global-search-result-button {
  height: 34px;
  background-color: var(--skin-transparent);
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 0;
  padding-right: 12px;
  padding-bottom: 0;
  padding-left: 8px;
}

/* Sibutton.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets spacing
 * around/inside the element.
 * Source rule 2407.
 */
.global-search-see-all-button.sibutton {
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  border-top-width: 0;
  border-right-width: 0;
  border-left-width: 0;
  border-bottom-width: 1px;
  border-bottom-color: var(--skin-text-secondary);
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 2px;
  padding-bottom: 0;
}

/* Grabber.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2409.
 */
.grabber {
  width: 56px;
  height: 4px;
  background-color: var(--skin-on-media-alpha-25);
  border-radius: 2.5px;
}

/* Grades background colour happy.
 * sets the background fill.
 * Source rule 2410.
 */
.grades-background-colour-happy {
  background-color: var(--theme-color-yellow-soft-surface);
}

/* Grades background colour neutral.
 * sets the background fill.
 * Source rule 2411.
 */
