  position: absolute;
  width: 8px;
  height: 18px;
  left: -8px;
  bottom: 0;
  --start-colour: var(--skin-transparent);
  --end-colour: var(--skin-component-issuggestedsubborder-posessionproximitywarning-sigradient-end-colour);
}

/* Unity scroll view vertical scroller.
