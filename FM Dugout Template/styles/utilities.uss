/* Explicit utility classes load after component defaults so spacing/text helpers retain their purpose. */

/* Cascading menu folder.
 * controls size/placement.
 * Shared rule for 9 selectors. Editing a declaration here affects the whole group below.
 * Source rule 174.
 */
.content-base-element,
.flex-grow-class {
  flex-grow: 1;
}

/* Flex grow initial class.
 * controls size/placement.
 * Source rule 175.
 */
.flex-grow-initial-class {
  flex-grow: initial;
}

/* Justify content center class.
 * controls size/placement.
 * Source rule 177.
 */
.justify-content-center-class {
  justify-content: center;
}

/* Justify content space evenly.
 * controls size/placement.
 * Source rule 178.
 */
.justify-content-space-evenly {
  justify-content: space-evenly;
}

/* Pane drag anchor.
 * controls size/placement.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 193.
 */
.position-absolute-class {
  position: absolute;
}

/* Pane drag line.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 194.
 */
.flex-no-shrink-class {
  flex-shrink: 0;
}

/* Position picker.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets spacing
 * around/inside the element.
 * Source rule 202.
 */
.position-picker {
  background-color: var(--skin-surface-raised);
  color: var(--skin-text-primary);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
  border-top-left-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
  margin-left: 4px;
  margin-right: 4px;
  margin-top: 4px;
  margin-bottom: 4px;
}

/* Position disc.
 * sets the background artwork; sets spacing around/inside the element.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 265.
 */
.position-disc {
  margin-right: 16px;
  margin-left: 16px;
}

/* Position disc highlighted.
 * sets the background artwork; tints background artwork; sets spacing around/inside the element.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 266.
 */
.position-disc--highlighted {
  margin-right: 16px;
  margin-left: 16px;
  -unity-background-image-tint-color: var(--skin-component-position-disc-highlighted-image-tint);
}

/* Flex autosize vertical.
 * controls size/placement.
 * Source rule 288.
 */
.flex-autosize-vertical {
  flex-grow: initial;
  flex-shrink: 0;
}

/* Align self center class.
 * controls size/placement.
 * Source rule 289.
 */
.align-self-center-class {
  align-self: center;
}

/* Align self stretch class.
 * controls size/placement.
 * Source rule 290.
 */
.align-self-stretch-class {
  align-self: stretch;
}

/* Flex basis 0.
 * controls size/placement.
 * Source rule 308.
 */
.flex-basis-0 {
  flex-basis: 0;
}

/* Justify content flex start.
 * controls size/placement.
 * Source rule 325.
 */
.justify-content-flex-start {
  justify-content: flex-start;
}

/* Row direction normal full width no grow.
 * controls size/placement.
 * Source rule 623.
 */
.row-direction-normal-full-width-no-grow {
  width: 100%;
  overflow: hidden;
  flex-direction: var(--row-direction-normal);
  flex-grow: 0;
}

/* Row direction normal full width grow.
 * controls size/placement.
 * Source rule 624.
 */
.row-direction-normal-full-width-grow {
  width: 100%;
  overflow: hidden;
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
}

/* Width auto.
 * controls size/placement.
 * Source rule 697.
 */
.width-auto {
  width: auto;
}

/* Position disc.
 * sets the background artwork; sets spacing around/inside the element.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 711.
 */
.position-disc {
  margin-right: 16px;
  margin-left: 16px;
}

/* Heading no wrap.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 753.
 */
.content-no-wrap {
  white-space: nowrap;
}

/* Content wrap.
 * sets font/text presentation.
 * Source rule 754.
 */
.content-wrap {
  white-space: normal;
}

/* Content left align.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 755.
 */
.content-left-align {
  -unity-text-align: middle-left;
}

/* Content center align.
 * sets font/text presentation.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 756.
 */
