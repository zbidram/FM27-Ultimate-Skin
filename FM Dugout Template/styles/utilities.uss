  -unity-text-align: middle-center;
}

/* Content top align.
 * sets font/text presentation.
 * Source rule 757.
 */
.content-top-align {
  -unity-text-align: upper-left;
}

/* Content right align.
 * sets font/text presentation.
 * Source rule 758.
 */
.content-right-align {
  -unity-text-align: middle-right;
}

/* Content ellipsis.
 * sets font/text presentation.
 * Source rule 759.
 */
.content-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Content ellipsis wrap.
 * sets font/text presentation.
 * Source rule 760.
 */
.content-ellipsis-wrap {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: normal;
}

/* Global text focus women primary.
