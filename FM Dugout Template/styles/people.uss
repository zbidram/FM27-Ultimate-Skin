  border-color: var(--skin-surface-canvas-alpha-85);
  background-color: var(--skin-surface-page);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
}

/* Team report header team icon.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4050.
 */
.team-report-header-team-icon {
  width: 42.667px;
  height: 42.667px;
  padding: 0.014px 4.696px 0.044px 4.931px;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Team report segmented bar chart segment container.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4051.
 */
.team-report-segmented-bar-chart-segment-container {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  align-self: flex-start;
  margin-right: 2px;
  margin-top: 0;
  margin-bottom: 8px;
}

/* Team report segmented bar chart segment container element.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 4052.
 */
.team-report-segmented-bar-chart-segment-container-element {
  display: flex;
  height: 34px;
  padding: 8px 16px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-20);
  background-color: var(--skin-transparent);
  align-items: center;
  margin-right: 2px;
}

/* Team report team badge.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4053.
 */
.team-report-team-badge {
  width: 24px;
  height: 24px;
  padding: 0.008px 2.641px 0.024px 2.774px;
  justify-content: center;
  align-items: center;
  margin-right: 4px;
  flex-direction: var(--row-direction-normal);
}

/* Team report upcoming match kit.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4054.
 */
.team-report-upcoming-match-kit {
  width: 128px;
  height: 128px;
  min-width: 128px;
  min-height: 128px;
  margin-bottom: 8px;
}

/* Team talk block 8x4.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 4055.
 */
.team-talk-block-8x4 {
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  flex-direction: var(--row-direction-normal);
  align-items: flex-start;
  border-radius: var(--skin-radius-card);
}

/* Team talk block8x4 row.
 * sets spacing around/inside the element.
 * Source rule 4056.
 */
.team-talk-block8x4-row {
  padding-left: 8px;
  padding-right: 8px;
}

/* Team talk header.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4057.
 */
.team-talk-header {
  height: 80px;
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 16px;
  padding-bottom: 16px;
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4058.
 */
.team_card_quick_pick_dropdown .si-dropdown__selection-field {
  padding: var(--spacing-small---8) var(--global-padding-regular);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  max-height: 32px;
  align-items: center;
  border-top-right-radius: var(--numbers-border-radius-small);
  border-bottom-right-radius: var(--numbers-border-radius-small);
  border-top-left-radius: 0;
  border-bottom-left-radius: 0;
  flex-direction: var(--row-direction-normal);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-long);
  transition-timing-function: ease-in-out;
}

/* Text align upper left.
 * sets font/text presentation.
 * Source rule 4059.
 */
.text-align-upper-left {
  -unity-text-align: upper-left;
}

/* Text colour surface icon standard.
 * Changes text/foreground colour.
 * Source rule 4060.
 */
.text-colour-surface-icon-standard {
  color: var(--skin-text-primary);
}

/* Text wrap normal.
 * sets font/text presentation.
 * Source rule 4061.
 */
.text-wrap-normal {
  white-space: normal;
}

/* Club Player Staff
 * Native club player staff selectors, with adjacent shared rules in source order.
 */

/* Training improvement very good color.
