  justify-content: center;
  align-items: flex-start;
  border-radius: var(--border-radius-leading-small);
}

/* Tutorial floating continue button back part — pointer hover.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4230.
 */
.tutorial-floating-continue-button-back-part:hover,
.tutorial-floating-continue-button-back-part:active:enabled {
  background-color: var(--skin-surface-panel-alpha-14);
}

/* Tutorial floating continue button continue part.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4231.
 */
.tutorial-floating-continue-button-continue-part {
  height: 32px;
  margin: 0;
  padding: 0 16px;
  border-width: 1px 1px 1px 0.5px;
  border-color: var(--skin-surface-page-alpha-20);
  background-color: var(--skin-action-primary-background);
  color: var(--skin-action-primary-foreground);
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
  align-items: center;
  border-radius: var(--border-radius-trailing-small);
  flex-direction: var(--row-direction-normal);
}

/* The tutorial continue label is a child text element with its own native text colour.
 * Keep it paired with the Volt fill across default, hover and active states. */
.tutorial-floating-continue-button-continue-part .sitext,
.tutorial-floating-continue-button-continue-part .sitextmedium,
.tutorial-floating-continue-button-continue-part .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Tutorial floating continue button continue part disabled.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4232.
 */
.tutorial-floating-continue-button-continue-part-disabled {
  height: 32px;
  margin: 0;
  padding: 0 16px;
  border-width: 1px 1px 1px 0.5px;
  border-color: var(--skin-surface-page-alpha-20);
  background-color: var(--skin-surface-panel-alpha-14);
  align-items: center;
  border-radius: var(--border-radius-trailing-small);
  flex-direction: var(--row-direction-normal);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.training_tab-group .unity-radio-button-group__child-active .sitext,
.training_tab-group .unity-radio-button-group__child-active .sitextmedium,
.training_tab-group .unity-radio-button-group__child-active .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Club Player Staff
 * Native club player staff selectors, with adjacent shared rules in source order.
 */

/* Contract negotiation status fill colour negative.
 * sets the background fill.
 * Source rule 4424.
 */
.contract-negotiation-status-fill-colour-negative {
  background-color: var(--communication-feedback-negative);
}

/* Contract negotiation status fill colour neutral.
 * sets the background fill.
 * Source rule 4425.
 */
.contract-negotiation-status-fill-colour-neutral {
  background-color: var(--communication-feedback-information);
}

/* Contract negotiation status fill colour positive.
 * sets the background fill.
 * Source rule 4426.
 */
.contract-negotiation-status-fill-colour-positive {
  background-color: var(--communication-feedback-positive);
}

/* Contract negotiation status icon colour invalid.
 * tints background artwork.
 * Source rule 4427.
 */
.contract-negotiation-status-icon-colour-invalid {
  -unity-background-image-tint-color: var(--colours-base-orange-strong);
}

/* Contract negotiation status icon colour negative.
 * tints background artwork.
 * Source rule 4428.
 */
.contract-negotiation-status-icon-colour-negative {
  -unity-background-image-tint-color: var(--communication-feedback-negative);
}

/* Contract negotiation status icon colour neutral.
 * tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4429.
 */
.contract-negotiation-status-icon-colour-neutral,
.communication-feedback-information-icon-colour {
  -unity-background-image-tint-color: var(--communication-feedback-information);
}

/* Contract negotiation status icon colour positive.
 * tints background artwork.
 * Source rule 4430.
 */
.contract-negotiation-status-icon-colour-positive {
  -unity-background-image-tint-color: var(--communication-feedback-positive);
}

/* Contract negotiation status invalid.
