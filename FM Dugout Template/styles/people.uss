/* A form chart is not a striped table: its bars carry the result meaning. */
.player-form-chart .virtualised-list__item,
.player-form-chart .virtualised-list__item--odd,
.player-form-fixed-bars .virtualised-list__item,
.player-form-fixed-bars .virtualised-list__item--odd {
  background-color: var(--skin-transparent);
}

/* The same form-chart class also appears on full data tables (for example
 * supporter squad feedback). Restore row states there; only bar-list items
 * above remain transparent. Nested chart glyphs keep their result colours. */
.player-form-chart.streamed-table .streamed-table__row {
  background-color: var(--skin-table-row-background);
}
.player-form-chart.streamed-table .streamed-table__row.virtualised-list__item--odd {
  background-color: var(--skin-table-row-alternate-background);
}
.player-form-chart.streamed-table .streamed-table__row:hover {
  background-color: var(--skin-control-hover);
}
.player-form-chart.streamed-table .streamed-table__row.virtualised-list__item--selected {
  background-color: var(--skin-list-selection-background);
}
.player-form-chart.streamed-table .streamed-table__row.virtualised-list__item--selected:hover {
  background-color: var(--skin-list-selection-hover);
}

/* Keep FM's bound club colour, but push the native alpha fade outside the
 * visible header. Equal padding/negative margin retain its natural height at
 * each breakpoint; clipping belongs to the wrapper, not the player content. */
#ReportBody #PlayerReport #PlayerReportHeaderRemapper {
  overflow: hidden;
}
#ReportBody #PlayerReport #PlayerReportHeaderGradient.sigradient {
  padding-bottom: var(--skin-player-header-gradient-extension);
  margin-bottom: var(--skin-player-header-gradient-overlap);
  flex-shrink: 0;
}

/* The authored content body is a sibling of the portrait. Protect its text
 * over light club colours while retaining bound paint and full-colour artwork. */
#ReportBody #PlayerReport #PlayerReportHeaderRemapper > #PlayerReportHeaderGradient > #PlayerReportHeaderSetter > #report-player-full-header-max > #report-player-full-header-max-body {
  background-color: var(--skin-player-header-content-scrim);
}

/* ClubSiteHeader owns its content inside the gradient. Extend only the
 * paint box with padding, cancel its layout footprint, and clip at the club
 * wrapper so the bound club colour stays solid through the visible header. */
#ReportBody .ios-site-header {
  overflow: hidden;
}
#ReportBody .ios-site-header > .sigradient {
  padding-bottom: var(--skin-club-header-gradient-extension);
  margin-bottom: var(--skin-club-header-gradient-overlap);
  flex-shrink: 0;
}

/* The club-details template is separate from the summary-card template.
 * Darken only its backplate: retain bound club paint and full-colour kits,
 * crests, reputation and linked women's-team identity above it. */
#ReportBody .ios-site-header > .sigradient #NonPhoneLayout .site-active-property-1-club-property-2-header-components-property-3-club-details-property-4-max-res {
  background-color: var(--skin-club-details-scrim);
}

/* Competition sites use a sibling gradient beneath their header content.
 * Crop only that paint element, preserving the native competition colour and
 * the header's natural size. This excludes the score/fixture artwork below it.
 */
#ReportBody .comp-site-header > * > .sigradient {
  padding-bottom: var(--skin-header-gradient-extension);
  margin-bottom: var(--skin-header-gradient-overlap);
  flex-shrink: 0;
}

/* Career contract is an ordinary report card, rather than a floating dialog. */
#ReportBody #MyContractBlock #Border {
  border-width: var(--skin-card-border-width);
}
/* Wage percentage is supporting contract data, not a brand/status signal. */
#ReportBody #WagesData .colours-base-purple-soft {
  color: var(--skin-text-secondary);
}

/* Club overview's balance is neutral financial data. The native helper name
 * refers to the old purple brand, not a positive/negative account status. */
#ClubScreenOverviewBlock .colours-brand-foundation-horizon-soft {
  color: var(--skin-finance-value-foreground);
}

/* Staff/Career headers bind a horizontal club gradient. Extend paint only,
 * counterbalance its margin, and clip at the original content wrapper. */
#ReportBody #ReportHeader #ContractSetter > .entity-background-header {
  overflow: hidden;
}
#ReportBody #ReportHeader #ContractSetter > .entity-background-header > .sigradient {
  padding-right: var(--skin-staff-header-gradient-extension);
  margin-right: var(--skin-staff-header-gradient-overlap);
  flex-shrink: 0;
}

/* Medical low-risk badge: retain its positive green meaning with a paired
 * subdued surface, rather than green text on the unrelated mustard scale.
 * Separate roles allow alternative themes without changing global status data. */
.injury-risk-background-colour-low {
  background-color: var(--skin-medical-risk-low-background);
}
.injury-risk-text-colour-low {
  color: var(--skin-medical-risk-low-foreground);
}

/* Discipline history cards are ordinary inset report cards, not fields.
 * Use the shared raised surface and ordinary-card edge/radius roles.
 * Source rule 1711.
 */
.code-of-conduct-previous-offender {
  width: 144px;
  padding: 16px 8px;
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  background-color: var(--skin-surface-raised);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-card);
}


/* Dynamics summary sentences are prose, not table labels. The native row
 * leaves this text unwrapped, so the atmosphere explanation escapes its
 * half-width panel with the template body font. Keep natural panel sizing. */
#SquadYouthDynamics #Heading-frame #BottomFrame #text.sitext {
  white-space: normal;
  flex-shrink: 1;
}

/* Competition summary headers bind arbitrary competition colours in game code.
 * Darken only their content backplate, not artwork or whole-card opacity. Move
 * the existing gap from margin to padding so bounds and content spacing stay
 * the same while the scrim reaches the full header and its outer corners. */
#CompetitionsOverviewTool #Frame > .flex-no-shrink-class > .flex-no-shrink-class.flex-grow-class > #Content {
  background-color: var(--skin-competition-summary-scrim);
  margin: var(--global-gap-none);
  padding: var(--global-gap-regular);
  border-radius: var(--global-gap-none);
}
#CompetitionsOverviewTool #Frame.siblock-border {
  border-radius: var(--skin-radius-card);
  overflow: hidden;
}

/* A fixture's relative date and “vs” form one inline phrase. Native body-md
 * wrapping split the phrase from its opponent in the horizontal summary. */
.training-intensity-block-upcoming-fixtures #FixturesList .row-direction-normal > #text.sitext {
  white-space: nowrap;
  flex-shrink: 0;
}

/* Club team reports use the same horizontal fade family as staff headers.
 * Crop its paint extension without enlarging the content or replacing club ink. */
#ReportBody #TeamReportSite #ReportHeader .entity-background-header {
  overflow: hidden;
}
#ReportBody #TeamReportSite #ReportHeader .entity-background-header > .sigradient {
  padding-right: var(--skin-team-report-header-gradient-extension);
  margin-right: var(--skin-team-report-header-gradient-overlap);
  flex-shrink: 0;
}

/* Position/role selection is a regular outlined field, not a white media wash.
 * Leave the miniature pitch and player data colours intact. */
.player_position_dropdown:hover:enabled .si-dropdown__selection-field {
  background-color: var(--skin-control-hover);
}
.player_position_dropdown:active:enabled .si-dropdown__selection-field {
  background-color: var(--skin-control-pressed);
}

/* Club News uses the compact dynamic header instead of ClubSiteHeader.
 * Crop its verified outer paint chain only; story-image gradients below are
 * content and must keep their native treatment. Equal offsets preserve layout. */
#ReportBody #NewsTeamSite #SiteHeaderDynamicItem {
  overflow: hidden;
}
#ReportBody #NewsTeamSite #SiteHeaderDynamicItem #BindingExpect > * > .unity-image > .sigradient {
  padding-bottom: var(--skin-club-header-gradient-extension);
  margin-bottom: var(--skin-club-header-gradient-overlap);
  flex-shrink: 0;
}
/* Current NewsClubSiteHeader places the crest, club title and metadata inside
 * this direct content child. Share the overview's backplate without tinting
 * child artwork or the separate news-story images. */
#ReportBody #NewsTeamSite #SiteHeaderDynamicItem #BindingExpect > * > .unity-image > .sigradient > #Container.ios-site-header {
  background-color: var(--skin-club-details-scrim);
}
/* NewsClubBlock_Large gives this title a native 10% column and an ellipsis
 * utility. Let the larger Poppins metrics wrap at the existing size instead
 * of losing "Table" or widening the league's data columns. */
#ReportBody #NewsTeamSite #LeagueTable > .thematic-md.content-ellipsis {
  white-space: normal;
  height: auto;
  min-height: 0;
  max-height: none;
  text-overflow: clip;
}

/* Competition News uses the same native dynamic header chain as Club News.
 * Keep its competition-bound colour and crop the fade within that header only;
 * the story artwork below is outside SiteHeaderDynamicItem. */
#ReportBody #NewsCompetitionSite #SiteHeaderDynamicItem {
  overflow: hidden;
}
#ReportBody #NewsCompetitionSite #SiteHeaderDynamicItem #BindingExpect > * > .unity-image > .sigradient {
  padding-bottom: var(--skin-header-gradient-extension);
  margin-bottom: var(--skin-header-gradient-overlap);
  flex-shrink: 0;
}

/* This header binds the secondary club colour, which may be almost white.
 * Darken only its content backplate, preserving club identity beneath it and
 * avoiding opacity on the text, badge or football artwork. */
#ReportBody #ClubInfo .club-info-header > * {
  background-color: var(--skin-club-info-header-scrim);
}

/* Biography paragraphs must grow with the selected theme font, not paint over
 * the cover or introductory paragraph when the native measured height differs. */
#NonPlayerReportPersonal .siscrollview > .align-self-stretch-class.align-items-start > .align-self-stretch-class.align-items-start > .sitext {
  -unity-text-align: upper-left;
  height: auto;
  flex-shrink: 0;
}

/* Keep the biography cover's measured space before its natural-height prose. */
#NonPlayerReportPersonal .siscrollview > .align-self-stretch-class.align-items-start > .width-100-percent,
#NonPlayerReportPersonal .siscrollview > .align-self-stretch-class.align-items-start > .align-self-stretch-class.align-items-start {
  flex-shrink: 0;
}

#NonPlayerReportPersonal .siscrollview > .align-self-stretch-class.align-items-start > .width-100-percent {
  margin-bottom: var(--skin-biography-cover-gap);
}


/* Height units are plain choices on the appearance canvas, not filled pills.
 * Native selected rows already stay transparent; retain readable light labels
 * through selection/hover/press and leave the Volt radio dot as the marker. */
.manager-creation-height-unit .unity-radio-button:enabled .sitext,
.manager-creation-height-unit .unity-radio-button.unity-radio-button-group__child-active:active:enabled .sitext {
  color: var(--skin-choice-foreground);
}
.manager-creation-height-unit .unity-radio-button:hover:enabled {
  background-color: var(--skin-choice-hover);
  border-radius: var(--skin-choice-radius);
}
.manager-creation-height-unit .unity-radio-button:active:enabled {
  background-color: var(--skin-choice-pressed);
}
.manager-creation-height-unit .unity-radio-button:disabled .sitext {
  color: var(--skin-text-disabled);
}
.manager-creation-height-unit .unity-radio-button:focus:enabled .unity-radio-button__checkmark-background {
  border-color: var(--skin-focus-ring);
}


/* Appearance Sculpt/height sliders use the ordinary control accent, not an
 * information/status colour. Both native families retain their own dimensions. */
.manager-creation-screen-slider:hover:enabled .sislider--dragger,
.manager-creation-slider:hover:enabled .sislider--dragger {
  background-color: var(--skin-range-marker-hover);
}
.manager-creation-screen-slider:active:enabled .sislider--dragger,
.manager-creation-screen-slider .sislider--dragger:active:enabled,
.manager-creation-slider:active:enabled .sislider--dragger,
.manager-creation-slider .sislider--dragger:active:enabled {
  background-color: var(--skin-range-marker-pressed);
}
.manager-creation-screen-slider:disabled .sislider--dragger,
.manager-creation-slider:disabled .sislider--dragger {
  background-color: var(--skin-range-marker-disabled);
}
.manager-creation-screen-slider .sislider--dragger:focus:enabled,
.manager-creation-slider .sislider--dragger:focus:enabled {
  border-color: var(--skin-focus-ring);
}

/* None is a monochrome UI glyph, unlike adjacent head/clothing thumbnails.
 * Its named native host may create the restricted-icon leaf dynamically. */
.manager-preset-button:enabled #NoneIcon,
.manager-preset-button:enabled .manager-creation-option-none-container .ui-concepts-restricted_large {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
.virtualised-list__item--selected .manager-preset-button:enabled #NoneIcon,
.virtualised-list__item--selected .manager-preset-button:enabled .manager-creation-option-none-container .ui-concepts-restricted_large {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.manager-preset-button:disabled #NoneIcon,
.manager-preset-button:disabled .manager-creation-option-none-container .ui-concepts-restricted_large {
  -unity-background-image-tint-color: var(--skin-text-disabled);
}


/* Milestones All omits the category icon, leaving its label against the radio
 * mark. Keep the shared field gap without moving icon-bearing categories. */
.frames-milestone-list-size-size3 .unity-radio-button-group__child-first .sitext {
  margin-left: var(--skin-field-label-gap);
}


/* Player contract and comparison headers bind horizontal club fades. Clip the
 * extended paint at their existing wrappers, preserving native club binding and
 * content size. The contract padding includes its original 12px end inset. */
#ReportBody #contractcontainer > .align-self-stretch-class.flex-no-shrink-class {
  overflow: hidden;
  border-top-left-radius: var(--skin-radius-card);
  border-top-right-radius: var(--skin-radius-card);
}
#ReportBody #contractcontainer .loan-report-header.sigradient {
  padding-right: var(--skin-contract-header-gradient-padding);
  margin-right: var(--skin-contract-header-gradient-overlap);
  flex-shrink: 0;
}
#ReportBody .player-comparison-player-widget {
  overflow: hidden;
  border-radius: var(--skin-radius-card);
}
/* Hover previews are hosted inside their source row, outside ReportBody.
 * Clip their actual header tile while preserving the bound club colour. */
#PlayerReportHeaderTooltip {
  overflow: hidden;
}
/* These two headers set child width and gradient padding in game code.
 * Expanding layout would move trailing contract data outside the clip. Scale
 * paint about the shared centre, then counter-scale the single full-width
 * content row. Symmetric native insets keep the two centres aligned. */
#ReportBody .player-comparison-header #LeftSIGradient.sigradient,
#ReportBody .player-comparison-header #RightSIGradient.sigradient,
#ReportBody #PlayerInfoBlock .entity-background-header > .sigradient,
#PlayerReportHeaderTooltip .sigradient {
  scale: var(--skin-player-header-horizontal-paint-scale) 1;
  transform-origin: center;
}
#ReportBody .player-comparison-header #LeftSIGradient.sigradient > #left-full,
#ReportBody .player-comparison-header #RightSIGradient.sigradient > #right-full,
#ReportBody #PlayerInfoBlock .entity-background-header > .sigradient > .row-direction-normal,
#PlayerReportHeaderTooltip .sigradient > .row-direction-normal {
  scale: var(--skin-player-header-horizontal-content-scale) 1;
  transform-origin: center;
}

/* Compact overview assessment prose uses a body role, rather than the same
 * size as its tile title. Preserve the native report/status variants. */
#PlayerTrainingOverview #HeaderText .heading-xsmall-14px {
  font-size: var(--skin-player-training-summary-size);
}

/* Full club Facts has a native inline 192px label lane and matching header
 * spacer. A minimum preserves longer Poppins labels with the shared field gap,
 * without replacing inline widths, changing fonts or increasing row height.
 * The authored card/row chains keep this separate from compact Facts rows. */
#ReportBody #ElementBindingRoot > #Nonphone-FigmaBaseCardTemplate #Row > #Baseline_192 {
  min-width: var(--skin-facts-label-min-width);
  padding-right: var(--skin-field-label-gap);
}
#ReportBody #ElementBindingRoot > #Nonphone-FigmaBaseCardTemplate #Content > #Horizontal1 > #BaseSpace {
  min-width: var(--skin-facts-label-min-width);
}

/* Club Profile's compact stadium pairs already have a 16px label gutter.
 * Limit the native 140px value lanes together so flexible labels keep that
 * space. Retain row height, label ellipsis and all value/football bindings. */
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #TotalCapacityTextFrame,
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #SurfaceFrame,
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #ConditionTextFrame,
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #PitchDimensionsTextFrame,
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #YearBuiltTextFrame,
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #SeasonTicketHoldersTextFrame,
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #SeasonTicketPriceTextFrame,
#ReportBody #ClubProfileCard #MainTeamStadiumDetailsFrame > * > #MatchTicketPriceTextFrame {
  max-width: var(--skin-club-profile-value-max-width);
}

/* Advice titles explicitly request start alignment in both the static round-up
 * row and the shared advice-giver row. Preserve that authored intent against
 * the imported centering helper; descriptions and owner fields keep their layout. */
#ReportBody #Frame-RoundUpFrequency > #TextContainer > #data_display-cell-standard-regular-0-unpacked > .regular-horizontal-container-center-all.justify-content-start,
#ReportBody #binding_expect > .row-direction-normal.align-items-start.justify-content-center > #TextContainer > #data_display-cell-standard-regular-0-unpacked > #data_display-cell-standard-regular.regular-horizontal-container-center-all.justify-content-start {
  justify-content: flex-start;
}

/* Compact selected-manager results have a native inline 220px allocation.
 * Reclaim only authored inter-group and badge-label gaps, retaining badge
 * dimensions, typography, ellipsis protection and the neighbouring groups. */
#ReportBody #SelectedManagerBlock > #selected-manager-info > #info #percent-gauge-wins.margin-right-global-gap-regular,
#ReportBody #SelectedManagerBlock > #selected-manager-info > #info #percent-gauge-draws.margin-right-global-gap-regular {
  margin-right: var(--skin-manager-history-record-group-gap);
}
#ReportBody #SelectedManagerBlock > #selected-manager-info > #info #percent-gauge-wins > .data_display-graphs-elements-data_badge-colour-green-text_type-primary.margin-right-global-gap-small,
#ReportBody #SelectedManagerBlock > #selected-manager-info > #info #percent-gauge-draws > .data_display-graphs-elements-data_badge-colour-green-text_type-primary.margin-right-global-gap-small,
#ReportBody #SelectedManagerBlock > #selected-manager-info > #info #percent-gauge-losses > .data_display-graphs-elements-data_badge-colour-green-text_type-primary.margin-right-global-gap-small {
  margin-right: var(--skin-manager-history-record-label-gap);
}

/* The 4x2 history tile uses ManagerHistoryShortCell, whose name column has
 * inline width55%. Bound only that column so the dates sibling can grow;
 * preserve name/date ellipsis, portraits, separator and native row height. */
#ReportBody #tile-wide-4x2 #ManagersInfoStreamedList BindingExpect > .row-direction-normal.flex-grow-class > .row-direction-normal.padding-right-global-padding-regular.padding-left-global-padding-none.align-items-center {
  max-width: var(--skin-manager-history-tile-name-max-width);
}

/* Transfer Activity's imported potential summary root carries both classes.
 * Native AlwaysApplied orders the column variant after the row helper; the
 * loose utilities import reverses that tie. Restore only this authored root's
 * native column direction, leaving its host alignment and spacing unchanged. */
#player-list-frame #bottom-frame #potential-stacked.potential-stacked-variant.row-direction-normal {
  flex-direction: column;
}
