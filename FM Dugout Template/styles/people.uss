  height: 32px;
  padding: var(--spacing-padding-small---8) var(--spacing-padding-tiles);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-page-alpha-100);
  align-items: center;
  border-radius: var(--numbers-border-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Reports main site default.
 * controls size/placement.
 * Source rule 3409.
 */
.reports-main-site-default {
  width: 1366px;
  height: 826px;
}

/* Reports main tabs default type site competition platform FM desktop.
 * controls size/placement.
 * Source rule 3410.
 */
.reports-main-tabs-default-type-site-competition-platform-fm-pc {
  width: 1366px;
  height: 836px;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
}

/* Reputation highlight color.
 * Changes text/foreground colour.
 * Source rule 3411.
 */
.reputation-highlight-color {
  color: var(--skin-component-reputation-highlight-color-foreground);
}

/* Reputation highlight color.
 * Changes text/foreground colour.
 * Source rule 3411.
 */
.reputation-highlight-color-heading-text .data-display-data_display-table-heading-default-default .text-header-container .sitext {
  color: var(--skin-component-reputation-highlight-color-heading-text-data-display-data-display-table-heading-default-default-text-header-contain-foreground);
}

/* Reputation radial.
 * controls size/placement.
 * Source rule 3412.
 */
.reputation-radial {
  width: var(--height-height-16);
  height: var(--height-height-16);
}

/* Unity radio button checkmark background.
 * Shows these elements; sets the background fill; sets the outline/corner shape.
 * Source rule 3413.
 */
.ring-radio-button-group .unity-radio-button__checkmark-background {
  display: flex;
  border-color: var(--skin-text-secondary);
  background-color: var(--skin-transparent);
}

/* Role selector standard property 1 variant2.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3414.
 */
.role_selector-standard-property-1-variant2 {
  width: 295px;
  height: 452px;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  margin-right: var(--spacing-tiles);
}

/* Rotate minus ninety degrees.
 * sets the native component presentation.
 * Source rule 3415.
 */
.rotate-minus-ninety-degrees {
  rotate: -90deg;
}

/* Rotate ninety degrees.
 * sets the native component presentation.
 * Source rule 3416.
 */
.rotate-ninety-degrees {
  rotate: 90deg;
}

/* Row direction always inverted.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3417.
 */
.speakto-panel-right-aligned {
  flex-direction: var(--row-direction-always-reverse);
}

/* Row direction inverted.
 * controls size/placement.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3418.
 */
.row-direction-inverted .embedded-button,
.row-direction-inverted .cell-large,
.row-direction-inverted .cell-medium,
.row-direction-inverted .cell-small {
  flex-direction: var(--row-direction-reverse);
}

/* Row property 1 neutral.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3419.
 */
.row-property-1-neutral {
  background-color: var(--skin-on-media-alpha-04);
  padding-top: var(--global-padding-small);
  padding-right: var(--global-padding-regular);
  padding-bottom: var(--global-padding-small);
  padding-left: var(--global-padding-regular);
  align-items: center;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
}

/* Row property 1 warning blocker row.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 3420.
 */
.row-property-1-warning--blocker-row {
  background-color: var(--staff-medical-physio-16);
  padding-top: var(--global-padding-small);
  padding-right: var(--global-padding-regular);
  padding-bottom: var(--global-padding-small);
  padding-left: var(--global-padding-regular);
  align-items: center;
  align-self: stretch;
  margin-bottom: var(--global-gap-regular);
  flex-direction: var(--row-direction-normal);
}

/* Rules all ucl.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3421.
 */
.rules-all---ucl {
  width: 312px;
  height: 804px;
  padding: var(--spacing-medium---16) var(--spacing-tiles);
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  flex-direction: column;
  /* Constrain rule cards and explanatory copy to the sidebar's content width;
   * intrinsic text width otherwise overflows with the template's body face. */
  align-items: var(--align-stretch);
  border-radius: var(--skin-radius-card);
}

/* Rules min.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3422.
 */
.rules-min {
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  padding-top: var(--global-padding-extra-large);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-extra-large);
  padding-left: var(--global-padding-large);
  align-items: flex-start;
  border-radius: var(--layout-modules-block-radius);
  flex-direction: var(--row-direction-normal);
}

/* Save block buttons frame.
 * controls size/placement.
 * Source rule 3423.
 */
.save-block-buttons-frame {
  align-self: stretch;
  min-height: 32px;
}

/* Save browse top frame.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3424.
 */
.save-browse-top-frame {
  width: 100%;
  min-height: 32px;
  margin-bottom: 8px;
}

/* Club Player Staff
 * Native club player staff selectors, with adjacent shared rules in source order.
 */

/* Squad depth fmc block.
 * controls size/placement.
 * Source rule 3689.
 */
.squad-depth-fmc-block {
  flex-direction: column;
  align-self: stretch;
}

/* Squad depth fmc carousel widget.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 3690.
 */
.squad-depth-fmc-carousel-widget {
  padding: 4px 8px 4px 8px;
  border-radius: var(--skin-radius-small);
}

/* Squad depth fmc header.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3691.
 */
.squad-depth-fmc-header {
  height: 56px;
  padding: 8px;
  background-color: var(--colours-tactics-base-80);
  border-radius: var(--skin-radius-control) var(--skin-radius-control) 0px 0px;
  align-self: stretch;
  align-items: center;
}

/* Squad depth fmc lacking depth border colour.
 * sets the outline/corner shape.
 * Source rule 3692.
 */
.squad-depth-fmc-lacking-depth-border-colour {
  border-color: var(--colours-base-orange-strong);
}

/* Squad depth fmc lacking depth colour.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3693.
 */
.squad-depth-fmc-lacking-depth-colour {
  border-color: var(--colours-base-orange-strong);
  background-color: var(--colours-base-orange-deep);
}

/* Squad depth fmc large widget.
 * controls size/placement.
 * Source rule 3694.
 */
.squad-depth-fmc-large-widget {
  min-width: 200px;
  min-height: 100px;
}

/* Squad depth fmc min res widget.
 * controls size/placement.
 * Source rule 3695.
 */
.squad-depth-fmc-min-res-widget {
  min-width: 138px;
  min-height: 60px;
}

/* Squad depth fmc pitch container.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3696.
 */
.squad-depth-fmc-pitch-container {
  border-width: 2px;
  border-color: var(--colours-base-neutral-white);
  border-radius: var(--skin-radius-control);
  align-self: stretch;
  flex-direction: column;
}

/* Squad depth fmc player depth cell body.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3697.
 */
.squad-depth-fmc-player-depth-cell-body {
  padding: var(--spacing-padding-extra-small---4);
  border-width: 0px 1px 1px 1px;
  background-color: var(--skin-surface-canvas-alpha-90);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  border-radius: 0px 0px var(--skin-radius-control) var(--skin-radius-control);
}

/* Squad depth fmc player depth cell header.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3698.
 */
.squad-depth-fmc-player-depth-cell-header {
  padding: var(--spacing-padding-extra-small---4) var(--spacing-padding-small---8);
  border-width: 1px 1px 0px 1px;
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
  flex-direction: var(--row-direction-normal);
  border-radius: var(--skin-radius-control) var(--skin-radius-control) 0px 0px;
}

/* Squad depth fmc player depth cell text.
 * sets spacing around/inside the element.
 * Source rule 3699.
 */
.squad-depth-fmc-player-depth-cell-text {
  padding-top: 2px;
}

/* Squad depth fmc player name and ability row.
 * controls size/placement.
 * Source rule 3700.
 */
.squad-depth-fmc-player-name-and-ability-row {
  width: 100%;
  height: 20px;
}

/* Squad depth fmc poor depth border colour.
 * sets the outline/corner shape.
 * Source rule 3701.
 */
.squad-depth-fmc-poor-depth-border-colour {
  border-color: var(--colours-linear-scale-strong-1);
}

/* Squad depth fmc poor depth colour.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3702.
 */
.squad-depth-fmc-poor-depth-colour {
  border-color: var(--colours-linear-scale-strong-1);
  background-color: var(--colours-brand-tints-highlight-red-80);
}

/* Squad depth fmc standard widget.
 * controls size/placement.
 * Source rule 3703.
 */
.squad-depth-fmc-standard-widget {
  min-width: 200px;
  min-height: 60px;
}

/* Squad depth fmc transfer offer recap.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 3704.
 */
.squad-depth-fmc-transfer-offer-recap {
  padding: 4px 8px 4px 8px;
  border-radius: var(--skin-radius-shell);
}

/* States templates tile content.
 * sets spacing around/inside the element.
 * Source rule 3705.
 */
.squad-number-tile-2x1 .states-templates-tile-content {
  padding-right: 0;
}

/* Squad numbers disaplay table view.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3706.
 */
.squad-numbers-disaplay-table-view {
  width: auto;
  height: auto;
  padding: var(--spacing-tiles);
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--layout-modules-block-radius);
}

/* Squad overview block.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3707.
 */
.squad-overview-block {
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--midnight);
  border-radius: var(--layout-modules-block-radius);
}

/* Squad overview item.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3708.
 */
.squad-overview-item {
  border-color: var(--skin-border-subtle);
  background-color: var(--midnight);
  border-top-width: 0px;
  border-right-width: 1px;
  border-bottom-width: 0px;
  border-left-width: 0px;
}

/* SI dropdown selection field.
 * sets the outline/corner shape; defines how state changes animate.
 * Source rule 3709.
 */
.squad-overview-player-block .si-dropdown__selection-field {
  border-radius: var(--global-radius-none);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* SI dropdown selection field — pressed.
 * sets the background fill.
 * Source rule 3710.
 */
.squad-overview-player-block .si-dropdown__selection-field:active {
  background-color: var(--skin-border-subtle);
}

/* SI dropdown selection field — disabled.
 * sets the background fill.
 * Source rule 3711.
 */
.squad-overview-player-block .si-dropdown__selection-field:disabled {
  background-color: var(--skin-border-subtle);
}

/* Squad reg ineligble table row.
 * sets the background fill.
 * Source rule 3712.
 */
.squad-reg-ineligble-table-row {
  background-color: var(--interaction-input-switch-active-row-table-warning);
}

/* Squad registration notification bar warning.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3713.
 */
.squad-registration-notification-bar-warning {
  border-width: 1px;
  border-color: var(--interaction-input-switch-active-surface-warning);
  background-color: var(--colours-base-orange-base);
  padding-top: var(--global-padding-regular);
  padding-right: var(--global-padding-regular);
  padding-bottom: var(--global-padding-regular);
  padding-left: var(--global-padding-regular);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--global-radius-small);
}

/* Stadium sponsor.
 * sets the background fill.
 * Source rule 3714.
 */
.stadium-sponsor {
  background-color: var(--colours-base-yellow-strong);
}

/* Staff additionals property 1 manager.
 * controls size/placement.
 * Source rule 3715.
 */
.staff-additionals-property-1-manager {
  width: 22%;
  height: 100%;
  align-items: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Staff feedback row type base.
 * sets spacing around/inside the element.
 * Source rule 3716.
 */
.staff-feedback-row-type-base {
  padding-left: 8px;
  padding-right: 8px;
  padding-bottom: 6px;
  padding-top: 6px;
}

/* Staff role stack property 1 manager.
 * controls size/placement.
 * Source rule 3717.
 */
.staff-role-stack-property-1-manager {
  width: 26%;
  height: 100%;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
}

/* Club Player Staff
 * Native club player staff selectors, with adjacent shared rules in source order.
 */

/* Club icon small.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4023.
 */
.team-cell-small-reversed-override .club-icon-small,
.nation-cell-short-reversed-override .margin-right-global-gap-small {
  margin-right: var(--global-gap-none);
  margin-left: var(--global-gap-close);
}

/* Team comparison rating above average.
 * sets the background fill.
 * Source rule 4024.
 */
.team-comparison-rating-above-average {
  background-color: var(--colours-linear-scale-strong-8-alpha-16);
}

/* Team comparison rating average text.
 * Changes text/foreground colour.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4025.
 */
.team-comparison-rating-average-text,
.transfer-window-restricted,
.data_knowledge_level_3_decent {
  color: var(--theme-color-yellow-soft-soft);
}

/* Team comparison rating below average thumb colour.
 * tints background artwork.
 * Source rule 4026.
 */
.team-comparison-rating-below-average-thumb-colour {
  -unity-background-image-tint-color: var(--colours-linear-scale-strong-3);
}

/* Team field row odd.
 * sets the background fill; controls size/placement.
 * Source rule 4027.
 */
.team-field-row-odd {
  background-color: var(--skin-surface-raised);
  align-self: stretch;
}

/* Team form defeat.
 * sets the background fill; controls size/placement.
 * Source rule 4028.
 */
.team-form-defeat {
  height: 60%;
  background-color: var(--communication-feedback-negative);
}

/* Team form draw.
 * sets the background fill; controls size/placement.
 * Source rule 4029.
 */
.team-form-draw {
  height: 30%;
  background-color: var(--skin-on-media-alpha-35);
}

/* Team form panel.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 4030.
 */
.team-form-panel {
  background-color: var(--skin-surface-panel);
  border-radius: var(--skin-radius-small);
}

/* Team form win.
 * sets the background fill; controls size/placement.
 * Source rule 4031.
 */
.team-form-win {
  height: 60%;
  background-color: var(--communication-feedback-positive);
}

/* Team instruction cell pending.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 4032.
 */
.team-instruction-cell--pending {
  height: auto;
  border-width: var(--global-border-width-thin);
  border-color: var(--colours-tactics-tweak-pending);
  background-color: var(--colours-tactics-tweak-pending-background);
  border-top-left-radius: var(--global-radius-small);
  border-top-right-radius: var(--global-radius-small);
  border-bottom-right-radius: var(--global-radius-small);
  border-bottom-left-radius: var(--global-radius-small);
}

/* Team instruction cell tweaked.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 4033.
 */
.team-instruction-cell--tweaked {
  height: auto;
  border-width: var(--global-border-width-thin);
  border-color: var(--colours-base-cyan-50);
  background-color: var(--skin-component-team-instruction-cell-tweaked-background);
  border-top-left-radius: var(--global-radius-small);
  border-top-right-radius: var(--global-radius-small);
  border-bottom-right-radius: var(--global-radius-small);
  border-bottom-left-radius: var(--global-radius-small);
}

/* Text second.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4034.
 */
.team-instruction-cell--tweaked #text-second,
.team-instruction-cell--pending #text-second {
  padding-right: var(--global-padding-small);
}

/* Team instruction cell tweak icon.
 * Hides these elements; controls size/placement.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 4035.
 */
.team-instruction-cell__tweak-icon,
.team-instruction-tile__tweak-icon,
.team-instruction-tile__tweak-icon-pending {
  display: none;
  width: 16px;
  height: 16px;
}

/* Team instruction cell tweak icon holder.
 * controls size/placement.
 * Source rule 4036.
 */
.team-instruction-cell__tweak-icon-holder {
  position: absolute;
  top: 0;
  bottom: 0;
  right: var(--global-padding-regular);
  align-items: center;
  justify-content: center;
}

/* Team instruction option list tweak footer.
 * Hides these elements; controls size/placement.
 * Source rule 4037.
 */
.team-instruction-option-list__tweak-footer {
  display: none;
  flex-direction: var(--row-direction-normal);
  align-items: flex-start;
}

/* Team instruction option tweak badge.
 * Hides these elements; controls size/placement.
 * Source rule 4038.
 */
.team-instruction-option__tweak-badge {
  display: none;
  flex-direction: var(--row-direction-normal);
  align-items: center;
}

/* Team instruction option tweak tooltip.
 * sets font/text presentation; controls size/placement.
 * Source rule 4039.
 */
.team-instruction-option__tweak-tooltip {
  white-space: normal;
  max-width: 250px;
}

/* The phase-relevant tactic tile keeps its accent outline as a meaningful
 * state, while ordinary card tiles rely on their surface layers.
 * Source rule 4040.
 */
.team-instruction-tile--phase-relevant .surfaces-card-tile-border {
  border-width: var(--global-border-width-tile-card);
  border-color: var(--skin-brand-accent);
  background-color: var(--colours-tactics-phase-highlight-background);
}

/* Team instruction tile list item.
 * controls size/placement.
 * Source rule 4041.
 */
.team-instruction-tile-list-item {
  width: 148px;
  height: 148px;
  flex-shrink: 0;
}

/* Team picker.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 4042.
 */
.team-picker {
  width: 24px;
  height: 24px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-canvas-alpha-56);
  border-top-left-radius: var(--skin-radius-compact);
  border-top-right-radius: var(--skin-radius-compact);
  border-bottom-right-radius: var(--skin-radius-compact);
  border-bottom-left-radius: var(--skin-radius-compact);
  align-items: center;
  align-self: center;
  justify-content: center;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
}

/* Team picker foreground.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 4043.
 */
.team-picker-foreground {
  width: 24px;
  height: 24px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-text-disabled);
  border-top-left-radius: var(--skin-radius-compact);
  border-top-right-radius: var(--skin-radius-compact);
  border-bottom-right-radius: var(--skin-radius-compact);
  border-bottom-left-radius: var(--skin-radius-compact);
  align-items: center;
  align-self: center;
  justify-content: center;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
}

/* Team report assist summary record.
 * sets spacing around/inside the element.
 * Source rule 4044.
 */
.team-report-assist-summary-record {
  margin: 0 0 12px 0;
}

/* Team report assist type record.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4045.
 */
.team-report-assist-type-record {
  margin: 0 0 12px 0;
  align-items: flex-end;
}

/* Team report formation circle.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 4046.
 */
.team-report-formation-circle {
  width: 6px;
  height: 6px;
  background-color: var(--colours-base-neutral-white);
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
  border-bottom-left-radius: 3px;
  align-self: center;
  align-content: center;
}

/* Team report goal analysis positions item goals conceding.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4047.
 */
.team-report-goal-analysis-positions-item-goals-conceding {
  width: var(--spacing-padding-extra-large---64);
  height: 48px;
  padding: var(--numbers-border-radius-null) var(--spacing-padding-new-ex);
  border-width: 2px;
  border-color: var(--skin-text-primary);
  background-color: var(--colours-base-red-base);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
}

/* Team report goal analysis positions item goals scoring.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4048.
 */
.team-report-goal-analysis-positions-item-goals-scoring {
  width: var(--spacing-padding-extra-large---64);
  height: 48px;
  padding: var(--numbers-border-radius-null) var(--spacing-padding-new-ex);
  border-width: 2px;
  border-color: var(--skin-text-primary);
  background-color: var(--colours-base-teal-base);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
}

/* Team report goal analysis positions item no goals.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
