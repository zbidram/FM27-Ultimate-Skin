 * Source rule 4431.
 */
.contract-negotiation-status-invalid,
.transfer-negotiation-status-colour-invalid {
  background-color: var(--contract-negotiation-invalid-background);
}

/* Contract negotiation status rejected.
 * sets the background fill.
