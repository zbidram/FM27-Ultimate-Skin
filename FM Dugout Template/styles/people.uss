/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Club facilities rating text colour 0.
 * Changes text/foreground colour.
 * Source rule 1658.
 */
.club-facilities-rating-text-colour-0 {
  color: var(--communication-coaching-adjective-ratings-reasonable-text);
}

/* Club facilities rating text colour 1.
 * Changes text/foreground colour.
 * Source rule 1659.
 */
.club-facilities-rating-text-colour-1 {
  color: var(--communication-coaching-adjective-ratings-competent-text);
}

/* Club headers site national team header max res.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1660.
 */
.club-headers-site-national-team-header-max-res {
  width: 100%;
  height: 166px;
  justify-content: center;
  align-items: center;
  padding-right: 24px;
  padding-left: 24px;
  padding-top: 12px;
}

/* Club highlighted personnel card status background 1.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1661.
 */
.club-highlighted-personnel-card-status-background-1 {
  background-color: var(--communication-coaching-adjective-ratings-competent-surface);
}

/* Club highlighted personnel card status background 2.
 * sets the background fill.
 * Source rule 1662.
 */
.club-highlighted-personnel-card-status-background-2 {
  background-color: var(--communication-coaching-adjective-ratings-good-surface);
}

/* Club highlighted personnel card status background 3.
 * sets the background fill.
 * Source rule 1663.
 */
.club-highlighted-personnel-card-status-background-3 {
  background-color: var(--communication-coaching-adjective-ratings-elite-surface);
}

/* Club highlighted personnel card status text 1.
 * Changes text/foreground colour.
 * Source rule 1664.
 */
.club-highlighted-personnel-card-status-text-1 {
  color: var(--favoured-personnel-at-club-status-favoured);
}

/* Club highlighted personnel card status text 2.
 * Changes text/foreground colour.
 * Source rule 1665.
 */
.club-highlighted-personnel-card-status-text-2 {
  color: var(--favoured-personnel-at-club-status-icon);
}

/* Club highlighted personnel card status text 3.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1666.
 */
.club-highlighted-personnel-card-status-text-3,
.training-improvement-superb-color {
  color: var(--favoured-personnel-at-club-status-legend);
}

/* Club icon 24px.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1667.
 */
.club-icon-24px {
  width: 24px;
  height: 24px;
  justify-content: center;
  align-items: center;
  margin-right: var(--global-gap-close);
}

/* Club icon small.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1668.
 */
.club-icon-small {
  width: 16px;
  height: 16px;
  justify-content: center;
  align-items: center;
  margin-right: var(--global-gap-close);
}

/* Club icon small new.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1669.
 */
.club-icon-small-new {
  width: 14px;
  height: 14px;
  justify-content: center;
  align-items: center;
  margin-right: var(--global-gap-close);
}

/* Club icon xlarge 48px.
 * controls size/placement.
 * Source rule 1670.
 */
.club-icon-xlarge-48px {
  width: 48px;
  height: 48px;
  justify-content: center;
  align-items: center;
}

/* Club info header.
 * sets the outline/corner shape.
 * Source rule 1671.
 */
.club-info-header {
  border-top-left-radius: var(--global-radius-large);
  border-top-right-radius: var(--global-radius-large);
}

/* Club nation team info banner.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1672.
 */
.club-nation-team-info-banner {
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  flex-grow: 0;
  align-self: stretch;
  border-radius: var(--global-radius-regular);
  margin-bottom: var(--global-gap-extra-large);
}

/* Club nation team info banner background.
 * sets the background fill.
 * Source rule 1673.
 */
.club-nation-team-info-banner-background {
  background-color: var(--club-nation-info-badge-background);
}

/* Club nation team info next fixture comp container.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1674.
 */
.club-nation-team-info-next-fixture-comp-container {
  height: var(--interaction-global-height-xs);
  background-color: var(--skin-surface-panel);
  align-self: stretch;
  padding-top: var(--global-padding-extra-small);
  padding-bottom: var(--global-padding-extra-small);
  border-radius: var(--global-radius-small);
}

/* Club nation team info next fixture container.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1675.
 */
.club-nation-team-info-next-fixture-container {
  padding: var(--global-padding-regular);
  background-color: var(--skin-surface-panel);
  align-self: stretch;
  border-radius: var(--global-radius-small);
}

/* Club radio button bg.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1676.
 */
.club-radio-button-bg {
  width: 100%;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  flex-direction: column;
  align-items: var(--flex-start-normal);
  border-radius: var(--numbers-border-radius-small);
}

/* Club screen board vision.
 * controls size/placement.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1677.
 */
.club-screen-board-vision,
.club-screen-staff,
.manager-creation-manager-rt {
  width: 50%;
  height: 100%;
}

/* Club selection button.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1678.
 */
.club-selection-button {
  background-color: var(--skin-surface-page);
  border-radius: var(--global-radius-small);
  overflow: hidden;
  flex-grow: 1;
}

/* Club selection team name.
 * sets font/text presentation; controls size/placement.
 * Source rule 1679.
 */
.club-selection-team-name {
  width: 216px;
  height: 36px;
  min-width: 216px;
  min-height: 36px;
  max-width: 216px;
  max-height: 36px;
  white-space: normal;
}

/* Club selector preset button — pointer hover.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1680.
 */
.club-selector-preset-button:hover,
.virtualised-list__item--selected:hover > .club-selector-preset-button,
.virtualised-list__item--selected .club-selector-preset-button {
  background-color: var(--skin-control-hover);
}

/* Club vision background colour default.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1681.
 */
.club-vision-background-colour-default,
.fitness-test-result-background-colour-tbc {
  background-color: var(--skin-on-media-alpha-16);
}

/* Club vision background colour negative.
 * sets the background fill.
 * Source rule 1682.
 */
.club-vision-background-colour-negative {
  background-color: var(--skin-component-club-vision-background-colour-negative-background);
}

/* Club vision background colour negative.
 * sets the background fill.
 * Source rule 1682.
 */
.fitness-test-result-background-colour-fail {
  background-color: var(--skin-component-fitness-test-result-background-colour-fail-background);
}

/* Club vision background colour neutral.
 * sets the background fill.
 * Source rule 1683.
 */
.club-vision-background-colour-neutral {
  background-color: var(--skin-component-club-vision-background-colour-neutral-background);
}

/* Club vision background colour positive.
 * sets the background fill.
 * Source rule 1684.
 */
.club-vision-background-colour-positive {
  background-color: var(--skin-component-club-vision-background-colour-positive-background);
}

/* Club vision background colour positive.
 * sets the background fill.
 * Source rule 1684.
 */
.fitness-test-result-background-colour-pass {
  background-color: var(--skin-component-fitness-test-result-background-colour-pass-background);
}

/* Club vision background colour progress.
 * sets the background fill.
 * Source rule 1685.
 */
.club-vision-background-colour-progress {
  background-color: var(--skin-component-club-vision-background-colour-progress-background);
}

/* Club vision background colour slightly negative.
 * sets the background fill.
 * Source rule 1686.
 */
.club-vision-background-colour-slightly-negative {
  background-color: var(--skin-component-club-vision-background-colour-slightly-negative-background);
}

/* Club vision background colour slightly positive.
 * sets the background fill.
 * Source rule 1687.
 */
.club-vision-background-colour-slightly-positive {
  background-color: var(--skin-component-club-vision-background-colour-slightly-positive-background);
}

/* Club vision card states board vision.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1688.
 */
.club-vision-card-states-board-vision {
  padding: 16px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--layout-modules-block-radius);
}

/* Club vision continue.
 * controls size/placement.
 * Source rule 1689.
 */
.club-vision-continue {
  position: absolute;
  width: 208px;
  height: 44px;
  top: 0;
  left: 0;
  overflow: visible;
}

/* Club vision continue gradient.
 * controls size/placement.
 * Source rule 1690.
 */
.club-vision-continue-gradient {
  width: 208px;
  height: 44px;
  overflow: visible;
  flex-shrink: 0;
}

/* Club vision objective progress container.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1691.
 */
.club-vision-objective-progress-container {
  height: 28px;
  align-self: center;
  flex-direction: var(--row-direction-normal);
  border-top-left-radius: 15px;
  border-top-right-radius: 15px;
  border-bottom-right-radius: 15px;
  border-bottom-left-radius: 15px;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  border-left-color: var(--skin-on-media-alpha-08);
  border-right-color: var(--skin-on-media-alpha-08);
  border-top-color: var(--skin-on-media-alpha-08);
  border-bottom-color: var(--skin-on-media-alpha-08);
  padding-right: 8px;
  padding-left: 8px;
}

/* Club vision tab buttons.
 * sets spacing around/inside the element.
 * Source rule 1692.
 */
.club-vision-tab-buttons {
  padding: 0;
  margin-top: var(--global-gap-seperation);
  margin-bottom: var(--global-gap-seperation);
  margin-left: var(--none);
  margin-right: var(--none);
}

/* Club vision text colour neutral.
 * Changes text/foreground colour.
 * Shared rule for 7 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1693.
 */
.club-vision-text-colour-neutral,
.fitness-test-result-text-colour-partial-pass,
.player-interest-yellow,
.squad-dynamics-pro-con-neutral-text,
.transfer-overview-restrict-text,
.relationship-with-you-text-colour-distant,
.happiness-happy-text-colour {
  color: var(--colours-base-yellow-soft);
}

/* Club vision text colour slightly negative.
 * Changes text/foreground colour.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1694.
 */
.club-vision-text-colour-slightly-negative,
.player-interest-orange,
.relationship-with-you-text-colour-adversary,
.happiness-unhappy-text-colour,
.colours-base-orange-soft {
  color: var(--colours-base-orange-soft);
}

/* Club vision text colour slightly positive.
 * Changes text/foreground colour.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1695.
 */
.club-vision-text-colour-slightly-positive,
.player-interest-lime,
.relationship-with-you-text-colour-acquaintance,
.happiness-very-happy-text-colour {
  color: var(--colours-base-lime-soft);
}

/* Clubcolours border.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 1696.
 */
.clubcolours-border {
  position: absolute;
  width: 100%;
  height: 100%;
  border-color: var(--skin-on-media-alpha-35);
  top: 0;
  left: 0;
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 0;
  border-radius: 0 var(--skin-radius-micro) var(--skin-radius-micro) 0;
}

/* Club Player Staff
 * Native club player staff selectors, with adjacent shared rules in source order.
 */

/* Injury risk background colour high.
 * sets the background fill.
 * Source rule 2498.
 */
.injury-risk-background-colour-high {
  background-color: var(--skin-medical-risk-high-background);
}

/* Injury risk background colour increased.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2499.
 */
.injury-risk-background-colour-increased,
.team-comparison-rating-below-average {
  background-color: var(--colours-linear-scale-strong-3-alpha-16);
}

/* Injury risk background colour none.
 * sets the background fill.
 * Source rule 2500.
 */
.injury-risk-background-colour-none {
  background-color: var(--skin-data-injury-risk-background-colour-none-background);
}

/* Injury risk background colour normal.
 * sets the background fill.
 * Source rule 2501.
 */
.injury-risk-background-colour-normal {
  background-color: var(--colours-linear-scale-strong-6-alpha-16);
}

/* Progress bar value.
 * sets the background fill.
 * Shared rule for 7 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2502.
 */
.injury-risk-none-progress > .progress-bar-value,
.injury-risk-normal-progress > .progress-bar-value,
.injury-susceptibility-average-progress > .progress-bar-value,
.pagination-page-marker-ellipse-selected,
.player_position_dropdown .micro-pitch-tactics .not-gk,
.training-load-medium-progress,
.nav-on-dark .calendar-widget-time-container {
  background-color: var(--colours-base-neutral-white);
}

/* Injury risk siradialgauge colour high.
 * supplies local values read by the component styling.
 * Source rule 2503.
 */
.injury-risk-siradialgauge-colour-high {
  --current-colour: var(--colours-linear-scale-strong-2);
}

/* Injury risk siradialgauge colour increased.
 * supplies local values read by the component styling.
 * Source rule 2504.
 */
.injury-risk-siradialgauge-colour-increased {
  --current-colour: var(--colours-linear-scale-strong-3);
}

/* Injury risk siradialgauge colour low.
 * supplies local values read by the component styling.
 * Source rule 2505.
 */
.injury-risk-siradialgauge-colour-low {
  --current-colour: var(--colours-linear-scale-strong-5);
}

/* Injury risk siradialgauge colour none.
 * supplies local values read by the component styling.
 * Source rule 2506.
 */
.injury-risk-siradialgauge-colour-none {
  --current-colour: var(--skin-data-injury-risk-siradialgauge-colour-none-current-colour);
}

/* Injury risk siradialgauge colour normal.
 * supplies local values read by the component styling.
 * Source rule 2507.
 */
.injury-risk-siradialgauge-colour-normal {
  --current-colour: var(--colours-linear-scale-strong-6);
}

/* Injury risk siradialgauge colour very high.
 * supplies local values read by the component styling.
 * Source rule 2508.
 */
.injury-risk-siradialgauge-colour-very-high {
  --current-colour: var(--colours-linear-scale-strong-1);
}

/* Injury risk text colour none.
 * Changes text/foreground colour.
 * Source rule 2509.
 */
.injury-risk-text-colour-none {
  color: var(--skin-data-injury-risk-text-colour-none-foreground);
}

/* Injury severity background image colour major.
 * tints background artwork.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2510.
 */
.injury-severity-background-image-colour-major,
.injury-severity-image-colour-major,
.training-review-extra-curricular {
  -unity-background-image-tint-color: var(--colours-base-red-strong);
}

/* Injury severity background image colour minor.
 * tints background artwork.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2511.
 */
.injury-severity-background-image-colour-minor,
.injury-severity-image-colour-minor,
.injury-severity-background-image-colour-moderate,
.injury-severity-image-colour-moderate,
.training-review-physical-and-recovery {
  -unity-background-image-tint-color: var(--colours-base-yellow-strong);
}

/* Injury severity background image colour slight.
 * tints background artwork.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2512.
 */
.injury-severity-background-image-colour-slight,
.injury-severity-image-colour-slight,
.speech-tail-reply-colour,
.player_position-md-tint {
  -unity-background-image-tint-color: var(--colours-base-blue-strong);
}

/* Injury severity image colour recurring.
 * tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2513.
 */
.injury-severity-image-colour-recurring,
.training-review-tactical-understanding {
  -unity-background-image-tint-color: var(--colours-base-purple-strong);
}

/* Injury severity stepper.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2514.
 */
.injury-severity-stepper,
.si-input-stepper__step-display {
  width: 68px;
  height: 4px;
}

/* Injury severity stepper major colour.
 * sets the background fill.
 * Source rule 2515.
 */
.injury-severity-stepper-major-colour {
  background-color: var(--status-linear-4-values-strong-1);
}

/* Injury severity stepper minor colour.
 * sets the background fill.
 * Source rule 2516.
 */
.injury-severity-stepper-minor-colour {
  background-color: var(--status-linear-4-values-strong-3);
}

/* Injury severity stepper moderate colour.
 * sets the background fill.
 * Source rule 2517.
 */
.injury-severity-stepper-moderate-colour {
  background-color: var(--status-linear-4-values-strong-2);
}

/* Injury severity stepper slight colour.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
