}

/* Manager preset button.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2809.
 */
.manager-preset-button,
.ige-kit-style-selected-button,
.club-selector-preset-button {
  margin: 0;
  background-color: var(--skin-transparent);
  align-self: stretch;
  align-items: center;
  border-radius: var(--numbers-border-radius-small);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Unity toggle checkmark — checked/selected.
 * sets the background artwork; sets the outline/corner shape; controls size/placement.
 * Source rule 2810.
 */
.manager-preset-button-active-toggle .unity-toggle__input:checked > .unity-toggle__checkmark {
  width: 9px;
  height: 8px;
  border-width: 0;
  border-color: var(--skin-text-secondary);
  background-image: none;
  border-radius: var(--skin-radius-small);
}

/* Unity toggle checkmark — pointer hover, checked/selected.
 * sets the background artwork.
 * Source rule 2811.
 */
.manager-preset-button-active-toggle:checked:hover .unity-toggle__input > .unity-toggle__checkmark {
  background-image: none;
}

/* Manager preset button bg.
 * sets the background fill; sets the outline/corner shape; controls size/placement; defines how state
 * changes animate.
 * Source rule 2812.
 */
.manager-preset-button-bg {
  width: 188px;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--numbers-border-radius-small);
  transition: background-color 0.15s ease;
}

/* Appearance picture choices share ordinary neutral pointer feedback until
 * their virtualised item is selected. Keep the portrait/model artwork intact;
 * only the small control mark consumes the selected foreground. */
.manager-preset-button:hover:enabled {
  background-color: var(--skin-radio-hover-background);
  color: var(--skin-radio-interaction-foreground);
}
.manager-preset-button:active:enabled {
  background-color: var(--skin-radio-pressed-background);
  color: var(--skin-radio-interaction-foreground);
}
.virtualised-list__item--selected .manager-preset-button {
  --skin-radio-hover-background: var(--skin-selection-hover);
  --skin-radio-pressed-background: var(--skin-selection-pressed);
  --skin-radio-interaction-foreground: var(--skin-selection-foreground);
}
.manager-preset-button:hover:enabled .sitext,
.manager-preset-button:hover:enabled .sitextmedium,
.manager-preset-button:hover:enabled .sitextsmall,
.manager-preset-button:active:enabled .sitext,
.manager-preset-button:active:enabled .sitextmedium,
.manager-preset-button:active:enabled .sitextsmall {
  color: var(--skin-radio-interaction-foreground);
}
.virtualised-list__item--selected .manager-preset-button-active-toggle .unity-toggle__input {
  border-color: var(--skin-selection-foreground);
}
.virtualised-list__item--selected .manager-preset-button-active-toggle .unity-toggle__input > .unity-toggle__checkmark {
  background-color: var(--skin-selection-foreground);
  border-color: var(--skin-selection-foreground);
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* Manager preset button bg border.
 * sets the background fill; sets the outline/corner shape; controls size/placement; defines how state
 * changes animate.
 * Source rule 2813.
 */
.manager-preset-button-bg-border {
  position: absolute;
  width: 100%;
  height: 100%;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  left: 0px;
  top: 0px;
  border-radius: var(--numbers-border-radius-small);
  transition: border-color 0.15s ease-out, border-radius 0.15s ease-out;
}

/* Manager preset button image.
 * controls size/placement.
 * Source rule 2814.
 */
.manager-preset-button-image {
  width: 172px;
  height: 172px;
}

/* Manager preset button navigatable element.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2815.
 */
.manager-preset-button-navigatable-element {
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-transparent);
  border-radius: var(--numbers-border-radius-small);
}

/* Manager preset button toggle container.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2816.
 */
.manager-preset-button-toggle-container {
  justify-content: flex-start;
  flex-grow: 0;
  flex-shrink: 0;
  margin-bottom: 12px;
  align-self: stretch;
}

/* Manager preset button toggle container absolute.
 * controls size/placement.
 * Source rule 2817.
 */
.manager-preset-button-toggle-container-absolute {
  position: absolute;
  top: 4px;
  right: 4px;
  justify-content: flex-start;
  flex-grow: 0;
  flex-shrink: 0;
  align-self: flex-end;
}

/* Manager preset side container.
 * controls size/placement.
 * Source rule 2818.
 */
.manager-preset-side-container {
  width: 188px;
  height: 216px;
}

/* Manager preset side image.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 2819.
 */
.manager-preset-side-image {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-08);
  flex-grow: 1;
  border-radius: var(--skin-radius-small);
}

/* Manager reputation container.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2820.
 */
.manager-reputation-container {
  display: flex;
  padding: 8px 16px 8px 16px;
  border-width: 1px;
  background-color: var(--internal-design-system-surface-tile);
  align-self: stretch;
  flex-direction: column;
  align-items: var(--flex-start-normal);
  border-radius: var(--skin-radius-control);
}

/* Manager reputation tooltip.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2821.
 */
.manager-reputation-tooltip {
  padding: 12px;
  background-color: var(--skin-surface-raised);
  max-width: 416px;
  border-radius: var(--skin-radius-shell);
}

/* Manager selection manager picture container.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2822.
 */
.manager-selection-manager-picture-container {
  width: 40px;
  height: 40px;
  background-color: var(--skin-on-media-alpha-12);
  max-height: 44px;
  max-width: 44px;
  overflow: hidden;
  justify-content: center;
  align-items: center;
  border-radius: 22px;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
}

/* Manager selection padding 32.
 * sets spacing around/inside the element.
 * Source rule 2823.
 */
.manager-selection-padding-32 {
  padding: 32px;
}

/* Manager selection padding 48.
 * sets spacing around/inside the element.
 * Source rule 2824.
 */
.manager-selection-padding-48 {
  padding: 48px;
}

/* Manager style grid item checkbox.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2825.
 */
.manager-style-grid-item-checkbox {
  margin: 0px;
  border-width: 0px;
  background-color: var(--skin-transparent);
  flex-direction: var(--row-direction-normal);
  flex-wrap: nowrap;
  overflow: hidden;
  border-radius: var(--skin-choice-card-radius);
}

/* Unity base field input.
 * controls size/placement.
 * Source rule 2826.
 */
.manager-style-grid-item-checkbox > .unity-base-field__input {
  max-width: 0px;
  max-height: 0px;
}

/* Inputs hybrid task switch button large active false type default — checked/selected.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2827.
 */
.manager-style-grid-item-checkbox:checked .inputs-hybrid-task_switch_button-large-active-false--type-default {
  width: 491px;
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-choice-card-background);
  align-items: center;
  border-radius: var(--skin-choice-card-radius);
  margin-bottom: 0px;
  flex-direction: var(--row-direction-normal);
}

/* ManagementStyleTemplate hides its outer native input and paints a child
 * card plus a named, visible checkbox. Standalone-checkbox fills must never
 * paint the whole wrapper. Keep the native grid dimensions and input visibility. */
.manager-style-grid-item-checkbox .inputs-hybrid-task_switch_button-large-active-false--type-default {
  background-color: var(--skin-choice-card-background);
  border-radius: var(--skin-choice-card-radius);
}
.manager-style-grid-item-checkbox.inputs-switch-checkbox-default-switch-false--icon-none,
.manager-style-grid-item-checkbox.inputs-switch-checkbox-default-switch-false--icon-none:checked:enabled,
.manager-style-grid-item-checkbox.inputs-switch-checkbox-default-switch-false--icon-none:checked:hover:enabled,
.manager-style-grid-item-checkbox.inputs-switch-checkbox-default-switch-false--icon-none:checked:active:enabled,
.manager-style-grid-item-checkbox.inputs-switch-checkbox-default-switch-false--icon-none:disabled {
  background-color: var(--skin-transparent);
}
.manager-style-grid-item-checkbox:enabled {
  color: var(--skin-choice-foreground);
}
.manager-style-grid-item-checkbox:enabled .global-text-secondary {
  color: var(--skin-text-secondary);
}
/* The compact native grid keeps the same fixed-height cards at a narrower
 * width. Use its smaller text roles so full descriptions fit inside the frame;
 * preserve the game's grid, control, artwork and selection geometry. */
#GridBreakpointSmallCoachingStep,
#GridBreakpointSmallMentalStep {
  --skin-choice-card-title-size: var(--skin-choice-card-compact-title-size);
  --skin-choice-card-description-size: var(--skin-choice-card-compact-description-size);
}
.manager-style-grid-item-checkbox .heading-md {
  font-size: var(--skin-choice-card-title-size);
}
.manager-style-grid-item-checkbox .body-sm {
  font-size: var(--skin-choice-card-description-size);
}
.manager-style-grid-item-checkbox:checked:enabled .inputs-hybrid-task_switch_button-large-active-false--type-default {
  background-color: var(--skin-choice-card-selected);
  border-color: var(--skin-choice-marker);
}
.manager-style-grid-item-checkbox:hover:enabled .inputs-hybrid-task_switch_button-large-active-false--type-default {
  background-color: var(--skin-control-hover);
}
.manager-style-grid-item-checkbox:active:enabled .inputs-hybrid-task_switch_button-large-active-false--type-default {
  background-color: var(--skin-control-pressed);
}
.manager-style-grid-item-checkbox:focus:enabled .inputs-hybrid-task_switch_button-large-active-false--type-default {
  border-color: var(--skin-focus-ring);
}
/* The named square is control artwork. Concept icons elsewhere in the card
 * retain their native tint; only the tick receives the filled-square ink. */
.manager-style-grid-item-checkbox:checked:enabled #inputs-switch-checkbox {
  background-color: var(--skin-choice-marker);
  border-color: var(--skin-choice-marker);
}
.manager-style-grid-item-checkbox:checked:hover:enabled #inputs-switch-checkbox {
  background-color: var(--skin-selection-hover);
}
.manager-style-grid-item-checkbox:checked:active:enabled #inputs-switch-checkbox {
  background-color: var(--skin-selection-pressed);
}
.manager-style-grid-item-checkbox:checked:enabled #inputs-switch-checkbox .unity-toggle__checkmark {
  background-color: var(--skin-transparent);
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.manager-style-grid-item-checkbox:disabled .inputs-hybrid-task_switch_button-large-active-false--type-default,
.manager-style-grid-item-checkbox:disabled #inputs-switch-checkbox {
  background-color: var(--skin-action-disabled-background);
  border-color: var(--skin-border-subtle);
}
.manager-style-grid-item-checkbox:disabled .sitext {
  color: var(--skin-text-disabled);
}
.manager-style-grid-item-checkbox:disabled #inputs-switch-checkbox .unity-toggle__checkmark {
  -unity-background-image-tint-color: var(--skin-text-disabled);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.manager-creation-tab > .tabgroup > * > .tabgroup__tab--active .sitext,
.manager-creation-tab > .tabgroup > * > .tabgroup__tab--active .sitextmedium,
.manager-creation-tab > .tabgroup > * > .tabgroup__tab--active .sitextsmall,
.manager-creation-tab > .buttongroup > .buttongroup__button--active .sitext,
.manager-creation-tab > .buttongroup > .buttongroup__button--active .sitextmedium,
.manager-creation-tab > .buttongroup > .buttongroup__button--active .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Club Player Staff
 * Native club player staff selectors, with adjacent shared rules in source order.
 */

/* Player active injury ellipse.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3190.
 */
.player-active-injury-ellipse {
  width: 8px;
  height: 8px;
  background-color: var(--colours-base-red-strong);
  border-radius: 4px;
}

/* Player attribute color point.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3191.
 */
.player-attribute-color-point {
  width: 14px;
  height: 14px;
  border-radius: 8px;
}

/* Player attribute line chart color point.
 * sets the outline/corner shape; controls size/placement; changes opacity for the whole element and its
 * contents.
 * Source rule 3192.
 */
.player-attribute-line-chart-color-point {
  opacity: 0;
  width: 10px;
  height: 10px;
  border-radius: 8px;
}

/* Player attribute rating text max width.
 * controls size/placement.
 * Source rule 3193.
 */
.player-attribute-rating-text-max-width {
  max-width: 130px;
}

/* Player cell button.
 * sets font/text presentation; controls size/placement; sets spacing around/inside the element.
 * Source rule 3194.
 */
.player-cell-button {
  width: auto;
  margin: var(--global-gap-none);
  padding: var(--global-padding-none) var(--global-padding-small);
  flex-grow: 1;
  flex-shrink: 0;
  justify-content: center;
  white-space: nowrap;
}

/* Player comparison overview block.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 3195.
 */
.player-comparison-overview-block {
  padding: var(--global-padding-extra-large);
  background-color: var(--skin-on-media-alpha-08);
  border-radius: var(--skin-radius-card);
}

/* Player comparison spider graph.
 * controls size/placement; sets spacing around/inside the element; changes opacity for the whole element
 * and its contents.
 * Source rule 3196.
 */
.player-comparison-spider-graph {
  opacity: 0.72;
  width: 100%;
  height: 100%;
  flex-grow: 1;
  align-self: center;
  margin-top: 16px;
  margin-bottom: 12px;
}

/* Player database filters block frame.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 3197.
 */
.player-database-filters-block-frame {
  height: 56px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  padding-top: var(--global-padding-large);
  padding-right: var(--global-padding-extra-large);
  padding-bottom: var(--global-padding-large);
  padding-left: var(--global-padding-extra-large);
  border-radius: var(--layout-modules-block-radius);
}

/* Player database suggested player active.
 * sets the background fill.
 * Source rule 3198.
 */
.player-database-suggested-player-active {
  background-color: var(--skin-surface-panel);
}

/* Player fitness active injury recurring overlap.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3199.
 */
.player-fitness-active-injury-recurring-overlap {
  position: relative;
  align-self: center;
  flex-direction: column;
  padding-top: 1px;
  padding-bottom: 1px;
}

/* Player fitness active injury recurring.
 * sets the background artwork; controls size/placement; sets spacing around/inside the element; changes
 * opacity for the whole element and its contents.
 * Source rule 3200.
 */
.player-fitness-active-injury-recurring:enabled {
  position: relative;
  opacity: 1;
  width: 100%;
  height: 200px;
  background-image: none;
  flex-grow: 1;
  margin-bottom: 0;
  align-self: stretch;
}

/* Bar chart item.
 * controls size/placement.
 * Source rule 3201.
 */
.player-form-chart .bar-chart-item {
  width: 5px;
  height: 20px;
}

/* Bar chart item small.
 * controls size/placement.
 * Source rule 3202.
 */
.player-form-chart .bar-chart-item-small {
  width: 5px;
  height: 19px;
}

/* Player form data display tooltip hover default with fixture.
 * controls size/placement.
 * Source rule 3203.
 */
.player-form-data_display-tooltip-hover-default-with-fixture {
  width: 353px;
}

/* Player form data display tooltip hover player form default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3204.
 */
.player-form-data_display-tooltip-hover-player-form-default {
  padding: var(--spacing-padding-extra-small---4) var(--spacing-padding-small---8);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-raised);
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  border-radius: var(--skin-radius-small);
}

/* Bar chart item.
 * controls size/placement; sets spacing around/inside the element.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3205.
 */
.player-form-fixed-bars .bar-chart-item,
.player-form-fixed-bars .bar-chart-item-small,
.team-form-fixed-bars .bar-chart-item,
.team-form-fixed-bars .bar-chart-item-small {
  width: var(--width-height-08);
  flex-grow: 0;
  flex-shrink: 0;
  margin-left: var(--global-gap-none);
  margin-right: var(--global-gap-none);
}

/* Data display graphs bar chart bar.
 * sets the outline/corner shape; controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3206.
 */
.player-form-fixed-bars .data_display-graphs-bar_chart-bar,
.team-form-fixed-bars .data_display-graphs-bar_chart-bar {
  width: var(--width-height-06);
  align-self: center;
  border-radius: var(--skin-form-bar-radius);
  flex-grow: 0;
}

/* Streamed list view item.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3207.
 */
.player-form-fixed-bars .streamed-list-view-item,
.team-form-fixed-bars .streamed-list-view-item {
  flex-grow: 0;
  flex-shrink: 0;
}

/* Player info block small title.
 * sets the background fill.
 * Source rule 3208.
 */
.player-info-block-small-title {
  background-color: var(--skin-on-media-alpha-08);
}

/* Player info property 1 overview mode.
 * sets the background fill; controls size/placement.
 * Source rule 3209.
 */
.player-info-property-1-overview-mode {
  background-color: var(--skin-on-media-alpha-08);
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/* Sitext.
 * Changes text/foreground colour.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3210.
 */
.player-injury-cell-active-injury .sitext,
.fitness-test-result-text-colour-fail,
.injury-severity-text-colour-major,
.player-interest-red,
.squad-dynamics-pro-con-negative-text,
.transfer-overview-closed-text {
  color: var(--colours-base-red-soft);
}

/* A tweaked instruction remains marked by its cyan status outline even though
 * ordinary card-tile borders are suppressed at the shared frame.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3211.
 */
.player-instruction-tile--tweaked .surfaces-card-tile-border,
.team-instruction-tile--tweaked .surfaces-card-tile-border,
.team-instruction-tile--phase-relevant .team-instruction-tile--tweaked .surfaces-card-tile-border {
  border-width: var(--global-border-width-tile-card);
  border-color: var(--colours-base-cyan-50);
}

/* Player instruction tile tweak icon.
 * Hides these elements; controls size/placement.
 * Source rule 3212.
 */
.player-instruction-tile__tweak-icon {
  position: absolute;
  display: none;
  width: 16px;
  height: 16px;
  top: 8px;
  right: 8px;
}

/* Player match simulation circle.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3213.
 */
.player-match-simulation-circle {
  width: 20px;
  height: 20px;
  border-width: 1.5px;
  border-color: var(--skin-text-secondary);
  flex-shrink: 0;
  border-radius: 20px;
}

/* Player match simulation circle fullscreen.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3214.
 */
.player-match-simulation-circle-fullscreen {
  width: 30px;
  height: 30px;
  border-width: 1.5px;
  border-color: var(--skin-text-secondary);
  flex-shrink: 0;
  border-radius: 30px;
}

/* Player match simulation circle small.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3215.
 */
.player-match-simulation-circle-small {
  width: 10px;
  height: 10px;
  border-width: 1.5px;
  border-color: var(--skin-text-secondary);
  flex-shrink: 0;
  border-radius: 10px;
}

/* Player match simulation direction.
 * controls size/placement.
 * Source rule 3216.
 */
.player-match-simulation-direction {
  width: 12px;
  height: 16px;
  flex-shrink: 0;
}

/* Player on loan colour.
 * Changes text/foreground colour.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3217.
 */
.player-on-loan-colour,
.biography-property1-stepper .stepper-text {
  color: var(--communication-feedback-information);
}

/* Player picked position down arrow.
 * controls size/placement.
 * Source rule 3218.
 */
.player-picked-position-down-arrow {
  position: absolute;
  width: 100%;
  height: 100%;
  right: 0px;
  top: 0px;
}

/* Player property 1 1.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3219.
 */
.player-property-1-1 {
  width: 160px;
  height: 124px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-strong);
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--layout-modules-block-radius);
}

/* Player prospect level decent text.
 * Changes text/foreground colour.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3220.
 */
.player-prospect-level-decent-text,
.squad-happiness-unhappy-players-3,
.training-load-heavy-text {
  color: var(--linear-ranges-5-values-2);
}

/* Player recommendations block fmc.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 3221.
 */
.player-recommendations-block-fmc {
  padding: 12px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  border-radius: var(--layout-modules-block-radius);
}

/* Player recommendations property 1 empty.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3222.
 */
.player-recommendations-property-1-empty {
  padding: 12px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  flex: 1 0 0;
  align-self: stretch;
  border-radius: var(--layout-modules-block-radius);
}

/* Player recommendations top bar fmc.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 3223.
 */
.player-recommendations-top-bar-fmc {
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--colours-brand-tints-horizon-alpha-8);
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  padding-top: var(--global-padding-large);
  padding-right: var(--global-padding-extra-large);
  padding-bottom: var(--global-padding-large);
  padding-left: var(--global-padding-extra-large);
  border-radius: var(--layout-modules-block-radius);
}

/* Player recurring injury ellipse.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3224.
 */
.player-recurring-injury-ellipse {
  width: 8px;
  height: 8px;
  background-color: var(--colours-base-purple-strong);
  border-radius: 4px;
}

/* Player report role selector roles size high possession ip.
 * controls size/placement.
 * Source rule 3225.
 */
.player-report-role-selector-roles-size-high-possession-ip {
  width: 100%;
  height: 100%;
  min-width: 380px;
  max-width: 420px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

/* Player report role selector roles size min res.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3226.
 */
.player-report-role-selector-roles-size-min-res {
  width: 132px;
  height: 452px;
  flex-direction: column;
  align-items: flex-start;
  margin-right: var(--spacing-padding-tiles);
}

/* Player report role selector roles size min res possession ip.
 * controls size/placement.
 * Source rule 3227.
 */
.player-report-role-selector-roles-size-min-res-possession-ip {
  width: 170px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 1;
}

/* Player role dropdown left.
 * controls size/placement.
 * Source rule 3228.
 */
.player-role-dropdown-left {
  width: 44px;
  height: 28px;
}

/* Player role dropdown right.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3229.
 */
.player-role-dropdown-right,
.tactical-tweaks-tabs .buttongroup__button {
  height: 28px;
}

/* Player search dialog fmc.
 * controls size/placement.
 * Source rule 3230.
 */
.player-search-dialog-fmc {
  width: 622px;
  align-items: center;
}

/* Player search pitch.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3231.
 */
.player-search-pitch,
.player-fitness-injury-frame:enabled {
  width: 250px;
}

/* Player thumbnail shirt rounded.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3232.
 */
.player-thumbnail-shirt-rounded {
  background-color: var(--skin-on-media-alpha-12);
  border-radius: 40px;
}

/* Player position dm tint.
 * tints background artwork.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3233.
 */
.player_position-dm-tint,
.transfer-comment-notification-icon-colour {
  -unity-background-image-tint-color: var(--colours-base-green-strong);
}

/* Player position goalkeeper tint.
 * tints background artwork.
 * Source rule 3234.
 */
.player_position-goalkeeper-tint {
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Player position strikers tint.
 * tints background artwork.
 * Source rule 3235.
 */
.player_position-strikers-tint {
  -unity-background-image-tint-color: var(--colours-base-pink-base);
}

/* Player position dropdown.
 * controls size/placement.
 * Source rule 3236.
 */
.player_position_dropdown {
  width: 100%;
  height: 80px;
  flex-grow: 1;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
  min-width: 100%;
}

/* Micro pitch parent.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3237.
 */
.player_position_dropdown .micro-pitch-parent {
  border-width: 2px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-data-player-position-dropdown-micro-pitch-parent-background);
  border-radius: var(--skin-radius-compact);
}

/* Micro pitch tactics.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3238.
 */
.player_position_dropdown .micro-pitch-tactics {
  width: 100%;
  height: 100%;
  border-radius: var(--skin-radius-micro);
}

/* Is gk.
 * sets the background fill.
 * Source rule 3239.
 */
.player_position_dropdown .micro-pitch-tactics .is-gk {
  background-color: var(--colours-base-grey-deep);
}

/* Pitch dot 2px.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3240.
 */
.player_position_dropdown .micro-pitch-tactics .pitch-dot-2px {
  width: 2px;
  height: 2px;
  border-radius: 2px;
}

/* Pitch dot 4px.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3241.
 */
.player_position_dropdown .micro-pitch-tactics .pitch-dot-4px {
  width: 4px;
  height: 4px;
  border-radius: 4px;
}

/* Pitch dot 6px.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 3242.
 */
.player_position_dropdown .micro-pitch-tactics .pitch-dot-6px {
  width: 6px;
  height: 6px;
  border-radius: 6px;
}

/* SI dropdown down arrow.
 * sets the outline/corner shape.
 * Source rule 3243.
 */
.player_position_dropdown .si-dropdown__down-arrow {
  border-left-width: 1px;
  border-left-color: var(--skin-on-media-alpha-12);
  background-size: 35px 25px;
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 3244.
 */
.player_position_dropdown .si-dropdown__selection-field {
  width: 100%;
  padding: 7px;
  border-width: var(--global-border-regular);
  border-color: var(--skin-control-border);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  min-width: 100%;
  min-height: 80px;
  max-height: 80px;
}

/* Playerindicator bottom.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 3245.
 */
.playerindicator_bottom {
  background-color: var(--skin-surface-page);
  border-bottom-left-radius: var(--skin-radius-control);
  border-bottom-right-radius: var(--skin-radius-control);
  overflow: hidden;
}

/* Playerindicator top.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 3246.
 */
.playerindicator_top {
  height: 28px;
  background-color: var(--skin-surface-page-alpha-60);
  border-top-left-radius: var(--skin-radius-control);
  border-top-right-radius: var(--skin-radius-control);
}

/* Playerreport Tooltip Popup.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 3247.
 */
.playerreportTooltipPopup {
  width: 16px;
  height: 16px;
  min-width: 16px;
  margin-right: 2px;
}

/* Position attribute rating accomplished.
 * sets the outline/corner shape; controls size/placement.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 3248.
 */
