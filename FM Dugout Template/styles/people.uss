/* Club Player Staff
 * Native club player staff selectors, with adjacent shared rules in source order.
 */

/* Manager accessories side button toggle container.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2749.
 */
.manager-accessories-side-button-toggle-container {
  height: 16px;
  align-self: stretch;
  flex-shrink: 0;
  margin-bottom: 12px;
}

/* Unity radio button checkmark background.
 * Shows these elements; sets the outline/corner shape.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2750.
 */
.manager-background-highest-level-radiogroup .unity-radio-button__checkmark-background,
.manager-background-nonplaying-career-radiogroup .unity-radio-button__checkmark-background,
.manager-creation-color-button--selected .manager-creation-color-button-checkbox,
.manager-creation-mobile-grid-button-selected .manager-creation-mobile-grid-button-checkmark {
  display: flex;
  border-width: 3px;
  border-color: var(--skin-radio-ring-foreground);
  border-radius: 3px;
}

/* Sicontainer horizontal align.
 * sets font/text presentation; controls size/placement.
 * Source rule 2751.
 */
.manager-background-phone-radio-group .sicontainer_horizontal_align {
  width: 100%;
  -unity-font-style: var(--typography-weight-regular);
}

/* Unity radio button container.
 * controls size/placement.
 * Source rule 2752.
 */
