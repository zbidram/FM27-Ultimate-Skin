.transfers-panel-type-in-active-no,
.transfers-panel-type-in-active-yes,
.transfers-panel-type-out-active-no,
.transfers-panel-type-out-active-yes,
.transfers-panel-type-trades-active-yes {
  width: 312px;
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  min-height: 475px;
  max-height: 580px;
  flex-direction: column;
  align-items: flex-start;
