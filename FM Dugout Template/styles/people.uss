.playerreport_positional_data_points .position-attribute-indicator.position-attribute-rating-competent,
.playerreport_positional_data_points .position-attribute-indicator.position-attribute-rating-natural {
  width: 15px;
  height: 15px;
  border-radius: 7.5px;
}

