}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.manager-creation-tab > .tabgroup > * > .tabgroup__tab--active,
.manager-creation-tab > .buttongroup > .buttongroup__button--active {
  border-width: 1px;
  border-color: var(--skin-border-default);
