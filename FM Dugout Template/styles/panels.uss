  justify-content: space-between;
  align-items: flex-start;
  border-radius: var(--skin-radius-card);
}

/* Frames property 1 default.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2342.
 */
.frames-property-1-default {
  width: 968px;
  height: 804px;
  padding: 16px 12px 24px 12px;
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  flex-direction: column;
  align-items: flex-end;
  border-radius: var(--skin-radius-card);
}

/* Frames property 1 squad number unassigned.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2343.
 */
.frames-property-1-squad-number-unassigned,
.frames-squad-numbers-assigned-registration-close {
  width: 328px;
  padding: var(--spacing-medium---16);
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--layout-modules-block-radius);
}

/* Frames right side intensity.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2344.
 */
.frames-right_side_intensity {
  width: 481px;
  height: 347px;
  padding: var(--spacing-padding-medium---16);
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
  border-radius: var(--layout-modules-block-radius);
}

/* Frames scouting budget remaining budget property 1 adjusted.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2345.
 */
.frames-scouting-budget-remaining-budget-property-1-adjusted,
.frames-wage-info-property-1-default,
.mentoring-block-mentoring_name {
  width: 640px;
  padding: var(--spacing-padding-medium---16);
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--layout-modules-block-radius);
}

/* Frames staff attributes full frame min states manager.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2346.
 */
.frames-staff-attributes-full-frame-min-states-manager {
  width: 968px;
  height: 476px;
  padding: 12px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  align-items: flex-start;
  border-radius: var(--layout-modules-block-radius);
  flex-direction: var(--row-direction-normal);
}

/* Frames staff attributes low res tab managerial highlighted no masked no.
 * controls size/placement.
 * Source rule 2347.
 */
.frames-staff-attributes-low-res-tab-managerial-highlighted-no-masked-no {
  height: 452px;
  flex-direction: column;
  align-items: var(--flex-start-normal);
  flex: 1 0 0;
}

/* Frames staff attributes tab managerial highlighted no masked no.
 * controls size/placement.
 * Source rule 2348.
 */
.frames-staff-attributes-tab-managerial-highlighted-no-masked-no {
  width: 52%;
  height: 100%;
  flex-direction: column;
  align-items: flex-start;
}

/* Frames staff attributes full frame standard states manager.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2349.
 */
/* Inline staff attributes follow ordinary report-card edges, like players. */
.frames-staff_attributes-full_frame-standard-states-manager {
  width: auto;
  height: 476px;
  padding: var(--spacing-tiles);
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-card);
  flex-direction: var(--row-direction-normal);
}

/* Frames staff role stack low res property 1 manager.
 * controls size/placement.
 * Source rule 2350.
 */
.frames-staff_role_stack-low-res-property-1-manager {
  width: 180px;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
}

/* Frames summary property 1 board.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2351.
 */
/* Board/supporter feedback is inline report content, not a floating dialog. */
.frames-summary-property-1-board {
  padding: var(--spacing-padding-medium---16);
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  align-items: center;
  align-self: stretch;
  border-radius: var(--skin-radius-card);
  flex-direction: var(--row-direction-normal);
}

/* Frames terms block top bar.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 2352.
 */
.frames-terms-block-top-bar {
  padding: var(--padding-padding-12);
  background-color: var(--skin-surface-page-alpha-80);
  border-top-left-radius: var(--global-radius-regular);
  border-top-right-radius: var(--global-radius-regular);
}

/* Frames wage info property 1 auto width.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2353.
 */
.frames-wage-info-property-1-auto-width {
  width: auto;
  padding: var(--spacing-padding-medium---16);
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  border-radius: var(--layout-modules-block-radius);
}

/* Frames world knowledge property 1 nations.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2354.
 */
.frames-world-knowledge-property-1-nations {
  width: 640px;
  height: 640px;
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-card);
}

/* Full capacity widget.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2355.
 */
.full-capacity-widget {
  border-width: 0.5px;
  border-color: var(--staff-coaching-assistant-manager-20);
  background-color: var(--internal-design-system-surface-wireframe-background);
  padding-top: var(--global-padding-regular);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-regular);
  padding-left: var(--global-padding-large);
  align-items: center;
  align-self: stretch;
  border-radius: var(--global-gap-regular);
  flex-direction: var(--row-direction-normal);
}

/* Fullscreen experience header.
 * sets the background fill; controls size/placement; sets spacing around/inside the element.
 * Source rule 2356.
 */
.fullscreen-experience-header {
  height: var(--main-header-height);
  padding: 0;
  background-color: var(--skin-surface-page);
}

/* Speakto size.
 * controls size/placement.
 * Source rule 2357.
 */
.fullscreen-meeting-with-larger-speakto .speakto-size {
  width: 475px;
}

/* Future playing time property 1 default.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2358.
 */
.future-playing-time-property-1-default {
  padding-top: 0;
  padding-right: var(--global-padding-large);
  padding-bottom: 0;
  padding-left: var(--global-padding-large);
  align-items: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Panels
 * Panels, cards, tiles, frames and layout containers. Some adjacent cross-component rules retain their original place.
 */

/* Layout block base container compact.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2687.
 */
.layout-block-base-container-compact {
  padding: 8px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  border-radius: var(--layout-modules-block-radius);
}

/* Layout block tactics.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 2688.
 */
.layout-block-tactics {
  padding: var(--spacing-medium---16) var(--spacing-tiles);
  border-width: 1px;
  border-color: var(--colours-tactics-base-20);
  background-color: var(--colours-tactics-teaminstruction-background);
  border-radius: var(--layout-modules-block-radius);
}

/* Layout card content default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2689.
 */
.layout-card-content-default {
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--internal-design-system-surface-wireframe-border);
  background-color: var(--internal-design-system-surface-wireframe-background);
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Layout card content table default.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2690.
 */
.layout-card-content-table-default {
  padding: var(--spacing-medium---16);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Layout card default default.
 * controls size/placement.
 * Source rule 2691.
 */
.layout-card-default-default {
  flex-direction: column;
  justify-content: space-between;
  align-self: stretch;
  align-items: flex-start;
  flex-grow: 1;
}

/* Layout card pop up default.
 * controls size/placement.
 * Source rule 2692.
 */
.layout-card-pop-up-default {
  width: 429px;
  align-items: flex-start;
  flex-direction: var(--row-direction-normal);
}

/* Layout divider solid horizontal.
 * sets the background fill; controls size/placement.
 * Source rule 2693.
 */
.layout-divider-solid-horizontal {
  height: 1px;
  background-color: var(--skin-on-media-alpha-20);
  flex-shrink: 0;
  align-self: stretch;
}

/* Layout divider solid horizontal white.
 * sets the background fill; controls size/placement.
 * Source rule 2694.
 */
.layout-divider-solid-horizontal-white {
  height: 1px;
  background-color: var(--skin-text-primary);
  flex-shrink: 0;
  align-self: stretch;
}

/* Layout divider solid vertical.
 * sets the background fill; controls size/placement.
 * Source rule 2695.
 */
.layout-divider-solid-vertical {
  width: 1px;
  height: 100%;
  background-color: var(--skin-on-media-alpha-20);
  max-width: 1px;
}

/* Layout divider solid vertical stretch.
 * sets the background fill; controls size/placement.
 * Source rule 2696.
 */
.layout-divider-solid-vertical-stretch {
  width: 1px;
  background-color: var(--skin-on-media-alpha-20);
  align-self: stretch;
}

/* Layout divider thematic horizontal.
 * controls size/placement.
 * Source rule 2697.
 */
.layout-divider-thematic-horizontal {
  width: 100%;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* Layout layout divider solid horizontal.
 * sets the background fill; controls size/placement.
 * Source rule 2698.
 */
.layout-layout-divider-solid-horizontal {
  height: 1px;
  background-color: var(--skin-border-subtle);
  align-self: stretch;
}

/* Layout layout divider solid vertical.
 * sets the background fill; controls size/placement.
 * Source rule 2699.
 */
.layout-layout-divider-solid-vertical {
  width: 1px;
  height: 100%;
  background-color: var(--skin-border-subtle);
  align-self: stretch;
}

/* Tile base container.
 * The base surface/geometry behind native tile content. Changing it can affect tiles across screens.
 * Source rule 2700.
 */
.layout-tile-base-container {
  height: 100%;
  border-width: 0;
  border-color: var(--skin-border-subtle);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  flex-shrink: 0;
  flex-grow: 0;
  border-radius: var(--skin-radius-control);
  overflow: hidden;
}

/* Interactive tile.
 * Clickable tile presentation. Hover and pressed rules may override this normal state.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2701.
 */
.layout-tile-interaction-button,
.layout-tile-interaction-none {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-color: var(--skin-transparent);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  flex-shrink: 0;
  flex-grow: 0;
  border-radius: var(--interaction-global-radius-lg);
  transition-property: background-color;
  transition-duration: var(--global-transition-short);
  transition-timing-function: var(--transition-cb-ui);
}

/* Interactive tile background.
 * Background layer beneath a clickable tile. Separate from the content and title.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2702.
 */
.layout-tile-interaction-button-background,
.layout-tile-interaction-none {
  background-color: var(--skin-surface-panel);
}

/* Layout tile interaction button background golden.
 * sets the background fill.
 * Source rule 2703.
 */
.layout-tile-interaction-button-background-golden {
  background-color: var(--theme-color-yellow-strong-soft);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.layout-tile-interaction-button-background-highlighted {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}

/* Startscreen Var.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2705.
 */
.layout-tile-interaction-button.startscreenVar,
.layout-tile-tactics .layout-tile-interaction-button,
.recruitment-player-scouted-grade-header--no-report {
  background-color: var(--skin-on-media-alpha-08);
}

/* Startscreen Var — pressed.
 * sets the background fill.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2706.
 */
.layout-tile-interaction-button.startscreenVar:active:enabled,
.layout-tile-interaction-button.startscreenVar:hover,
.layout-tile-tactics .layout-tile-interaction-button:active:enabled,
.layout-tile-tactics .layout-tile-interaction-button:hover,
.startnewcareer_custom_bg_tile .layout-tile-interaction-button:active:enabled,
.startnewcareer_custom_bg_tile .layout-tile-interaction-button:hover {
  background-color: var(--skin-on-media-alpha-12);
}

/* Interactive tile — pressed.
 * sets the background fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2707.
 */
.layout-tile-interaction-button:active:enabled,
.layout-tile-interaction-button:hover,
.surfaces-card-tile-border.startscreenVar:hover {
  background-color: var(--skin-control-hover);
}

/* Layout tile interaction border tactics.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 2708.
 */
.layout-tile-interaction_border_tactics {
  position: absolute;
  border-width: 2px;
  border-color: var(--skin-on-media-alpha-12);
  border-radius: var(--skin-radius-control);
}

/* Layout tile scalable default background true.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2709.
 */
.layout-tile-scalable-default--background-true {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-08);
  background-color: var(--skin-surface-panel);
  flex-grow: 1;
  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
}

/* Layout tile base container.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2710.
 */
.layout-tile-tactics .layout-tile-base-container {
  border-width: var(--numbers-border-radius-null);
  border-color: var(--skin-border-subtle);
  background-color: var(--pitch-tile-default-background);
}

/* Layered Dugout Navy fill replaces the outline: large panels use panel Navy and nested tiles use raised
 * Navy.
 */
#MenuBody .grid-element-scope,
#ReportBody .grid-element-scope,
#MenuBody .siblock-border,
#ReportBody .siblock-border {
  background-color: var(--skin-surface-panel);
  background-image: none;
  border-width: 0;
  border-color: var(--skin-transparent);
  border-radius: var(--skin-radius-card);
}

/* The open message detail sits one layer above its containing report panel; the surface provides the
 * separation, so the native frame outline is unnecessary.
 */
#ReportBody .message-container-frame {
  background-color: var(--skin-message-surface);
  background-image: none;
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-transparent);
  border-radius: var(--skin-message-radius);
}

/* Layered Dugout Navy fill replaces the outline: large panels use panel Navy and nested tiles use raised
 * Navy.
 */
#MenuBody .layout-tile-base-container,
#ReportBody .layout-tile-base-container,
#MenuBody .layout-tile-interaction-button-background,
#ReportBody .layout-tile-interaction-button-background,
#MenuBody .layout-block-base-container,
#ReportBody .layout-block-base-container,
#MenuBody .messages-tile-background,
#ReportBody .messages-tile-background {
  background-color: var(--skin-surface-raised);
  background-image: none;
  border-width: 0;
  border-color: var(--skin-transparent);
  border-radius: var(--skin-radius-card);
}

/* The native messages switch draws a frame around the complete list/detail split. Remove the frame;
 * keep the list and detail as separate raised surfaces using the shared module radius. The split
 * wrapper must show the page Navy through the space between those surfaces.
 */
#ReportBody .tool-messages-list {
  border-width: 0;
  border-color: var(--skin-transparent);
}

/* MessagesBlock is a generic tile with a panel fill. Here it only lays out the two message
 * surfaces, so let its 16px inter-column gap reveal the workspace colour underneath. */
#ReportBody #MessagesBlock.grid-element-scope {
  background-color: var(--skin-transparent);
}

#ReportBody .tool-messages-list .messages-tool-list-container {
  margin-right: var(--global-gap-seperation);
}

/* The outer Grid has a separate 16px right margin. Remove only that inset so the detail reaches
 * the right edge while the list keeps its intended transparent gap. */
#ReportBody .tool-messages-list #Grid {
  margin-right: var(--global-gap-none);
  background-color: var(--skin-transparent);
}

/* Action suggestions are neutral guidance, not a branded status. Remove FM's purple Horizon
 * stripe and use the normal Dugout text treatment. */
#ReportBody .notificationmessagestatus-action-colour {
  background-color: var(--skin-transparent);
  border-top-width: var(--global-border-width-none);
  border-top-color: var(--skin-transparent);
  border-radius: 0;
}

#ReportBody .notificationmessagestatus-action-colour .action-header {
  color: var(--skin-text-primary);
}

/* This message footer inherits a native text colour on some action-button templates. Keep
 * its Volt label and icon paired with the dark action foreground in every enabled state. */
#ReportBody .notificationmessagestatus .buttons-button-primary-default,
#ReportBody .notificationmessagestatus .buttons-button-primary-default .sitext,
#ReportBody .notificationmessagestatus .buttons-button-primary-default .sitextmedium,
#ReportBody .notificationmessagestatus .buttons-button-primary-default .sitextsmall {
  color: var(--skin-action-primary-foreground);
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Tint every monochrome icon leaf inside this Volt action. The native footer can
 * use different image classes across message action templates, so target the
 * Unity image element rather than guessing the icon's class. */
#ReportBody .notificationmessagestatus .buttons-button-primary-default:enabled .unity-image {
  -unity-background-image-tint-color: var(--skin-action-primary-foreground);
}

#ReportBody .notificationmessagestatus .buttons-button-primary-default:disabled,
#ReportBody .notificationmessagestatus .buttons-button-primary-default:disabled .sitext,
#ReportBody .notificationmessagestatus .buttons-button-primary-default:disabled .sitextmedium,
#ReportBody .notificationmessagestatus .buttons-button-primary-default:disabled .sitextsmall {
  color: var(--skin-action-disabled-foreground);
}

#ReportBody .notificationmessagestatus .buttons-button-primary-default:disabled .unity-image {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.layout-tile-interaction-button-background-highlighted .sitext,
.layout-tile-interaction-button-background-highlighted .sitextmedium,
.layout-tile-interaction-button-background-highlighted .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Club overview summary cards blend with the dynamic club banner. Use alpha
 * on the surface only: text, badges and state icons keep their own opacity.
 * Preserve the shared card radius and keep the treatment out of other headers. */
#ReportBody #ClubSite .ios-site-header .background-color-global-sink-surface-base.border-radius-global-border-extra-small {
  background-color: var(--skin-club-summary-surface);
  border-radius: var(--skin-radius-card);
}

/* Panels
 * Panels, cards, tiles, frames and layout containers. Some adjacent cross-component rules retain their original place.
 */

/* Tile mockups navigation hi res bookmarks secondary nav.
 * controls size/placement.
 * Source rule 4095.
 */
.tile-mockups-navigation-hi-res-bookmarks-secondary-nav {
  height: 30px;
  justify-content: flex-end;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* Tile mockups navigation secondary entity default.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4096.
 */
/* The entity strip intentionally aligns to the right even when its template also
 * supplies the generic justify-content-center helper. Keep this component intent explicit. */
.tile-mockups-navigation-secondary-entity-default,
.tile-mockups-navigation-secondary-entity-default.justify-content-center {
  width: 144px;
  height: 30px;
  padding-left: var(--global-padding-small);
  justify-content: flex-end;
  align-items: center;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Tile mockups navigation secondary nav hi standard res default.
 * controls size/placement.
 * Source rule 4097.
 */
.tile-mockups-navigation-secondary-nav-hi-standard-res-default {
  align-items: flex-start;
  flex: 1 0 0;
  flex-direction: var(--row-direction-normal);
}

/* Tile online game size large.
 * controls size/placement.
 * Source rule 4098.
 */
.tile-online-game-size-large {
  width: 340px;
  flex-direction: column;
  justify-content: space-between;
  align-self: stretch;
  align-items: flex-start;
}

/* Tile player fitness.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 4099.
 */
.tile-player-fitness {
  width: 100%;
  height: 120px;
  margin: 8px;
  padding: 8px;
  background-color: var(--skin-on-media-alpha-04);
  flex-shrink: 1;
  flex-grow: 0;
  border-top-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
}

/* Tile search results.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 4100.
 */
.tile-search-results {
  width: 148px;
  height: 114px;
  align-items: flex-start;
