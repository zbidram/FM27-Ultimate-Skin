  border-left-color: var(--skin-border-subtle);
  border-right-color: var(--skin-border-subtle);
  border-top-color: var(--skin-border-subtle);
  border-bottom-color: var(--skin-border-subtle);
}

/* Neutral section heading on a Navy panel; the link underline carries the brand accent.
 */
#MenuBody .tile-title-color,
#ReportBody .tile-title-color {
  color: var(--skin-text-primary);
}

/* Panels
 * Panels, cards, tiles, frames and layout containers. Some adjacent cross-component rules retain their original place.
