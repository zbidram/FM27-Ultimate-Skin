/* Tile heading colour.
 * Changes the tile heading rather than all text in the tile.
 * Source rule 4138.
 */
.tile-title-color {
  color: var(--skin-text-primary);
}

/* Actual panel titles use FM's centrally mapped heading-small family and
 * weight. Keep thematic-small uses such as dense game data on their native
 * face and weight.
 */
.tile-title-color.thematic-sm,
.title-link-button .title-link-primary-text.thematic-sm {
  -unity-font-definition: var(--heading-sm-family);
  -unity-font-style: var(--heading-sm-weight);
}

/* Tile title color permanent.
 * supplies local values read by the component styling.
 * Source rule 4139.
 */
.tile-title-color-permanent {
  --layout-tiles-heading: var(--skin-text-primary);
}

/* Fmpediatile.
 * Changes text/foreground colour.
 * Source rule 4140.
 */
.tile-title-color.fmpediatile {
  color: var(--colours-base-teal-strong);
}

/* Tile title frame.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 4141.
 */
.tile-title-frame {
  height: 34px;
  padding: 2px 12px 0 12px;
  align-self: stretch;
  min-height: 34px;
  max-height: 34px;
}

/* Tiles players meetings type standard.
