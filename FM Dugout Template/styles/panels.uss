  flex-direction: column;
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--skin-radius-card);
}

/* Frames player attributes fixed column position outfeild highlighted no masked no.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2333.
 */
.frames-player-attributes-fixed-column-position-outfeild-highlighted-no-masked-no {
  width: 875px;
  height: 452px;
  align-items: flex-start;
  margin-right: var(--spacing-padding-tiles);
  flex-direction: var(--row-direction-normal);
}

/* Frames player attributes fixed column position outfeild highlighted no masked no possession n a.
 * controls size/placement.
 * Source rule 2334.
 */
.frames-player-attributes-fixed-column-position-outfeild-highlighted-no-masked-no-possession-n-a {
  width: 960px;
  height: 452px;
  align-items: flex-start;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Frames player attributes full block size max rows.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
