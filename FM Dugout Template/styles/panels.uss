/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* This full-window host sits above the 3D renderer even when its scene child
 * is hidden. Page panels own their surfaces; the host must stay transparent. */
#Background {
  background-color: var(--skin-transparent);
  background-image: none;
}

/* FM shows this scene backdrop between highlights and hides it for the pitch.
 * Paint this conditional layer rather than the always-present root/HUD. */
#Background > #GameWorldBackground.panel {
  background-color: var(--skin-surface-page);
}

/* Popup Background reuses the layer name but keeps the explicit dialog scrim
 * role. Its inner frame owns the modal surface; the page remains visible. */
#Background.sipopup-container {
  background-color: var(--skin-dialog-backdrop);
  background-image: none;
}

/* Native style setters also use Background for duration/status badges.
 * Their bound semantic class owns the fill, independent of the transparent
 * scene host above. Keep native thresholds, text and badge geometry intact. */
#Background.badge-string-thematic-default-size-small-status-positive {
  background-color: var(--skin-data-badge-string-thematic-default-size-small-status-positive-background);
}
#Background.badge-string-thematic-default-size-small-status-neutral {
  background-color: var(--skin-control-hover);
}
#Background.badge-string-thematic-default-size-small-status-negative {
  background-color: var(--skin-data-badge-string-thematic-default-size-small-status-negative-background);
}

/* The average-rating style setter also uses Background. Its bound rating
 * class owns this data fill; scene transparency must not erase performance
 * bands. Preserve the native rating classes, thresholds and geometry. */
#Background.data_display-average_rating-default-default-rating-null {
  background-color: var(--data-average-rating-surface-not-available);
}
#Background.data_display-average_rating-default-default-rating-less-than-6 {
  background-color: var(--data-average-rating-surface-0-6);
}
#Background.data_display-average_rating-default-default-rating-6 {
  background-color: var(--data-average-rating-surface-6-7);
}
#Background.data_display-average_rating-default-default-rating-7 {
  background-color: var(--data-average-rating-surface-7-8);
}
#Background.data_display-average_rating-default-default-rating-8 {
  background-color: var(--data-average-rating-surface-8-9);
}
#Background.data_display-average_rating-default-default-rating-9 {
  background-color: var(--data-average-rating-surface-9-10);
}

/* Layer hosts exist even when empty. Painting ReportBody covers the main menu
 * and leaves a solid screen after an overlay closes. The visible screen/report
 * panel owns the workspace fill; empty hosts preserve the native scene below. */
#MenuBody,
#ReportBody {
  background-color: var(--skin-transparent);
  background-image: none;
}

#MenuBody > .panel,
#ReportBody > .panel {
  background-color: var(--skin-surface-page);
}

/* The live-match HUD fills the viewport but its empty area is the pitch. */
#MenuBody > #OverviewPrototype.panel {
  background-color: var(--skin-transparent);
  background-image: none;
}

/* Half/full-time reports sit over the live stadium scene. Both the screen and its
 * reused conversation frame are layout hosts; the report tiles own the fill. */
#MenuBody > #HalfTimeTeamReport.panel,
#MenuBody > #FullTimeTeamReport.panel,
#HalfTimeTeamReport #Card-frame,
#FullTimeTeamReport #Card-frame {
  background-color: var(--skin-transparent);
  background-image: none;
}
/* Card-frame is also a Unity Image; tint its own retained native image only,
 * never whole-element opacity, which would also hide the report children. */
#HalfTimeTeamReport #Card-frame,
#FullTimeTeamReport #Card-frame {
  --unity-image-tint-color: var(--skin-transparent);
  -unity-background-image-tint-color: var(--skin-transparent);
}
/* The native SIImage keeps bound paint after tint resets. Visibility suppresses
 * that element's own drawing; visible children retain the report and layout. */
#HalfTimeTeamReport #Card-frame,
#FullTimeTeamReport #Card-frame {
  visibility: hidden;
}
#HalfTimeTeamReport #Card-frame > #GridSafeArea,
#FullTimeTeamReport #Card-frame > #GridSafeArea {
  visibility: visible;
}

/* CTRL background target: make native backdrop artwork transparent while keeping an opaque Navy surface.
 */
#background_image,
#Card-frame {
  background-color: var(--skin-surface-page);
  --unity-image-tint-color: var(--skin-background-image-tint);
  -unity-background-image-tint-color: var(--skin-background-image-tint);
  opacity: 1;
}

/* Hide this decorative backdrop/gradient only. Its content and bindings keep their layout.
 */
#GameWorldBackground #background_image,
#MenuTitle .navigation-header-gradient {
  opacity: 0;
}

/* Global game navigation matches Dugout's sidebar canvas without club-colour bleed.
 */
#MenuTitle {
  background-color: var(--skin-transparent);
  background-image: none;
  border-bottom-width: 0;
  border-bottom-color: var(--skin-transparent);
}
#MenuTitle #MainNav {
  background-color: var(--skin-surface-canvas);
  background-image: none;
  border-bottom-width: 0;
  border-bottom-color: var(--skin-transparent);
}

/* The primary bar contains a separate club gradient layer; suppress it so the canvas stays solid.
 */
#MenuTitle #MainNav #Club.sigradient {
  opacity: 0;
}

/* A quieter workspace-Navy row distinguishes secondary navigation without a club strip or claret seam. */
#MenuTitle #SecondaryNavigationBar {
  background-color: var(--skin-surface-page);
  background-image: none;
  border-top-width: 0;
  border-top-color: var(--skin-transparent);
}

/* Fill the native 1px gap between nav rows with the secondary-row surface, preventing colour bleed. */
#MenuTitle .main-navigation-overview-container {
  background-color: var(--skin-surface-page);
  background-image: none;
  border-bottom-width: 0;
  border-bottom-color: var(--skin-transparent);
}

/* The native title panel extends one pixel beyond its content. Give that exposed edge the
 * secondary-nav surface so a club-colour line cannot show below the row. The club overview
 * header is a separate panel below #MenuTitle and retains its own colours.
 */
#MenuTitle #OverviewTitleBar {
  background-color: var(--skin-surface-page);
  /* Separate the full header from content without changing the tab layout. */
  border-bottom-width: var(--skin-nav-secondary-edge-width);
  border-bottom-color: var(--skin-nav-secondary-edge);
}

/* Suppress only the secondary club gradient; the global bar already uses the sidebar canvas. */
#MenuTitle #SecondaryNavigationBar #Club.sigradient {
  opacity: 0;
}

/* Club pages render this second, separately named gradient over the secondary row.
 * Neutralize its paint here while leaving the coloured club overview header below intact.
 */
#MenuTitle #SecondaryNavigationBar #ClubGradient,
#MenuTitle #SecondaryNavigationBar #PlayerGradient {
  --start-colour: var(--skin-surface-page);
  --end-colour: var(--skin-surface-page);
}

/* These absolute decorative layers carry the remaining club-colour seam even when their
 * gradient variables are neutral. Leave the text, tabs and club identity in the row visible.
 */
#MenuTitle #SecondaryNavigationBar #EntityGradient,
#MenuTitle #SecondaryNavigationBar #PrimaryTabGraidient {
  opacity: 0;
}

/* This 1px native divider binds the club colour between rows; collapse it to remove the tinted seam. */
#MenuTitle #NavBarBindingSetter #IsEmployedDivider {
  display: none;
}

#MenuTitle #SecondaryNavigationBar .main-nav-secondary-bar {
  background-color: var(--skin-surface-page);
  background-image: none;
  border-top-width: 0;
  border-top-color: var(--skin-transparent);
}

/* Solid image backplate remains visible at transparent/cropped edges while preserving the native article
 * image.
 */
#MenuBody .news-button .dynamicImageFrame,
#ReportBody .news-button .dynamicImageFrame,
#MenuBody .news-button #dynamicImageFrame,
#ReportBody .news-button #dynamicImageFrame {
  background-color: var(--skin-surface-strong);
  border-radius: var(--skin-radius-control);
  overflow: hidden;
}

/* Panels
 * Panels, cards, tiles, frames and layout containers. Some adjacent cross-component rules retain their original place.
 */

/* Module block outline.
 * Shared panel/frame outline. This can affect several kinds of content container.
 * Source rule 86.
 */
.siblock-border {
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  border-radius: var(--layout-modules-block-radius);
}

/* Grid element editor border.
 * sets the outline/corner shape.
 * Source rule 87.
 */
.grid-element--editor-border {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
}

/* Grid element editor border — pointer hover.
 * sets the outline/corner shape.
 * Source rule 88.
 */
.grid-element--editor-border:hover {
  border-color: var(--skin-on-media-alpha-65);
}

/* Grid element drop preview.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 89.
 */
.grid-element--drop-preview {
  border-width: 2px;
  border-color: var(--colours-brand-accent);
  background-color: var(--colours-brand-accent-alpha-20);
}

/* Grid composition editor dragged element.
 * changes opacity for the whole element and its contents.
 * Source rule 90.
 */
.grid-composition-editor-dragged-element {
  opacity: 0.6;
}

/* Grid element info header.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 91.
 */
.grid-element__info-header {
  background-color: var(--skin-surface-canvas-alpha-55);
  flex-direction: var(--row-direction-normal);
  align-items: center;
  padding-top: 2px;
  padding-bottom: 2px;
  padding-left: 6px;
  padding-right: 4px;
  border-bottom-width: 1px;
  border-bottom-color: var(--skin-on-media-alpha-08);
}

/* Grid element info name.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement.
 * Source rule 92.
 */
.grid-element__info-name {
  color: var(--skin-text-primary);
  font-size: var(--skin-font-size-11);
  flex-grow: 1;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  -unity-font-style: bold;
}

/* Grid element info size.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 93.
 */
.grid-element__info-size {
  color: var(--colours-brand-accent);
  font-size: var(--skin-font-size-10);
  flex-shrink: 0;
  margin-left: 6px;
  margin-right: 2px;
}

/* SI dropdown selection field.
 * sets the outline/corner shape.
 * Source rule 94.
 */
.secondary-navigation-tab-dropdown > .si-dropdown__selection-field {
  border-radius: 0px;
}

/* Grid element info button.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; sets font/text
 * presentation.
 * Source rule 95.
 */
.grid-element__info-button {
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-18);
  background-color: var(--skin-on-media-alpha-06);
  color: var(--skin-text-primary);
  font-size: var(--skin-font-size-10);
  flex-shrink: 0;
  margin-left: 3px;
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 1px;
  padding-bottom: 1px;
  padding-left: 5px;
  padding-right: 5px;
  border-radius: var(--skin-radius-small);
  -unity-font-style: bold;
}

/* Grid element info button — pointer hover.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape.
 * Source rule 96.
 */
.unity-button.grid-element__info-button:hover {
  border-color: var(--skin-on-media-alpha-40);
  background-color: var(--skin-on-media-alpha-14);
  color: var(--skin-text-primary);
}

/* Siblock padding.
 * sets spacing around/inside the element.
 * Source rule 97.
 */
.siblock-padding {
  padding: var(--spacing-padding-medium---16);
}

/* Plugin context menu bindings overlay.
 * chooses the pointer and hotspot.
 * Source rule 98.
 */
.plugin-context-menu-bindings-overlay {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sitext hover cursor.
 * chooses the pointer and hotspot.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 99.
 */
.sitext-hover-cursor,
.draggable-hover-cursor {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* Sitext.
 * chooses the pointer and hotspot.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 100.
 */
.sibutton .sitext,
.si-dropdown__selection-field .sitext {
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

