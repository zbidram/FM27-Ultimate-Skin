 * Source rule 2336.
 */
.frames-player-attributes-full-block-size-mid-player-attributes-property-3-compact {
  height: 100%;
  padding: var(--global-padding-large);
  border-width: 0;
  border-color: var(--skin-transparent);
  background-color: var(--skin-surface-panel);
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--layout-modules-block-radius);
  flex-direction: var(--row-direction-normal);
}

/* Frames player attributes full block size min player attributes property 3 compact.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2337.
 */
.frames-player-attributes-full-block-size-min-player-attributes-property-3-compact {
  height: 100%;
  border-width: 0;
  border-color: var(--skin-transparent);
  background-color: var(--skin-surface-panel);
  padding-top: var(--global-padding-large);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-large);
  padding-left: var(--global-padding-large);
  align-items: flex-start;
  flex-shrink: 0;
  border-radius: var(--layout-modules-block-radius);
  flex-direction: var(--row-direction-normal);
}

/* Frames player attributes high res position outfeild highlighted yes masked no.
 * controls size/placement.
 * Source rule 2338.
 */
.frames-player-attributes-high-res-position-outfeild-highlighted-yes-masked-no {
  width: auto;
  height: auto;
  align-items: flex-start;
  flex-shrink: 0;
  flex-direction: var(--row-direction-normal);
}

/* Frames playing time upcoming property 1 pathway playing time v2.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2339.
 */
.frames-playing-time-upcoming-property-1-pathway-playing-time-v2,
.frames-playing-time-vertical-scale-property-1-base {
  padding: 16px;
  border-width: var(--layout-modules-block-border-thickness);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-surface-panel);
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
  flex-grow: 1;
  border-radius: var(--layout-modules-block-radius);
  margin-bottom: 0;
}

/* Frames promises.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2340.
 */
.frames-promises {
  padding: var(--spacing-medium---16);
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  flex-direction: var(--row-direction-normal);
  align-items: flex-start;
  flex: 1 0 0;
  border-radius: var(--skin-radius-card);
}

/* Frames property 1 code of conduct list.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2341.
 */
.frames-property-1-code-of-conduct-list {
