  width: 316px;
  height: 118px;
  padding: var(--numbers-border-radius-null) var(--spacing-tiles) 8px var(--spacing-tiles);
  flex-direction: column;
  align-items: var(--flex-start-normal);
  flex-shrink: 0;
  border-radius: var(--numbers-border-radius-null) var(--numbers-border-radius-null) var(--spacing-tiles) var(--spacing-tiles);
}

/* Tile states promises small.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 5051.
 */
.tile-states-promises-small {
  width: 150px;
  height: 118px;
  padding: var(--numbers-border-radius-null) var(--spacing-tiles) 8px var(--spacing-tiles);
  flex-direction: column;
  align-items: var(--flex-start-normal);
  flex-shrink: 0;
  border-radius: var(--numbers-border-radius-null) var(--numbers-border-radius-null) var(--spacing-tiles) var(--spacing-tiles);
}

/* Tile states promises tiny.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5052.
 */
.tile-states-promises-tiny,
.tile-states-targets-tiny {
  position: absolute;
  width: 148px;
  height: 32px;
  padding: 0 12px 8px 12px;
  flex-direction: column;
  align-items: flex-start;
  left: 0.424px;
  bottom: 0;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
}

/* Tile states targets small.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5053.
 */
.tile-states-targets-small,
.tile-states-squad-atmosphere-small {
  padding: 0 12px 8px 12px;
  flex-direction: column;
  align-items: var(--flex-start-normal);
  flex: 1 0 0;
  align-self: stretch;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
}

/* Tile states targets medium.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5054.
 */
.tile-states-targets-medium,
.tile-states-squad-atmosphere-medium {
  position: absolute;
  width: 312px;
  height: 114px;
  padding: 0 12px 8px 12px;
  flex-direction: column;
  align-items: var(--flex-start-normal);
  bottom: 0;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
}

/* Tile states targets large.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 5055.
 */
.tile-states-targets-large {
  position: absolute;
  width: 312px;
  height: 278px;
  padding: 0 12px 8px 12px;
  flex-direction: column;
  align-items: var(--flex-start-normal);
  left: 0;
  bottom: 0;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
}

/* Tile states targets hero.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 5056.
 */
.tile-states-targets-hero,
.tile-states-squad-atmosphere-hero {
  position: absolute;
  width: 640px;
  height: 278px;
  padding: 0 12px 8px 12px;
  flex-direction: column;
  align-items: var(--flex-start-normal);
  left: 0.424px;
  bottom: 0;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
}

/* Virtualised list item.
 * sets the outline/corner shape.
 * Source rule 5057.
 */
.vertical_llist_item_separator > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item {
  border-bottom-color: var(--skin-on-media-alpha-08);
  border-bottom-width: 1px;
}

/* Virtualised list item last.
 * sets the outline/corner shape.
 * Source rule 5058.
 */
.vertical_llist_item_separator > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item--last {
  border-bottom-width: 0;
}

/* Virtualised list item.
 * sets spacing around/inside the element.
 * Source rule 5059.
 */
.vertical_list_item_margin-bottom > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item {
  margin-bottom: var(--list_with_item_separator_spacing);
}

/* Virtualised list item last.
 * sets spacing around/inside the element.
 * Source rule 5060.
 */
.vertical_list_item_border-bottom > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item--last {
  margin-bottom: 0;
}

/* Virtualised list item.
 * sets spacing around/inside the element.
 * Source rule 5061.
 */
.vertical_list_item_padding-bottom > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item {
  padding-bottom: var(--list_with_item_separator_spacing);
}

/* Virtualised list item last.
 * sets spacing around/inside the element.
 * Source rule 5062.
 */
.vertical_list_item_padding-bottom > VirtualisedList > .unity-scroll-view--vertical > #View > .virtualised-list__item--last {
  padding-bottom: 0;
}

/* Tile states fixture shedule medium.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 5063.
 */
.tile-states-fixture-shedule-medium {
  flex-direction: column;
  align-items: flex-start;
  flex: 1 0 0;
  align-self: stretch;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
  padding-top: 4px;
}

/* Tile states fixture shedule large.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 5064.
 */
.tile-states-fixture-shedule-large {
  position: absolute;
  width: 312px;
  height: 278px;
  padding: 8px 12px 8px 12px;
  flex-direction: column;
  align-items: flex-start;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
}

/* Tile states fixture shedule hero.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 5065.
 */
.tile-states-fixture-shedule-hero {
  width: 640px;
  height: 278px;
  padding: 16px 12px 16px 12px;
  flex-direction: column;
  align-items: flex-start;
  bottom: 0;
  border-radius: 0 0 var(--skin-radius-card) var(--skin-radius-card);
}

/* Siradialgauge width 10px.
 * supplies local values read by the component styling.
 * Source rule 5066.
 */
.siradialgauge_width_10px {
  --track-width: 10;
}

/* Grid.
 * controls size/placement.
 * Source rule 5067.
 */
.Grid {
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  align-items: flex-start;
  justify-content: center;
  flex-wrap: wrap;
}

/* Grid Empty Slot.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 5068.
 */
.GridEmptySlot {
  width: 150px;
  height: 150px;
  margin-left: 5px;
  margin-right: 5px;
  margin-top: 5px;
  margin-bottom: 5px;
  border-left-color: var(--colours-base-grey-deep);
  border-right-color: var(--colours-base-grey-deep);
  border-top-color: var(--colours-base-grey-deep);
  border-bottom-color: var(--colours-base-grey-deep);
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
}

/* Card Background.
 * sets the background fill; sets the outline/corner shape; sets spacing around/inside the element.
 * Source rule 5069.
 */
.CardBackground {
  background-color: var(--skin-surface-panel);
  padding-left: 5px;
  padding-right: 5px;
  padding-top: 5px;
  padding-bottom: 5px;
  margin-left: 5px;
  margin-right: 5px;
  margin-top: 5px;
  margin-bottom: 5px;
  border-left-width: 1px;
  border-right-width: 1px;
  border-top-width: 1px;
  border-bottom-width: 1px;
}

/* Card Title.
 * Changes text/foreground colour; sets font/text presentation.
 * Source rule 5070.
 */
.CardTitle {
  color: var(--skin-text-primary);
  font-size: var(--typography-size-18);
  -unity-font-definition: var(--skin-font-body);
}

/* Card1x1.
 * controls size/placement.
 * Source rule 5071.
 */
.Card1x1 {
  min-width: 150px;
  min-height: 150px;
}

/* Card2x2.
 * controls size/placement.
 * Source rule 5072.
 */
.Card2x2 {
  min-width: 310px;
  min-height: 310px;
}

/* Card1x2.
 * controls size/placement.
 * Source rule 5073.
 */
.Card1x2 {
  min-width: 310px;
  min-height: 150px;
}

/* Card3x3.
 * controls size/placement.
 * Source rule 5074.
 */
.Card3x3 {
  min-width: 470px;
  min-height: 470px;
}

/* Native floating card frames already own an absolute border element, so
 * restoring its stroke separates dialogs without changing content sizing or
 * adding outlines to ordinary report cards. Card is the alternate floating
 * document host used by manager summaries; its frame owns the same stroke.
 * Keep radius aligned with the fill. */
#CardBody .surfaces-card-block-border,
#Card .card-template-inner-frame > .surfaces-card-block-border {
  border-width: var(--skin-dialog-border-width);
  border-color: var(--skin-dialog-border);
  border-radius: var(--skin-dialog-radius);
}
#CardBody .card-template-inner-frame,
#Card .card-template-inner-frame {
  border-radius: var(--skin-dialog-radius);
}

/* Keep linked report headings consistent with the overview standard. */
#ReportBody #LeagueTable > .buttons-button-tertiary-default,
#ReportBody #PlayerStats > .buttons-button-tertiary-default,
#ReportBody #TeamStatsVar > .buttons-button-tertiary-default,
#ReportBody #CompNews > .buttons-button-tertiary-default {
  border-bottom-color: var(--skin-nav-active-indicator);
  border-radius: 0;
}

/* Clause lists wrap rounded cards in square virtualised rows. Move selection
 * and hover paint onto the inner card so it cannot fill the card's outer gaps.
 * Scope this to the detail list; player choices on the left retain table stripes. */
#RecruitmentClausesCard #StreamedObjectList .virtualised-list__item--selected,
#RecruitmentClausesCard #StreamedObjectList .virtualised-list__item:hover {
  background-color: var(--skin-transparent);
}
#RecruitmentClausesCard #StreamedObjectList .virtualised-list__item--selected .frames-clauses-competition-bonus-property-1-complete-selection-southampton {
  background-color: var(--skin-list-selection-background);
}
#RecruitmentClausesCard #StreamedObjectList .virtualised-list__item:hover .frames-clauses-competition-bonus-property-1-complete-selection-southampton {
  background-color: var(--skin-control-hover);
}


/* Background is also the name of a content tile in the manager summary.
 * It is not the full-window canvas: painting it leaves dark square corners
 * behind the tile's own rounded surface. Native content retains its paint. */
#Background.si-tile {
  background-color: var(--skin-transparent);
}


/* Contract report header/body are ordinary joined report panels. Native side
 * utilities otherwise restore outlined edges after the shared module frame. */
#ReportBody .loan-report-header {
  border-top-width: var(--skin-card-border-width);
  border-right-width: var(--skin-card-border-width);
  border-left-width: var(--skin-card-border-width);
  border-top-color: var(--skin-card-border-colour);
  border-right-color: var(--skin-card-border-colour);
  border-left-color: var(--skin-card-border-colour);
}
#ReportBody .loan-report-body {
  border-bottom-width: var(--skin-card-border-width);
  border-right-width: var(--skin-card-border-width);
  border-left-width: var(--skin-card-border-width);
  border-bottom-color: var(--skin-card-border-colour);
  border-right-color: var(--skin-card-border-colour);
  border-left-color: var(--skin-card-border-colour);
}
