.buttons-hybrid-split-button-left-no-background:disabled,
.buttons-hybrid-split-button-right:disabled,
.buttons-hybrid-split-button-right-no-background:disabled,
.buttons-hero-toggle-small--dropdown--border-radius-none:disabled,
.buttons-hero-toggle-small--dropdown--border-radius-left:disabled,
.buttons-hero-toggle-small--dropdown--border-radius-right:disabled,
.inputs-combobox-default-default-transfer-activity .si-dropdown__selection-field:disabled,
