/* Inputs hybrid task switch button regular active false type default.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2564.
 */
.inputs-hybrid-task_switch_button-regular-active-false--type-default {
  width: auto;
  padding: var(--spacing-small---8) var(--padding-padding-8);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-border-subtle);
  max-height: 56px;
  border-radius: var(--global-radius-small);
  flex-direction: var(--row-direction-normal);
  align-items: center;
}

/* Inputs hybrid task switch button regular active false type default — pointer hover.
 * sets the background fill; sets the outline/corner shape.
