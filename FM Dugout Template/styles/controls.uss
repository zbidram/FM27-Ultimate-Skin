/* Edit this stylesheet directly, then reload the skin. Shared values live in theme.uss. */

/* Inputs
 * Native inputs selectors, with adjacent shared rules in source order.
 */

/* SI dropdown selection label.
 * Changes text/foreground colour; sets font/text presentation; controls size/placement.
 * Source rule 129.
 */
.si-dropdown-selection-label {
  color: var(--skin-text-primary);
  flex-grow: 1;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  -unity-font-definition: var(--skin-font-body);
  -unity-text-align: middle-left;
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; sets font/text presentation; controls
 * size/placement.
 * Source rule 130.
 */
.si-dropdown__selection-field {
  border-width: 2px;
  border-color: var(--skin-text-secondary);
  background-color: var(--skin-transparent);
  padding-right: 3px;
  padding-left: 3px;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  flex-shrink: 1;
  flex-grow: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  align-items: center;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 131.
 */
.squad-numbers-dropdown-no-value > .si-dropdown__selection-field {
  border-width: 2px;
  border-color: var(--linear-ranges-4-values-4);
  background-color: var(--skin-transparent);
  padding-bottom: 1px;
  padding-right: 3px;
  padding-left: 3px;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  flex-grow: 1;
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 132.
 */
.si-dropdown-no-border > .si-dropdown__selection-field {
  margin: 0;
  padding: 0;
  border-width: 0;
  border-color: var(--skin-transparent);
  background-color: var(--skin-transparent);
  flex-direction: var(--row-direction-normal);
  flex-shrink: 1;
  min-height: 25px;
  overflow: visible;
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
}

/* SI dropdown selection field.
 * sets the background fill; sets the background artwork; sets the outline/corner shape; sets font/text
 * presentation.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 133.
 */
.si-dropdown__iphone-options-list .si-dropdown__selection-field {
  background-color: var(--skin-on-media-alpha-08);
  border-top-left-radius: var(--skin-radius-medium);
  border-bottom-left-radius: var(--skin-radius-medium);
  border-top-right-radius: var(--skin-radius-medium);
  border-bottom-right-radius: var(--skin-radius-medium);
  -unity-font-definition: var(--skin-font-body);
  cursor: var(--cursor-clickable-1x-url) var(--cursor-clickable-1x-hotspot-x) var(--cursor-clickable-1x-hotspot-y);
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  rotate: 90deg;
  padding-bottom: 8px;
  padding-right: 8px;
  padding-left: 8px;
  padding-top: 8px;
}

/* SI dropdown binding root.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 134.
 */
.si-dropdown__binding-root {
  flex-direction: var(--row-direction-normal);
  flex-grow: 1;
  padding-top: 0;
  padding-bottom: 0;
  overflow: hidden;
}

/* SI dropdown binding root iphone.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 135.
 */
.si-dropdown__binding-root-iphone {
  height: 200px;
  border-width: 0;
  flex-grow: 0;
}

/* SI dropdown slider button.
 * sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 136.
 */
.si-dropdown__slider-button {
  height: 40px;
  background-color: var(--skin-surface-strong);
  border-radius: var(--skin-radius-control);
}

/* SI dropdown down arrow.
 * sets spacing around/inside the element.
 * Source rule 137.
 */
.si-dropdown__down-arrow {
  -unity-background-scale-mode: scale-to-fit;
  margin-top: 5px;
}

/* SI dropdown selection arrow.
 * Hides these elements; sets the background artwork; tints background artwork; controls size/placement.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 138.
 */
.si-dropdown__selection-arrow {
  display: none;
  width: 8px;
  height: 8px;
  align-self: center;
  -unity-background-image-tint-color: var(--skin-on-media);
  flex-grow: 0;
  flex-shrink: 0;
  margin-right: 4px;
}

/* SI dropdown folder icon.
 * sets the background artwork; controls size/placement.
 * Native image/font declarations stay with the game; their omitted positions are marked below.
 * Source rule 139.
 */
.si-dropdown-folder-icon {
  width: 12px;
  height: 12px;
  align-self: center;
  flex-grow: 0;
  flex-shrink: 0;
}

/* SI dropdown.
 * controls size/placement.
 * Source rule 140.
 */
.si-dropdown {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 1;
  min-height: 25px;
  min-width: 200px;
  overflow: visible;
  transform-origin: center;
}

/* Cascading menu.
 * controls size/placement.
 * Source rule 141.
 */
.cascading-menu {
  flex-direction: var(--row-direction-normal);
  flex-shrink: 1;
  min-height: 25px;
  overflow: visible;
}

/* Virtualised list item.
 * Shows these elements; sets the background fill; sets font/text presentation; controls size/placement.
 * Source rule 142.
 */
.si-dropdown .virtualised-list__item {
  display: flex;
  height: 32px;
  background-color: var(--skin-surface-page);
  white-space: nowrap;
  align-items: auto;
  flex-shrink: 0;
}

/* Virtualised list item.
 * controls size/placement.
 * Source rule 143.
 */
.si-dropdown.dynamic-elements .virtualised-list__item {
  height: auto;
}

/* Show spacer above.
 * sets the outline/corner shape.
 * Source rule 144.
 */
.show-spacer-above {
  border-top-color: var(--skin-divider-colour);
  border-top-width: var(--skin-divider-width);
}

/* Disabled menu labels retain their own ink through direct, inherited and
 * unity-disabled states, including the smaller native text families.
 * Extends source rule 145. */
.si-dropdown .virtualised-list__item.unity-disabled .sitext,
.cascading-menu__folder__entry.unity-disabled .sitext,
.si-dropdown .virtualised-list__item:disabled .sitext,
.si-dropdown .virtualised-list__item:disabled .sitextmedium,
.si-dropdown .virtualised-list__item:disabled .sitextsmall,
.cascading-menu__folder__entry:disabled .sitext,
.cascading-menu__folder__entry:disabled .sitextmedium,
.cascading-menu__folder__entry:disabled .sitextsmall,
.si-dropdown__binding-root .sub-dropdown-content-container:disabled .sitext,
.si-dropdown__binding-root .sub-dropdown-content-container:disabled .sitextmedium,
.si-dropdown__binding-root .sub-dropdown-content-container:disabled .sitextsmall {
  color: var(--skin-text-disabled);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.si-dropdown .virtualised-list__item:active:enabled,
.si-dropdown .virtualised-list__item--odd:active:enabled,
.cascading-menu__folder__entry:active:enabled,
.cascading-menu__folder__entry.virtualised-list__item--odd:active:enabled,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container > SIRadioButton.unity-radio-button-group__child-active,
.routine-dropdown-item__selected {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.si-dropdown .virtualised-list__item:hover:enabled,
.si-dropdown .virtualised-list__item.visual-highlighted:enabled,
.si-dropdown .virtualised-list__item--odd:hover:enabled,
.cascading-menu__folder__entry.virtualised-list__item:hover:enabled,
.cascading-menu__folder__entry.visual-highlighted:enabled,
.cascading-menu__folder__entry.virtualised-list__item--odd:hover:enabled {
  background-color: var(--skin-selection-hover);
  color: var(--skin-selection-foreground);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.si-dropdown .virtualised-list__item:active:enabled .sitext,
.si-dropdown .virtualised-list__item:active:enabled .sitextmedium,
.si-dropdown .virtualised-list__item:active:enabled .sitextsmall,
.si-dropdown .virtualised-list__item--odd:active:enabled .sitext,
.si-dropdown .virtualised-list__item--odd:active:enabled .sitextmedium,
.si-dropdown .virtualised-list__item--odd:active:enabled .sitextsmall,
.cascading-menu__folder__entry:active:enabled .sitext,
.cascading-menu__folder__entry:active:enabled .sitextmedium,
.cascading-menu__folder__entry:active:enabled .sitextsmall,
.cascading-menu__folder__entry.virtualised-list__item--odd:active:enabled .sitext,
.cascading-menu__folder__entry.virtualised-list__item--odd:active:enabled .sitextmedium,
.cascading-menu__folder__entry.virtualised-list__item--odd:active:enabled .sitextsmall,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container > SIRadioButton.unity-radio-button-group__child-active .sitext,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container > SIRadioButton.unity-radio-button-group__child-active .sitextmedium,
.matchpreferences-replaysblock-radiogroup > .unity-radio-button-group__container > SIRadioButton.unity-radio-button-group__child-active .sitextsmall,
.routine-dropdown-item__selected .sitext,
.routine-dropdown-item__selected .sitextmedium,
.routine-dropdown-item__selected .sitextsmall,
.si-dropdown .virtualised-list__item:hover:enabled .sitext,
.si-dropdown .virtualised-list__item:hover:enabled .sitextmedium,
.si-dropdown .virtualised-list__item:hover:enabled .sitextsmall,
.si-dropdown .virtualised-list__item.visual-highlighted:enabled .sitext,
.si-dropdown .virtualised-list__item.visual-highlighted:enabled .sitextmedium,
.si-dropdown .virtualised-list__item.visual-highlighted:enabled .sitextsmall,
.si-dropdown .virtualised-list__item--odd:hover:enabled .sitext,
.si-dropdown .virtualised-list__item--odd:hover:enabled .sitextmedium,
.si-dropdown .virtualised-list__item--odd:hover:enabled .sitextsmall,
.cascading-menu__folder__entry.virtualised-list__item:hover:enabled .sitext,
.cascading-menu__folder__entry.virtualised-list__item:hover:enabled .sitextmedium,
.cascading-menu__folder__entry.virtualised-list__item:hover:enabled .sitextsmall,
.cascading-menu__folder__entry.visual-highlighted:enabled .sitext,
.cascading-menu__folder__entry.visual-highlighted:enabled .sitextmedium,
.cascading-menu__folder__entry.visual-highlighted:enabled .sitextsmall,
.cascading-menu__folder__entry.virtualised-list__item--odd:hover:enabled .sitext,
.cascading-menu__folder__entry.virtualised-list__item--odd:hover:enabled .sitextmedium,
.cascading-menu__folder__entry.virtualised-list__item--odd:hover:enabled .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Disabled menu choices keep their quiet resting surface even when a
 * retained highlight class survives a game-state change. Pressed rows use
 * the pressed role after hover; selection-only controls keep their own fill. */
.si-dropdown .virtualised-list__item:disabled,
.cascading-menu__folder__entry:disabled,
.si-dropdown__binding-root .sub-dropdown-content-container:disabled {
  background-color: var(--skin-transparent);
  color: var(--skin-text-disabled);
}
.si-dropdown .virtualised-list__item:active:enabled,
.si-dropdown .virtualised-list__item--odd:active:enabled,
.cascading-menu__folder__entry:active:enabled,
.si-dropdown .virtualised-list__item:active:hover:enabled,
.si-dropdown .virtualised-list__item--odd:active:hover:enabled,
.si-dropdown .virtualised-list__item.visual-highlighted:active:enabled,
.cascading-menu__folder__entry.virtualised-list__item:active:enabled,
.cascading-menu__folder__entry.virtualised-list__item--odd:active:enabled,
.cascading-menu__folder__entry.visual-highlighted:active:enabled {
  background-color: var(--skin-selection-pressed);
  color: var(--skin-selection-foreground);
}

/* Some generated menus mark a choice with unity-disabled while it can still
 * acquire enabled/hover paint. The explicit native class must win as well as
 * :disabled; retain the native opacity and do not imply an available action. */
.cascading-menu__folder__entry.cascading-menu__folder__item.virtualised-list__item.unity-disabled {
  background-color: var(--skin-transparent);
  color: var(--skin-text-disabled);
}
.cascading-menu__folder__entry.cascading-menu__folder__item.virtualised-list__item.unity-disabled .sitext,
.cascading-menu__folder__entry.cascading-menu__folder__item.virtualised-list__item.unity-disabled .sitextmedium,
.cascading-menu__folder__entry.cascading-menu__folder__item.virtualised-list__item.unity-disabled .sitextsmall {
  color: var(--skin-text-disabled);
}
.cascading-menu__folder__entry.cascading-menu__folder__item.virtualised-list__item.unity-disabled > .indicator.ui-concepts-open_small,
.cascading-menu__folder__entry.cascading-menu__folder__item.virtualised-list__item.unity-disabled > .indicator.ui-concepts-speech-bubble_small,
.cascading-menu__folder__entry.cascading-menu__folder__item.virtualised-list__item.unity-disabled.cascading-menu__folder__entry__has_children > .indicator {
  -unity-background-image-tint-color: var(--skin-text-disabled);
}

/* Cascading interaction menus use a plain image indicator rather than SIText.
 * Pair the verified monochrome speech glyph with the same filled-row ink;
 * arbitrary club/status artwork in other indicators retains its own colour. */
.cascading-menu__folder__entry:enabled > .indicator.ui-concepts-speech-bubble_small {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
.cascading-menu__folder__entry:hover:enabled > .indicator.ui-concepts-speech-bubble_small,
.cascading-menu__folder__entry.visual-highlighted:enabled > .indicator.ui-concepts-speech-bubble_small,
.cascading-menu__folder__entry:active:enabled > .indicator.ui-concepts-speech-bubble_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.cascading-menu__folder__entry:disabled > .indicator.ui-concepts-speech-bubble_small {
  -unity-background-image-tint-color: var(--skin-text-disabled);
}

/* Cascading folders generate left/right chevrons in plain named indicators.
 * Tint those folder-only leaves, plus the monochrome open-link glyph, without
 * recolouring transfer/status artwork in ordinary action rows. */
.cascading-menu__folder__entry.cascading-menu__folder__entry__has_children:enabled > .indicator,
.cascading-menu__folder__entry:enabled > .indicator.ui-concepts-open_small {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
.cascading-menu__folder__entry.cascading-menu__folder__entry__has_children:hover:enabled > .indicator,
.cascading-menu__folder__entry.cascading-menu__folder__entry__has_children.visual-highlighted:enabled > .indicator,
.cascading-menu__folder__entry.cascading-menu__folder__entry__has_children:active:enabled > .indicator,
.cascading-menu__folder__entry:hover:enabled > .indicator.ui-concepts-open_small,
.cascading-menu__folder__entry.visual-highlighted:enabled > .indicator.ui-concepts-open_small,
.cascading-menu__folder__entry:active:enabled > .indicator.ui-concepts-open_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.cascading-menu__folder__entry.cascading-menu__folder__entry__has_children:disabled > .indicator,
.cascading-menu__folder__entry:disabled > .indicator.ui-concepts-open_small {
  -unity-background-image-tint-color: var(--skin-text-disabled);
}

/* Buttons
 * Primary, secondary, toggle and action controls, including state and gradient rules.
 */

/* Button size small.
 * controls size/placement.
 * Source rule 1310.
 */
.button-size-small {
  height: var(--interaction-global-height-sm);
  max-height: 32px;
}

/* Sitext hover cursor — pointer hover.
 * chooses the pointer and hotspot.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1311.
 */
.buttongroup.Default .buttongroup__button--active:hover .navigation-tab-default-default-text.sitext-hover-cursor,
.navigation-tab-default-default--active-true:hover:enabled,
.navigation-tab-default-default--active-true:hover:enabled .sitext-hover-cursor,
.tactics-visualiser-tactical-analysis-grid-cell-button:disabled {
  cursor: var(--cursor-default-1x-url) var(--cursor-default-1x-hotspot-x) var(--cursor-default-1x-hotspot-y);
}

/* Fmc preferences radio buttons.
 * sets spacing around/inside the element.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1312.
 */
.buttongroup.Default .buttongroup__button.buttongroup__button--leading.fmc-preferences-radio-buttons,
.no-left-margin,
.buttongroup.Default .navigation-tab-small-default--active-false.buttongroup__button--leading {
  margin-left: 0;
}

/* Unity radio button checkmark.
 * Shows these elements.
 * Shared rule for 38 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1313.
 */
.buttongroup__button--active .unity-radio-button__checkmark,
.manager-creation-menu .ui-concepts-chevron-down_small,
.manager-creation-menu .virtualised-list__item--selected .ui-concepts-chevron-top_small,
.passive-toggle,
.pivotalMomentNameList .pivotalMomentNameList__midPunctuation,
.pivotalMomentNameList .virtualised-list__item--last .pivotalMomentNameList__finalPunctuation,
.segmented-button-group .unity-radio-button-group__child-active .ui-concepts-tick_small,
.tabgroup__tab--active .segmented-row-button-icon,
.tabgroup__tab--active > .show-when-tab-active,
.buttongroup__button--active .segmented-row-button-icon,
.buttongroup__button--active > .show-when-tab-active,
.virtualised-list__item--selected .active-toggle,
.virtualised-list__item--selected .colour-swatch-selected,
.virtualised-list__item--selected .manager-creation-menu-option-selection-border,
.virtualised-list__item--selected .manager-preset-button-active-toggle,
.show-button-image .hidden-item,
.show-thematic-string-secondary-text .hidden-item,
.manager-creation-visible-element,
.tactical-tweak-row--hovered .tactical-tweak-row__instruct-pill,
.tactical-tweak-row--active.tactical-tweak-row--hovered .tactical-tweak-row__stop-pill,
.tactical-tweak-row--pending-apply .tactical-tweak-row__instructing-pill,
.tactical-tweak-row--pending-remove .tactical-tweak-row__stopping-pill,
.tactical-tweak-row--pending-apply.tactical-tweak-row--hovered .tactical-tweak-row__instructing-pill,
.tactical-tweak-row--pending-remove.tactical-tweak-row--hovered .tactical-tweak-row__stopping-pill,
.tactical-tweak-row--pending-apply.tactical-tweak-row--hovered .tactical-tweak-row__cancel-apply-button,
.tactical-tweak-row--pending-remove.tactical-tweak-row--hovered .tactical-tweak-row__cancel-remove-button,
.tactical-tweak-row--active.tactical-tweak-row--conflict .tactical-tweak-row__stop-pill,
.tactical-tweak-row--pending-apply.tactical-tweak-row--conflict .tactical-tweak-row__cancel-apply-button,
.tactical-tweak-player-row--expanded .tactical-tweak-player-row__picker,
.team-instruction-tile--tweaked .team-instruction-tile__tweak-icon,
.team-instruction-tile--pending .team-instruction-tile__tweak-icon-pending,
.team-instruction-cell--has-tweak-icon .team-instruction-tile__tweak-icon,
.team-instruction-cell--pending .team-instruction-tile__tweak-icon-pending,
.team-instruction-cell--has-tweak-icon .team-instruction-cell__tweak-icon,
.player-instruction-tile--tweaked .player-instruction-tile__tweak-icon,
.team-instruction-options--tweaked .unity-radio-button-group__child-active .team-instruction-option__tweak-badge,
.team-instruction-options--tweaked > .team-instruction-option-list__tweak-footer,
.calendar-training-session-selected > .calendar-training-session-selection-ring {
  display: flex;
}

/* Sigradient.
 * sets the outline/corner shape.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1314.
 */
.buttongroup__button--leading .sigradient,
.tab-button-segmented-selected.tabgroup__tab--leading,
.team-report-segmented-bar-chart-segment-container-element.tabgroup__tab--leading,
.tab-button-segmented-selected.buttongroup__button--leading,
.team-report-segmented-bar-chart-segment-container-element.buttongroup__button--leading {
  border-radius: var(--border-radius-leading-small);
}

/* Buttongroup controller icon left.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1315.
 */
.buttongroup__controller-icon--left {
  padding-right: 8px;
}

/* Buttongroup controller icon right.
 * sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1316.
 */
.buttongroup__controller-icon--right {
  padding-left: 8px;
}

/* Buttons button affiliated club.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1317.
 */
.buttons-button-affiliated-club {
  margin: 6px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--none);
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  padding-right: 16px;
  padding-left: 16px;
  padding-top: 8px;
  padding-bottom: 8px;
}

/* Buttons button base dark.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 1318.
 */
.buttons-button-base-dark {
  padding: var(--spacing-padding-small---8) var(--spacing-padding-medium---16);
  border-width: 1px;
  border-color: var(--skin-surface-page-alpha-20);
  background-color: var(--skin-surface-panel-alpha-14);
  color: var(--skin-text-primary);
  max-height: 32px;
  align-items: center;
  border-radius: var(--skin-radius-control);
  min-height: 32px;
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Buttons button base dark — pointer hover.
 * sets the background fill.
 * Source rule 1319.
 */
.buttons-button-base-dark:hover {
  background-color: var(--skin-surface-page-alpha-16);
}

/* Buttons button base default.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 1320.
 */
.buttons-button-base-default {
  margin: var(--global-gap-none);
  border-width: var(--global-border-regular);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  padding-top: 0;
  padding-right: var(--interaction-global-padding-horizontal-md);
  padding-bottom: 0;
  padding-left: var(--interaction-global-padding-horizontal-md);
  flex-direction: var(--row-direction-normal);
  align-items: center;
  border-radius: var(--skin-radius-control);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons), color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Buttons button base default — pressed.
 * sets the background fill; sets the outline/corner shape.
 * Shared rule for 8 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1321.
 */
.buttons-button-base-default:active:enabled,
.buttons-combo-button-base-default:active:enabled,
.inputs-combobox-default-default-primary .si-dropdown__selection-field:active:enabled,
.inputs-combobox-default-default-disabled-no-padding .si-dropdown__selection-field:active:enabled,
