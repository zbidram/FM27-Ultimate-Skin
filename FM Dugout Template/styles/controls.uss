  padding: var(--numbers-border-radius-null);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-border-default);
  background-color: var(--skin-planner-point-background);
  color: var(--skin-text-secondary);
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.input-squad-planner-data-point-regular-type-depth-mode-mixed-active-true,
.input-squad-planner-data-point-regular-type-position-mode-mixed-active-true {
  width: var(--spacing-extra-large---64);
  height: 48px;
  padding: var(--numbers-border-radius-null);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-planner-point-selected-border);
  background-color: var(--skin-selection-background);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
  color: var(--skin-selection-foreground);
}

/* Input toggle icon default active false.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 2538.
 */
.input-toggle-icon-default-active-false {
  display: flex;
  height: var(--interaction-global-height-sm, 24px);
  padding: 0 var(--padding-padding-4, 4px);
  border-width: 1.5px;
  border-color: var(--theme-core-secondary-border-default, var(--skin-on-media-alpha-56));
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  justify-content: center;
}

/* Input toggle icon default active true.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2539.
 */
.input-toggle-icon-default-active-true {
  display: flex;
  height: var(--interaction-global-height-sm, 24px);
  padding: 0 var(--padding-padding-4, 4px);
  border-width: 1.5px;
  border-color: var(--theme-core-primary-border-default, var(--skin-on-media-alpha-35));
  background-color: var(--theme-core-primary-surface-default, var(--skin-brand-primary));
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-small);
  justify-content: center;
}

/* Inputs colour picker swatch pallete swatch.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 2540.
 */
.inputs-colour_picker-swatch-pallete-swatch {
  width: 40px;
  height: 40px;
