  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  justify-content: space-between;
  align-items: center;
  border-radius: var(--numbers-border-radius-small);
  margin-bottom: 0;
  flex-direction: var(--row-direction-normal);
}

/* Inputs combobox default calendar — disabled.
 * Changes text/foreground colour; sets the outline/corner shape.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2546.
 */
.inputs-combobox-default-calendar:disabled,
.inputs-text-field-default-default-validation-default:disabled .bindableeditbox {
  border-color: var(--skin-border-subtle);
  color: var(--skin-text-disabled);
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2547.
 */
.inputs-combobox-default-default-base .si-dropdown__selection-field,
.tifo-dropdown .si-dropdown__selection-field {
  padding: 0 var(--padding-padding-8);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  min-height: 32px;
  max-height: 32px;
  align-items: center;
  border-radius: var(--numbers-border-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Inputs combobox default default base.
 * sets the outline/corner shape.
 * Shared rule for 6 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2548.
 */
.inputs-combobox-default-default-base,
.inputs-combobox-default-default-disabled,
.inputs-combobox-default-default-disabled-no-padding,
.inputs-combobox-default-default-primary,
.inputs-combobox-default-default-secondary,
.border-radius-small {
  border-radius: var(--numbers-border-radius-small);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2549.
 */
.inputs-combobox-default-default-disabled .si-dropdown__selection-field {
  margin: 2px;
  padding: 0 var(--padding-padding-8);
  background-color: var(--skin-transparent);
  min-height: 32px;
  max-height: 32px;
  justify-content: center;
  align-items: center;
  flex-direction: var(--row-direction-normal);
  border-radius: var(--numbers-border-radius-small);
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2550.
 */
.inputs-combobox-default-default-disabled-no-padding .si-dropdown__selection-field {
  margin: var(--gap-gap-0);
  padding: var(--padding-padding-0);
  border-width: 0;
  background-color: var(--skin-transparent);
  min-height: 20px;
  max-height: 20px;
  justify-content: flex-start;
  align-items: center;
  flex-direction: var(--row-direction-normal);
  border-radius: var(--numbers-border-radius-small);
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
}

/* SI dropdown selection field.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 2551.
 */
.inputs-combobox-default-default-edit-leagues-rulegroup-mode #inputs-combobox-default-default .si-dropdown__selection-field {
  min-width: 72px;
  border-top-width: 2px;
  border-right-width: 2px;
  border-bottom-width: 2px;
  border-left-width: 2px;
}

/* Primary combobox selection field.
 * Its Volt surface needs Dugout's dark action ink, including on hover; the native
 * white foreground made this control unreadable. Keep the paired disabled roles.
 * Source rule 2552.
 */
.inputs-combobox-default-default-primary .si-dropdown__selection-field {
  padding: 0 var(--padding-padding-8);
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-action-primary-background);
  color: var(--skin-action-primary-foreground);
  min-height: 32px;
  max-height: 32px;
  align-items: center;
  flex-direction: var(--row-direction-normal);
}

/* SI dropdown selection field — disabled.
 * Changes text/foreground colour; sets the background fill.
 * Source rule 2553.
 */
.inputs-combobox-default-default-primary .si-dropdown__selection-field:disabled {
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-action-disabled-foreground);
}

/* Native text leaves set their own colour instead of inheriting field ink.
 * Some templates (Medical Centre Actions) place their label alongside the
 * painted field rather than inside it. Pair both structures at the shared
 * primary family; more specific disabled-field rules still win below. */
.inputs-combobox-default-default-primary:enabled > .sitext,
.inputs-combobox-default-default-primary:enabled > .sitextmedium,
.inputs-combobox-default-default-primary:enabled > .sitextsmall {
  color: var(--skin-action-primary-foreground);
}
.inputs-combobox-default-default-primary:disabled > .sitext,
.inputs-combobox-default-default-primary:disabled > .sitextmedium,
.inputs-combobox-default-default-primary:disabled > .sitextsmall {
  color: var(--skin-action-disabled-foreground);
}

/* Keep every supported nested label size paired too. */
.inputs-combobox-default-default-primary .si-dropdown__selection-field:enabled .sitext,
.inputs-combobox-default-default-primary .si-dropdown__selection-field:enabled .sitextmedium,
.inputs-combobox-default-default-primary .si-dropdown__selection-field:enabled .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

.inputs-combobox-default-default-primary .si-dropdown__selection-field:disabled .sitext,
.inputs-combobox-default-default-primary .si-dropdown__selection-field:disabled .sitextmedium,
.inputs-combobox-default-default-primary .si-dropdown__selection-field:disabled .sitextsmall {
  color: var(--skin-action-disabled-foreground);
}

/* SI dropdown selection field.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2554.
 */
.inputs-combobox-default-default-secondary .si-dropdown__selection-field {
  padding: var(--padding-padding-8);
  border-width: 2px;
  border-color: var(--skin-border-default);
  background-color: var(--skin-transparent);
  max-height: 32px;
  align-items: center;
  border-radius: var(--numbers-border-radius-small);
  flex-direction: var(--row-direction-normal);
  min-height: 32px;
  padding-top: 4px;
  padding-bottom: 4px;
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2555.
 */
.inputs-combobox-default-default-transfer-activity .si-dropdown__selection-field {
  padding: var(--spacing-small---8) var(--padding-padding-8);
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
  align-items: center;
  border-radius: var(--numbers-border-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2556.
 */
.inputs-combobox-default-default-validation-default .si-dropdown__selection-field {
  padding: var(--spacing-new-ex) var(--padding-padding-8);
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  min-width: 120px;
  justify-content: space-between;
  align-items: center;
  border-radius: var(--numbers-border-radius-small);
  margin-bottom: 0;
  flex-direction: var(--row-direction-normal);
}

/* Inputs date picker column label default active false.
 * Changes text/foreground colour; controls size/placement; sets spacing around/inside the element.
 * Source rule 2557.
 */
.inputs-date_picker-column-label-default-active-false {
  width: 32px;
  height: 32px;
  padding: 8px;
  color: var(--skin-text-secondary);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-bottom: 0;
  flex-direction: var(--row-direction-normal);
}

/* Date selector grid element inactive.
 * Shows these elements; sets the outline/corner shape; controls size/placement; sets spacing around/inside
 * the element.
 * Source rule 2558.
 */
.inputs-date_picker-day-default-active-false .date-selector-grid-element__inactive {
  display: flex;
  width: 32px;
  height: 32px;
  padding: 0;
  border-width: 1px;
  border-color: var(--skin-border-subtle);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
}

/* Date selector grid element active.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 2559.
 */
.inputs-date_picker-day-default-active-true .date-selector-grid-element__active {
  display: flex;
  width: 32px;
  height: 32px;
  padding: 0;
  border-width: 1px;
  border-color: var(--skin-action-primary-border);
  background-color: var(--skin-action-primary-background);
  color: var(--skin-action-primary-foreground);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
}

/* Selected calendar days inherit Volt ink even when native text classes specify their own colour. */
.inputs-date_picker-day-default-active-true .date-selector-grid-element__active .sitext,
.inputs-date_picker-day-default-active-true .date-selector-grid-element__active .sitextmedium,
.inputs-date_picker-day-default-active-true .date-selector-grid-element__active .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Date selector grid element highlighted.
 * sets the outline/corner shape.
 * Source rule 2560.
 */
.inputs-date_picker-day-default-highlighted .date-selector-grid-element__highlighted {
  border-width: 2px;
  border-color: var(--skin-brand-accent);
}

/* Inputs date picker notification default type future.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2561.
 */
.inputs-date_picker-notification-default-type-future {
  width: 4px;
  height: 4px;
  padding: 0 2px;
  background-color: var(--colours-base-blue-soft);
  justify-content: center;
  align-items: center;
  margin-bottom: 2px;
  flex-direction: var(--row-direction-normal);
  flex-shrink: 0;
  padding-top: 0;
  padding-right: 0;
  padding-bottom: 0;
  padding-left: 0;
  border-left-color: var(--colours-base-blue-soft);
  border-right-color: var(--colours-base-blue-soft);
  border-top-color: var(--colours-base-blue-soft);
  border-bottom-color: var(--colours-base-blue-soft);
  border-top-width: 1px;
  border-right-width: 1px;
  border-bottom-width: 1px;
  border-left-width: 1px;
  margin-top: 2px;
  margin-right: 2px;
  margin-left: 2px;
  border-top-left-radius: var(--skin-radius-small);
  border-top-right-radius: var(--skin-radius-small);
  border-bottom-right-radius: var(--skin-radius-small);
  border-bottom-left-radius: var(--skin-radius-small);
}

/* Inputs hybrid task switch button large active false type default.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 2562.
 */
.inputs-hybrid-task_switch_button-large-active-false--type-default {
