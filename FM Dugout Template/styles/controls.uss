}

/* Buttons button fixture default active disabled.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element.
 * Source rule 1332.
 */
.buttons-button-fixture-default-active-disabled {
  width: 72px;
  height: 28px;
  border-radius: var(--skin-radius-control);
  margin-right: 8px;
  margin-left: 8px;
  flex-direction: var(--row-direction-normal);
}

/* Unity base field.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 1333.
 */
.buttons-button-fixture-default-active-disabled .unity-base-field {
  margin: 0;
  flex-grow: 1;
  flex-shrink: 0;
}

/* Buttons button navigation default.
 * sets the background fill; sets the outline/corner shape; controls size/placement; defines how state
 * changes animate.
 * Source rule 1334.
 */
.buttons-button-navigation-default {
  width: 116px;
  height: 40px;
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-on-media-alpha-08);
  align-items: center;
  justify-content: center;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Buttons button navigation default selected.
 * sets the background fill; sets the outline/corner shape; defines how state changes animate.
 * Source rule 1335.
 */
.buttons-button-navigation-default--selected {
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-action-primary-hover);
  color: var(--skin-action-primary-foreground);
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-buttons);
  transition-timing-function: var(--global-transition-animation-buttons);
}

/* Unity text children can carry their own foreground, so pair the selected
 * navigation fill with dark action ink on the label as well. */
.buttons-button-navigation-default--selected .sitext {
  color: var(--skin-action-primary-foreground);
}

/* Buttons button navigation default — pressed.
 * sets the background fill.
 * Shared rule for 18 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1336.
 */
.buttons-button-navigation-default:active:enabled,
.tweaks-list-bg-light,
.competition-team-injuries-count-other-team,
.vertical-radio-group .unity-radio-button__checkmark-background:hover,
.horizontal-radio-group .unity-radio-button__checkmark-background:hover,
.meeting-tiles-top-panel--background-inactive,
.calendar-day-future,
.manager-preset-button-bg:hover,
.buttons-toggle-picture-button-default-type-unselected--selected-false:hover,
.inputs-combobox-controls-default-type-integer-active-false-validation-default .si-combobox__input-field:hover,
.inputs-combobox-controls-default-type-integer-active-false-validation-default .si-dropdown__selection-field:hover,
.inputs-ige-combobox-controls-default-type-cash .si-combobox__input-field:hover,
.inputs-ige-combobox-controls-default-type-cash .si-dropdown__selection-field:hover,
.inputs-ige-combobox-controls-default-type-cash .si-combobox__selection-field:hover,
.inputs-combobox-controls-default-type-integer-active-false-validation-default .si-combobox__selection-field:hover,
.streamed-table__header .unity-button:hover:enabled,
.news-button:hover,
.message-button:hover {
  background-color: var(--skin-on-media-alpha-08);
}

/* Buttons button navigation default — disabled.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 1337.
 */
.buttons-button-navigation-default:disabled {
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-action-disabled-background);
}

/* Buttons button navigation default — pointer hover.
 * sets the background fill.
 * Shared rule for 11 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1338.
 */
.buttons-button-navigation-default:hover,
.dashboard-hud-continue_button-default:hover,
.vertical-radio-group .unity-radio-button__checkmark-background:active:enabled,
.horizontal-radio-group .unity-radio-button__checkmark-background:active:enabled,
.dashboard-hud-additional-buttons:hover,
.dashboard-hud-search-button:hover,
.data_display-cell-player-header:hover,
.data_display-cell-player-header-override:hover #ActiveClubButton:hover,
.nav-on-dark .nonDiegeticButton:hover,
.nav-on-dark .nonDiegeticButton #SelectionField:hover {
  background-color: var(--skin-on-media-alpha-12);
}

/* Primary action button.
 * Owns button size, padding, outline and fill. The child .sigradient can cover the fill.
 * Source rule 1339.
 */
.buttons-button-primary-default {
  height: var(--interaction-global-height-md);
  margin: var(--global-gap-none);
  border-width: var(--global-border-regular);
  border-color: var(--skin-action-primary-border);
  background-color: var(--skin-action-primary-background);
  max-height: 32px;
  padding-top: 0;
  padding-right: var(--interaction-global-padding-horizontal-md);
  padding-bottom: 0;
  padding-left: var(--interaction-global-padding-horizontal-md);
  align-items: center;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons), border-color var(--global-transition-buttons) var(--global-transition-animation-buttons), color var(--global-transition-buttons) var(--global-transition-animation-buttons);
  color: var(--skin-action-primary-foreground);
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Primary button gradient.
 * Draws the gradient over the button surface. Change both stops here for a flat action colour.
 * Source rule 1340.
 */
.buttons-button-primary-default .sigradient {
  position: absolute;
  width: 100%;
  height: 100%;
  --start-colour: var(--skin-action-primary-background);
  --end-colour: var(--skin-action-primary-background);
  left: 0;
  top: 0;
  flex-grow: 1;
  overflow: hidden;
}

/* Primary button gradient.
 * Draws the gradient over the button surface. Change both stops here for a flat action colour.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1340.
 */
.buttons-hero-toggle-buttons-active--border-radius-none .sigradient,
.buttons-hero-toggle-buttons-active--border-radius-left .sigradient,
.buttons-hero-toggle-buttons-active--border-radius-right .sigradient {
  position: absolute;
  width: 100%;
  height: 100%;
  --start-colour: var(--skin-selection-background);
  --end-colour: var(--skin-selection-background);
  left: 0;
  top: 0;
  flex-grow: 1;
  overflow: hidden;
}

/* Primary button gradient.
 * Draws the gradient over the button surface. Change both stops here for a flat action colour.
 * Source rule 1341.
 */
.buttons-button-primary-default .sigradient {
  border-radius: var(--skin-radius-control);
}

/* Shared floating host. This later native rule must agree with core.uss;
 * using the small control radius here leaves square wedges behind calendars.
 * Source rule 1341.
 */
.floating-element {
  border-radius: var(--skin-popup-radius);
}

/* Primary button gradient — pressed.
 * sets the gradient colours drawn by this component.
 * Source rule 1342.
 */
.buttons-button-primary-default:active:enabled .sigradient {
  --start-colour: var(--skin-action-primary-pressed);
  --end-colour: var(--skin-action-primary-pressed);
}

/* Primary button gradient — pressed.
 * sets the gradient colours drawn by this component.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1342.
 */
.buttons-hero-toggle-buttons-active--border-radius-none:active:enabled .sigradient,
.buttons-hero-toggle-buttons-active--border-radius-left:active:enabled .sigradient,
.buttons-hero-toggle-buttons-active--border-radius-right:active:enabled .sigradient {
  --start-colour: var(--skin-selection-background);
  --end-colour: var(--skin-selection-background);
}

/* Primary action hover/press retains dark Dugout ink for native icons as well as labels.
 */
.buttons-button-primary-default:active:enabled {
  background-color: var(--skin-action-primary-pressed);
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Filled segmented controls use monochrome action glyphs. Native SIImage
 * leaves do not read the parent text/icon variables; tint those leaves while
 * the selected control is enabled, preserving inactive/disabled artwork. */
.buttons-segmented-button-row-active-regular-placement-leading:enabled .unity-image,
.buttons-segmented-button-row-active-regular-placement-middle:enabled .unity-image,
.buttons-segmented-button-row-active-regular-placement-trailing:enabled .unity-image {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* ManagerCreationScreen's appearance tabs use plain concept-art leaves rather
 * than unity-image. These four monochrome glyphs share the selected tab ink;
 * portraits and other image children remain untinted. Selected disabled tabs
 * retain their Volt surface, so their glyph keeps the same paired foreground. */
.manager-creation-tab-button.buttongroup__button--active > .game-concepts-presets,
.manager-creation-tab-button.buttongroup__button--active > .game-concepts-body,
.manager-creation-tab-button.buttongroup__button--active > .game-concepts-head,
.manager-creation-tab-button.buttongroup__button--active > .game-concepts-attire {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* Hero add controls are filled actions despite their native "inactive" name.
 * Tint the stock plus only; routine thumbnails and other art remain intact. */
.buttons-hero-toggle-buttons-inactive--border-radius-left:enabled .ui-concepts-plus_large,
.buttons-hero-toggle-buttons-inactive--border-radius-none:enabled .ui-concepts-plus_large,
.buttons-hero-toggle-buttons-inactive--border-radius-right:enabled .ui-concepts-plus_large {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* Primary dropdown chevrons are plain VisualElement artwork rather than SIImage. */
.dropdown-primary-default:enabled .ui-concepts-chevron-down_small {
  -unity-background-image-tint-color: var(--skin-action-primary-foreground);
}

/* Named Unity image leaves and the plain VisualElement tick/person/chevron icons
 * used by context actions need their own tint because a direct
 * image colour does not inherit the button's icon variables. Keep its colour
 * paired with the Volt action in every enabled state, including hover/press;
 * explicitly restore the disabled action foreground when the control is off.
 * Message-footer actions can use different image leaves and need their own
 * verified selector in the owning message component sheet. */
.buttons-button-primary-default:enabled #Icon.unity-image,
.buttons-button-primary-default:enabled #leading-icon.unity-image,
.buttons-button-primary-default:enabled #trailing-icon.unity-image,
.buttons-button-primary-default:enabled .ui-concepts-tick_small,
.buttons-button-primary-default:enabled .ui-concepts-person_small,
.buttons-button-primary-default:enabled .ui-concepts-add-to-list_small,
.buttons-button-primary-default:enabled .ui-concepts-chevron-down_small {
  -unity-background-image-tint-color: var(--skin-action-primary-foreground);
}

.buttons-button-primary-default:disabled #Icon.unity-image,
.buttons-button-primary-default:disabled #leading-icon.unity-image,
.buttons-button-primary-default:disabled #trailing-icon.unity-image,
.buttons-button-primary-default:disabled .ui-concepts-tick_small,
.buttons-button-primary-default:disabled .ui-concepts-person_small,
.buttons-button-primary-default:disabled .ui-concepts-add-to-list_small,
.buttons-button-primary-default:disabled .ui-concepts-chevron-down_small {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

/* Primary action button — pressed.
 * sets the background fill.
 * Source rule 1343.
 */
.dropdown-primary-default .si-dropdown__selection-field:active:enabled {
  background-color: var(--skin-action-primary-pressed);
}

/* Primary action button — pressed.
 * sets the background fill.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1343.
 */
.buttons-quick-action-primary.is_active,
.tutorial-floating-continue-button-continue-part:hover,
.tutorial-floating-continue-button-continue-part:active:enabled,
.speakto-button-interaction-button-choices-primary:active:enabled {
  background-color: var(--skin-action-primary-background);
  color: var(--skin-action-primary-foreground);
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Primary action button — disabled.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1344.
 */
.buttons-button-primary-default:disabled,
.dropdown-primary-default .si-dropdown__selection-field:disabled,
.buttons-quick-action-primary:disabled {
  border-color: var(--skin-action-disabled-border);
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-action-disabled-foreground);
}

/* Primary button gradient — pointer hover.
 * sets the gradient colours drawn by this component.
 * Source rule 1345.
 */
.buttons-button-primary-default:hover:enabled .sigradient {
  --start-colour: var(--skin-action-primary-hover);
  --end-colour: var(--skin-action-primary-hover);
}

/* Primary button gradient — pointer hover.
 * sets the gradient colours drawn by this component.
 * Source rule 1345.
 */
.buttons-hero-toggle-buttons-active--border-radius-none:hover .sigradient {
  --start-colour: var(--skin-selection-hover);
  --end-colour: var(--skin-selection-hover);
}

/* Primary action button — pointer hover.
 * sets the background fill.
 * Shared rule for 7 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1346.
 */
.buttons-button-primary-default:hover:enabled,
.dropdown-primary-default .si-dropdown__selection-field:hover:enabled,
.inputs-combobox-default-default-primary .si-dropdown__selection-field:hover:enabled,
.dashboard-hud-additional-buttons:active:enabled,
.dashboard-hud-search-button:active:enabled,
.speakto-button-interaction-button-choices-primary:hover,
.inputs-date_picker-day-default-active-true .date-selector-grid-element__active:hover {
  background-color: var(--skin-action-primary-hover);
  color: var(--skin-action-primary-foreground);
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* A pressed pointer is also hovering: keep the pressed fill and its gradient
 * ahead of the enabled hover treatment without affecting disabled controls. */
.buttons-button-primary-default:hover:active:enabled {
  background-color: var(--skin-action-primary-pressed);
}
.buttons-button-primary-default:hover:active:enabled .sigradient {
  --start-colour: var(--skin-action-primary-pressed);
  --end-colour: var(--skin-action-primary-pressed);
}

/* Buttons button primary tactics.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 1347.
 */
.buttons-button-primary-tactics {
  height: var(--buttons-global-height-regular);
  margin: var(--global-gap-none) var(--global-gap-close);
  padding: var(--global-padding-none);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-data-buttons-button-primary-tactics-border-color);
  background-color: var(--skin-data-buttons-button-primary-tactics-background);
  align-items: center;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
