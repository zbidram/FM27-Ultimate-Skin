  -unity-text-align: middle-left;
}

/* Buttons button base soft default size small.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1325.
 */
.buttons-button-base-soft-default--size-sm {
  display: flex;
  height: var(--interaction-global-height-sm, 24px);
  margin: var(--global-gap-close, 4px);
  padding: 0 var(--interaction-global-padding-horizontal-md, 8px);
  border-width: var(--global-border-regular, 1px);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  max-height: 32px;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
  justify-content: center;
}

/* Buttons button base soft default size small.
 * Shows these elements; sets the background fill; sets the outline/corner shape; controls size/placement.
 * Source rule 1325.
 */
.ige-dropdown-action-button .si-dropdown__selection-field {
  display: flex;
  height: var(--interaction-global-height-sm, 24px);
  margin: var(--global-gap-close, 4px);
  padding: 0 var(--interaction-global-padding-horizontal-md, 8px);
  border-width: var(--global-border-regular, 1px);
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-control-background);
  max-height: 32px;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--interaction-global-radius-md, var(--skin-radius-small));
  justify-content: center;
}

/* Buttons button base soft — pressed.
 * sets the background fill.
 * Source rule 1326.
 */
.buttons-button-base-soft:active:enabled {
  background-color: var(--skin-control-pressed);
}

/* Buttons button base soft — disabled.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape.
 * Source rule 1327.
 */
.buttons-button-base-soft:disabled {
  border-color: var(--skin-border-subtle);
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-text-disabled);
}

/* Buttons button compare player.
 * sets the outline/corner shape; controls size/placement; sets spacing around/inside the element; defines
 * how state changes animate.
 * Source rule 1328.
 */
.buttons-button-compare-player {
  width: 32px;
  height: 32px;
  margin: 0;
  padding: 0 var(--spacing-padding-small---8);
  border-width: 1px;
  border-color: var(--layout-ui-cell-focus-default-border);
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  transition: background-color var(--global-transition-buttons) var(--global-transition-animation-buttons);
}

/* Buttons button compare player.
 * sets the background fill.
 * Shared rule for 16 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1329.
 */
.buttons-button-compare-player,
.data_display-cell-player-header,
.data_display-cell-player-header-override #ActiveClubButton,
.calendar-week-training-active,
.layout-tile-interaction-states-universal-size:hover,
.playing-time-stepper-cell-active,
.inputs-switch-checkbox-default-switch-false--icon-none:hover,
.streamed-table__checkbox:hover:enabled,
.data_display-cell-icon-and-double-string-regular:hover,
.data_display-cell-icon-and-string-regular:hover,
.data_display-cell-radial-gauge-single-string-regular:hover,
.data_display-sicell-substitute:hover,
.data_display-cell-standard-warning--type-standard:hover,
.data_display-cell-standard-small--type-small:hover,
.data_display-cell-ability-small-link-true:hover,
.data_display-cell-icon-and-string-small:hover {
  background-color: var(--skin-surface-panel);
}

/* Buttons button compare player — pressed.
 * sets the background fill.
 * Shared rule for 5 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1330.
 */
.buttons-button-compare-player:active:enabled,
.data_display-cell-player-header:active:enabled,
.data_display-cell-accent-with-icon-double-string-regular:active:enabled,
.data_display-cell-accent-with-icon-regular:active:enabled,
.data_display-cell-string-stepper-regular:active:enabled {
  background-color: var(--skin-control-pressed);
}

/* Buttons button compare player — pointer hover.
 * sets the background fill.
 * Shared rule for 15 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1331.
 */
.buttons-button-compare-player:hover,
.data_display-cell-ability-small-link-true:active:enabled,
.data_display-cell-icon-and-string-small:active:enabled,
.data_display-cell-icon-and-double-string-regular:active:enabled,
.data_display-cell-icon-and-string-regular:active:enabled,
.data_display-cell-radial-gauge-single-string-regular:active:enabled,
.data_display-cell-accent-with-icon-double-string-regular:hover,
.data_display-cell-accent-with-icon-regular:hover,
.data_display-sicell-substitute:active:enabled,
.data_display-cell-string-stepper-regular:hover,
.data_display-cell-standard-warning--type-standard:active:enabled,
.data_display-cell-standard-small--type-small:active:enabled,
.embedded-button-misc:active:enabled,
.calendar-training-session-edit-session-element:hover,
.calendar-training-session-gradient-element:hover {
