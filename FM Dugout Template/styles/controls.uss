}

/* Unity toggle input — pressed, checked/selected.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2608.
 */
.inputs-switch-toggle-large-default-switch-true--type-on-warning:checked:active:enabled .unity-toggle__input {
  border-color: var(--colours-base-orange-strong);
  background-color: var(--skin-on-media-alpha-16);
}

/* Unity toggle checkmark — pointer hover, checked/selected.
 * sets the background fill; tints background artwork; sets the outline/corner shape.
 * Source rule 2609.
 */
.inputs-switch-toggle-large-default-switch-true--type-on-warning:checked:hover .unity-toggle__input:checked:hover:enabled .unity-toggle__checkmark {
  border-color: var(--interaction-input-switch-active-surface-warning);
  background-color: var(--interaction-input-switch-active-surface-warning);
  -unity-background-image-tint-color: var(--skin-ink);
}

/* Shared ordinary switch states. The input and knob paint rules above read
 * these local roles; native dimensions, checked position and warning variants
 * remain owned by their existing templates. Pressed follows hover. */
.inputs-switch-toggle-default-switch-false:enabled,
.inputs-switch-toggle-default-switch-table:enabled,
.inputs-switch-toggle-large-default-switch-true--type-default:enabled {
  --skin-switch-track-current: var(--skin-switch-track-background);
  --skin-switch-edge-current: var(--skin-border-default);
  --skin-switch-marker-current: var(--skin-switch-off-marker);
}

.inputs-switch-toggle-default-switch-false:checked:enabled,
.inputs-switch-toggle-default-switch-table:checked:enabled,
.inputs-switch-toggle-large-default-switch-true--type-default:checked:enabled {
  --skin-switch-edge-current: var(--skin-switch-on-marker);
  --skin-switch-marker-current: var(--skin-switch-on-marker);
}

.inputs-switch-toggle-default-switch-false:hover:enabled,
.inputs-switch-toggle-default-switch-table:hover:enabled,
.inputs-switch-toggle-large-default-switch-true--type-default:hover:enabled {
  --skin-switch-track-current: var(--skin-switch-track-hover);
}

.inputs-switch-toggle-default-switch-false:checked:hover:enabled,
.inputs-switch-toggle-default-switch-table:checked:hover:enabled,
.inputs-switch-toggle-large-default-switch-true--type-default:checked:hover:enabled {
  --skin-switch-edge-current: var(--skin-switch-on-hover);
  --skin-switch-marker-current: var(--skin-switch-on-hover);
}

.inputs-switch-toggle-default-switch-false:active:enabled,
.inputs-switch-toggle-default-switch-table:active:enabled,
.inputs-switch-toggle-large-default-switch-true--type-default:active:enabled {
  --skin-switch-track-current: var(--skin-switch-track-pressed);
}

.inputs-switch-toggle-default-switch-false:checked:active:enabled,
.inputs-switch-toggle-default-switch-table:checked:active:enabled,
.inputs-switch-toggle-large-default-switch-true--type-default:checked:active:enabled {
  --skin-switch-edge-current: var(--skin-switch-on-pressed);
  --skin-switch-marker-current: var(--skin-switch-on-pressed);
}

.inputs-switch-toggle-default-switch-false.sicheckbox:focus:enabled,
.inputs-switch-toggle-default-switch-table.sicheckbox:focus:enabled,
.inputs-switch-toggle-large-default-switch-true--type-default.sicheckbox:focus:enabled {
  --skin-switch-edge-current: var(--skin-focus-ring);
}

.inputs-switch-toggle-default-switch-false:disabled,
.inputs-switch-toggle-default-switch-table:disabled,
.inputs-switch-toggle-large-default-switch-true--type-default:disabled {
  --skin-switch-track-current: var(--skin-action-disabled-background);
  --skin-switch-edge-current: var(--skin-border-subtle);
  --skin-switch-marker-current: var(--skin-text-disabled);
}

.inputs-switch-toggle-default-switch-false.sicheckbox .unity-toggle__input,
.inputs-switch-toggle-default-switch-table.sicheckbox .unity-toggle__input,
.inputs-switch-toggle-large-default-switch-true--type-default.sicheckbox .unity-toggle__input {
  border-color: var(--skin-switch-edge-current);
  background-color: var(--skin-switch-track-current);
}

.inputs-switch-toggle-default-switch-false.sicheckbox .unity-toggle__input:enabled .unity-toggle__checkmark,
.inputs-switch-toggle-default-switch-table.sicheckbox .unity-toggle__input:enabled .unity-toggle__checkmark,
.inputs-switch-toggle-large-default-switch-true--type-default.sicheckbox .unity-toggle__input:enabled .unity-toggle__checkmark {
  border-color: var(--skin-switch-marker-current);
  background-color: var(--skin-switch-marker-current);
}

.inputs-switch-toggle-default-switch-false.sicheckbox:disabled .unity-toggle__input .unity-toggle__checkmark,
.inputs-switch-toggle-default-switch-table.sicheckbox:disabled .unity-toggle__input .unity-toggle__checkmark,
.inputs-switch-toggle-large-default-switch-true--type-default.sicheckbox:disabled .unity-toggle__input .unity-toggle__checkmark {
  border-color: var(--skin-switch-marker-current);
  background-color: var(--skin-switch-marker-current);
}

/* Bindableeditbox.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2610.
 */
.inputs-text-field-default-default-validation-default .bindableeditbox {
  width: 120px;
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-field-border);
  background-color: var(--skin-field-background);
  color: var(--skin-field-foreground);
  transition: background-color 0.15s ease-in, border-color 0.15s ease-in, color 0.15s ease-in;
  padding-top: var(--global-padding-new-ex);
  padding-right: var(--global-padding-large);
  padding-bottom: var(--global-padding-new-ex);
  padding-left: var(--global-padding-large);
  justify-content: space-between;
  align-items: center;
  align-self: stretch;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
}

/* Inputs text field default fill available width.
 * controls size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2611.
 */
.inputs-text-field-default-fill-available-width,
.bindable-edit-box-field {
  flex-grow: 1;
  align-self: stretch;
}

/* Inputs text field default medium type filled.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2612.
 */
.inputs-text-field-default-medium--type-filled {
  padding: var(--spacing-padding-small---8) 0;
  min-width: 120px;
  flex-direction: column;
  align-items: flex-start;
  align-self: stretch;
}

/* Inputs text field default medium additional comments.
 * sets the background fill; controls size/placement.
 * Source rule 2613.
 */
.inputs-text-field-default-medium-additional-comments {
  height: 64px;
  background-color: var(--skin-transparent);
}

/* Inputs text field default small validation default type filled.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2614.
 */
.inputs-text-field-default-small-validation-default-type-filled {
  width: 52px;
  height: 32px;
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-transparent);
  padding-top: var(--global-padding-new-ex);
  padding-right: var(--global-padding-regular);
  padding-bottom: var(--global-padding-new-ex);
  padding-left: var(--global-padding-regular);
  justify-content: space-between;
  align-items: center;
  align-self: center;
  border-radius: var(--global-radius-small);
  flex-direction: var(--row-direction-normal);
}

/* Selected surface and label use the paired Volt/ink tokens from the default Dugout theme.
 */
.input-squad-planner-data-point-regular-type-ability-mode-light-active-false .sitext,
.input-squad-planner-data-point-regular-type-ability-mode-light-active-false .sitextmedium,
.input-squad-planner-data-point-regular-type-ability-mode-light-active-false .sitextsmall,
.input-squad-planner-data-point-regular-type-ability-mode-mixed-active-true .sitext,
.input-squad-planner-data-point-regular-type-ability-mode-mixed-active-true .sitextmedium,
.input-squad-planner-data-point-regular-type-ability-mode-mixed-active-true .sitextsmall,
.input-squad-planner-data-point-regular-type-depth-mode-mixed-active-true .sitext,
.input-squad-planner-data-point-regular-type-depth-mode-mixed-active-true .sitextmedium,
.input-squad-planner-data-point-regular-type-depth-mode-mixed-active-true .sitextsmall,
.input-squad-planner-data-point-regular-type-position-mode-mixed-active-true .sitext,
.input-squad-planner-data-point-regular-type-position-mode-mixed-active-true .sitextmedium,
.input-squad-planner-data-point-regular-type-position-mode-mixed-active-true .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Plain form radios indicate selection with a circle, not a filled row.
 * Override the generic radio selection/hover treatment as one shared family.
 * Nested inactive fields retain native disabled opacity; segmented buttons
 * and other deliberately filled choices keep their separate Volt pairing. */
.vertical-radio-group .radio-button-element-no-border:enabled,
.vertical-radio-group .radio-button-element-no-border.unity-radio-button-group__child-active:enabled {
  background-color: var(--skin-choice-background);
  color: var(--skin-choice-foreground);
  /* Standalone rows own their paint shape in every state; table joins do not. */
  border-radius: var(--skin-choice-radius);
}
.vertical-radio-group .radio-button-element-no-border:hover:enabled {
  --skin-choice-background: var(--skin-choice-hover);
  background-color: var(--skin-choice-background);
}
.vertical-radio-group .radio-button-element-no-border:active:enabled {
  --skin-choice-background: var(--skin-choice-pressed);
  background-color: var(--skin-choice-background);
}
/* Disabled rows keep their native dimming and do not acquire a hover fill. */
.vertical-radio-group .radio-button-element-no-border:disabled {
  background-color: var(--skin-choice-background);
  color: var(--skin-choice-foreground);
}
.vertical-radio-group .unity-radio-button.radio-button-element-no-border:enabled .sitext,
.vertical-radio-group .unity-radio-button.radio-button-element-no-border:enabled .sitextmedium,
.vertical-radio-group .unity-radio-button.radio-button-element-no-border:enabled .sitextsmall,
.vertical-radio-group .radio-button-element-no-border:disabled .sitext,
.vertical-radio-group .radio-button-element-no-border:disabled .sitextmedium,
.vertical-radio-group .radio-button-element-no-border:disabled .sitextsmall {
  color: var(--skin-choice-foreground);
}
.vertical-radio-group .radio-button-element-no-border:enabled .unity-radio-button__checkmark {
  background-color: var(--skin-choice-marker);
  border-color: var(--skin-choice-marker);
}
.vertical-radio-group .radio-button-element-no-border:focus:enabled .unity-radio-button__checkmark-background {
  border-color: var(--skin-focus-ring);
}

/* Standalone form checkboxes: Volt belongs to the 16px checked square only.
 * The tick uses its paired ink through hover/press, rather than white artwork
 * on Volt. Keep native disabled rules and checkbox-as-button variants separate. */
.inputs-switch-checkbox-default-switch-false--icon-none:checked:enabled {
  background-color: var(--skin-choice-marker);
  border-color: var(--skin-choice-marker);
}
.inputs-switch-checkbox-default-switch-false--icon-none:checked:hover:enabled {
  background-color: var(--skin-selection-hover);
}
.sicheckbox.inputs-switch-checkbox-default-switch-false--icon-none:checked:active:enabled {
  background-color: var(--skin-action-primary-pressed);
}
.inputs-switch-checkbox-default-switch-false--icon-none:checked:enabled .unity-toggle__checkmark,
.inputs-switch-checkbox-default-switch-false--icon-none:checked:hover:enabled .unity-toggle__checkmark,
.inputs-switch-checkbox-default-switch-false--icon-none:checked:active:enabled .unity-toggle__checkmark {
  background-color: var(--skin-transparent);
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.inputs-switch-checkbox-default-switch-false--icon-none:focus:enabled {
  border-color: var(--skin-focus-ring);
}

/* Keyboard focus changes the edge, not the surface's foreground role. Keep
 * focus visible without turning neutral dropdowns/secondary actions Volt. */
.buttons-dropdown-base-regular .si-dropdown__selection-field:hover:active:enabled {
  background-color: var(--skin-control-pressed);
}
.buttons-button-primary-default:focus:enabled,
.buttons-button-secondary-default:focus:enabled,
.buttons-dropdown-base-regular .si-dropdown__selection-field:focus:enabled {
  border-color: var(--skin-focus-ring);
}

/* Runtime segmented controls retain both active and inactive classes.
 * Keep selected paint paired after the inactive defaults, including held states. */
.sibutton.buttons-segmented-button-row-active-regular-placement-leading,
.sibutton.buttons-segmented-button-row-active-regular-placement-middle,
.sibutton.buttons-segmented-button-row-active-regular-placement-trailing,
.sibutton.buttons-segmented-button-row-active-small-placement-leading,
.sibutton.buttons-segmented-button-row-active-small-placement-middle,
.sibutton.buttons-segmented-button-row-active-small-placement-trailing {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}
.sibutton.buttons-segmented-button-row-active-regular-placement-leading:hover:enabled,
.sibutton.buttons-segmented-button-row-active-regular-placement-middle:hover:enabled,
.sibutton.buttons-segmented-button-row-active-regular-placement-trailing:hover:enabled,
.sibutton.buttons-segmented-button-row-active-small-placement-leading:hover:enabled,
.sibutton.buttons-segmented-button-row-active-small-placement-middle:hover:enabled,
.sibutton.buttons-segmented-button-row-active-small-placement-trailing:hover:enabled {
  background-color: var(--skin-selection-hover);
  color: var(--skin-selection-foreground);
}
.sibutton.buttons-segmented-button-row-active-regular-placement-leading:active:enabled,
.sibutton.buttons-segmented-button-row-active-regular-placement-middle:active:enabled,
.sibutton.buttons-segmented-button-row-active-regular-placement-trailing:active:enabled,
.sibutton.buttons-segmented-button-row-active-small-placement-leading:active:enabled,
.sibutton.buttons-segmented-button-row-active-small-placement-middle:active:enabled,
.sibutton.buttons-segmented-button-row-active-small-placement-trailing:active:enabled {
  background-color: var(--skin-selection-pressed);
  color: var(--skin-selection-foreground);
}

/* Held pointer feedback must win over hover on unselected segmented controls.
 * Explicit active classes above retain their paired Volt selection role. */
.buttons-segmented-button-row-inactive-regular-placement-leading:active:enabled,
.buttons-segmented-button-row-inactive-regular-placement-middle:active:enabled,
.buttons-segmented-button-row-inactive-regular-placement-trailing:active:enabled,
.buttons-segmented-button-row-inactive-small-placement-leading:active:enabled,
.buttons-segmented-button-row-inactive-small-placement-middle:active:enabled,
.buttons-segmented-button-row-inactive-small-placement-trailing:active:enabled {
  background-color: var(--skin-control-pressed);
}

/* Older secondary dropdowns paint their field separately from the label and
 * chevron (for example Change Captain). FM's generic visual-highlighted fill
 * otherwise puts Volt behind siblings that retain primary ink. Secondary
 * controls stay neutral when hovered/open; primary actions keep their own pair.
 * The single-icon binding template exposes its family as a name, not a class
 * (verified on Recruitment feedback); cover that reusable root explicitly. */
#buttons-dropdown-icon-base-default-single-icon .si-dropdown__selection-field {
  background-color: var(--skin-control-background);
  border-width: var(--global-border-regular);
  border-color: var(--skin-border-subtle);
  color: var(--skin-text-primary);
}
.dropdown-secondary-default:hover:enabled .si-dropdown__selection-field:enabled,
.dropdown-secondary-default .si-dropdown__selection-field.visual-highlighted:enabled,
#buttons-dropdown-icon-base-default-single-icon .si-dropdown__selection-field:hover:enabled,
#buttons-dropdown-icon-base-default-single-icon .si-dropdown__selection-field.visual-highlighted:enabled {
  background-color: var(--skin-control-hover);
  border-color: var(--skin-text-secondary);
}
.dropdown-secondary-default:active:enabled .si-dropdown__selection-field:enabled,
.dropdown-secondary-default .si-dropdown__selection-field:active:enabled,
#buttons-dropdown-icon-base-default-single-icon .si-dropdown__selection-field:active:enabled {
  background-color: var(--skin-control-pressed);
  border-color: var(--skin-border-default);
}

/* Primary combobox chevrons use the action foreground; only the shared
 * chevron glyph is tintable here, leaving option artwork untouched. */
.inputs-combobox-default-default-primary:enabled .ui-concepts-chevron-down_small {
  -unity-background-image-tint-color: var(--skin-action-primary-foreground);
}
.inputs-combobox-default-default-primary:disabled .ui-concepts-chevron-down_small {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}


/* Filled horizontal choices need dark radio marks on the selection surface.
 * Plain vertical form choices retain their separate neutral-row/Volt-dot role. */
.segmented-button-group.horizontal-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark-background,
.segmented-horizontal-radio-group.horizontal-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark-background {
  background-color: var(--skin-transparent);
  border-color: var(--skin-selection-foreground);
}
.segmented-button-group.horizontal-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark,
.segmented-horizontal-radio-group.horizontal-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark {
  background-color: var(--skin-selection-foreground);
  border-color: var(--skin-selection-foreground);
}

/* Overview summary controls use neutral card depth across modules. Both native
 * gradient layers contain only paint, not the action text or icon. */
.control_bar_button {
  background-color: var(--skin-control-summary-background);
  border-radius: var(--skin-radius-card);
}
.control_bar_button:hover:enabled {
  background-color: var(--skin-control-summary-hover);
}
.control_bar_button:active:enabled {
  background-color: var(--skin-control-summary-pressed);
}
.control_bar_button:disabled,
.control_bar_button:hover:disabled,
.control_bar_button:active:disabled {
  background-color: var(--skin-control-summary-background);
}
.control_bar_button > .control_bar_wrapper_border {
  border-width: var(--skin-card-border-width);
  border-color: var(--skin-card-border-colour);
  border-radius: var(--skin-radius-card);
}
.control_bar_button > #SIGradient.sigradient,
.control_bar_button > .control_bar_wrapper {
  opacity: var(--skin-control-summary-overlay-opacity);
}
.control_bar_button .badge-icon-regular-lift {
  background-color: var(--skin-control-summary-icon-background);
  border-radius: var(--skin-radius-small);
}

/* Large radio cards are browse/filter choices, not primary actions. Keep their
 * content neutral; the selected outline carries Volt without washing the card. */
.vertical-radio-group .unity-radio-button.sicontainer_horizontal_align,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-regular-active-false--type-default,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-large-active-false--type-default {
  background-color: var(--skin-choice-card-background);
  color: var(--skin-choice-foreground);
  border-color: var(--skin-border-subtle);
}
.vertical-radio-group .unity-radio-button.sicontainer_horizontal_align.unity-radio-button-group__child-active:enabled,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-regular-active-false--type-default.unity-radio-button-group__child-active:enabled,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-large-active-false--type-default.unity-radio-button-group__child-active:enabled {
  background-color: var(--skin-choice-card-selected);
  border-color: var(--skin-choice-marker);
}
.vertical-radio-group .unity-radio-button.sicontainer_horizontal_align:hover:enabled,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-regular-active-false--type-default:hover:enabled,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-large-active-false--type-default:hover:enabled {
  background-color: var(--skin-control-hover);
}
.vertical-radio-group .unity-radio-button.sicontainer_horizontal_align:active:enabled,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-regular-active-false--type-default:active:enabled,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-large-active-false--type-default:active:enabled {
  background-color: var(--skin-control-pressed);
}
.vertical-radio-group .unity-radio-button.sicontainer_horizontal_align:enabled .sitext {
  color: var(--skin-choice-foreground);
}
.vertical-radio-group .unity-radio-button.sicontainer_horizontal_align:enabled .global-text-secondary {
  color: var(--skin-text-secondary);
}
/* Transfer/task browse cards use the same selection ink aliases in nested
 * status labels. Preserve their directional/domain icons on the neutral card. */
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-regular-active-false--type-default,
.vertical-radio-group .unity-radio-button.inputs-hybrid-task_switch_button-large-active-false--type-default {
  --skin-selection-foreground: var(--skin-choice-foreground);
  --skin-selection-background: var(--skin-choice-card-selected);
}
/* Generated selected-tab gradients can retain bound dark paint even when
 * their colour variables are transparent. This direct child is paint only. */
.buttongroup.SegmentedButtonRow .buttongroup__button--active > .sigradient {
  opacity: var(--skin-segmented-overlay-opacity);
}

/* Pitch tiles select a data view. Neutral selected paint keeps gold ability
 * stars legible; the Volt outline identifies the current position. Native
 * selected/hover label rules read these component-local selection aliases. */
.input-squad-planner-data-point-regular-type-ability-mode-dark-active-false,
.input-squad-planner-data-point-regular-type-ability-mode-light-active-false,
.input-squad-planner-data-point-regular-type-ability-mode-mixed-active-true,
.input-squad-planner-data-point-regular-type-depth-mode-dark-active-false,
.input-squad-planner-data-point-regular-type-position-mode-dark-active-false,
.input-squad-planner-data-point-regular-type-depth-mode-mixed-active-true,
.input-squad-planner-data-point-regular-type-position-mode-mixed-active-true {
  --skin-selection-background: var(--skin-planner-point-selected);
  --skin-selection-hover: var(--skin-control-hover);
  --skin-selection-foreground: var(--skin-text-primary);
}
.input-squad-planner-data-point-upper-frame-backgroud {
  background-color: var(--skin-transparent);
}

/* List/Position view switches instantiate plain concept glyphs, not SIImage.
 * Native PersonSearchTableTopSection names both monochrome leaves Tick; pair
 * only those verified glyphs with the filled segmented state, never club art. */
.buttons-segmented-button-row-active-regular-placement-leading:enabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-regular-placement-leading:enabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-regular-placement-middle:enabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-regular-placement-middle:enabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-regular-placement-trailing:enabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-regular-placement-trailing:enabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-small-placement-leading:enabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-small-placement-leading:enabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-small-placement-middle:enabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-small-placement-middle:enabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-small-placement-trailing:enabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-small-placement-trailing:enabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.buttons-segmented-button-row-active-regular-placement-leading:disabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-regular-placement-leading:disabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-regular-placement-middle:disabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-regular-placement-middle:disabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-regular-placement-trailing:disabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-regular-placement-trailing:disabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-small-placement-leading:disabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-small-placement-leading:disabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-small-placement-middle:disabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-small-placement-middle:disabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small,
.buttons-segmented-button-row-active-small-placement-trailing:disabled #Tick.game-concepts-shortlist_small,
.buttons-segmented-button-row-active-small-placement-trailing:disabled #Tick.game-concepts-tactics-visualiser-suitability-positions_small {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}


/* Owner fields are status/selection controls, separate from Control/Delegate
 * actions. Tint only the verified chevron, never the staff portrait. */
.buttons-dropdown-icon-base-responsibilities-primary #SIDropdown_AssignableStaff:enabled .sitext {
  color: var(--skin-responsibility-owner-foreground);
}
.buttons-dropdown-icon-base-responsibilities-primary #SIDropdown_AssignableStaff:enabled .ui-concepts-chevron-down_small {
  -unity-background-image-tint-color: var(--skin-responsibility-owner-foreground);
}
.buttons-dropdown-icon-base-responsibilities-primary #SIDropdown_AssignableStaff:hover:enabled .si-dropdown__selection-field {
  background-color: var(--skin-responsibility-owner-hover);
}
.buttons-dropdown-icon-base-responsibilities-primary #SIDropdown_AssignableStaff:active:enabled .si-dropdown__selection-field {
  background-color: var(--skin-responsibility-owner-pressed);
}
.buttons-dropdown-icon-base-responsibilities-primary #SIDropdown_AssignableStaff:disabled .sitext {
  color: var(--skin-text-disabled);
}
.buttons-dropdown-icon-base-responsibilities-primary #SIDropdown_AssignableStaff:disabled .ui-concepts-chevron-down_small {
  -unity-background-image-tint-color: var(--skin-text-disabled);
}

/* Staff summary choices can contain names painted directly by game bindings.
 * Keep these cards neutral across selected/hover/press states; their accent
 * edge and radio mark communicate selection. Category navigation stays filled. */
#StaffResponsibilitiesOverview .frame-enabled-content-staff-resolution-low.unity-radio-button-group__child-active,
#StaffResponsibilitiesOverview .frame-enabled-content-staff-resolution-low:hover:enabled {
  background-color: var(--skin-responsibility-owner-background);
  border-color: var(--skin-responsibility-owner-border);
  color: var(--skin-responsibility-owner-foreground);
}
#StaffResponsibilitiesOverview .frame-enabled-content-staff-resolution-low:hover:enabled {
  background-color: var(--skin-responsibility-owner-hover);
}
#StaffResponsibilitiesOverview .frame-enabled-content-staff-resolution-low:active:enabled {
  background-color: var(--skin-responsibility-owner-pressed);
}
#StaffResponsibilitiesOverview .frame-enabled-content-staff-resolution-low.unity-radio-button:enabled .sitext {
  color: var(--skin-responsibility-owner-foreground);
}
#StaffResponsibilitiesOverview .frame-enabled-content-staff-resolution-low.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark-background {
  background-color: var(--skin-transparent);
  border-color: var(--skin-responsibility-owner-border);
}
#StaffResponsibilitiesOverview .frame-enabled-content-staff-resolution-low.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark {
  background-color: var(--skin-responsibility-owner-border);
  border-color: var(--skin-responsibility-owner-border);
}

/* Filled responsibility categories are navigation choices. Pair their verified
 * monochrome TabIcon and radio mark with selection ink; ordinary unselected
 * categories keep light marks on the neutral surface. */
.frame-enabled-content-responsibility-resolution-high.unity-radio-button-group__child-active:enabled #TabIcon,
.frame-enabled-content-responsibility-resolution-high:hover:enabled #TabIcon,
.frame-enabled-content-responsibility-resolution-high:active:enabled #TabIcon {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
.frame-enabled-content-responsibility-resolution-high.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark-background,
.frame-enabled-content-responsibility-resolution-high:hover:enabled .unity-radio-button__checkmark-background,
.frame-enabled-content-responsibility-resolution-high:active:enabled .unity-radio-button__checkmark-background {
  background-color: var(--skin-transparent);
  border-color: var(--skin-selection-foreground);
}
.frame-enabled-content-responsibility-resolution-high.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark,
.frame-enabled-content-responsibility-resolution-high:hover:enabled .unity-radio-button__checkmark,
.frame-enabled-content-responsibility-resolution-high:active:enabled .unity-radio-button__checkmark {
  background-color: var(--skin-selection-foreground);
  border-color: var(--skin-selection-foreground);
}

/* Dropdown-choice content is detached into the floating layer, so it cannot
 * inherit the owner field's class. Apply the shared neutral choice role here,
 * including retained child-menu highlights. Navigation's cascading-menu family
 * keeps its separate contract. Rich person-name paint can ignore USS colour;
 * neutral surfaces keep both that ink and ordinary USS labels readable. */
.si-dropdown__binding-root .sub-dropdown-content-container:hover:enabled,
.si-dropdown__binding-root .sub-dropdown-content-container.visual-highlighted:enabled {
  background-color: var(--skin-menu-choice-hover);
  color: var(--skin-menu-choice-foreground);
}
.si-dropdown__binding-root .sub-dropdown-content-container:active:enabled {
  background-color: var(--skin-menu-choice-pressed);
  color: var(--skin-menu-choice-foreground);
}
.si-dropdown__binding-root .sub-dropdown-content-container:hover:enabled .sitext,
.si-dropdown__binding-root .sub-dropdown-content-container.visual-highlighted:enabled .sitext,
.si-dropdown__binding-root .sub-dropdown-content-container:active:enabled .sitext {
  color: var(--skin-menu-choice-foreground);
}
.si-dropdown__binding-root .sub-dropdown-content-container:hover:enabled .indicator,
.si-dropdown__binding-root .sub-dropdown-content-container.visual-highlighted:enabled .indicator,
.si-dropdown__binding-root .sub-dropdown-content-container:active:enabled .indicator {
  -unity-background-image-tint-color: var(--skin-menu-choice-foreground);
}

/* Finance's period-tab binding retains transparent paint despite the generic
 * active fill matching in Dev Tools. Pair its ink with that actual neutral
 * surface and keep the selected period visible through the accent edge. */
#FinancesIncomeBreakdownBlock .buttongroup.SegmentedButtonRow,
#FinancesExpenditureBreakdwonBlock .buttongroup.SegmentedButtonRow {
  --skin-selection-background: var(--skin-finance-period-background);
  --skin-selection-hover: var(--skin-finance-period-hover);
  --skin-selection-pressed: var(--skin-finance-period-pressed);
  --skin-selection-foreground: var(--skin-finance-period-foreground);
}
#FinancesIncomeBreakdownBlock .buttongroup.SegmentedButtonRow .buttongroup__button--active,
#FinancesExpenditureBreakdwonBlock .buttongroup.SegmentedButtonRow .buttongroup__button--active {
  border-color: var(--skin-finance-period-border);
}

/* FMActionButton builds monochrome action artwork at runtime and its children
 * are beyond the inspector's depth limit. Tint this action-only factory, not
 * arbitrary primary buttons that may contain club or person artwork. */
#FMActionButton .buttons-button-primary-default:enabled * {
  -unity-background-image-tint-color: var(--skin-action-primary-foreground);
}
#FMActionButton .buttons-button-primary-default:disabled * {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

/* Milestone filters share filled horizontal radio buttons. Their verified
 * named icon is monochrome action artwork, separate from timeline club badges. */
.horizontal-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled #icon.unity-image,
.horizontal-radio-group .unity-radio-button:hover:enabled #icon.unity-image,
.horizontal-radio-group .unity-radio-button:active:enabled #icon.unity-image {
  -unity-background-image-tint-color: var(--skin-radio-action-foreground);
}
.horizontal-radio-group .unity-radio-button:disabled #icon.unity-image {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

.horizontal-radio-group .unity-radio-button:hover:enabled .unity-radio-button__checkmark-background,
.horizontal-radio-group .unity-radio-button:active:enabled .unity-radio-button__checkmark-background {
  background-color: var(--skin-transparent);
  border-color: var(--skin-radio-ring-foreground);
}

/* Radio marks inherit the role of the owning row even in groups that do
 * not carry horizontal/vertical layout classes. Visibility/geometry stay native. */
.unity-radio-button .unity-radio-button__checkmark-background {
  border-color: var(--skin-radio-ring-foreground);
}
.unity-radio-button .unity-radio-button__checkmark {
  background-color: var(--skin-radio-marker-foreground);
  border-color: var(--skin-radio-marker-foreground);
}
/* Pointer feedback is neutral until a choice is actually selected. These
 * shared roles also own text and monochrome marks, not just the row fill. */
.unity-radio-button:hover:enabled {
  --skin-selection-background: var(--skin-selection-hover);
  background-color: var(--skin-radio-hover-background);
  color: var(--skin-radio-interaction-foreground);
}
.unity-radio-button:active:enabled {
  --skin-selection-background: var(--skin-selection-pressed);
  background-color: var(--skin-radio-pressed-background);
  color: var(--skin-radio-interaction-foreground);
}
.unity-radio-button:hover:enabled .sitext,
.unity-radio-button:hover:enabled .sitextmedium,
.unity-radio-button:hover:enabled .sitextsmall,
.unity-radio-button:active:enabled .sitext,
.unity-radio-button:active:enabled .sitextmedium,
.unity-radio-button:active:enabled .sitextsmall {
  color: var(--skin-radio-interaction-foreground);
}

/* Detailed Preferences receives pointer events on its outer SI button; the
 * visible radio child may never get :hover or :active. Forward those states
 * through the same radio roles, preserving selected and disabled semantics. */
.fmc-preferences-radio-buttons.buttongroup__button:hover:enabled > .navigation-tab-settings.unity-radio-button {
  --skin-selection-background: var(--skin-selection-hover);
  background-color: var(--skin-radio-hover-background);
  color: var(--skin-radio-interaction-foreground);
}
.fmc-preferences-radio-buttons.buttongroup__button:active:enabled > .navigation-tab-settings.unity-radio-button {
  --skin-selection-background: var(--skin-selection-pressed);
  background-color: var(--skin-radio-pressed-background);
  color: var(--skin-radio-interaction-foreground);
}

/* Only selected filled choices use Volt interaction surfaces and dark ink.
 * Unselected options keep the shared neutral pointer roles, including glyphs. */
.segmented-button-group .unity-radio-button.unity-radio-button-group__child-active:enabled,
.segmented-button-group-purple .unity-radio-button.unity-radio-button-group__child-active:enabled,
.segmented-horizontal-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled,
.segmented-button-labels .unity-radio-button.unity-radio-button-group__child-active:enabled,
.radio_group_button_purple .unity-radio-button.unity-radio-button-group__child-active:enabled,
.settings_highlights_block .unity-radio-button.unity-radio-button-group__child-active:enabled,
.manager-coaching-badge-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled,
.game-creation-quick-setup-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled,
.quick_start-club-selection .unity-radio-button.unity-radio-button-group__child-active:enabled,
.button-active-manager-selection.unity-radio-button.unity-radio-button-group__child-active:enabled,
.tabgroup__tab-settings--active .navigation-tab-settings:enabled {
  --skin-radio-hover-background: var(--skin-selection-hover);
  --skin-radio-pressed-background: var(--skin-selection-pressed);
  --skin-radio-interaction-foreground: var(--skin-selection-foreground);
  --skin-radio-ring-foreground: var(--skin-selection-foreground);
  --skin-radio-marker-foreground: var(--skin-selection-foreground);
  --skin-radio-action-foreground: var(--skin-selection-foreground);
}

/* The manager-row class is used on every option, not only the current one.
 * Its neutral default is declared in core; only the selected row owns Volt. */
.button-active-manager-selection.unity-radio-button-group__child-active:enabled {
  background-color: var(--skin-selection-background);
  color: var(--skin-selection-foreground);
}
.button-active-manager-selection.unity-radio-button-group__child-active:enabled .sitext,
.button-active-manager-selection.unity-radio-button-group__child-active:enabled .sitextmedium,
.button-active-manager-selection.unity-radio-button-group__child-active:enabled .sitextsmall {
  color: var(--skin-selection-foreground);
}

/* Only the template's named edit/delete glyphs are monochrome actions.
 * PersonImage and other manager artwork deliberately do not match. */
.button-active-manager-selection #EditButton,
.button-active-manager-selection #EditButton_editsession,
.button-active-manager-selection #DeleteManagerButton {
  -unity-background-image-tint-color: var(--skin-radio-action-foreground);
}

/* Large background/role cards contain secondary copy and neutral dropdowns.
 * Keep their shared selection role neutral; the outline and dot carry Volt. */
.football-career-radio-group,
.non-playing-role-radio-group,
.manager-background-highest-level-radiogroup {
  --skin-selection-background: var(--skin-choice-card-selected);
  --skin-selection-hover: var(--skin-control-hover);
  --skin-selection-pressed: var(--skin-control-pressed);
  --skin-selection-foreground: var(--skin-choice-foreground);
}
.non-playing-role-radio-group .unity-radio-button {
  background-color: var(--skin-choice-card-background);
  border-color: var(--skin-border-subtle);
}
.non-playing-role-radio-group .unity-radio-button.unity-radio-button-group__child-active:enabled {
  background-color: var(--skin-choice-card-selected);
  border-color: var(--skin-choice-marker);
}
.non-playing-role-radio-group .unity-radio-button:hover:enabled {
  background-color: var(--skin-control-hover);
}
.non-playing-role-radio-group .unity-radio-button:active:enabled {
  background-color: var(--skin-control-pressed);
}
.non-playing-role-radio-group .unity-radio-button:enabled .global-text-secondary {
  color: var(--skin-text-secondary);
}

/* Disabled radios cannot acquire a live selection fill from hover/press.
 * Component-local roles also pair later native selected-label consumers. */
.segmented-button-group .unity-radio-button:disabled,
.segmented-button-group-purple .unity-radio-button:disabled,
.segmented-horizontal-radio-group .unity-radio-button:disabled,
.segmented-button-labels .unity-radio-button:disabled,
.radio_group_button_purple .unity-radio-button:disabled,
.settings_highlights_block .unity-radio-button:disabled,
.manager-coaching-badge-radio-group .unity-radio-button:disabled,
.game-creation-quick-setup-radio-group .unity-radio-button:disabled,
.quick_start-club-selection .unity-radio-button:disabled,
.non-playing-role-radio-group .unity-radio-button:disabled,
.football-career-radio-group .unity-radio-button:disabled,
.game-creation-radiogroup .unity-radio-button:disabled,
.navigation-tab-settings.unity-radio-button:disabled {
  --skin-selection-background: var(--skin-action-disabled-background);
  --skin-selection-foreground: var(--skin-text-disabled);
  --skin-radio-ring-foreground: var(--skin-text-disabled);
  --skin-radio-marker-foreground: var(--skin-text-disabled);
  --skin-radio-action-foreground: var(--skin-text-disabled);
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-text-disabled);
}
.unity-radio-button:disabled .sitext,
.unity-radio-button:disabled .sitextmedium,
.unity-radio-button:disabled .sitextsmall {
  color: var(--skin-text-disabled);
}

/* Preferences' active circle is a control glyph on a filled selection. */
.tabgroup__tab-settings--active .navigation-tab-settings-circle-empty-icon,
.tabgroup__tab-settings--active .navigation-tab-settings-circle-filled-icon {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}

/* Display-size choices share this monochrome icon family in Quick and Detailed
 * Preferences. Never tint unrelated segmented-control artwork. FM disables the
 * current choice's action but retains its Volt selection paint, so selected
 * icons keep paired ink even when that button is disabled. */
.ui-concepts-scaling-mode-large,
.ui-concepts-scaling-mode-medium,
.ui-concepts-scaling-mode-small {
  -unity-background-image-tint-color: var(--skin-preferences-scaling-icon-foreground);
}
.buttons-segmented-button-row-inactive-small-placement-leading:disabled,
.buttons-segmented-button-row-inactive-small-placement-middle:disabled,
.buttons-segmented-button-row-inactive-small-placement-trailing:disabled {
  --skin-preferences-scaling-icon-foreground: var(--skin-text-disabled);
}
.sibutton.buttons-segmented-button-row-active-small-placement-leading,
.sibutton.buttons-segmented-button-row-active-small-placement-middle,
.sibutton.buttons-segmented-button-row-active-small-placement-trailing {
  --skin-preferences-scaling-icon-foreground: var(--skin-selection-foreground);
}

/* Live Match highlight choices also carry settings_highlights_block, but their
 * vertical-radio-group contract gives them neutral cards. Re-pair only this
 * native combination; ordinary filled highlight controls keep selection ink.
 * Keep the pie-gauge artwork, marker geometry and disabled roles unchanged. */
.matchpreferences-radiogroup.settings_highlights_block .unity-radio-button:enabled {
  --skin-radio-hover-background: var(--skin-control-hover);
  --skin-radio-pressed-background: var(--skin-control-pressed);
  --skin-radio-interaction-foreground: var(--skin-text-primary);
  --skin-radio-ring-foreground: var(--skin-text-primary);
  --skin-radio-marker-foreground: var(--skin-choice-marker);
  --skin-radio-action-foreground: var(--skin-text-primary);
}


/* Shared ordinary text-entry states. The native focus selector lives in the
 * later screens sheet, so keep this default-validation family more specific.
 * Error/warning variants and embedded numeric controls retain their own roles. */
.inputs-text-field-default-default-validation-default:hover:enabled .bindableeditbox {
  background-color: var(--skin-field-hover);
  color: var(--skin-field-foreground);
}
.inputs-text-field-default-default-validation-default:active:enabled .bindableeditbox {
  background-color: var(--skin-field-pressed);
}
.inputs-text-field-default-default-validation-default:enabled .unity-base-text-field:hover:enabled > .unity-base-text-field__input {
  border-color: var(--skin-field-border);
}
.inputs-text-field-default-default-validation-default:enabled .unity-base-text-field:focus:enabled > .unity-base-text-field__input,
.inputs-text-field-default-default-validation-default:enabled .bindableeditbox:focus:enabled {
  border-color: var(--skin-field-focus-border);
}
.inputs-text-field-default-default-validation-default:disabled .bindableeditbox {
  background-color: var(--skin-action-disabled-background);
  border-color: var(--skin-action-disabled-border);
  color: var(--skin-text-disabled);
}


/* Secondary manager/biography pickers are fields, including their generated
 * SelectionField child. Opening a cascading club menu must retain neutral
 * control paint instead of generic Volt visual-highlighted behind light ink. */
.tifo-dropdown-secondary .si-dropdown__selection-field,
.manager-creation-dropdown-secondary .si-dropdown__selection-field {
  background-color: var(--skin-control-background);
  color: var(--skin-text-primary);
}
.tifo-dropdown-secondary:hover:enabled .si-dropdown__selection-field:enabled,
.tifo-dropdown-secondary .si-dropdown__selection-field:hover:enabled,
.tifo-dropdown-secondary .si-dropdown__selection-field.visual-highlighted:enabled,
.manager-creation-dropdown-secondary:hover:enabled .si-dropdown__selection-field:enabled,
.manager-creation-dropdown-secondary .si-dropdown__selection-field:hover:enabled,
.manager-creation-dropdown-secondary .si-dropdown__selection-field.visual-highlighted:enabled {
  background-color: var(--skin-control-hover);
  color: var(--skin-text-primary);
}
.tifo-dropdown-secondary:active:enabled .si-dropdown__selection-field:enabled,
.tifo-dropdown-secondary .si-dropdown__selection-field:active:enabled,
.manager-creation-dropdown-secondary:active:enabled .si-dropdown__selection-field:enabled,
.manager-creation-dropdown-secondary .si-dropdown__selection-field:active:enabled {
  background-color: var(--skin-control-pressed);
}
.tifo-dropdown-secondary:disabled .si-dropdown__selection-field,
.manager-creation-dropdown-secondary:disabled .si-dropdown__selection-field,
.tifo-dropdown-secondary .si-dropdown__selection-field:disabled,
.manager-creation-dropdown-secondary .si-dropdown__selection-field:disabled {
  background-color: var(--skin-action-disabled-background);
  color: var(--skin-text-disabled);
}


/* The swatch badge is selection chrome, not a success assessment. Replace
 * only its multicolour native tick-circle asset; colour-option paint remains
 * the chosen skin/hair/clothing colour. FM binds this badge to a black backing
 * and white edge at runtime, so use a high-contrast accent tick on that neutral
 * backing rather than dark ink that depends on an overridable filled surface.
 * Keep native size and show/hide rules. */
.colour-swatch-selected.ui-concepts-tick_circle_success_small {
  background-image: url("assets/icons/selection-tick.png");
  background-color: var(--skin-surface-canvas);
  -unity-background-image-tint-color: var(--skin-selection-background);
  border-color: var(--skin-selection-background);
  border-width: 1px;
  border-radius: 16px;
}
.manager-creation-colour-remap-button:hover:enabled .colour-swatch-selected {
  -unity-background-image-tint-color: var(--skin-selection-hover);
}
.manager-creation-colour-remap-button:active:enabled .colour-swatch-selected {
  -unity-background-image-tint-color: var(--skin-selection-pressed);
}
.manager-creation-colour-remap-button:disabled .colour-swatch-selected {
  background-color: var(--skin-action-disabled-background);
  -unity-background-image-tint-color: var(--skin-text-disabled);
}

/* Qualification competition names retain white native rich-text paint even
 * when their sitext leaf computes selection ink. Use the shared neutral choice
 * surface with a Volt selection edge/mark, as for other rich-name controls. */
#CompetitionQualificationPlacesCard .segmented-button-group.horizontal-radio-group {
  --skin-selection-background: var(--skin-choice-card-selected);
  --skin-selection-hover: var(--skin-control-hover);
  --skin-selection-pressed: var(--skin-control-pressed);
  --skin-selection-foreground: var(--skin-choice-foreground);
}
#CompetitionQualificationPlacesCard .segmented-button-group .unity-radio-button.unity-radio-button-group__child-active:enabled {
  border-color: var(--skin-choice-marker);
}
#CompetitionQualificationPlacesCard .segmented-button-group .unity-radio-button.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark-background {
  border-color: var(--skin-choice-marker);
}
#CompetitionQualificationPlacesCard .segmented-button-group .unity-radio-button.unity-radio-button-group__child-active:enabled .unity-radio-button__checkmark {
  background-color: var(--skin-choice-marker);
  border-color: var(--skin-choice-marker);
}

/* The position colour lives on the clipping parent, while the full-field
 * embedded button paints above it. Keep role colour visible through feedback;
 * this is separate from ordinary neutral embedded buttons and pitch controls. */
.picked_position-border-clip > .embedded-button-misc:hover:enabled {
  background-color: var(--skin-picked-position-hover-overlay);
}
.picked_position-border-clip > .embedded-button-misc:active:enabled {
  background-color: var(--skin-picked-position-pressed-overlay);
}
.picked_position-border-clip > .embedded-button-misc:disabled {
  background-color: var(--skin-transparent);
}

/* Player overview's two verified monochrome toggle glyphs share their fill's
 * ink. Scope to these leaves; preserve portraits, badges and status artwork. */
#PlayerAttributesBlock .sicheckbox .game-concepts-attributes-medium,
#roles-positions-tables-visible-toggle-button.sicheckbox .game-concepts-compare_small {
  -unity-background-image-tint-color: var(--skin-text-primary);
}
#PlayerAttributesBlock .sicheckbox:checked:enabled .game-concepts-attributes-medium,
#roles-positions-tables-visible-toggle-button.sicheckbox:checked:enabled .game-concepts-compare_small {
  -unity-background-image-tint-color: var(--skin-selection-foreground);
}
#PlayerAttributesBlock .sicheckbox:disabled .game-concepts-attributes-medium,
#roles-positions-tables-visible-toggle-button.sicheckbox:disabled .game-concepts-compare_small {
  -unity-background-image-tint-color: var(--skin-action-disabled-foreground);
}

/* Finance Overview's two popup actions duplicate a trailing gap after their
 * open icon. Preserve the label-to-icon gap and ordinary button padding. */
#ReportBody #frames-transfer-budget-graphs #BottomFrame #TransferAction #ui-concepts-open_small.margin-right-global-gap-small,
#ReportBody #frames-transfer-budget-graphs #BottomFrame #ScoutingAction #ui-concepts-open_small.margin-right-global-gap-small {
  margin-right: var(--skin-finance-budget-action-trailing-gap);
}
