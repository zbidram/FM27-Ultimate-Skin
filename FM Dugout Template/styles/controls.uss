  border-radius: 7px;
}

/* Inputs colour picker swatch pallete swatch regular.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 2541.
 */
.inputs-colour_picker-swatch-pallete-swatch-regular {
  background-color: var(--skin-text-primary);
  border-radius: var(--skin-radius-micro);
}

/* SI combobox button.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2542.
 */
.inputs-combobox-controls-default-type-integer-active-false-validation-default .si-combobox__button {
  padding: var(--spacing-small---8);
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  max-height: 32px;
  margin-left: 2px;
  margin-right: 2px;
  justify-content: center;
  align-items: center;
  border-radius: var(--skin-radius-control);
  flex-direction: var(--row-direction-normal);
  border-left-color: var(--skin-transparent);
  border-right-color: var(--skin-transparent);
  border-top-color: var(--skin-transparent);
  border-bottom-color: var(--skin-transparent);
}

/* SI combobox input field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Shared rule for 4 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2543.
 */
.inputs-combobox-controls-default-type-integer-active-false-validation-default .si-combobox__input-field,
.inputs-combobox-controls-default-type-integer-active-false-validation-default .si-dropdown__selection-field,
.inputs-ige-combobox-controls-default-type-cash .si-combobox__input-field,
.inputs-ige-combobox-controls-default-type-cash .si-dropdown__selection-field {
  padding: var(--spacing-new-ex) var(--spacing-tiles);
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  max-height: 32px;
  min-width: 120px;
  justify-content: space-between;
  align-items: center;
  border-radius: var(--skin-radius-small);
  margin-bottom: 0;
  flex-direction: var(--row-direction-normal);
}

/* SI combobox selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Source rule 2544.
 */
.inputs-combobox-controls-default-type-integer-active-false-validation-default .si-combobox__selection-field {
  padding: var(--spacing-new-ex) var(--spacing-tiles);
  border-width: 1px;
  border-color: var(--skin-on-media-alpha-35);
  background-color: var(--skin-transparent);
  color: var(--skin-text-primary);
  max-height: 32px;
  min-width: 60px;
  justify-content: space-between;
  align-items: center;
  border-radius: var(--skin-radius-small);
  margin-bottom: 0;
  flex-direction: var(--row-direction-normal);
}

/* SI dropdown selection field.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
