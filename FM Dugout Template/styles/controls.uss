/* Primary action hover/press retains dark Dugout ink for native icons as well as labels.
 */
.buttons-button-primary-default:hover:enabled {
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Volt hover/press uses the paired dark Dugout foreground.
 */
.buttons-button-primary-default:hover:enabled .sitext,
.buttons-button-primary-default:hover:enabled .sitextmedium,
.buttons-button-primary-default:hover:enabled .sitextsmall,
.buttons-button-primary-default:active:enabled .sitext,
.buttons-button-primary-default:active:enabled .sitextmedium,
.buttons-button-primary-default:active:enabled .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Continue
 * Continue control presentation. Native competition and response-required states are distinct contracts.
 */

/* Continue button layout.
 * Owns the common size, spacing, outline and clipping. Its variant classes choose the colours.
 * Source rule 1747.
 */
.continue-button {
  width: 212px;
  height: 40px;
  margin: 0;
  padding: 0px 12px;
  border-width: 1px;
  border-color: var(--skin-action-primary-border);
  flex-direction: var(--row-direction-normal);
  min-height: 40px;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-control);
  overflow: hidden;
  transition-property: var(--transition-props-paint);
  transition-duration: var(--global-transition-long);
  transition-timing-function: linear;
}

/* Continue button bundesliga.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 1748.
 */
.continue-button---bundesliga {
  border-color: var(--skin-data-continue-button-bundesliga-border-color);
  background-color: var(--skin-data-continue-button-bundesliga-background);
}

/* Continue button bundesliga — pointer hover.
 * sets the background fill.
 * Source rule 1749.
 */
.continue-button---bundesliga:hover {
  background-color: var(--skin-data-continue-button-bundesliga-hover-background);
}

/* Continue button carabao cup.
 * tints background artwork; sets the outline/corner shape.
 * Source rule 1750.
 */
.continue-button---carabao-cup {
  border-color: var(--skin-data-continue-button-carabao-cup-border-color);
  -unity-background-image-tint-color: var(--skin-data-continue-button-carabao-cup-image-tint);
}

/* Continue button carabao cup — pointer hover.
 * tints background artwork.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1751.
 */
.continue-button---carabao-cup:hover,
.continue-button---efl-trophy:hover,
.continue-button---efl:hover {
  -unity-background-image-tint-color: var(--skin-on-media-alpha-84);
}

/* Continue button conference league.
 * sets the outline/corner shape.
 * Source rule 1752.
 */
.continue-button---conference-league {
  border-color: var(--skin-data-continue-button-conference-league-border-color);
}

/* Continue button conference league — pointer hover.
 * tints background artwork.
 * Source rule 1753.
 */
.continue-button---conference-league:hover {
  -unity-background-image-tint-color: var(--skin-data-continue-button-conference-league-hover-image-tint);
}

/* Standard Continue gradient.
 * Sets both ends of the gradient drawn over the Continue fill.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1754.
 */
.continue-button---default .sigradient,
.continue-button---default-match .sigradient,
.continue-button---processing .sigradient {
  --start-colour: var(--skin-action-primary-background);
  --end-colour: var(--skin-action-primary-background);
}

/* Standard Continue button.
 * Normal action fill and outline. Warning and licensed competition variants are styled separately.
 * Shared rule for 3 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1755.
 */
.continue-button---default,
.continue-button---default-match,
.continue-button---processing {
  border-color: var(--skin-action-primary-border);
  background-color: var(--skin-action-primary-background);
  color: var(--skin-action-primary-foreground);
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* The main Messages/Continue chevron is a Unity image, so tint it directly with the
 * same dark ink as the label on the Volt fill. */
.continue-button---default #primary-icon-image,
.continue-button---default-match #primary-icon-image {
  -unity-background-image-tint-color: var(--skin-action-primary-foreground);
}

/* Standard Continue button — pointer hover.
 * sets the background fill.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1756.
 */
.continue-button---default:hover,
.continue-button---default-match:hover {
  background-color: var(--skin-action-primary-hover);
}

/* Continue button efl.
 * sets the outline/corner shape.
 * Source rule 1757.
 */
.continue-button---efl {
  border-color: var(--skin-data-continue-button-efl-border-color);
}

/* Continue button efl trophy.
 * tints background artwork; sets the outline/corner shape.
 * Source rule 1758.
 */
.continue-button---efl-trophy {
  border-color: var(--skin-data-continue-button-efl-trophy-border-color);
  -unity-background-image-tint-color: var(--skin-data-continue-button-efl-trophy-image-tint);
}

/* Continue button europa league.
 * sets the outline/corner shape.
 * Source rule 1759.
 */
.continue-button---europa-league {
  border-color: var(--skin-data-continue-button-europa-league-border-color);
}

/* Continue button europa league — pointer hover.
 * tints background artwork.
 * Source rule 1760.
 */
.continue-button---europa-league:hover {
  -unity-background-image-tint-color: var(--skin-data-continue-button-europa-league-hover-image-tint);
}

/* Response-required gradient.
 * Warning gradient for Continue. This is separate from the normal action gradient.
 * Source rule 1761.
 */
.continue-button---must-respond SIGradient {
  --start-colour: var(--skin-feedback-warning-surface);
  --end-colour: var(--skin-feedback-warning-surface);
}

/* Continue: response required.
 * Warning presentation for an action that needs a response. Keep it recognisably different from normal
 * Continue.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1762.
 */
.continue-button---must-respond,
.continue-button---pulse {
  border-color: var(--skin-feedback-warning);
  background-color: var(--skin-feedback-warning-surface);
}

/* Continue button premier league.
 * sets the outline/corner shape.
 * Source rule 1763.
 */
.continue-button---premier-league {
  border-color: var(--skin-on-media-alpha-20);
}

/* Continue button premier league.
 * sets the gradient colours drawn by this component.
 * Shared rule for 10 selectors. Editing a declaration here affects the whole group below.
 * Source rule 1764.
 */
.continue-button---premier-league SIGradient,
.continue-button---uefa-supercup SIGradient,
.continue-button---women-ucl SIGradient,
.continue-button---conference-league SIGradient,
.continue-button---efl SIGradient,
.continue-button---efl-trophy SIGradient,
.continue-button---ucl SIGradient,
.continue-button---carabao-cup SIGradient,
.continue-button---bundesliga SIGradient,
.continue-button---europa-league SIGradient {
  --start-colour: var(--skin-transparent);
  --end-colour: var(--skin-transparent);
}

/* Continue button premier league — pointer hover.
 * sets the background fill; sets the outline/corner shape.
 * Source rule 1765.
 */
.continue-button---premier-league:hover {
  border-color: var(--skin-on-media-alpha-60);
  background-color: var(--skin-control-pressed);
}

/* Continue button processing.
 * supplies local values read by the component styling.
 * Source rule 1766.
 */
.continue-button---processing Rotator {
  --rotator-speed: 225;
}

/* Continue button processing.
 * supplies local values read by the component styling.
 * Source rule 1767.
 */
.continue-button---processing Sliding {
  --sliding-speed: 100;
}

/* Continue button pulse overlay.
 * defines how state changes animate.
 * Source rule 1768.
 */
.continue-button---pulse-overlay {
  transition-property: var(--transition-props-paint);
  transition-duration: 1.5s;
  transition-timing-function: ease-in-out;
}

/* Continue button ucl.
 * sets the outline/corner shape.
 * Source rule 1769.
 */
.continue-button---ucl {
  border-color: var(--skin-component-continue-button-ucl-border-color);
}

/* Continue button ucl — pointer hover.
 * tints background artwork.
 * Source rule 1770.
 */
.continue-button---ucl:hover {
  -unity-background-image-tint-color: var(--skin-component-continue-button-ucl-hover-image-tint);
}

/* Continue button uefa supercup.
 * sets the outline/corner shape.
 * Source rule 1771.
 */
.continue-button---uefa-supercup {
  border-color: var(--skin-data-continue-button-uefa-supercup-border-color);
}

/* Continue button women ucl.
 * sets the outline/corner shape.
 * Source rule 1772.
 */
.continue-button---women-ucl {
  border-color: var(--skin-data-continue-button-women-ucl-border-color);
}

/* Continue button background image.
 * sets the outline/corner shape; controls size/placement.
 * Source rule 1773.
 */
.continue-button--background-image {
  position: absolute;
  top: 0px;
  left: 0px;
  right: 0px;
  bottom: 0px;
  border-radius: var(--global-radius-regular);
  overflow: hidden;
}

/* Label/icon ink belongs to this component. These selectors use the same action roles
 * as the fills above; disabled controls keep their separate paired foreground. */
.continue-button---default:enabled .sitext,
.continue-button---default:enabled .sitextmedium,
.continue-button---default:enabled .sitextsmall,
.continue-button---default-match:enabled .sitext,
.continue-button---default-match:enabled .sitextmedium,
.continue-button---default-match:enabled .sitextsmall,
.continue-button---processing:enabled .sitext,
.continue-button---processing:enabled .sitextmedium,
.continue-button---processing:enabled .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

.continue-button---default:disabled .sitext,
.continue-button---default:disabled .sitextmedium,
.continue-button---default:disabled .sitextsmall,
.continue-button---default-match:disabled .sitext,
.continue-button---default-match:disabled .sitextmedium,
.continue-button---default-match:disabled .sitextsmall,
.continue-button---processing:disabled .sitext,
.continue-button---processing:disabled .sitextmedium,
.continue-button---processing:disabled .sitextsmall {
  color: var(--skin-action-disabled-foreground);
}

/* Disabled gradient uses the disabled surface, matching its label and outline. */
.continue-button---default:disabled .sigradient,
.continue-button---default-match:disabled .sigradient,
.continue-button---processing:disabled .sigradient {
  --start-colour: var(--skin-action-disabled-background);
  --end-colour: var(--skin-action-disabled-background);
}

/* Disabled native icon readers use the disabled foreground, matching the labels above. */
.continue-button---default:disabled,
.continue-button---default-match:disabled,
.continue-button---processing:disabled {
  --buttons-icons-default: var(--skin-action-disabled-foreground);
  --buttons-global-icon-surface: var(--skin-action-disabled-foreground);
  --core-controls-icon-default: var(--skin-action-disabled-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-disabled-foreground);
}

/* Continue gradient follows the same interaction role as the action fill. */
.continue-button---default:hover:enabled .sigradient,
.continue-button---default-match:hover:enabled .sigradient {
  --start-colour: var(--skin-action-primary-hover);
  --end-colour: var(--skin-action-primary-hover);
}

.continue-button---default:active:enabled .sigradient,
.continue-button---default-match:active:enabled .sigradient {
  --start-colour: var(--skin-action-primary-pressed);
  --end-colour: var(--skin-action-primary-pressed);
}

/* Primary action hover/press retains dark Dugout ink for native icons as well as labels.
 */
.continue-button---default:hover:enabled {
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Volt hover/press uses the paired dark Dugout foreground.
 */
.continue-button---default:hover:enabled .sitext,
.continue-button---default:hover:enabled .sitextmedium,
.continue-button---default:hover:enabled .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Primary action hover/press retains dark Dugout ink for native icons as well as labels.
 */
.continue-button---default-match:hover:enabled {
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Volt hover/press uses the paired dark Dugout foreground.
 */
.continue-button---default-match:hover:enabled .sitext,
.continue-button---default-match:hover:enabled .sitextmedium,
.continue-button---default-match:hover:enabled .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Primary action hover/press retains dark Dugout ink for native icons as well as labels.
 */
.continue-button---default:active:enabled {
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Volt hover/press uses the paired dark Dugout foreground.
 */
.continue-button---default:active:enabled .sitext,
.continue-button---default:active:enabled .sitextmedium,
.continue-button---default:active:enabled .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Primary action hover/press retains dark Dugout ink for native icons as well as labels.
 */
.continue-button---default-match:active:enabled {
  --buttons-icons-default: var(--skin-action-primary-foreground);
  --buttons-global-icon-surface: var(--skin-action-primary-foreground);
  --core-controls-icon-default: var(--skin-action-primary-foreground);
  --layout-ui-core-controls-icon-default: var(--skin-action-primary-foreground);
}

/* Volt hover/press uses the paired dark Dugout foreground.
 */
.continue-button---default-match:active:enabled .sitext,
.continue-button---default-match:active:enabled .sitextmedium,
.continue-button---default-match:active:enabled .sitextsmall {
  color: var(--skin-action-primary-foreground);
}

/* Inputs
 * Native inputs selectors, with adjacent shared rules in source order.
 */

/* Unity base field input.
 * sets the outline/corner shape; sets spacing around/inside the element.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2531.
 */
.input-field-noborder .unity-base-field__input,
.input-field-noborder .bindableeditbox.bindabletexteditbox {
  border-width: 0px;
  padding-left: 0px;
  padding-right: 0px;
}

/* Input positions selector medium default type thematic orientation landscape.
 * controls size/placement; sets spacing around/inside the element.
 * Source rule 2532.
 */
.input-positions-selector-medium-default-type-thematic-orientation-landscape {
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: var(--spacing-padding-small---8);
}

/* Input squad planner data point regular type ability mode dark active false.
 * sets the background fill; sets the outline/corner shape; controls size/placement; sets spacing
 * around/inside the element.
 * Source rule 2533.
 */
.input-squad-planner-data-point-regular-type-ability-mode-dark-active-false {
  width: var(--spacing-extra-large---64);
  height: 48px;
  padding: var(--numbers-border-radius-null);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-border-default);
  background-color: var(--skin-planner-point-background);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
  overflow: hidden;
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.input-squad-planner-data-point-regular-type-ability-mode-light-active-false {
  width: var(--spacing-extra-large---64);
  height: 48px;
  padding: var(--numbers-border-radius-null);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-planner-point-selected-border);
  background-color: var(--skin-selection-background);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
  overflow: hidden;
  margin-bottom: 0;
  color: var(--skin-selection-foreground);
}

/* Selected fill and foreground use the paired default Dugout Volt/ink roles.
 */
.input-squad-planner-data-point-regular-type-ability-mode-mixed-active-true {
  width: var(--spacing-extra-large---64);
  height: 48px;
  padding: var(--numbers-border-radius-null);
  border-width: var(--global-border-width-thin);
  border-color: var(--skin-planner-point-selected-border);
  background-color: var(--skin-selection-background);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  border-radius: var(--skin-radius-micro);
  overflow: hidden;
  color: var(--skin-selection-foreground);
}

/* Input squad planner data point regular type depth mode dark active false.
 * Changes text/foreground colour; sets the background fill; sets the outline/corner shape; controls
 * size/placement.
 * Shared rule for 2 selectors. Editing a declaration here affects the whole group below.
 * Source rule 2536.
 */
.input-squad-planner-data-point-regular-type-depth-mode-dark-active-false,
.input-squad-planner-data-point-regular-type-position-mode-dark-active-false {
